---
import SkipLink from '../components/common/SkipLink.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import ConciergeChat from '../components/common/ConciergeChat.astro';
import config from '../data/site-config.json';
import '../styles/global.css';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  noindex = false,
  breadcrumbs
} = Astro.props;

const siteBaseUrl = config.business.siteUrl || 'https://www.unilka.ca';
const canonicalURL = new URL(Astro.url.pathname, siteBaseUrl);
const showBreadcrumbs = breadcrumbs && breadcrumbs.length > 0 && Astro.url.pathname !== '/';
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';

// 1. Nœud WebSite (Brand Entity)
const websiteNode = {
  "@type": "WebSite",
  "@id": `${siteBaseUrl}/#website`,
  "url": `${siteBaseUrl}/`,
  "name": "unilka",
  "alternateName": ["unilka Canada", "unilka Montréal", "UNILKA Nettoyage"],
  "description": "Conciergerie et entretien ménager haut de gamme à Montréal, Rive-Sud et Lanaudière.",
  "inLanguage": "fr-CA",
  "publisher": {
    "@id": `${siteBaseUrl}/#business`
  }
};

// 2. Nœud Entreprise (Organization / LocalBusiness)
const businessNode = {
  "@type": "HomeAndConstructionBusiness",
  "@id": `${siteBaseUrl}/#business`,
  "name": "unilka",
  "url": `${siteBaseUrl}/`,
  "telephone": config.business.phone || "+1-450-421-2635",
  "email": config.business.email || "bonjour@unilka.ca",
  "logo": `${siteBaseUrl}/favicon.svg`,
  "image": `${siteBaseUrl}/images/service-residential.jpg`,
  "priceRange": "$$",
  "currenciesAccepted": "CAD",
  "paymentAccepted": "Virement Interac, Carte de crédit",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Montréal",
    "addressRegion": "QC",
    "addressCountry": "CA"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Montréal" },
    { "@type": "AdministrativeArea", "name": "Rive-Sud de Montréal" },
    { "@type": "AdministrativeArea", "name": "Lanaudière" }
  ],
  "sameAs": [
    "https://www.instagram.com/unilk_ca/"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Prestations d'entretien et de conciergerie unilka",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Nettoyage Résidentiel Prestige",
          "url": `${siteBaseUrl}/services/nettoyage-residentiel/`
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Nettoyage Commercial & Espaces Corporatifs",
          "url": `${siteBaseUrl}/services/nettoyage-commercial/`
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Nettoyage Spécialisé & Surfaces Délicates",
          "url": `${siteBaseUrl}/services/nettoyage-specialise/`
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Entretien Régulier Hôtelier 5 Étoiles",
          "url": `${siteBaseUrl}/services/entretien-regulier/`
        }
      }
    ]
  }
};

// 3. Nœud WebPage pour relier chaque page fille à l'entité mère
const webpageNode = {
  "@type": "WebPage",
  "@id": `${canonicalURL.href}#webpage`,
  "url": canonicalURL.href,
  "name": title,
  "description": description,
  "isPartOf": {
    "@id": `${siteBaseUrl}/#website`
  },
  "inLanguage": "fr-CA"
};

// 4. Nœud BreadcrumbList Schema.org (Fondamental pour que Google structure les résultats et produise des sitelinks)
const breadcrumbNode = showBreadcrumbs ? {
  "@type": "BreadcrumbList",
  "@id": `${canonicalURL.href}#breadcrumb`,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": `${siteBaseUrl}/`
    },
    ...breadcrumbs.map((b, idx) => ({
      "@type": "ListItem",
      "position": idx + 2,
      "name": b.label,
      ...(b.href ? { "item": new URL(b.href, siteBaseUrl).href } : {})
    }))
  ]
} : null;

// 5. Nœud SiteNavigationElement (Indique formellement à Google les liens annexes prioritaires)
const siteNavigationNode = isHomePage ? {
  "@type": "ItemList",
  "@id": `${siteBaseUrl}/#navigation`,
  "name": "Navigation Principale & Liens Rapides",
  "itemListElement": [
    {
      "@type": "SiteNavigationElement",
      "position": 1,
      "name": "Nos Services",
      "url": `${siteBaseUrl}/services/`
    },
    {
      "@type": "SiteNavigationElement",
      "position": 2,
      "name": "Obtenir une Soumission",
      "url": `${siteBaseUrl}/soumission/`
    },
    {
      "@type": "SiteNavigationElement",
      "position": 3,
      "name": "Carrières & Recrutement",
      "url": `${siteBaseUrl}/carrieres/`
    },
    {
      "@type": "SiteNavigationElement",
      "position": 4,
      "name": "Zones Desservies",
      "url": `${siteBaseUrl}/zones-desservies/`
    },
    {
      "@type": "SiteNavigationElement",
      "position": 5,
      "name": "Notre Méthode",
      "url": `${siteBaseUrl}/a-propos/`
    },
    {
      "@type": "SiteNavigationElement",
      "position": 6,
      "name": "Foire Aux Questions",
      "url": `${siteBaseUrl}/faq/`
    }
  ]
} : null;

// Données structurées enrichies Schema.org pour Google Sitelinks & Knowledge Panel
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    websiteNode,
    businessNode,
    webpageNode,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...(siteNavigationNode ? [siteNavigationNode] : [])
  ]
};
---

<!DOCTYPE html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Titre et Métadonnées SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Open Graph / Réseaux Sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="unilka" />

    <!-- Données structurées JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google Fonts : Manrope (Officielle) & Playfair Display (Serif Éditorial pour titres Offcut) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,600;1,700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-[#0B2A2E] flex flex-col min-h-screen selection:bg-[#E3F4F5] selection:text-[#0A5A62] font-sans">
    <SkipLink />
    <Header currentPath={Astro.url.pathname} />

    {showBreadcrumbs && <Breadcrumb items={breadcrumbs} />}

    <main id="main-content" class="flex-1 focus:outline-none overflow-x-clip">
      <slot />
    </main>

    <Footer />
    <ConciergeChat />
  </body>
</html>
