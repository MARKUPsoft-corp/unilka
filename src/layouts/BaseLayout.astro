---
import SkipLink from '../components/common/SkipLink.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import ConciergeChat from '../components/common/ConciergeChat.astro';
import config from '../data/site-config.json';
import '../styles/global.css';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  noindex = false,
  breadcrumbs
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, config.business.siteUrl || 'https://www.unilka.ca');
const showBreadcrumbs = breadcrumbs && breadcrumbs.length > 0 && Astro.url.pathname !== '/';

// Données structurées enrichies Schema.org pour Google Sitelinks & Knowledge Panel
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.unilka.ca/#website",
      "url": "https://www.unilka.ca/",
      "name": "unilka",
      "alternateName": "unilka Montréal",
      "description": "Conciergerie et entretien ménager haut de gamme à Montréal, Rive-Sud et Lanaudière.",
      "inLanguage": "fr-CA"
    },
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": "https://www.unilka.ca/#business",
      "name": "unilka",
      "url": "https://www.unilka.ca/",
      "telephone": config.business.phone || "+1-450-421-2635",
      "logo": "https://www.unilka.ca/favicon.svg",
      "image": "https://www.unilka.ca/favicon.svg",
      "description": description,
      "priceRange": "$$",
      "currenciesAccepted": "CAD",
      "paymentAccepted": "Virement Interac, Carte de crédit",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montréal",
        "addressRegion": "QC",
        "addressCountry": "CA"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Montréal" },
        { "@type": "AdministrativeArea", "name": "Rive-Sud de Montréal" },
        { "@type": "AdministrativeArea", "name": "Lanaudière" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Prestations d'entretien et de conciergerie",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Nettoyage Résidentiel Prestige",
              "url": "https://www.unilka.ca/services/nettoyage-residentiel/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Nettoyage Commercial & Espaces Corporatifs",
              "url": "https://www.unilka.ca/services/nettoyage-commercial/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Nettoyage Spécialisé & Après Rénovation",
              "url": "https://www.unilka.ca/services/nettoyage-specialise/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Entretien Régulier Hôtelier 5 Étoiles",
              "url": "https://www.unilka.ca/services/entretien-regulier/"
            }
          }
        ]
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Titre et Métadonnées SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Open Graph / Réseaux Sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="unilka" />

    <!-- Données structurées JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google Fonts : Manrope (Officielle) & Playfair Display (Serif Éditorial pour titres Offcut) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,600;1,700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-[#0B2A2E] flex flex-col min-h-screen selection:bg-[#E3F4F5] selection:text-[#0A5A62] font-sans">
    <SkipLink />
    <Header currentPath={Astro.url.pathname} />

    {showBreadcrumbs && <Breadcrumb items={breadcrumbs} />}

    <main id="main-content" class="flex-1 focus:outline-none overflow-x-clip">
      <slot />
    </main>

    <Footer />
    <ConciergeChat />
  </body>
</html>
