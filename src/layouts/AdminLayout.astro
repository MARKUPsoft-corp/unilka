---
import '../styles/global.css';

interface Props {
  title: string;
  activeNav?: 'dashboard' | 'soumissions' | 'planning' | 'clients' | 'equipe' | 'facturation' | 'parametres';
}

const { title, activeNav = 'dashboard' } = Astro.props;

const navItems = [
  {
    id: 'dashboard',
    label: "Vue d'ensemble",
    href: '/admin/',
    icon: 'chart'
  },
  {
    id: 'soumissions',
    label: "Soumissions & Devis",
    href: '/admin/soumissions/',
    icon: 'inbox',
    badge: '23'
  },
  {
    id: 'planning',
    label: "Planning & Missions",
    href: '/admin/planning/',
    icon: 'calendar',
    badge: '3'
  },
  {
    id: 'clients',
    label: "Clients & Forfaits",
    href: '/admin/clients/',
    icon: 'users'
  },
  {
    id: 'equipe',
    label: "Équipe & Candidats",
    href: '/admin/equipe/',
    icon: 'badge-check',
    badge: '11'
  },
  {
    id: 'facturation',
    label: "Facturation & Stripe",
    href: '/admin/facturation/',
    icon: 'credit-card'
  },
  {
    id: 'parametres',
    label: "Paramètres & Site",
    href: '/admin/parametres/',
    icon: 'settings'
  }
];
---

<!DOCTYPE html>
<html lang="fr-CA" class="h-full bg-[#F5FAFA]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — unilka Console Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-Flash Auth Guard : Bloque le rendu si non authentifié -->
    <style>
      html.auth-checking body {
        opacity: 0 !important;
        visibility: hidden !important;
      }
    </style>
    <script is:inline>
      (function() {
        try {
          const hasSession = localStorage.getItem('unilka_admin_logged_in') === 'true';
          if (!hasSession) {
            const target = window.location.pathname + window.location.search;
            window.location.replace('/admin/login?redirect=' + encodeURIComponent(target));
          } else {
            document.documentElement.classList.add('auth-checking');
          }
        } catch (e) {
          window.location.replace('/admin/login');
        }
      })();
    </script>
  </head>
  <body class="h-full font-['Manrope',sans-serif] text-[#0B2A2E] antialiased bg-[#F5FAFA] flex overflow-hidden">
    
    <!-- Rideau de chargement anti-flash pendant la confirmation du jeton Firebase -->
    <div id="admin-auth-curtain" class="fixed inset-0 z-[9999] bg-[#0B2A2E] flex flex-col items-center justify-center gap-3 transition-opacity duration-200">
      <div class="w-12 h-12 rounded-2xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center shadow-lg border border-[#0E7C86]/20">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 5V13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13V5" stroke="#0E7C86" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="18" cy="6" r="2.5" fill="#FFB703" />
        </svg>
      </div>
      <div class="flex items-center gap-2 text-white/80 text-xs font-semibold">
        <svg class="w-4 h-4 animate-spin text-[#0E7C86]" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Vérification de la session…</span>
      </div>
    </div>
    
    <!-- 1. BACKDROP MOBILE -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-[#0B2A2E]/50 backdrop-blur-xs z-30 hidden lg:hidden transition-opacity duration-200"></div>

    <!-- 2. BARRE LATÉRALE (SIDEBAR) -->
    <aside
      id="admin-sidebar"
      class="fixed lg:static inset-y-0 left-0 z-40 w-64 lg:w-72 bg-white border-r border-[#0E7C86]/12 flex flex-col justify-between shrink-0 h-full transition-transform duration-200 ease-out -translate-x-full lg:translate-x-0 shadow-xl lg:shadow-none"
    >
      
      <!-- Haut Sidebar : Logo & Branding -->
      <div class="p-6 border-b border-[#0E7C86]/10">
        <div class="flex items-center justify-between">
          <a href="/admin/" class="flex items-center gap-3 no-underline group" aria-label="unilka console admin">
            <span class="w-9 h-9 rounded-xl bg-[#0E7C86] flex items-center justify-center text-white font-bold text-base shadow-sm group-hover:scale-105 transition-transform duration-200">
              <svg width="20" height="20" class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 5V13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13V5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <circle cx="18" cy="6" r="2.5" fill="#FFB703" />
              </svg>
            </span>
            <div class="flex flex-col">
              <span class="text-xl font-black text-[#0B2A2E] tracking-tight leading-none lowercase">
                unilka<span class="text-[#0E7C86] text-[10px] font-bold align-super ml-0.5">®</span>
              </span>
              <span class="text-[9px] font-extrabold uppercase tracking-[0.16em] text-[#0E7C86] mt-1">
                Console Direction
              </span>
            </div>
          </a>

          <div class="flex items-center gap-1">
            <a
              href="/"
              target="_blank"
              class="text-[#3D5A5E] hover:text-[#0E7C86] p-1.5 rounded-lg hover:bg-[#F5FAFA] transition-colors"
              title="Ouvrir le site client dans un nouvel onglet"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <!-- Bouton fermer sur mobile -->
            <button
              type="button"
              id="close-sidebar-btn"
              class="lg:hidden text-[#3D5A5E] hover:text-[#0E7C86] p-1.5 rounded-lg hover:bg-[#F5FAFA]"
              aria-label="Fermer le menu"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Navigation Centrale -->
      <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto" aria-label="Menu d'administration">
        <span class="px-3 text-[10px] font-bold uppercase tracking-widest text-[#3D5A5E]/70 mb-2 block">
          Menu de Gestion
        </span>

        {navItems.map((item) => {
          const isActive = activeNav === item.id;
          return (
            <a
              href={item.href}
              class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all no-underline group ${
                isActive
                  ? 'bg-[#E3F4F5] text-[#0E7C86] shadow-2xs font-extrabold'
                  : 'text-[#3D5A5E] hover:bg-[#F5FAFA] hover:text-[#0B2A2E]'
              }`}
            >
              <div class="flex items-center gap-3">
                {item.icon === 'chart' && (
                  <svg class={`w-4 h-4 ${isActive ? 'text-[#0E7C86]' : 'text-[#3D5A5E] group-hover:text-[#0E7C86]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 10a2 2 0 012-2h2a2 2 0 012 2v8a2 2 0 01-2 2h-2a2 2 0 01-2-2v-8zM10 14a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z" />
                  </svg>
                )}
                {item.icon === 'inbox' && (
                  <svg class={`w-4 h-4 ${isActive ? 'text-[#0E7C86]' : 'text-[#3D5A5E] group-hover:text-[#0E7C86]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                  </svg>
                )}
                {item.icon === 'calendar' && (
                  <svg class={`w-4 h-4 ${isActive ? 'text-[#0E7C86]' : 'text-[#3D5A5E] group-hover:text-[#0E7C86]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
                {item.icon === 'users' && (
                  <svg class={`w-4 h-4 ${isActive ? 'text-[#0E7C86]' : 'text-[#3D5A5E] group-hover:text-[#0E7C86]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                )}
                {item.icon === 'badge-check' && (
                  <svg class={`w-4 h-4 ${isActive ? 'text-[#0E7C86]' : 'text-[#3D5A5E] group-hover:text-[#0E7C86]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.icon === 'credit-card' && (
                  <svg class={`w-4 h-4 ${isActive ? 'text-[#0E7C86]' : 'text-[#3D5A5E] group-hover:text-[#0E7C86]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                )}
                {item.icon === 'settings' && (
                  <svg class={`w-4 h-4 ${isActive ? 'text-[#0E7C86]' : 'text-[#3D5A5E] group-hover:text-[#0E7C86]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                )}
                <span>{item.label}</span>
              </div>

              {item.badge && (
                <span
                  id={`nav-badge-${item.id}`}
                  class={`text-[10px] font-extrabold px-2 py-0.5 rounded-full ${
                  item.id === 'soumissions'
                    ? 'bg-[#0E7C86] text-white'
                    : item.id === 'planning'
                    ? 'bg-[#E3F4F5] text-[#0E7C86]'
                    : 'bg-[#FFB703] text-[#0B2A2E]'
                }`}>
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Bas Sidebar : Profil Direction & Déconnexion -->
      <div class="p-4 border-t border-[#0E7C86]/10 bg-white">
        <div class="p-3 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12 flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5 overflow-hidden flex-1">
            <div id="admin-user-avatar" class="w-8 h-8 rounded-full bg-[#0E7C86] text-white font-bold text-xs flex items-center justify-center shrink-0 overflow-hidden">
              AD
            </div>
            <div class="flex flex-col min-w-0 flex-1">
              <span id="admin-user-name" class="text-xs font-extrabold text-[#0B2A2E] leading-tight truncate">Direction Unilka</span>
              <span id="admin-user-email" class="text-[10px] text-[#3D5A5E] truncate">direction@unilka.ca</span>
            </div>
          </div>
          <!-- Bouton Déconnexion -->
          <button
            type="button"
            id="admin-logout-btn"
            class="p-1.5 text-[#3D5A5E] hover:text-red-700 hover:bg-red-50 rounded-lg transition-colors cursor-pointer shrink-0"
            title="Se déconnecter de la console"
            aria-label="Déconnexion"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </button>
        </div>
      </div>

    </aside>

    <!-- 3. ZONE DE CONTENU PRINCIPALE -->
    <div class="flex-1 flex flex-col h-full overflow-hidden">
      
      <!-- Topbar Header -->
      <header class="h-16 bg-white border-b border-[#0E7C86]/12 px-4 sm:px-6 lg:px-8 flex items-center justify-between shrink-0">
        
        <div class="flex items-center gap-3 flex-1 max-w-md">
          <!-- Bouton hamburger mobile -->
          <button
            type="button"
            id="toggle-sidebar-btn"
            class="lg:hidden p-2 text-[#3D5A5E] hover:text-[#0E7C86] rounded-xl hover:bg-[#F5FAFA] -ml-1 transition-colors"
            aria-label="Ouvrir le menu"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          <!-- Recherche globale -->
          <div class="relative w-full">
            <svg class="w-4 h-4 text-[#3D5A5E] absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="search"
              id="admin-search-input"
              placeholder="Rechercher soumission, client, préposé..."
              class="w-full pl-9 pr-4 py-2 text-xs rounded-full bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] placeholder-[#3D5A5E]/60 focus:outline-none focus:border-[#0E7C86] focus:bg-white transition-all"
            />
          </div>
        </div>

        <!-- Actions rapides & Statut -->
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="hidden sm:flex items-center gap-2 text-xs text-[#3D5A5E] mr-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-semibold">Montréal</span>
            <span class="text-[#0E7C86] font-bold">● Opérationnel</span>
          </div>

          <a
            href="/admin/soumissions/?create=true"
            class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full shadow-2xs transition-colors no-underline"
          >
            <span>+ Devis</span>
          </a>

          <a
            href="/"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-[#0B2A2E] bg-[#F5FAFA] hover:bg-[#E3F4F5] border border-[#0E7C86]/15 rounded-full transition-colors no-underline"
          >
            <span class="hidden sm:inline">Site public</span>
            <svg class="w-3.5 h-3.5 text-[#0E7C86]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </header>

      <!-- Zone de Défilement Principale -->
      <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
        <div class="max-w-7xl mx-auto space-y-8">
          <slot />
        </div>
      </main>

    </div>

    <!-- 4. CONTENEUR TOAST DE CONFIRMATION -->
    <div
      id="admin-toast"
      class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-3 bg-[#0B2A2E] text-white px-5 py-3 rounded-2xl shadow-xl border border-[#0E7C86]/30 text-xs font-bold"
      role="status"
      aria-live="polite"
    >
      <span id="admin-toast-icon" class="w-5 h-5 rounded-full bg-[#0E7C86] text-white flex items-center justify-center shrink-0">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </span>
      <span id="admin-toast-message">Action confirmée</span>
    </div>

    <script is:inline>
      // 1. Mobile Sidebar toggle
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const toggleBtn = document.getElementById('toggle-sidebar-btn');
      const closeBtn = document.getElementById('close-sidebar-btn');

      function openSidebar() {
        if (sidebar && backdrop) {
          sidebar.classList.remove('-translate-x-full');
          backdrop.classList.remove('hidden');
        }
      }

      function closeSidebar() {
        if (sidebar && backdrop) {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }
      }

      toggleBtn?.addEventListener('click', openSidebar);
      closeBtn?.addEventListener('click', closeSidebar);
      backdrop?.addEventListener('click', closeSidebar);

      // 2. Global Toast Notification helper
      window.showAdminToast = function(message) {
        const toast = document.getElementById('admin-toast');
        const msgEl = document.getElementById('admin-toast-message');

        if (!toast || !msgEl) return;

        msgEl.textContent = message;

        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 3000);
      };

      // 3. Recherche globale instantanée
      const searchInput = document.getElementById('admin-search-input');
      searchInput?.addEventListener('input', (e) => {
        const query = (e.target.value || '').toLowerCase().trim();

        const subRows = document.querySelectorAll('.submission-row');
        if (subRows.length > 0) {
          let matched = 0;
          subRows.forEach(row => {
            const text = (row.textContent || '').toLowerCase();
            const show = text.includes(query);
            row.style.display = show ? '' : 'none';
            if (show) matched++;
          });
          const countEl = document.getElementById('rows-count-label');
          if (countEl) countEl.textContent = `Affichage de ${matched} sur ${subRows.length} soumissions`;
          return;
        }

        const subItems = document.querySelectorAll('.submission-item');
        if (subItems.length > 0) {
          subItems.forEach(item => {
            const text = (item.textContent || '').toLowerCase();
            item.style.display = text.includes(query) ? '' : 'none';
          });
        }
      });

      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const val = (searchInput.value || '').trim();
          if (val && !window.location.pathname.includes('/admin/soumissions')) {
            window.location.href = `/admin/soumissions/?q=${encodeURIComponent(val)}`;
          }
        }
      });
    </script>

    <!-- 3. AUTH GUARD & GESTION DU COMPTE GOOGLE -->
    <script>
      import { auth } from '../lib/firebase';
      import { onAuthStateChanged, signOut } from 'firebase/auth';

      // Garde d'authentification : Redirige vers /admin/login si non connecté
      onAuthStateChanged(auth, (user) => {
        const curtain = document.getElementById('admin-auth-curtain');

        if (!user) {
          try { localStorage.removeItem('unilka_admin_logged_in'); } catch (e) {}
          const currentPath = window.location.pathname + window.location.search;
          window.location.replace(`/admin/login?redirect=${encodeURIComponent(currentPath)}`);
          return;
        }

        // Marquer la session comme active
        try { localStorage.setItem('unilka_admin_logged_in', 'true'); } catch (e) {}
        document.documentElement.classList.remove('auth-checking');

        // Retirer l'écran de chargement en douceur
        if (curtain) {
          curtain.style.opacity = '0';
          curtain.style.pointerEvents = 'none';
          setTimeout(() => curtain.remove(), 250);
        }

        // Mise à jour de l'interface avec les données réelles du compte Google
        const nameEl = document.getElementById('admin-user-name');
        const emailEl = document.getElementById('admin-user-email');
        const avatarEl = document.getElementById('admin-user-avatar');

        if (nameEl && user.displayName) nameEl.textContent = user.displayName;
        if (emailEl && user.email) emailEl.textContent = user.email;

        if (avatarEl) {
          if (user.photoURL) {
            avatarEl.innerHTML = `<img src="${user.photoURL}" alt="${user.displayName || 'Admin'}" class="w-full h-full object-cover rounded-full" referrerpolicy="no-referrer" />`;
          } else {
            const initials = (user.displayName || user.email || 'AD').substring(0, 2).toUpperCase();
            avatarEl.textContent = initials;
          }
        }
      });

      // Synchronisation en temps réel des compteurs du menu latéral
      try {
        const { db } = await import('../lib/firebase');
        const { collection, onSnapshot } = await import('firebase/firestore');

        onSnapshot(collection(db, 'submissions'), (snap) => {
          let pendingCount = 0;
          snap.docs.forEach((doc) => {
            const data = doc.data();
            const isPending = !data.status || data.status === 'À traiter' || data.status === 'Nouveau' || data.status === 'nouveau';
            if (isPending) pendingCount++;
          });
          const badge = document.getElementById('nav-badge-soumissions');
          if (badge) badge.textContent = String(pendingCount || snap.size);
        });

        onSnapshot(collection(db, 'candidates'), (snap) => {
          const badge = document.getElementById('nav-badge-equipe');
          if (badge) badge.textContent = String(snap.size);
        });
      } catch (err) {
        console.warn('[Admin Layout] Synchronisation badges en direct :', err);
      }

      // Déconnexion
      document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
        try {
          try { localStorage.removeItem('unilka_admin_logged_in'); } catch (e) {}
          await signOut(auth);
          window.location.replace('/admin/login');
        } catch (err) {
          console.error("[unilka Auth Error] Erreur déconnexion :", err);
        }
      });
    </script>

  </body>
</html>
