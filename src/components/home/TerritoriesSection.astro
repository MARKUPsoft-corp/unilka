---
// Section 04 — Territoires d'Intervention & Zones Desservies
// Style architectural & éditorial inspiré d'Offcut, 100% charte Unilka
---

<section class="py-20 lg:py-28 bg-[#FFFFFF] border-b border-[#0E7C86]/12 relative" aria-labelledby="territories-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- EN-TÊTE ÉDITORIAL -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.14em] text-[#0E7C86]">
            04 / 04 — Territoires d'Intervention
          </span>
        </div>
        <h2 id="territories-title" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2A2E] tracking-[-0.025em] leading-[1.12]">
          Un service de proximité dans le Grand Montréal.
        </h2>
        <p class="text-base sm:text-lg text-[#3D5A5E] leading-[1.75]">
          Nos équipes se déplacent avec discrétion et ponctualité dans vos résidences privées, appartements de prestige et locaux d'affaires.
        </p>
      </div>

      <div class="hidden md:block shrink-0">
        <a
          href="/zones-desservies/"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#0E7C86] hover:text-[#0A5A62] transition-colors pb-1 border-b border-[#0E7C86]/30 hover:border-[#0E7C86]"
        >
          <span>Consulter la carte complète</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- GRILLE DES 3 ZONES PRINCIPALES -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Zone 1 : Montréal -->
      <div class="territory-card group">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="territory-badge">Zone 01</span>
            <span class="text-xs font-bold text-[#0E7C86]">Centre & Ouest</span>
          </div>
          <h3 class="text-xl font-extrabold text-[#0B2A2E] group-hover:text-[#0E7C86] transition-colors">
            Montréal & Arrondissements
          </h3>
          <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
            Interventions quotidiennes dans les quartiers résidentiels et d'affaires les plus exigeants.
          </p>

          <div class="pt-2 flex flex-wrap gap-1.5">
            <span class="tag-pill">Ville-Marie</span>
            <span class="tag-pill">Outremont</span>
            <span class="tag-pill">Westmount</span>
            <span class="tag-pill">Plateau</span>
            <span class="tag-pill">Griffintown</span>
            <span class="tag-pill">Rosemont</span>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#0E7C86]/10 flex items-center justify-between text-xs text-[#3D5A5E]">
          <span class="font-semibold">Résidences & Bureaux</span>
          <span class="text-[#0E7C86] font-bold group-hover:translate-x-1 transition-transform">Explorer ↗</span>
        </div>
      </div>

      <!-- Zone 2 : Longueuil & Rive-Sud -->
      <div class="territory-card group">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="territory-badge">Zone 02</span>
            <span class="text-xs font-bold text-[#0E7C86]">Rive-Sud</span>
          </div>
          <h3 class="text-xl font-extrabold text-[#0B2A2E] group-hover:text-[#0E7C86] transition-colors">
            Longueuil & Rive-Sud
          </h3>
          <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
            Formules adaptées aux maisons familiales, condos de standing et espaces professionnels de la Rive-Sud.
          </p>

          <div class="pt-2 flex flex-wrap gap-1.5">
            <span class="tag-pill">Vieux-Longueuil</span>
            <span class="tag-pill">Saint-Lambert</span>
            <span class="tag-pill">Brossard</span>
            <span class="tag-pill">Boucherville</span>
            <span class="tag-pill">Saint-Bruno</span>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#0E7C86]/10 flex items-center justify-between text-xs text-[#3D5A5E]">
          <span class="font-semibold">Formules récurrentes</span>
          <span class="text-[#0E7C86] font-bold group-hover:translate-x-1 transition-transform">Explorer ↗</span>
        </div>
      </div>

      <!-- Zone 3 : Lanaudière -->
      <div class="territory-card group">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="territory-badge">Zone 03</span>
            <span class="text-xs font-bold text-[#0E7C86]">Couronne Nord</span>
          </div>
          <h3 class="text-xl font-extrabold text-[#0B2A2E] group-hover:text-[#0E7C86] transition-colors">
            Lanaudière & Nord
          </h3>
          <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
            Grand ménage en profondeur, remises à neuf et entretien régulier pour grandes propriétés et résidences.
          </p>

          <div class="pt-2 flex flex-wrap gap-1.5">
            <span class="tag-pill">Repentigny</span>
            <span class="tag-pill">Terrebonne</span>
            <span class="tag-pill">Mascouche</span>
            <span class="tag-pill">Charlemagne</span>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#0E7C86]/10 flex items-center justify-between text-xs text-[#3D5A5E]">
          <span class="font-semibold">Selon distance & accès</span>
          <span class="text-[#0E7C86] font-bold group-hover:translate-x-1 transition-transform">Explorer ↗</span>
        </div>
      </div>

    </div>

    <!-- BANDEAU SOUS LES ZONES -->
    <div class="rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/15 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center font-bold text-sm shrink-0">
          📍
        </div>
        <div>
          <h4 class="text-xs sm:text-sm font-bold text-[#0B2A2E]">
            Votre municipalité ou code postal n'apparaît pas ici ?
          </h4>
          <p class="text-xs text-[#3D5A5E] mt-0.5">
            Nous analysons les demandes spécifiques sous 24h ouvrées selon le rayon de déplacement.
          </p>
        </div>
      </div>

      <div class="shrink-0 w-full sm:w-auto">
        <a
          href="/zones-desservies/"
          class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 text-xs font-bold text-[#0B2A2E] bg-white hover:bg-[#E3F4F5] border border-[#0E7C86]/20 rounded-full transition-colors no-underline"
        >
          <span>Vérifier mon code postal ↗</span>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .territory-card {
    background: #FFFFFF;
    border: 1px solid rgba(14, 124, 134, 0.12);
    border-radius: 20px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  .territory-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px -8px rgba(14, 124, 134, 0.1);
    border-color: rgba(14, 124, 134, 0.3);
  }

  .territory-badge {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background: #E3F4F5;
    color: #0E7C86;
    border: 1px solid rgba(14, 124, 134, 0.15);
  }

  .tag-pill {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #0B2A2E;
    background: #F5FAFA;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(14, 124, 134, 0.08);
  }
</style>
