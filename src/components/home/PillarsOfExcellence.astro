---
// Section 02 — Charte d'Excellence & Philosophie unilka
// Style architectural & éditorial inspiré d'Offcut, 100% charte Unilka
---

<section class="py-20 lg:py-28 bg-[#FFFFFF] border-b border-[#0E7C86]/12 relative" aria-labelledby="excellence-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 lg:space-y-20">
    
    <!-- 1. EN-TÊTE ÉDITORIAL AVEC SPLIT ASYMÉTRIQUE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Colonne Texte (7 colonnes) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.14em] text-[#0E7C86]">
            02 / 04 — Standards & Philosophie
          </span>
        </div>

        <h2 id="excellence-title" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2A2E] tracking-[-0.025em] leading-[1.12]">
          La perfection se niche dans ce qui ne se remarque pas.
        </h2>

        <p class="text-base sm:text-lg text-[#3D5A5E] leading-[1.75] max-w-2xl">
          Nous abordons chaque résidence et chaque bureau comme un sanctuaire. Pas de précipitation, pas de formules vagues : une équipe rigoureuse formée aux exigences hôtelières, intervenant avec un équipement discret et des produits sains pour votre santé et votre environnement.
        </p>

        <!-- Micro-piliers sous le texte -->
        <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/10">
            <div class="w-5 h-5 rounded-full bg-[#0E7C86] text-white flex items-center justify-center shrink-0 mt-0.5 text-[11px] font-bold">
              ✓
            </div>
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-[#0B2A2E]">Zéro Contrat Forcé</h4>
              <p class="text-xs text-[#3D5A5E] mt-0.5 leading-relaxed">Liberté totale d'ajuster ou d'interrompre vos passages.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/10">
            <div class="w-5 h-5 rounded-full bg-[#0E7C86] text-white flex items-center justify-center shrink-0 mt-0.5 text-[11px] font-bold">
              ✓
            </div>
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-[#0B2A2E]">Personnel Vérifié</h4>
              <p class="text-xs text-[#3D5A5E] mt-0.5 leading-relaxed">Antécédents contrôlés, discrétion et secret professionnel.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Colonne Image Éditoriale (5 colonnes) -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-[28px] overflow-hidden border border-[#0E7C86]/15 shadow-sm group">
          <img
            src="/images/philosophy-unilka.jpg"
            alt="Détail architectural épuré et impeccable d'un intérieur nettoyé par unilka"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="w-full h-[360px] sm:h-[420px] object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/70 via-transparent to-transparent pointer-events-none"></div>

          <!-- Badge flottant bas de photo -->
          <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md rounded-2xl p-4 border border-[#0E7C86]/15 flex items-center justify-between gap-3 shadow-lg">
            <div class="space-y-0.5">
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
                Protocole Hôtelier
              </span>
              <p class="text-xs font-bold text-[#0B2A2E]">
                Inspection en 42 points à chaque départ
              </p>
            </div>
            <span class="w-9 h-9 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-xs font-bold shrink-0">
              42/42
            </span>
          </div>
        </div>

        <!-- Pastille dorée décorative discrète en coin -->
        <div class="absolute -top-3 -right-3 w-8 h-8 rounded-full bg-[#FFB703] text-[#0B2A2E] font-black text-xs flex items-center justify-center shadow-md border-2 border-white pointer-events-none">
          ★
        </div>
      </div>

    </div>

    <!-- 2. LES 4 PILIERS DE RIGUEUR (DISPOSITION STACKING CARDS & IMAGE FIXE) -->
    <div class="space-y-8" id="engagements-section">
      
      <!-- Titre de la sous-section -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[#0E7C86]/12 pb-5">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#0E7C86]">
            Les 4 Engagements Inébranlables
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight mt-1">
            Ce que vous êtes en droit d'exiger à chaque passage.
          </h3>
        </div>
        <span class="text-xs font-semibold text-[#3D5A5E]">
          Montréal • Longueuil • Lanaudière
        </span>
      </div>

      <!-- Layout 2 colonnes : Cartes empilables à gauche + Image fixe à droite -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start relative">
        
        <!-- Colonne Gauche : Les 4 cartes qui s'empilent au défilement -->
        <div class="lg:col-span-7 relative">
          
          <!-- Carte 01 (Stacking Top: 125px) -->
          <div class="stacking-card card-stack-1 group">
            <span class="card-giant-watermark" aria-hidden="true">01</span>

            <div class="relative z-10 flex flex-col h-full justify-between">
              <!-- En-tête visible de la carte (reste visible à l'empilement) -->
              <div class="card-tab-header">
                <div class="flex items-center gap-2.5">
                  <span class="card-tab-badge">01</span>
                  <span class="card-tab-label">Méthode</span>
                </div>
                <span class="card-status-pill">Standard 5★</span>
              </div>

              <!-- Corps de la carte -->
              <div class="space-y-3 mt-1">
                <h4 class="text-xl sm:text-2xl font-extrabold text-[#0B2A2E] group-hover:text-[#0E7C86] transition-colors tracking-tight">
                  Rigueur & Finition Hôtelière
                </h4>
                <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-xl">
                  Du dépoussiérage méticuleux des plinthes au polissage des chromes et des surfaces en marbre, aucun recoin n'est négligé. Nos protocoles s'inspirent des plus grands palaces.
                </p>

                <!-- Points de contrôle hôtelier -->
                <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-semibold text-[#0B2A2E]">
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Microfibres dédiées par zone</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Aspiration HEPA filtration 99.9%</span>
                  </div>
                </div>
              </div>

              <!-- Pied de carte -->
              <div class="mt-6 pt-4 border-t border-[#0E7C86]/10 text-xs font-bold text-[#0E7C86] flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                  <span>Checklist 42 points validée</span>
                  <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
                <span class="text-[11px] font-bold text-[#3D5A5E]">Intervention certifiée</span>
              </div>
            </div>
          </div>

          <!-- Carte 02 (Stacking Top: 175px — laisse voir le haut de 01) -->
          <div class="stacking-card card-stack-2 group">
            <span class="card-giant-watermark" aria-hidden="true">02</span>

            <div class="relative z-10 flex flex-col h-full justify-between">
              <!-- En-tête visible de la carte -->
              <div class="card-tab-header">
                <div class="flex items-center gap-2.5">
                  <span class="card-tab-badge">02</span>
                  <span class="card-tab-label">Confiance</span>
                </div>
                <span class="card-status-pill">Personnel Assermenté</span>
              </div>

              <!-- Corps de la carte -->
              <div class="space-y-3 mt-1">
                <h4 class="text-xl sm:text-2xl font-extrabold text-[#0B2A2E] group-hover:text-[#0E7C86] transition-colors tracking-tight">
                  Discrétion & Antécédents
                </h4>
                <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-xl">
                  Vos espaces, vos effets personnels et vos dossiers professionnels restent inviolables. Personnel salarié assermenté, vérification systématique du casier judiciaire et clause de secret total.
                </p>

                <!-- Points de contrôle de confiance -->
                <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-semibold text-[#0B2A2E]">
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Casier judiciaire canadien vierge</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Clause de confidentialité signée</span>
                  </div>
                </div>
              </div>

              <!-- Pied de carte -->
              <div class="mt-6 pt-4 border-t border-[#0E7C86]/10 text-xs font-bold text-[#0E7C86] flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                  <span>Confiance & sérénité totale</span>
                  <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
                <span class="text-[11px] font-bold text-[#3D5A5E]">Contrôle rigoureux</span>
              </div>
            </div>
          </div>

          <!-- Carte 03 (Stacking Top: 225px — laisse voir le haut de 01 et 02) -->
          <div class="stacking-card card-stack-3 group">
            <span class="card-giant-watermark" aria-hidden="true">03</span>

            <div class="relative z-10 flex flex-col h-full justify-between">
              <!-- En-tête visible de la carte -->
              <div class="card-tab-header">
                <div class="flex items-center gap-2.5">
                  <span class="card-tab-badge">03</span>
                  <span class="card-tab-label">Exactitude</span>
                </div>
                <span class="card-status-pill">Ponctualité 100%</span>
              </div>

              <!-- Corps de la carte -->
              <div class="space-y-3 mt-1">
                <h4 class="text-xl sm:text-2xl font-extrabold text-[#0B2A2E] group-hover:text-[#0E7C86] transition-colors tracking-tight">
                  Ponctualité & Écoute
                </h4>
                <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-xl">
                  Arrivée à l'heure convenue, respect strict du cahier des charges et adaptation fine à vos habitudes de vie ou de travail. Vous gardez le même préposé attitré pour chaque passage.
                </p>

                <!-- Points de contrôle ponctualité -->
                <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-semibold text-[#0B2A2E]">
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Créneau horaire strict respecté</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Même intervenant(e) attitré(e)</span>
                  </div>
                </div>
              </div>

              <!-- Pied de carte -->
              <div class="mt-6 pt-4 border-t border-[#0E7C86]/10 text-xs font-bold text-[#0E7C86] flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                  <span>Créneau garanti sans décalage</span>
                  <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
                <span class="text-[11px] font-bold text-[#3D5A5E]">Engagement tenu</span>
              </div>
            </div>
          </div>

          <!-- Carte 04 (Stacking Top: 275px — laisse voir le haut de 01, 02 et 03) -->
          <div class="stacking-card card-stack-4 group">
            <span class="card-giant-watermark" aria-hidden="true">04</span>

            <div class="relative z-10 flex flex-col h-full justify-between">
              <!-- En-tête visible de la carte -->
              <div class="card-tab-header">
                <div class="flex items-center gap-2.5">
                  <span class="card-tab-badge">04</span>
                  <span class="card-tab-label">Flexibilité</span>
                </div>
                <span class="card-status-pill">Liberté Absolue</span>
              </div>

              <!-- Corps de la carte -->
              <div class="space-y-3 mt-1">
                <h4 class="text-xl sm:text-2xl font-extrabold text-[#0B2A2E] group-hover:text-[#0E7C86] transition-colors tracking-tight">
                  Sans Engagement de Durée
                </h4>
                <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-xl">
                  Pas de clause restrictive, de tacite reconduction ni de cadenas contractuel. Vous renouvelez nos interventions pour la constance et la qualité du résultat, tout simplement.
                </p>

                <!-- Points de contrôle flexibilité -->
                <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-semibold text-[#0B2A2E]">
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Suspension ou pause en 1 clic</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center text-[10px] font-bold">✓</span>
                    <span>Zéro frais d'annulation cachés</span>
                  </div>
                </div>
              </div>

              <!-- Pied de carte -->
              <div class="mt-6 pt-4 border-t border-[#0E7C86]/10 text-xs font-bold text-[#0E7C86] flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                  <span>Liberté de choix garantie</span>
                  <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
                <span class="text-[11px] font-bold text-[#3D5A5E]">Sans contrainte</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Colonne Droite : Image fixe qui reste ancrée pendant l'empilement -->
        <div class="lg:col-span-5 sticky-image-wrapper">
          <div class="sticky-image-card group">
            <img
              src="/images/service-residential.jpg"
              alt="Intérieur raffiné impeccable entretenu selon les standards hôteliers par unilka"
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/75 via-[#0B2A2E]/20 to-transparent pointer-events-none"></div>

            <!-- Badge supérieur gauche -->
            <div class="absolute top-5 left-5 bg-white/95 backdrop-blur-md rounded-full px-3.5 py-1.5 border border-[#0E7C86]/20 shadow-sm flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#0E7C86] animate-pulse"></span>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-[#0B2A2E]">
                Finition Hôtelière 5★
              </span>
            </div>

            <!-- Badge flottant inférieur -->
            <div class="absolute bottom-5 left-5 right-5 bg-white/95 backdrop-blur-md rounded-2xl p-5 border border-[#0E7C86]/20 shadow-xl space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
                  Protocole d'Excellence
                </span>
                <span class="text-[11px] font-bold bg-[#E3F4F5] text-[#0A5A62] px-2.5 py-0.5 rounded-full">
                  Certifié unilka
                </span>
              </div>
              <p class="text-xs sm:text-sm font-bold text-[#0B2A2E] leading-snug">
                Chaque pièce fait l'objet d'un contrôle visuel systématique avant le départ de nos équipes.
              </p>
              <div class="pt-2 border-t border-[#0E7C86]/10 flex items-center justify-between text-[11px] text-[#3D5A5E]">
                <span>Soin des matériaux nobles</span>
                <span class="font-extrabold text-[#0E7C86]">Marbre • Bois • Inox</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- 3. RUBAN DE CONFIANCE & SÉCURITÉ GARANTIE -->
    <div class="rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/15 p-6 sm:p-8">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
            <h4 class="text-sm font-extrabold uppercase tracking-wider text-[#0B2A2E]">
              Garanties & Sérénité unilka
            </h4>
          </div>
          <p class="text-xs sm:text-sm text-[#3D5A5E]">
            Tout est en règle avant même que nos équipes ne franchissent votre porte.
          </p>
        </div>

        <!-- 4 Badges de réassurance clés -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 w-full lg:w-auto">
          
          <div class="trust-badge">
            <svg class="w-4 h-4 text-[#0E7C86] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Assurance responsabilité</span>
          </div>

          <div class="trust-badge">
            <svg class="w-4 h-4 text-[#0E7C86] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>Personnel cautionné & vérifié</span>
          </div>

          <div class="trust-badge">
            <svg class="w-4 h-4 text-[#0E7C86] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <span>Produits éco-responsables</span>
          </div>

          <div class="trust-badge">
            <svg class="w-4 h-4 text-[#0E7C86] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Devis sous 24h ouvrées</span>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* ==========================================================================
     STACKING CARDS (EFFET D'EMPILEMENT AU DÉFILEMENT)
     ========================================================================== */
  .stacking-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(14, 124, 134, 0.16);
    border-radius: 28px;
    padding: 2rem 1.75rem 1.75rem;
    position: relative;
    overflow: hidden;
    /* Ombre d'élévation supérieure et inférieure pour séparer les couches empilées */
    box-shadow:
      0 -4px 20px rgba(11, 42, 46, 0.05),
      0 12px 32px rgba(11, 42, 46, 0.07);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }

  @media (min-width: 640px) {
    .stacking-card {
      padding: 2.25rem 2rem 2rem;
    }
  }

  /* Définition du sticky & décalage progressif pour voir le bout des cartes précédentes */
  @media (min-width: 1024px) {
    .stacking-card {
      position: sticky;
      min-height: 310px;
    }

    .card-stack-1 {
      top: 115px;
      z-index: 10;
      margin-bottom: 80px;
    }

    .card-stack-2 {
      top: 175px;
      z-index: 20;
      margin-bottom: 80px;
    }

    .card-stack-3 {
      top: 235px;
      z-index: 30;
      margin-bottom: 80px;
    }

    .card-stack-4 {
      top: 295px;
      z-index: 40;
      margin-bottom: 30px;
    }
  }

  /* Sur mobile / tablette < 1024px, espacement naturel */
  @media (max-width: 1023px) {
    .stacking-card {
      margin-bottom: 24px;
    }
  }

  .stacking-card:hover {
    border-color: rgba(14, 124, 134, 0.32);
  }

  /* Grand numéro géant en filigrane d'arrière-plan (prend la moitié de la hauteur de la carte) */
  .card-giant-watermark {
    position: absolute;
    right: 1.25rem;
    bottom: -1rem;
    font-size: clamp(130px, 16vw, 190px);
    font-weight: 900;
    font-family: var(--font-body, 'Manrope', sans-serif);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: rgba(14, 124, 134, 0.08);
    user-select: none;
    pointer-events: none;
    z-index: 0;
    transition: color 0.3s ease, transform 0.3s ease;
