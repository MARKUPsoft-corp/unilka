---
// Hero Conciergerie & Hôtellerie Premium — unilka
---

<section class="relative bg-gradient-to-b from-brand-surface-subtle via-white to-brand-surface-subtle overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-brand-primary-light/60">
  
  <!-- Lueur d'ambiance luxueuse en arrière-plan -->
  <div class="absolute -top-40 right-0 w-[500px] h-[500px] bg-brand-primary-light/40 rounded-full blur-3xl pointer-events-none -z-0" aria-hidden="true"></div>
  <div class="absolute top-1/2 -left-40 w-[400px] h-[400px] bg-brand-gold-light/50 rounded-full blur-3xl pointer-events-none -z-0" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Colonne Gauche : Accroche Éditoriale -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        
        <!-- Badge Luxe -->
        <div class="inline-flex max-w-full items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-brand-primary/20 shadow-xs text-brand-navy text-[11px] sm:text-xs font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse shrink-0"></span>
          <span class="truncate sm:whitespace-normal">Service d'entretien haut de gamme • Montréal & environs</span>
        </div>

        <!-- Titre Majeur -->
        <div class="space-y-4">
          <h1 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-black text-brand-navy tracking-editorial leading-[1.12]">
            L'art d'un espace impeccable, le luxe de votre temps retrouvé.
          </h1>
          <p class="text-lg sm:text-xl font-medium text-brand-primary">
            La propreté qui fait toute la différence.
          </p>
        </div>

        <!-- Paragraphe descriptif haut de gamme -->
        <p class="text-base sm:text-lg text-brand-muted leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Nous apportons les standards de rigueur et de finition de l'hôtellerie à votre résidence privée, votre copropriété ou vos bureaux. Discrétion absolue, personnel sélectionné et interventions sur-mesure sans engagement.
        </p>

        <!-- Boutons d'action tactiles -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="/soumission/"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-brand-navy hover:bg-brand-primary rounded-lg shadow-luxury hover:shadow-luxury-hover transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] no-underline focus-visible:outline-2 focus-visible:outline-brand-primary"
          >
            <span>Demander une soumission</span>
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
          
          <a
            href="#services"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 text-base font-semibold text-brand-navy bg-white hover:bg-brand-primary-light/50 border border-brand-primary-light rounded-lg shadow-2xs transition-all duration-200 no-underline"
          >
            Découvrir nos standards
          </a>
        </div>

        <!-- Indicateurs de réassurance discrets -->
        <div class="pt-6 border-t border-brand-primary-light/70 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-semibold text-brand-navy/80">
          <div class="flex items-center justify-center lg:justify-start gap-2">
            <svg class="w-4 h-4 text-brand-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Discrétion & rigueur</span>
          </div>
          <div class="flex items-center justify-center lg:justify-start gap-2">
            <svg class="w-4 h-4 text-brand-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Personnel qualifié</span>
          </div>
          <div class="flex items-center justify-center lg:justify-start gap-2">
            <svg class="w-4 h-4 text-brand-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Sans contrat d'engagement</span>
          </div>
        </div>

      </div>

      <!-- Colonne Droite : Widget Conciergerie Express Interactif -->
      <div class="lg:col-span-5">
        <div class="bg-white/95 backdrop-blur-md rounded-2xl border border-brand-primary-light shadow-luxury-card p-6 sm:p-8 space-y-6 relative group">
          
          <!-- En-tête de la carte -->
          <div class="flex items-center justify-between border-b border-brand-primary-light/60 pb-4">
            <div>
              <p class="text-[11px] uppercase tracking-widest font-bold text-brand-primary">Module d'estimation</p>
              <h2 class="text-xl font-bold text-brand-navy">Votre besoin d'entretien</h2>
            </div>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-[11px] font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Disponibilité 7j/7</span>
            </span>
          </div>

          <!-- Onglets de sélection interactive -->
          <div class="grid grid-cols-2 gap-1.5 p-1 bg-brand-surface-subtle rounded-lg border border-brand-primary-light/80" role="tablist">
            <button
              type="button"
              class="hero-tab-btn py-2 px-3 text-xs font-bold rounded-md transition-all duration-150 bg-white text-brand-navy shadow-xs"
              data-target="tab-res"
              role="tab"
              aria-selected="true"
            >
              Résidentiel
            </button>
            <button
              type="button"
              class="hero-tab-btn py-2 px-3 text-xs font-semibold rounded-md transition-all duration-150 text-brand-muted hover:text-brand-navy"
              data-target="tab-com"
              role="tab"
              aria-selected="false"
            >
              Commercial
            </button>
            <button
              type="button"
              class="hero-tab-btn py-2 px-3 text-xs font-semibold rounded-md transition-all duration-150 text-brand-muted hover:text-brand-navy"
              data-target="tab-spe"
              role="tab"
              aria-selected="false"
            >
              Spécialisé
            </button>
            <button
              type="button"
              class="hero-tab-btn py-2 px-3 text-xs font-semibold rounded-md transition-all duration-150 text-brand-muted hover:text-brand-navy"
              data-target="tab-reg"
              role="tab"
              aria-selected="false"
            >
              Abonnement
            </button>
          </div>

          <!-- Contenu dynamique des onglets -->
          <div class="min-h-[160px] flex flex-col justify-between">
            
            <!-- Onglet 1 : Résidentiel -->
            <div id="tab-res" class="hero-tab-panel space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-brand-navy">Maison, Condo ou Appartement</span>
                <span class="text-xs px-2 py-0.5 rounded bg-brand-primary-light text-brand-primary font-semibold">Le + demandé</span>
              </div>
              <p class="text-xs text-brand-muted leading-relaxed">
                Cuisine intégrale, sanitaires étincelants, dépoussiérage méticuleux et soin des planchers.
              </p>
              <ul class="text-xs text-brand-navy space-y-1 pt-1">
                <li class="flex items-center gap-2">✓ Produits d'entretien sécuritaires et efficaces</li>
                <li class="flex items-center gap-2">✓ Même préposé(e) dédié(e) selon votre formule</li>
              </ul>
            </div>

            <!-- Onglet 2 : Commercial -->
            <div id="tab-com" class="hero-tab-panel hidden space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-brand-navy">Bureaux & Espaces Commerciaux</span>
                <span class="text-xs px-2 py-0.5 rounded bg-brand-primary-light text-brand-primary font-semibold">Propreté Pro</span>
              </div>
              <p class="text-xs text-brand-muted leading-relaxed">
                Environnement irréprochable pour vos collaborateurs et clients. Bureaux, boutiques, cliniques.
              </p>
              <ul class="text-xs text-brand-navy space-y-1 pt-1">
                <li class="flex items-center gap-2">✓ Horaires flexibles (tôt le matin ou en soirée)</li>
                <li class="flex items-center gap-2">✓ Protocole d'hygiène rigoureux et désinfection</li>
              </ul>
            </div>

            <!-- Onglet 3 : Spécialisé -->
            <div id="tab-spe" class="hero-tab-panel hidden space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-brand-navy">Canapés, Tapis & Remise à neuf</span>
                <span class="text-xs px-2 py-0.5 rounded bg-brand-gold-light text-brand-gold font-semibold">Soin Textil</span>
              </div>
              <p class="text-xs text-brand-muted leading-relaxed">
                Nettoyage par injection-extraction de vos canapés, matelas, tapis et intérieurs de véhicules.
              </p>
              <ul class="text-xs text-brand-navy space-y-1 pt-1">
                <li class="flex items-center gap-2">✓ Élimination des taches, odeurs et allergènes</li>
                <li class="flex items-center gap-2">✓ Possibilité de joindre des photos pour devis direct</li>
              </ul>
            </div>

            <!-- Onglet 4 : Régulier -->
            <div id="tab-reg" class="hero-tab-panel hidden space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-brand-navy">Entretien Récurrent Privilège</span>
                <span class="text-xs px-2 py-0.5 rounded bg-brand-primary text-white font-semibold">Tarif Forfaitaire</span>
              </div>
              <p class="text-xs text-brand-muted leading-relaxed">
                Chaque semaine, aux 2 semaines ou mensuel. Un tarif clair fixé à l'avance sans surprise.
              </p>
              <ul class="text-xs text-brand-navy space-y-1 pt-1">
                <li class="flex items-center gap-2">✓ Priorité sur le calendrier d'interventions</li>
                <li class="flex items-center gap-2">✓ Modulable ou annulable en toute liberté</li>
              </ul>
            </div>

          </div>

          <!-- Bouton CTA du Widget -->
          <div class="pt-2">
            <a
              id="hero-widget-cta"
              href="/soumission/"
              class="w-full inline-flex items-center justify-center py-3.5 px-4 text-sm font-bold text-white bg-brand-primary hover:bg-brand-primary-dark rounded-lg shadow-sm transition-all duration-150 no-underline text-center"
            >
              <span>Personnaliser ma soumission</span>
              <span class="ml-2 font-normal" aria-hidden="true">→</span>
            </a>
            <p class="text-[11px] text-center text-brand-muted mt-2">
              Estimation sans engagement • Réponse garantie sous 24h
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Contrôleur des onglets interactifs du Hero
  const tabButtons = document.querySelectorAll('.hero-tab-btn');
  const tabPanels = document.querySelectorAll('.hero-tab-panel');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      
      tabButtons.forEach(b => {
        b.classList.remove('bg-white', 'text-brand-navy', 'shadow-xs');
        b.classList.add('text-brand-muted');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('bg-white', 'text-brand-navy', 'shadow-xs');
      btn.classList.remove('text-brand-muted');
      btn.setAttribute('aria-selected', 'true');

      tabPanels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>
