---
// Étape 1 : Choix du type de service, fréquence, date et plage horaire
---
<fieldset class="p-6 sm:p-8 bg-white rounded-2xl border border-brand-primary-light/80 shadow-xs space-y-6">
  <legend class="text-xl font-bold text-brand-text flex items-center gap-2">
    <span class="w-7 h-7 rounded-full bg-brand-primary text-white text-xs font-bold flex items-center justify-center shrink-0">1</span>
    <span>Votre service</span>
  </legend>

  <!-- Type de service souhaité (Obligatoire) -->
  <div class="space-y-3">
    <label class="block text-sm font-bold text-brand-text">
      Type de service souhaité <span class="text-brand-error" aria-hidden="true">*</span>
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <label class="relative flex items-center gap-3 p-4 rounded-xl border border-brand-primary-light cursor-pointer hover:bg-brand-surface-subtle transition-colors has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary-light/40">
        <input type="radio" name="serviceType" value="residentiel" class="w-4 h-4 text-brand-primary focus:ring-brand-primary" required checked />
        <span class="text-sm font-semibold text-brand-text">Résidentiel (domicile)</span>
      </label>
      <label class="relative flex items-center gap-3 p-4 rounded-xl border border-brand-primary-light cursor-pointer hover:bg-brand-surface-subtle transition-colors has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary-light/40">
        <input type="radio" name="serviceType" value="commercial" class="w-4 h-4 text-brand-primary focus:ring-brand-primary" />
        <span class="text-sm font-semibold text-brand-text">Commercial</span>
      </label>
      <label class="relative flex items-center gap-3 p-4 rounded-xl border border-brand-primary-light cursor-pointer hover:bg-brand-surface-subtle transition-colors has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary-light/40">
        <input type="radio" name="serviceType" value="specialise" class="w-4 h-4 text-brand-primary focus:ring-brand-primary" />
        <span class="text-sm font-semibold text-brand-text">Spécialisé (canapé, tapis, véhicule…)</span>
      </label>
    </div>
  </div>

  <!-- Fréquence souhaitée (Obligatoire) -->
  <div class="space-y-3 pt-4 border-t border-brand-primary-light/60">
    <label class="block text-sm font-bold text-brand-text">
      Fréquence souhaitée <span class="text-brand-error" aria-hidden="true">*</span>
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      {[
        { value: "ponctuel", label: "Une seule fois (ponctuel)" },
        { value: "hebdomadaire", label: "Chaque semaine" },
        { value: "aux-2-semaines", label: "Toutes les 2 semaines" },
        { value: "aux-3-semaines", label: "Toutes les 3 semaines" },
        { value: "mensuel", label: "Une fois par mois" },
        { value: "flexible", label: "Selon mes besoins / je ne sais pas encore" }
      ].map((freq, idx) => (
        <label class="flex items-center gap-2.5 p-3 rounded-lg border border-brand-primary-light cursor-pointer hover:bg-brand-surface-subtle text-xs sm:text-sm font-medium has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary-light/40">
          <input type="radio" name="frequency" value={freq.value} class="w-4 h-4 text-brand-primary" required checked={idx === 0} />
          <span>{freq.label}</span>
        </label>
      ))}
    </div>
  </div>

  <!-- Date et Plage horaire souhaitées -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-brand-primary-light/60">
    <div>
      <label for="desiredDate" class="block text-sm font-bold text-brand-text mb-1.5">
        Date souhaitée pour le service
      </label>
      <input
        type="date"
        id="desiredDate"
        name="desiredDate"
        class="w-full px-3.5 py-2.5 rounded-lg border border-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-primary text-sm text-brand-text"
      />
    </div>

    <div>
      <label for="timeSlot" class="block text-sm font-bold text-brand-text mb-1.5">
        Plage horaire
      </label>
      <select
        id="timeSlot"
        name="timeSlot"
        class="w-full px-3.5 py-2.5 rounded-lg border border-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-primary text-sm text-brand-text bg-white"
      >
        <option value="">Sélectionnez une plage (facultatif)</option>
        <option value="Matin">Matin</option>
        <option value="Après-midi">Après-midi</option>
        <option value="Soir">Soir</option>
        <option value="Flexible">Flexible</option>
      </select>
    </div>
  </div>

</fieldset>
