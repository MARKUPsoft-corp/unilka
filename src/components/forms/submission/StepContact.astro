---
// Étape 4 : Vos coordonnées et consentement
---
<fieldset class="relative bg-white rounded-3xl border border-[#0E7C86]/20 p-6 sm:p-10 shadow-[0_12px_40px_rgba(11,42,46,0.06)] space-y-8 overflow-hidden">
  
  <!-- Accent décoratif d'arrière-plan -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-gradient-to-br from-[#E3F4F5]/60 to-transparent rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <!-- En-tête éditorial de l'étape -->
  <div class="relative border-b border-[#0E7C86]/12 pb-6 space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#0A5A62]">
      <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
      <span>Étape 04 • Coordonnées de réponse</span>
    </div>
    
    <legend class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight block">
      Où devons-nous vous transmettre l'estimation ?
    </legend>
    
    <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-2xl">
      Votre proposition chiffrée détaillée vous parviendra sous 24 heures ouvrées. Aucun commercial intrusif, aucune obligation.
    </p>
  </div>

  <!-- 1. GRILLE COORDONNÉES PERSONNELLES -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
    
    <!-- Prénom (Obligatoire) -->
    <div class="space-y-2">
      <label for="firstName" class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        <span>Prénom <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Obligatoire</span>
      </label>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <!-- Icône Profil -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <input
          type="text"
          id="firstName"
          name="firstName"
          required
          autocomplete="given-name"
          placeholder="Ex. Alexandre"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="firstName-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Veuillez renseigner votre prénom.</span>
      </span>
    </div>

    <!-- Nom (Facultatif) -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <label for="lastName" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
          Nom de famille
        </label>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70">Facultatif</span>
      </div>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <input
          type="text"
          id="lastName"
          name="lastName"
          autocomplete="family-name"
          placeholder="Ex. Tremblay"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
    </div>

    <!-- Téléphone -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <label for="phone" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
          Numéro de téléphone
        </label>
        <span class="text-[11px] font-semibold text-[#0E7C86]">Au moins un contact</span>
      </div>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <!-- Icône Téléphone -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          placeholder="514 555 0123"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="phone-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Veuillez saisir un numéro valide (ex. 514 555 0123).</span>
      </span>
    </div>

    <!-- Courriel -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <label for="email" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
          Adresse courriel
        </label>
        <span class="text-[11px] font-semibold text-[#0E7C86]">Pour recevoir le devis</span>
      </div>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <!-- Icône Courriel -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          placeholder="nom@exemple.ca"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="email-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Veuillez saisir une adresse courriel valide.</span>
      </span>
    </div>

  </div>

  <!-- Message d'erreur commun téléphone/courriel -->
  <div id="contact-required-error" class="hidden text-xs font-bold text-red-800 p-4 bg-red-50 border-2 border-red-400 rounded-xl flex items-center gap-2" role="alert">
    <svg class="w-4 h-4 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <span>Veuillez renseigner au moins un moyen de vous répondre : téléphone ou courriel.</span>
  </div>

  <!-- 2. PRÉFÉRENCE DE CONTACT -->
  <div class="space-y-3 pt-6 border-t border-[#0E7C86]/12">
    <label class="text-xs font-black uppercase tracking-wider text-[#0B2A2E] block">
      Comment préférez-vous être contacté(e) ?
    </label>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {[
        { val: "Téléphone", desc: "Pour un échange direct et conseils personnalisés" },
        { val: "Courriel", desc: "Devis PDF chiffré directement dans votre boîte" },
        { val: "Peu importe", desc: "Selon la rapidité de notre équipe concierge" }
      ].map((pref, idx) => (
        <label class="flex items-start gap-3 p-3.5 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] cursor-pointer hover:bg-white transition-all has-[:checked]:border-[#0E7C86] has-[:checked]:bg-[#E3F4F5]/40 has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 shadow-2xs group">
          <input
            type="radio"
            name="preferredContact"
            value={pref.val}
            checked={idx === 2}
            class="w-4 h-4 text-[#0E7C86] mt-0.5 shrink-0"
          />
          <div>
            <span class="text-xs sm:text-sm font-extrabold text-[#0B2A2E] block group-has-[:checked]:text-[#0A5A62]">
              {pref.val}
            </span>
            <span class="text-[11px] text-[#3D5A5E]/80">
              {pref.desc}
            </span>
          </div>
        </label>
      ))}
    </div>
  </div>

  <!-- 3. CARTE DE SÉCURITÉ & CONSENTEMENT (LOI 25) -->
  <div class="p-5 rounded-2xl bg-gradient-to-br from-[#F5FAFA] to-[#E3F4F5]/50 border border-[#0E7C86]/20 shadow-2xs space-y-3">
    <div class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg bg-[#0E7C86] text-white flex items-center justify-center shrink-0">
        <!-- Icône Cadenas / Bouclier -->
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <span class="text-xs font-black uppercase tracking-wider text-[#0A5A62]">
        Protection des données personnelles (Loi 25 Québec)
      </span>
    </div>

    <label class="flex items-start gap-3 cursor-pointer group">
      <input
        type="checkbox"
        id="consent"
        name="consent"
        required
        class="w-5 h-5 text-[#0E7C86] border-[#0E7C86]/40 rounded focus:ring-[#0E7C86] shrink-0 mt-0.5"
      />
      <span class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed group-hover:text-[#0B2A2E] transition-colors">
        J'accepte que unilka traite ces renseignements pour calculer et me faire parvenir ma soumission personnalisée, dans le strict respect de la <a href="/confidentialite/" class="text-[#0E7C86] font-bold underline hover:text-[#0A5A62]" target="_blank" rel="noopener">politique de confidentialité</a>. <span class="text-[#0E7C86] font-bold" aria-hidden="true">*</span>
      </span>
    </label>
    
    <span id="consent-error" class="hidden text-xs font-semibold text-brand-error mt-1 flex items-center gap-1.5" role="alert">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Le consentement à la politique de confidentialité est requis pour soumettre la demande.</span>
    </span>
  </div>

  <!-- 4. BARRE D'ACTIONS & SOUMISSION FINALE -->
  <div class="pt-4 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <button
        type="button"
        class="btn-step-prev inline-flex items-center justify-center px-6 py-4 text-xs font-bold text-[#0B2A2E] hover:text-[#0E7C86] bg-[#F8FCFC] border border-[#0E7C86]/20 hover:bg-white rounded-full transition-all duration-150 shadow-2xs hover:shadow-xs cursor-pointer active:scale-[0.98]"
        data-target="3"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
        <span>Retour aux détails de l'espace</span>
      </button>

      <button
        type="submit"
        id="submit-button"
        class="w-full sm:w-auto inline-flex items-center justify-center px-9 py-4 text-sm sm:text-base font-extrabold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full shadow-[0_6px_24px_rgba(14,124,134,0.30)] hover:shadow-[0_10px_30px_rgba(14,124,134,0.40)] transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.98] cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="submit-button-text" class="flex items-center gap-2">
          <span>Envoyer ma demande de soumission</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </span>
        <span id="submit-button-spinner" class="hidden ml-2">
          <svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
      </button>
    </div>

    <!-- Réassurance finale en pied de formulaire -->
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 pt-2 text-xs font-semibold text-[#0A5A62]">
      <span class="inline-flex items-center gap-1.5">
        <span class="text-[#0E7C86] font-bold">✓</span> Devis gratuit & sans engagement
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="text-[#0E7C86] font-bold">✓</span> Réponse en 24h ouvrées
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="text-[#0E7C86] font-bold">✓</span> Assurance responsabilité civile 2M$ & CNESST
      </span>
    </div>
  </div>

</fieldset>
