---
// Étape 2 : Localisation de l'espace à nettoyer
---
<fieldset class="relative bg-white rounded-3xl border border-[#0E7C86]/20 p-6 sm:p-10 shadow-[0_12px_40px_rgba(11,42,46,0.06)] space-y-8 overflow-hidden">
  
  <!-- Accent décoratif d'arrière-plan -->
  <div class="absolute top-0 right-0 w-36 h-36 sm:w-56 sm:h-56 bg-gradient-to-br from-[#E3F4F5]/60 to-transparent rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <!-- En-tête éditorial de l'étape -->
  <div class="relative border-b border-[#0E7C86]/12 pb-6 space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#0A5A62]">
      <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
      <span>Étape 02 • Périmètre d'intervention</span>
    </div>
    
    <legend class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight block">
      Où se situe votre espace ?
    </legend>
    
    <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-2xl">
      Nos équipes concierges mobiles interviennent chaque jour dans le Grand Montréal, sur la Rive-Sud et dans Lanaudière sans frais de déplacement cachés.
    </p>
  </div>

  <!-- Champs Ville & Adresse -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
    
    <!-- Ville -->
    <div class="space-y-2">
      <label for="city" class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        <span>Ville <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
      </label>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <!-- Icône Skyline / Ville -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <input
          type="text"
          id="city"
          name="city"
          required
          autocomplete="address-level2"
          placeholder="Ex. Montréal, Longueuil, Terrebonne..."
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="city-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Veuillez renseigner votre ville.</span>
      </span>
    </div>

    <!-- Adresse civique complète -->
    <div class="space-y-2">
      <label for="address" class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        <span>Adresse civique complète</span>
      </label>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <!-- Icône Maison / Porte -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </div>
        <input
          type="text"
          id="address"
          name="address"
          autocomplete="street-address"
          placeholder="Numéro civique, rue, app / suite"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <p class="text-xs text-[#3D5A5E]/80">
        Précise le lieu d'intervention pour planifier le passage.
      </p>
    </div>

  </div>

  <!-- Bannière de réassurance géographique -->
  <div class="mt-4 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-[#F5FAFA] to-[#E3F4F5]/60 border border-[#0E7C86]/15 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-start sm:items-center gap-3">
      <div class="w-8 h-8 rounded-xl bg-[#0E7C86] text-white flex items-center justify-center shrink-0 shadow-xs">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div class="text-xs">
        <span class="font-extrabold text-[#0B2A2E] block">Secteurs couverts en temps réel</span>
        <span class="text-[#3D5A5E]">Île de Montréal • Longueuil, Brossard, Boucherville • Terrebonne, Repentigny, Mascouche</span>
      </div>
    </div>
    <div class="sm:text-right shrink-0">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-[#0E7C86]/20 text-[11px] font-bold text-[#0A5A62] shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
        Déplacement inclus
      </span>
    </div>
  </div>

</fieldset>
