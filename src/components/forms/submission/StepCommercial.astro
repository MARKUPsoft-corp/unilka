---
// Étape 3B : Détails commerciaux (conditionnel)
---
<fieldset id="block-commercial" class="hidden relative bg-white rounded-3xl border border-[#0E7C86]/20 p-6 sm:p-10 shadow-[0_12px_40px_rgba(11,42,46,0.06)] space-y-8 overflow-hidden">
  
  <!-- Accent décoratif d'arrière-plan -->
  <div class="absolute top-0 right-0 w-36 h-36 sm:w-56 sm:h-56 bg-gradient-to-br from-[#E3F4F5]/60 to-transparent rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <!-- En-tête éditorial de l'étape -->
  <div class="relative border-b border-[#0E7C86]/12 pb-6 space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#0A5A62]">
      <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
      <span>Étape 03 • Espaces d'affaires & locaux</span>
    </div>
    
    <legend class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight block">
      Détails de vos locaux professionnels
    </legend>
    
    <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-2xl">
      Interventions flexibles sans interruption de vos activités : en soirée, tôt le matin ou le week-end avec personnel discret et assuré.
    </p>
  </div>

  <!-- Type de local & Superficie -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
    
    <!-- Type de local -->
    <div class="space-y-1.5">
      <label for="commercialType" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E] block">
        Type d'établissement <span class="text-[#0E7C86]">*</span>
      </label>
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <select
          id="commercialType"
          name="commercialType"
          class="w-full pl-10 pr-9 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-xs sm:text-sm font-semibold text-[#0B2A2E] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all appearance-none shadow-2xs"
        >
          <option value="Bureau">Bureaux corporatifs & sièges sociaux</option>
          <option value="Commerce">Boutique & commerce de détail</option>
          <option value="Local professionnel">Cabinet médical, dentaire ou paramédical</option>
          <option value="Petite entreprise">Atelier ou PME dynamique</option>
          <option value="Espaces communs">Syndicat de copropriété (parties communes)</option>
          <option value="Immeuble ou espaces locatifs">Immeuble commercial locatif</option>
          <option value="Local après travaux ou rénovation">Livraison post-construction / rénovation</option>
          <option value="Autre">Autre configuration commerciale</option>
        </select>
        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-[#0E7C86]/70">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>

    <!-- Superficie approximative -->
    <div class="space-y-1.5">
      <label for="commercialArea" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E] block">
        Superficie estimée
      </label>
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        </div>
        <select
          id="commercialArea"
          name="commercialArea"
          class="w-full pl-10 pr-9 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-xs sm:text-sm font-semibold text-[#0B2A2E] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all appearance-none shadow-2xs"
        >
          <option value="">Non spécifié</option>
          <option value="Moins de 600 pi²">Moins de 600 pi²</option>
          <option value="600 à 1 000 pi²">600 à 1 000 pi²</option>
          <option value="1 000 à 1 500 pi²">1 000 à 1 500 pi²</option>
          <option value="1 500 à 2 500 pi²">1 500 à 2 500 pi²</option>
          <option value="Plus de 2 500 pi²">Plus de 2 500 pi² (visite offerte)</option>
          <option value="Je ne sais pas">À évaluer lors de la soumission</option>
        </select>
        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-[#0E7C86]/70">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>

  </div>

  <!-- Moment d'intervention souhaité -->
  <div class="space-y-3 pt-6 border-t border-[#0E7C86]/12">
    <label class="text-xs font-black uppercase tracking-wider text-[#0B2A2E] block">
      Plage horaire privilégiée pour l'intervention
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {[
        { val: "Pendant les heures d'ouverture", sub: "Présence discrète sans perturber l'accueil" },
        { val: "En dehors des heures d'ouverture", sub: "Tôt le matin ou après la fermeture (clé/code)" },
        { val: "Peu importe / à discuter", sub: "Créneau flexible selon vos impératifs" }
      ].map((item, idx) => (
        <label class="flex flex-col justify-between p-4 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] cursor-pointer hover:bg-white transition-all has-[:checked]:border-[#0E7C86] has-[:checked]:bg-[#E3F4F5]/40 has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 shadow-2xs group">
          <div class="flex items-start justify-between mb-2">
            <span class="text-xs sm:text-sm font-extrabold text-[#0B2A2E] group-has-[:checked]:text-[#0A5A62]">{item.val}</span>
            <input type="radio" name="commercialTiming" value={item.val} checked={idx === 1} class="w-4 h-4 text-[#0E7C86] shrink-0 mt-0.5" />
          </div>
          <span class="text-[11px] text-[#3D5A5E]/80 leading-snug">{item.sub}</span>
        </label>
      ))}
    </div>
  </div>

  <!-- État actuel du local -->
  <div class="space-y-3 pt-6 border-t border-[#0E7C86]/12">
    <label class="text-xs font-black uppercase tracking-wider text-[#0B2A2E] block">
      Niveau d'entretien requis <span class="text-[#0E7C86]">*</span>
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {[
        { val: "Entretien régulier", sub: "Maintenance hygiène et propreté de routine" },
        { val: "Nettoyage standard", sub: "Nettoyage périodique approfondi des postes et sanitaires" },
        { val: "Nettoyage en profondeur", sub: "Désinfection virucide, sols lustrés et surfaces lavées" },
        { val: "Local très sale nécessitant une intervention importante", sub: "Remise en état complète ou fin de bail commercial" }
      ].map((item, idx) => (
        <label class="flex items-start gap-3 p-3.5 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] cursor-pointer hover:bg-white transition-all has-[:checked]:border-[#0E7C86] has-[:checked]:bg-[#E3F4F5]/40 text-xs shadow-2xs group">
          <input type="radio" name="commercialCondition" value={item.val} checked={idx === 0} class="w-4 h-4 text-[#0E7C86] mt-0.5 shrink-0" />
          <div>
            <span class="font-extrabold text-[#0B2A2E] block text-xs sm:text-sm">{item.val}</span>
            <span class="text-[11px] text-[#3D5A5E]/80">{item.sub}</span>
          </div>
        </label>
      ))}
    </div>
  </div>

</fieldset>
