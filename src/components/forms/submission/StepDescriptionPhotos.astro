---
// Étape 3D : Description des besoins et téléversement de photos (avec prévisualisation et compression)
---
<fieldset class="p-6 sm:p-8 bg-white rounded-2xl border border-brand-primary-light/80 shadow-xs space-y-6">
  <legend class="text-xl font-bold text-brand-text flex items-center gap-2">
    <span class="w-7 h-7 rounded-full bg-brand-primary text-white text-xs font-bold flex items-center justify-center shrink-0">4</span>
    <span>Description et photos</span>
  </legend>

  <!-- Description des besoins -->
  <div>
    <div class="flex items-center justify-between mb-1.5">
      <label for="description" class="block text-sm font-bold text-brand-text">
        Description des besoins <span id="description-required-star" class="hidden text-brand-error" aria-hidden="true">*</span>
      </label>
      <span id="char-count-description" class="text-xs text-brand-muted">0 / 1500</span>
    </div>
    <textarea
      id="description"
      name="description"
      rows="4"
      maxlength="1500"
      placeholder="Décrivez-nous brièvement ce que vous souhaitez faire nettoyer..."
      class="w-full px-3.5 py-2.5 rounded-lg border border-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-primary text-sm text-brand-text leading-relaxed"
    ></textarea>
    <p class="text-xs text-brand-muted mt-1">
      Décrivez-nous brièvement ce que vous souhaitez faire nettoyer. Vous pouvez préciser les pièces concernées, les surfaces à nettoyer ou toute situation particulière dont nous devrions être informés.
    </p>
    <span id="description-error" class="hidden text-xs text-brand-error mt-1" role="alert">Ce champ est obligatoire.</span>
  </div>

  <!-- Zone de téléversement des photos (Section 9.2) -->
  <div class="pt-4 border-t border-brand-primary-light/60 space-y-3">
    <label class="block text-sm font-bold text-brand-text">
      Photos (facultatif)
    </label>
    <p class="text-xs text-brand-muted">
      Vous pouvez joindre jusqu'à 3 photos (formats JPEG, PNG ou WebP). Elles sont automatiquement réduites pour un envoi rapide et sécurisé.
    </p>

    <!-- Zone de glisser-déposer ou sélection -->
    <div
      id="photo-dropzone"
      class="border-2 border-dashed border-brand-primary/30 hover:border-brand-primary rounded-xl p-6 text-center cursor-pointer bg-brand-surface-subtle transition-colors focus-within:ring-2 focus-within:ring-brand-primary"
    >
      <input
        type="file"
        id="photo-input"
        accept="image/jpeg,image/png,image/webp"
        multiple
        class="sr-only"
        aria-label="Sélectionner jusqu'à 3 photos pour votre demande"
      />
      <div class="space-y-2 pointer-events-none">
        <svg class="w-8 h-8 text-brand-primary mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class="text-sm font-semibold text-brand-primary">
          Cliquez pour ajouter des photos ou glissez-les ici
        </p>
        <p class="text-xs text-brand-muted">JPEG, PNG ou WebP (max 3 photos)</p>
      </div>
    </div>

    <!-- Message d'erreur photo -->
    <div id="photo-error-message" class="hidden text-xs text-brand-error font-semibold" role="alert"></div>

    <!-- Liste des miniatures de photos prévisualisées -->
    <div id="photo-preview-list" class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2" aria-live="polite"></div>
  </div>

  <!-- Autre commentaire -->
  <div class="pt-4 border-t border-brand-primary-light/60">
    <div class="flex items-center justify-between mb-1.5">
      <label for="comments" class="block text-sm font-bold text-brand-text">
        Autre commentaire à ajouter ?
      </label>
      <span id="char-count-comments" class="text-xs text-brand-muted">0 / 1000</span>
    </div>
    <textarea
      id="comments"
      name="comments"
      rows="2"
      maxlength="1000"
      placeholder="Précisions supplémentaires sur vos accès, stationnement, contraintes..."
      class="w-full px-3.5 py-2.5 rounded-lg border border-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-primary text-sm text-brand-text leading-relaxed"
    ></textarea>
  </div>

</fieldset>
