---
// Étape 4 : Formations souhaitées, atouts personnels, consentements Loi 25 et envoi
---

<fieldset class="relative bg-white rounded-3xl border border-[#0E7C86]/20 p-6 sm:p-10 shadow-[0_12px_40px_rgba(11,42,46,0.06)] space-y-8 overflow-hidden">
  
  <!-- Accent décoratif d'arrière-plan -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-gradient-to-br from-[#E3F4F5]/60 to-transparent rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <!-- En-tête éditorial de l'étape -->
  <div class="relative border-b border-[#0E7C86]/12 pb-6 space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#0A5A62]">
      <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
      <span>Étape 04 • Formation & Validation</span>
    </div>
    
    <legend class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight block">
      Perfectionnement, atouts & confirmation
    </legend>
    
    <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-2xl">
      Dernière étape avant la transmission de votre candidature à notre conciergerie. Chez unilka, chaque préposé(e) bénéficie d'un encadrement bienveillant et d'un accompagnement sur-mesure.
    </p>
  </div>

  <!-- 1. INTÉRÊT POUR LA FORMATION -->
  <div class="space-y-4">
    <label class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
      Souhaitez-vous suivre une formation rémunérée pour développer vos compétences ? <span class="text-[#0E7C86]" aria-hidden="true">*</span>
    </label>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {[
        { value: "Oui", label: "Oui, très intéressé(e)" },
        { value: "Peut-être", label: "Peut-être / Selon les sujets" },
        { value: "Non", label: "Non, déjà qualifié(e)" }
      ].map((opt, idx) => (
        <label class="flex items-center gap-3 p-4 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs sm:text-sm font-semibold text-[#0B2A2E] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs group">
          <input
            type="radio"
            name="wantsTraining"
            value={opt.value}
            checked={idx === 0}
            class="w-4 h-4 text-[#0E7C86] shrink-0"
            required
          />
          <span>{opt.label}</span>
        </label>
      ))}
    </div>

    <!-- Modules de formation (si pas Non) -->
    <div id="cand-trainingsListBlock" class="space-y-3 pt-3">
      <label class="block text-xs font-bold text-[#0B2A2E]">
        Modules ou thématiques qui vous intéressent particulièrement :
      </label>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {[
          "Protocoles d'entretien hôtelier de luxe",
          "Utilisation sécuritaire des produits écologiques",
          "Soin des surfaces délicates (bois précieux, marbre)",
          "Organisation, gestion du temps & efficacité",
          "Relation client d'excellence & discrétion",
          "Santé et sécurité au travail (normes CNESST)",
          "Autre"
        ].map((tr) => (
          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs font-semibold text-[#0B2A2E] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs">
            <input
              type="checkbox"
              name="trainingTopics"
              value={tr}
              id={`topic-${tr}`}
              class="w-4 h-4 text-[#0E7C86] rounded"
            />
            <span>{tr}</span>
          </label>
        ))}
      </div>

      <div id="cand-trainingOtherContainer" class="hidden max-w-md mt-2">
        <label for="cand-trainingOther" class="block text-xs font-bold text-[#0B2A2E] mb-1">Précisez le domaine de formation souhaité</label>
        <input
          type="text"
          id="cand-trainingOther"
          name="trainingTopicOther"
          placeholder="Ex. Nettoyage de vitres en hauteur, moquettes..."
          class="w-full px-3.5 py-2.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-xs font-semibold text-[#0B2A2E] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0E7C86]/25"
        />
      </div>
    </div>
  </div>

  <!-- 2. COMPÉTENCES PARTICULIÈRES OU ATOUTS -->
  <div class="space-y-2 pt-5 border-t border-[#0E7C86]/12">
    <div class="flex items-center justify-between">
      <label for="cand-skills" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        Compétences particulières ou message à notre attention (facultatif)
      </label>
      <span id="char-count-candSkills" class="text-[11px] font-mono text-[#3D5A5E]/70">0 / 800</span>
    </div>
    
    <textarea
      id="cand-skills"
      name="skills"
      rows="3"
      maxlength="800"
      placeholder="Partagez-nous vos points forts : sens du détail, ponctualité, permis de conduire, connaissances des textiles nobles..."
      class="w-full px-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-xs sm:text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs resize-none"
    ></textarea>
  </div>

  <!-- 3. CONSENTEMENTS & ENGAGEMENT LOI 25 (QUÉBEC) -->
  <div class="space-y-4 pt-5 border-t border-[#0E7C86]/12">
    
    <!-- Encadré de transparence légale -->
    <div class="p-4 sm:p-5 rounded-2xl bg-[#F8FCFC] border border-[#0E7C86]/15 text-xs text-[#3D5A5E] leading-relaxed space-y-1.5">
      <div class="font-extrabold text-[#0B2A2E] flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[#0E7C86]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>Engagement déontologique unilka & Respect de la Loi 25 :</span>
      </div>
      <p>
        Vos données personnelles sont traitées de manière strictement confidentielle et sécurisée pour l'étude de votre candidature. Elles ne sont jamais cédées ni vendues à des tiers.
      </p>
    </div>

    <!-- Case 1 : Exactitude des renseignements (Obligatoire) -->
    <div>
      <label class="flex items-start gap-3.5 cursor-pointer group">
        <input
          type="checkbox"
          id="cand-consentAccuracy"
          name="consentAccuracy"
          required
          class="w-5 h-5 text-[#0E7C86] border-[#0E7C86]/40 rounded focus:ring-[#0E7C86] shrink-0 mt-0.5"
        />
        <span class="text-xs sm:text-sm text-[#0B2A2E] font-medium leading-relaxed group-hover:text-[#0E7C86] transition-colors">
          Je confirme l'exactitude de ces renseignements et je comprends que l'inscription ne garantit pas automatiquement l'attribution immédiate d'une mission. <span class="text-[#0E7C86] font-bold" aria-hidden="true">*</span>
        </span>
      </label>
      <span id="cand-consentAccuracy-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Vous devez accepter pour soumettre votre candidature.</span>
      </span>
    </div>

    <!-- Case 2 : Contact téléphonique / courriel (Obligatoire) -->
    <div>
      <label class="flex items-start gap-3.5 cursor-pointer group">
        <input
          type="checkbox"
          id="cand-consentContact"
          name="consentContact"
          required
          class="w-5 h-5 text-[#0E7C86] border-[#0E7C86]/40 rounded focus:ring-[#0E7C86] shrink-0 mt-0.5"
        />
        <span class="text-xs sm:text-sm text-[#0B2A2E] font-medium leading-relaxed group-hover:text-[#0E7C86] transition-colors">
          J'accepte d'être contacté(e) par l'équipe de coordination unilka par téléphone ou courriel au sujet d'opportunités correspondant à mon profil. <span class="text-[#0E7C86] font-bold" aria-hidden="true">*</span>
        </span>
      </label>
      <span id="cand-consentContact-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Vous devez accepter pour soumettre votre candidature.</span>
      </span>
    </div>

    <!-- Case 3 : Politique de confidentialité Loi 25 (Obligatoire) -->
    <div>
      <label class="flex items-start gap-3.5 cursor-pointer group">
        <input
          type="checkbox"
          id="cand-consentPrivacy"
          name="consentPrivacy"
          required
          class="w-5 h-5 text-[#0E7C86] border-[#0E7C86]/40 rounded focus:ring-[#0E7C86] shrink-0 mt-0.5"
        />
        <span class="text-xs sm:text-sm text-[#0B2A2E] font-medium leading-relaxed group-hover:text-[#0E7C86] transition-colors">
          J'accepte que mes renseignements soient hébergés et traités conformément à la <a href="/confidentialite/" class="text-[#0E7C86] font-bold underline hover:text-[#0A5A62]" target="_blank" rel="noopener">politique de confidentialité</a> d'unilka. <span class="text-[#0E7C86] font-bold" aria-hidden="true">*</span>
        </span>
      </label>
      <span id="cand-consentPrivacy-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>L'acceptation de la politique de confidentialité est requise par la Loi 25.</span>
      </span>
    </div>

  </div>

  <!-- 4. BARRE D'ACTIONS & SOUMISSION FINALE -->
  <div class="pt-5 border-t border-[#0E7C86]/12 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <button
        type="button"
        class="btn-step-prev inline-flex items-center justify-center px-6 py-4 text-xs font-bold text-[#0B2A2E] hover:text-[#0E7C86] bg-[#F8FCFC] border border-[#0E7C86]/20 hover:bg-white rounded-full transition-all duration-150 shadow-2xs hover:shadow-xs cursor-pointer active:scale-[0.98]"
        data-target="3"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
        <span>Retour aux disponibilités</span>
      </button>

      <button
        type="submit"
        id="cand-submit-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center px-9 py-4 text-sm sm:text-base font-extrabold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full shadow-[0_6px_24px_rgba(14,124,134,0.30)] hover:shadow-[0_10px_30px_rgba(14,124,134,0.40)] transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.98] cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="cand-submit-text" class="flex items-center gap-2">
          <span>Envoyer mon dossier de candidature</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </span>
        <span id="cand-submit-spinner" class="hidden ml-2">
          <svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
      </button>
    </div>

    <!-- Réassurance en pied de candidature -->
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 pt-2 text-xs font-semibold text-[#0A5A62]">
      <span class="inline-flex items-center gap-1.5">
        <span class="text-[#0E7C86] font-bold">✓</span> Statut 100% salarié & protection CNESST
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="text-[#0E7C86] font-bold">✓</span> Confidentialité stricte Loi 25
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="text-[#0E7C86] font-bold">✓</span> Prise de contact garantie sous 48h
      </span>
    </div>
  </div>

</fieldset>
