---
// Étape 3 : Disponibilités, horaires et mobilité géographique
---

<fieldset class="relative bg-white rounded-3xl border border-[#0E7C86]/20 p-6 sm:p-10 shadow-[0_12px_40px_rgba(11,42,46,0.06)] space-y-8 overflow-hidden">
  
  <!-- Accent décoratif d'arrière-plan -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-gradient-to-br from-[#E3F4F5]/60 to-transparent rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <!-- En-tête éditorial de l'étape -->
  <div class="relative border-b border-[#0E7C86]/12 pb-6 space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#0A5A62]">
      <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
      <span>Étape 03 • Disponibilités & Mobilité</span>
    </div>
    
    <legend class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight block">
      Vos créneaux et vos zones d'intervention
    </legend>
    
    <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-2xl">
      Nos plannings sont conçus de façon regroupée pour vous éviter des heures de transport inutiles et vous offrir des missions régulières et équilibrées.
    </p>
  </div>

  <!-- 1. JOURS DISPONIBLES -->
  <div class="space-y-3">
    <label class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
      <span>Jours disponibles <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
      <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Au moins 1 jour</span>
    </label>
    
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
      {["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"].map((day) => (
        <label class="flex flex-col items-center justify-center p-3 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs font-bold text-[#0B2A2E] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs text-center">
          <input
            type="checkbox"
            name="availableDays"
            value={day}
            checked={["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi"].includes(day)}
            class="w-4 h-4 text-[#0E7C86] rounded mb-1.5"
          />
          <span>{day}</span>
        </label>
      ))}
    </div>
    
    <span id="cand-availableDays-error" class="hidden text-xs font-semibold text-brand-error mt-2 flex items-center gap-1.5" role="alert">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Veuillez sélectionner au moins un jour disponible.</span>
    </span>
  </div>

  <!-- 2. MOMENTS DE LA JOURNÉE -->
  <div class="space-y-3 pt-5 border-t border-[#0E7C86]/12">
    <label class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
      <span>Moments de la journée <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
      <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Au moins 1 créneau</span>
    </label>
    
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {[
        { time: "Matin", sub: "8h — 12h" },
        { time: "Après-midi", sub: "12h — 17h" },
        { time: "Soir", sub: "17h — 21h" },
        { time: "Flexible", sub: "Toute la journée" }
      ].map((item, idx) => (
        <label class="flex flex-col p-4 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs font-semibold text-[#0B2A2E] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-[#0B2A2E]">{item.time}</span>
            <input
              type="checkbox"
              name="availableTimes"
              value={item.time}
              checked={idx === 3 || idx === 0}
              class="w-4 h-4 text-[#0E7C86] rounded"
            />
          </div>
          <span class="text-[11px] text-[#3D5A5E]">{item.sub}</span>
        </label>
      ))}
    </div>
    
    <span id="cand-availableTimes-error" class="hidden text-xs font-semibold text-brand-error mt-2 flex items-center gap-1.5" role="alert">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Veuillez sélectionner au moins un moment de la journée.</span>
    </span>
  </div>

  <!-- 3. VOLUME D'HEURES SOUHAITÉ & DATE DE DÉBUT -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6 pt-5 border-t border-[#0E7C86]/12">
    <div class="space-y-2">
      <label for="cand-hours" class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        Nombre d'heures souhaitées par semaine
      </label>
      <input
        type="number"
        id="cand-hours"
        name="desiredHours"
        min="1"
        max="60"
        placeholder="Ex. 20, 30 ou 35 h"
        class="w-full px-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
      />
    </div>

    <div class="space-y-2">
      <label for="cand-startDate" class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        Date à laquelle vous pouvez commencer
      </label>
      <input
        type="date"
        id="cand-startDate"
        name="startDate"
        class="w-full px-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
      />
    </div>
  </div>

  <!-- 4. ZONES GÉOGRAPHIQUES DESSERVIES -->
  <div class="space-y-3 pt-5 border-t border-[#0E7C86]/12">
    <label class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
      <span>Dans quelle(s) zone(s) êtes-vous prêt(e) à travailler ? <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
      <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Au moins 1 zone</span>
    </label>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {[
        "Montréal",
        "Longueuil et Rive-Sud",
        "Lanaudière",
        "Autre secteur"
      ].map((zone, idx) => (
        <label class="flex items-center gap-3 p-3.5 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs sm:text-sm font-semibold text-[#0B2A2E] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs">
          <input
            type="checkbox"
            name="workZones"
            value={zone}
            checked={idx === 0}
            class="w-4 h-4 text-[#0E7C86] rounded"
          />
          <span>{zone}</span>
        </label>
      ))}
    </div>
    
    <span id="cand-workZones-error" class="hidden text-xs font-semibold text-brand-error mt-2 flex items-center gap-1.5" role="alert">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Veuillez choisir au moins une zone de travail.</span>
    </span>
  </div>

  <!-- 5. SECTEUR PRÉCIS & MOBILITÉ / TRANSPORT -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6 pt-5 border-t border-[#0E7C86]/12">
    
    <div class="space-y-2">
      <label for="cand-exactArea" class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        Secteur ou quartier précis (facultatif)
      </label>
      <input
        type="text"
        id="cand-exactArea"
        name="exactArea"
        placeholder="Ex. Rosemont, Plateau, Brossard, Terrebonne..."
        class="w-full px-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
      />
    </div>

    <div class="space-y-2">
      <label class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        En mesure de vous déplacer pour vos missions ? <span class="text-[#0E7C86]" aria-hidden="true">*</span>
      </label>
      <div class="grid grid-cols-3 gap-2">
        {["Oui", "Non", "Selon la distance"].map((opt, idx) => (
          <label class="flex items-center justify-center gap-2 p-3 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs font-bold text-[#0B2A2E] cursor-pointer hover:bg-white has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all text-center">
            <input type="radio" name="canTravel" value={opt} checked={idx === 0} class="w-3.5 h-3.5 text-[#0E7C86]" required />
            <span>{opt}</span>
          </label>
        ))}
      </div>
    </div>

  </div>

  <!-- 6. MOYEN DE TRANSPORT -->
  <div class="space-y-3 pt-5 border-t border-[#0E7C86]/12">
    <label class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
      Moyen(s) de transport utilisé(s) (facultatif)
    </label>
    
    <div class="flex flex-wrap gap-3">
      {["Transport en commun", "Voiture", "Vélo", "Autre"].map((mode) => (
        <label class="flex items-center gap-2.5 px-4 py-3 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs sm:text-sm font-semibold text-[#0B2A2E] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs">
          <input
            type="checkbox"
            name="transportModes"
            value={mode}
            id={`trans-${mode}`}
            class="w-4 h-4 text-[#0E7C86] rounded"
          />
          <span>{mode}</span>
        </label>
      ))}
    </div>

    <div id="cand-transportOtherContainer" class="hidden max-w-md mt-2">
      <label for="cand-transportOther" class="block text-xs font-bold text-[#0B2A2E] mb-1">Précisez votre moyen de transport</label>
      <input
        type="text"
        id="cand-transportOther"
        name="transportModeOther"
        placeholder="Ex. Scooter, covoiturage..."
        class="w-full px-3.5 py-2.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-xs font-semibold text-[#0B2A2E] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0E7C86]/25"
      />
    </div>
  </div>

</fieldset>
