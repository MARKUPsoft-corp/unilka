---
// Section 6 : Mobilité et zones géographiques
---
<fieldset class="p-6 sm:p-8 bg-white rounded-2xl border border-brand-primary-light/80 shadow-xs space-y-6">
  <legend class="text-xl font-bold text-brand-text flex items-center gap-2">
    <span class="w-7 h-7 rounded-full bg-brand-primary text-white text-xs font-bold flex items-center justify-center shrink-0">5</span>
    <span>Mobilité & Déplacements</span>
  </legend>

  <!-- Zones acceptées (Obligatoire >= 1) -->
  <div class="space-y-3">
    <label class="block text-sm font-bold text-brand-text">
      Dans quelle zone êtes-vous prêt(e) à travailler ? <span class="text-brand-error" aria-hidden="true">*</span>
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      {[
        "Montréal",
        "Longueuil et Rive-Sud",
        "Lanaudière",
        "Autre secteur"
      ].map((zone, idx) => (
        <label class="flex items-center gap-2.5 p-3 rounded-lg border border-brand-primary-light text-xs sm:text-sm font-medium cursor-pointer hover:bg-brand-surface-subtle has-[:checked]:bg-brand-primary-light/50 has-[:checked]:border-brand-primary">
          <input type="checkbox" name="workZones" value={zone} checked={idx === 0} class="w-4 h-4 text-brand-primary rounded" />
          <span>{zone}</span>
        </label>
      ))}
    </div>
    <span id="cand-workZones-error" class="hidden text-xs text-brand-error" role="alert">Veuillez choisir au moins une option.</span>
  </div>

  <!-- Secteur ou ville précis -->
  <div>
    <label for="cand-exactArea" class="block text-sm font-bold text-brand-text mb-1.5">
      Secteur ou ville précis (facultatif)
    </label>
    <input
      type="text"
      id="cand-exactArea"
      name="exactArea"
      placeholder="Ex. Rosemont, Brossard, Repentigny..."
      class="w-full px-3.5 py-2.5 rounded-lg border border-brand-primary-light focus:outline-none focus:ring-2 focus:ring-brand-primary text-sm text-brand-text"
    />
  </div>

  <!-- En mesure de se déplacer -->
  <div class="space-y-3 pt-4 border-t border-brand-primary-light/60">
    <label class="block text-sm font-bold text-brand-text">
      Êtes-vous en mesure de vous déplacer pour effectuer une mission ? <span class="text-brand-error" aria-hidden="true">*</span>
    </label>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {[
        "Oui",
        "Non",
        "Selon la distance"
      ].map((opt, idx) => (
        <label class="flex items-center gap-2.5 p-3 rounded-lg border border-brand-primary-light text-sm font-medium cursor-pointer hover:bg-brand-surface-subtle has-[:checked]:bg-brand-primary-light/50 has-[:checked]:border-brand-primary">
          <input type="radio" name="canTravel" value={opt} checked={idx === 0} class="w-4 h-4 text-brand-primary" required />
          <span>{opt}</span>
        </label>
      ))}
    </div>
  </div>

  <!-- Moyens de transport -->
  <div class="space-y-3 pt-4 border-t border-brand-primary-light/60">
    <label class="block text-sm font-bold text-brand-text">
      Moyen de transport (facultatif)
    </label>
    <div class="flex flex-wrap gap-2.5">
      {[
        "Transport en commun",
        "Voiture",
        "Vélo",
        "Autre"
      ].map((mode) => (
        <label class="flex items-center gap-2 px-3 py-2 rounded-lg border border-brand-primary-light text-xs sm:text-sm font-medium cursor-pointer hover:bg-brand-surface-subtle has-[:checked]:bg-brand-primary-light/50 has-[:checked]:border-brand-primary">
          <input type="checkbox" name="transportModes" value={mode} id={`trans-${mode}`} class="w-4 h-4 text-brand-primary rounded" />
          <span>{mode}</span>
        </label>
      ))}
    </div>
    <div id="cand-transportOtherContainer" class="hidden max-w-sm pt-1">
      <label for="cand-transportOther" class="block text-xs font-semibold text-brand-text mb-1">Précisez le moyen de transport</label>
      <input type="text" id="cand-transportOther" name="transportModeOther" class="w-full px-3 py-2 rounded-lg border border-brand-primary-light text-sm text-brand-text" />
    </div>
  </div>

</fieldset>
