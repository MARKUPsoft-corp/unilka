---
// Étape 1 : Profil & Informations personnelles du candidat
---

<fieldset class="relative bg-white rounded-3xl border border-[#0E7C86]/20 p-6 sm:p-10 shadow-[0_12px_40px_rgba(11,42,46,0.06)] space-y-8 overflow-hidden">
  
  <!-- Accent décoratif d'arrière-plan -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-gradient-to-br from-[#E3F4F5]/60 to-transparent rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <!-- En-tête éditorial de l'étape -->
  <div class="relative border-b border-[#0E7C86]/12 pb-6 space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#0A5A62]">
      <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
      <span>Étape 01 • Profil & Contact</span>
    </div>
    
    <legend class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight block">
      Vos informations personnelles
    </legend>
    
    <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed max-w-2xl">
      Présentez-vous en quelques clics. Vos coordonnées nous permettent de vous joindre pour une prise de contact rapide dès qu'une mission se libère dans votre zone.
    </p>
  </div>

  <!-- 1. IDENTITÉ DU CANDIDAT (Prénom & Nom) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
    
    <!-- Prénom (Obligatoire) -->
    <div class="space-y-2">
      <label for="cand-firstName" class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        <span>Prénom <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Obligatoire</span>
      </label>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <input
          type="text"
          id="cand-firstName"
          name="firstName"
          required
          autocomplete="given-name"
          placeholder="Ex. Marie"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="cand-firstName-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Le prénom est obligatoire.</span>
      </span>
    </div>

    <!-- Nom (Obligatoire) -->
    <div class="space-y-2">
      <label for="cand-lastName" class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        <span>Nom de famille <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Obligatoire</span>
      </label>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <input
          type="text"
          id="cand-lastName"
          name="lastName"
          required
          autocomplete="family-name"
          placeholder="Ex. Tremblay"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="cand-lastName-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Le nom de famille est obligatoire.</span>
      </span>
    </div>

  </div>

  <!-- 2. CONTACT (Téléphone & Courriel) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
    
    <!-- Téléphone (Obligatoire) -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <label for="cand-phone" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
          <span>Numéro de téléphone <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        </label>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70">Ex. 514 555 0123</span>
      </div>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <input
          type="tel"
          id="cand-phone"
          name="phone"
          required
          autocomplete="tel"
          placeholder="514 555 0123"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="cand-phone-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Veuillez saisir un numéro de téléphone valide.</span>
      </span>
    </div>

    <!-- Courriel (Obligatoire) -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <label for="cand-email" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
          <span>Adresse courriel <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        </label>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70">Pour votre dossier</span>
      </div>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <input
          type="email"
          id="cand-email"
          name="email"
          required
          autocomplete="email"
          placeholder="candidat@exemple.ca"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="cand-email-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Veuillez saisir une adresse courriel valide.</span>
      </span>
    </div>

  </div>

  <!-- 3. RÉSIDENCE & ADRESSE -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6 pt-4 border-t border-[#0E7C86]/12">
    
    <!-- Ville (Obligatoire) -->
    <div class="space-y-2">
      <label for="cand-city" class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        <span>Ville de résidence <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Obligatoire</span>
      </label>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <input
          type="text"
          id="cand-city"
          name="city"
          required
          autocomplete="address-level2"
          placeholder="Ex. Montréal, Laval, Longueuil, Terrebonne..."
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <span id="cand-city-error" class="hidden text-xs font-semibold text-brand-error mt-1.5 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>La ville de résidence est obligatoire.</span>
      </span>
    </div>

    <!-- Adresse (Facultatif) -->
    <div class="space-y-2">
      <label for="cand-address" class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E]">
        <span>Adresse ou quartier</span>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Facultatif</span>
      </label>
      
      <div class="relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#0E7C86]/70 group-focus-within:text-[#0E7C86] transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </div>
        <input
          type="text"
          id="cand-address"
          name="address"
          autocomplete="street-address"
          placeholder="Rue, quartier ou intersection"
          class="w-full pl-11 pr-4 py-3.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/40 focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs"
        />
      </div>
      <p class="text-[11px] text-[#3D5A5E]">Utile pour vous assigner des clients situés à proximité de chez vous.</p>
    </div>

  </div>

  <!-- 4. ATTESTATION DE MAJORITÉ LÉGALE (18 ans et plus) -->
  <div class="pt-4 border-t border-[#0E7C86]/12">
    <label class="flex items-start sm:items-center gap-3.5 p-4 rounded-2xl border border-[#0E7C86]/20 bg-[#F8FCFC] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs group">
      <input
        type="checkbox"
        id="cand-isAdult"
        name="isAdult"
        required
        class="w-5 h-5 text-[#0E7C86] border-[#0E7C86]/40 rounded focus:ring-[#0E7C86] shrink-0 mt-0.5 sm:mt-0"
      />
      <div class="text-xs sm:text-sm font-bold text-[#0B2A2E]">
        <span>J'atteste avoir 18 ans ou plus <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        <span class="block text-[11px] font-medium text-[#3D5A5E] mt-0.5">Condition légale requise pour les contrats d'emploi et la couverture CNESST au Québec.</span>
      </div>
    </label>
    <span id="cand-isAdult-error" class="hidden text-xs font-semibold text-brand-error mt-2 flex items-center gap-1.5" role="alert">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Vous devez confirmer que vous avez 18 ans ou plus.</span>
    </span>
  </div>

  <!-- 5. LANGUES PARLÉES & PRÉFÉRÉE -->
  <div class="space-y-4 pt-4 border-t border-[#0E7C86]/12">
    <div>
      <label class="flex items-center justify-between text-xs font-black uppercase tracking-wider text-[#0B2A2E] mb-2">
        <span>Langue(s) parlée(s) <span class="text-[#0E7C86]" aria-hidden="true">*</span></span>
        <span class="text-[11px] font-semibold text-[#3D5A5E]/70 normal-case">Au moins une langue</span>
      </label>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {["Français", "Anglais", "Autre"].map((lang) => (
          <label class="flex items-center gap-2.5 p-3.5 rounded-xl border border-[#0E7C86]/20 bg-[#F8FCFC] text-xs sm:text-sm font-semibold text-[#0B2A2E] cursor-pointer hover:bg-white hover:border-[#0E7C86]/40 has-[:checked]:bg-[#E3F4F5] has-[:checked]:border-[#0E7C86] has-[:checked]:ring-2 has-[:checked]:ring-[#0E7C86]/20 transition-all duration-150 shadow-2xs">
            <input
              type="checkbox"
              name="languages"
              value={lang}
              id={`lang-${lang}`}
              class="w-4 h-4 text-[#0E7C86] rounded"
              checked={lang === 'Français'}
            />
            <span>{lang}</span>
          </label>
        ))}
      </div>

      <!-- Précision si Autre langue -->
      <div id="cand-langOtherContainer" class="hidden max-w-md mt-3">
        <label for="cand-langOther" class="block text-xs font-bold text-[#0B2A2E] mb-1">Précisez la ou les autres langues</label>
        <input
          type="text"
          id="cand-langOther"
          name="languageOther"
          placeholder="Ex. Espagnol, Arabe, Créole, Portugais..."
          class="w-full px-3.5 py-2.5 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-xs font-semibold text-[#0B2A2E] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0E7C86]/25"
        />
      </div>

      <span id="cand-languages-error" class="hidden text-xs font-semibold text-brand-error mt-2 flex items-center gap-1.5" role="alert">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Veuillez sélectionner au moins une langue parlée.</span>
      </span>
    </div>

    <!-- Langue préférée -->
    <div class="max-w-xs pt-2">
      <label for="cand-prefLang" class="block text-xs font-black uppercase tracking-wider text-[#0B2A2E] mb-1.5">
        Langue préférée pour échanger <span class="text-[#0E7C86]" aria-hidden="true">*</span>
      </label>
      <div class="relative">
        <select
          id="cand-prefLang"
          name="preferredLanguage"
          required
          class="w-full px-4 py-3 rounded-xl bg-[#F8FCFC] border border-[#0E7C86]/20 text-xs sm:text-sm font-semibold text-[#0B2A2E] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all duration-200 shadow-2xs appearance-none cursor-pointer"
        >
          <option value="Français">Français</option>
          <option value="Anglais">Anglais</option>
          <option value="Autre">Autre</option>
        </select>
        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-[#0E7C86]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>
  </div>

</fieldset>
