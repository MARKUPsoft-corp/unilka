---
import Logo from './Logo.astro';
import config from '../../data/site-config.json';
import navData from '../../data/navigation.json';
import services from '../../data/services.json';

const currentYear = new Date().getFullYear();
const hasContactInfo = Boolean(config.business.phone || config.business.email || config.business.address);
---

<footer class="bg-brand-surface-subtle border-t border-brand-primary-light/80 mt-auto" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Pied de page</h2>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Colonne 1 : Identité & Régions -->
      <div class="space-y-4">
        <Logo size="md" />
        <p class="text-sm font-medium text-brand-primary">
          {config.business.slogan}
        </p>
        <p class="text-xs text-brand-muted leading-relaxed">
          Services professionnels de nettoyage à Montréal, Longueuil et la Rive-Sud, ainsi que dans Lanaudière.
        </p>
      </div>

      <!-- Colonne 2 : Services -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-text mb-4">
          Nos Services
        </h3>
        <ul class="space-y-2.5 text-sm" role="list">
          {services.map((service) => (
            <li>
              <a
                href={`/services/${service.slug}/`}
                class="text-brand-muted hover:text-brand-primary transition-colors no-underline block"
              >
                {service.title}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a
              href="/services/"
              class="text-xs font-semibold text-brand-primary hover:text-brand-primary-dark no-underline block"
            >
              Tous les services &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Colonne 3 : Entreprise -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-text mb-4">
          Entreprise
        </h3>
        <ul class="space-y-2.5 text-sm" role="list">
          <li>
            <a href="/a-propos/" class="text-brand-muted hover:text-brand-primary transition-colors no-underline block">
              À propos de unilka
            </a>
          </li>
          <li>
            <a href="/zones-desservies/" class="text-brand-muted hover:text-brand-primary transition-colors no-underline block">
              Zones desservies
            </a>
          </li>
          <li>
            <a href="/faq/" class="text-brand-muted hover:text-brand-primary transition-colors no-underline block">
              Questions fréquentes
            </a>
          </li>
          <li>
            <a href="/contact/" class="text-brand-muted hover:text-brand-primary transition-colors no-underline block">
              Nous joindre
            </a>
          </li>
          <li>
            <a href="/carrieres/" class="text-brand-muted hover:text-brand-primary transition-colors no-underline block font-medium">
              Emplois & Carrières
            </a>
          </li>
        </ul>
      </div>

      <!-- Colonne 4 : Légal & Contact conditionnel -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-text mb-4">
          Informations légales
        </h3>
        <ul class="space-y-2.5 text-sm" role="list">
          {navData.legalNav.map((item) => (
            <li>
              <a href={item.href} class="text-brand-muted hover:text-brand-primary transition-colors no-underline block">
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        {/* Bloc coordonnées conditionnel (affiché UNIQUEMENT si renseigné) */}
        {hasContactInfo && (
          <div class="pt-3 border-t border-brand-primary-light/60 space-y-2 text-xs text-brand-muted">
            {config.business.phone && (
              <p>
                <span class="font-medium text-brand-text">Téléphone :</span>{' '}
                <a href={`tel:${config.business.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-brand-primary">
                  {config.business.phone}
                </a>
              </p>
            )}
            {config.business.email && (
              <p>
                <span class="font-medium text-brand-text">Courriel :</span>{' '}
                <a href={`mailto:${config.business.email}`} class="hover:text-brand-primary">
                  {config.business.email}
                </a>
              </p>
            )}
            {config.business.address && (
              <p>
                <span class="font-medium text-brand-text">Adresse :</span> {config.business.address}
              </p>
            )}
          </div>
        )}
      </div>

    </div>

    <!-- Ligne de copyright et conformité -->
    <div class="mt-12 pt-6 border-t border-brand-primary-light/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-brand-muted">
      <p>
        &copy; {currentYear} {config.business.legalName || config.business.name}. Tous droits réservés.
      </p>
      <p class="text-center sm:text-right">
        Site respectueux de votre vie privée : aucun témoin (cookie), aucun outil de suivi publicitaire.
      </p>
    </div>

  </div>
</footer>
