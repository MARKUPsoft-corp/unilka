---
// Header unilka — Bulle flottante dynamique (Floating Island Navbar)
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavLinkItem {
  label: string;
  href: string;
  badge?: string;
}

const navLinks: NavLinkItem[] = [
  { label: "Nos services", href: "/#services" },
  { label: "Notre méthode", href: "/a-propos/" },
  { label: "Zones desservies", href: "/zones-desservies/" },
  { label: "Carrières", href: "/carrieres/", badge: "On recrute" },
  { label: "FAQ", href: "/faq/" }
];
---

<!-- 1. CONTENEUR FIXE DE L'ÎLE FLOTTANTE (AVEC ESPACE HAUT, GAUCHE, DROITE) -->
<div class="header-island-container" id="header-island-container">
  <header class="site-header-island" id="site-header-island">
    
    <!-- Logo Wordmark unilka -->
    <a class="island-wordmark" aria-label="unilka, accueil" href="/">
      <span class="island-brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor">
          <path d="M2 2h9v17a5 5 0 0 0 10 0V2h9v17a14 14 0 0 1-28 0V2Z" fill="#0E7C86"></path>
          <path d="M19 2h11v11H19z" fill="#FFB703"></path>
        </svg>
      </span>
      <span class="island-brand-text">unilka</span>
      <sup class="island-logo-sup">®︎</sup>
    </a>

    <!-- Navigation Centrale Bureau -->
    <nav class="island-desktop-nav" aria-label="Navigation principale">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && link.href !== '/#services' && currentPath.startsWith(link.href));
        return (
          <a href={link.href} class={`island-nav-link ${isActive ? "active-link" : ""}`}>
            <span>{link.label}</span>
            {link.badge && (
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 ml-1.5 text-[9px] font-extrabold uppercase tracking-wider bg-[#E3F4F5] text-[#0E7C86] rounded-full border border-[#0E7C86]/25 align-middle shadow-2xs">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>{link.badge}</span>
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Bouton CTA Pilule Offcut-style -->
    <a role="link" class="island-cta-btn" href="/soumission/">
      <span>Obtenir une soumission</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="island-cta-arrow" aria-hidden="true">
        <path d="M7 7h10v10"></path>
        <path d="M7 17 17 7"></path>
      </svg>
    </a>

    <!-- Bouton Menu Hamburger Mobile -->
    <button
      type="button"
      class="island-menu-toggle"
      id="mobile-menu-open-btn"
      aria-label="Ouvrir le menu de navigation"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 6h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 18h16"></path>
      </svg>
    </button>

  </header>
</div>

<!-- 2. ESPACEUR RÉSERVÉ DANS LE FLUX NATUREL POUR ÉVITER TOUT SAUT DE PAGE (CLS = 0) -->
<div class="header-island-spacer" aria-hidden="true"></div>

<!-- 3. TIROIR NAVIGATION MOBILE -->
<div id="mobile-drawer" class="mobile-drawer-overlay hidden" aria-hidden="true">
  <div class="mobile-drawer-content" role="dialog" aria-modal="true" aria-label="Menu principal">
    
    <div class="drawer-header">
      <a class="island-wordmark" href="/">
        <span class="island-brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor">
            <path d="M2 2h9v17a5 5 0 0 0 10 0V2h9v17a14 14 0 0 1-28 0V2Z" fill="#0E7C86"></path>
            <path d="M19 2h11v11H19z" fill="#FFB703"></path>
          </svg>
        </span>
        <span class="island-brand-text">unilka</span>
        <sup class="island-logo-sup">®︎</sup>
      </a>

      <button type="button" class="drawer-close" id="mobile-menu-close-btn" aria-label="Fermer le menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="mobile-drawer-nav">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && link.href !== '/#services' && currentPath.startsWith(link.href));
        return (
          <a href={link.href} class={`mobile-drawer-link ${isActive ? "text-[#0E7C86]" : ""}`}>
            <span class="inline-flex items-center gap-2">
              <span>{link.label}</span>
              {link.badge && (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider bg-[#E3F4F5] text-[#0E7C86] rounded-full border border-[#0E7C86]/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span>{link.badge}</span>
                </span>
              )}
            </span>
            <span class="drawer-arrow">↗</span>
          </a>
        );
      })}
    </nav>

    <div class="drawer-footer space-y-3">
      <a class="island-cta-btn w-full justify-center py-3.5 text-sm" href="/soumission/">
        <span>Obtenir une soumission</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="island-cta-arrow" aria-hidden="true">
          <path d="M7 7h10v10"></path>
          <path d="M7 17 17 7"></path>
        </svg>
      </a>

      <!-- Accès direct Recrutement & Carrières Mobile -->
      <a
        href="/carrieres/"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-full text-xs font-bold text-[#0E7C86] bg-[#E3F4F5] hover:bg-[#D5EEF0] border border-[#0E7C86]/25 transition-colors no-underline shadow-2xs"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Rejoindre notre équipe d'entretien ↗</span>
      </a>
    </div>

  </div>
</div>

<style>
  /* ==========================================================================
     1. CONTENEUR PRINCIPAL DE POSITIONNEMENT (ÎLE SUSPENDUE)
     ========================================================================== */
  .header-island-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 16px 16px 8px;
    pointer-events: none;
    display: flex;
    justify-content: center;
    transition: padding 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 640px) {
    .header-island-container {
      padding: 18px 24px 8px;
    }
  }

  @media (min-width: 1024px) {
    .header-island-container {
      padding: 22px 32px 8px;
    }
  }

  /* État au défilement : se rapproche subtilement du sommet */
  .header-island-container.is-scrolled {
    padding-top: 10px;
  }

  @media (min-width: 640px) {
    .header-island-container.is-scrolled {
      padding-top: 12px;
    }
  }

  /* ==========================================================================
     2. L'ÎLE FLOTTANTE (LA BULLE ARRONDIE EN VERRE DÉPOLI)
     ========================================================================== */
  .site-header-island {
    pointer-events: auto;
    width: 100%;
    max-width: 1140px;
    min-height: 60px;
    border-radius: 9999px; /* Forme de bulle / pilule continue */
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px 6px 18px;
    gap: 16px;
    
    /* État initial : incrustée dans la hero */
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(14, 124, 134, 0.16);
    box-shadow: 0 4px 20px rgba(11, 42, 46, 0.04);
    
    transition:
      background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      min-height 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 640px) {
    .site-header-island {
      padding: 8px 12px 8px 24px;
      min-height: 66px;
    }
  }

  /* État au défilement : détachement aérien et élévation marquée */
  .site-header-island.is-scrolled {
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-color: rgba(14, 124, 134, 0.24);
    box-shadow:
      0 14px 38px rgba(11, 42, 46, 0.09),
      0 2px 6px rgba(11, 42, 46, 0.03);
    min-height: 56px;
    padding-top: 5px;
    padding-bottom: 5px;
  }

  @media (min-width: 640px) {
    .site-header-island.is-scrolled {
      min-height: 60px;
      padding-top: 6px;
      padding-bottom: 6px;
    }
  }

  /* ==========================================================================
     3. ESPACEUR DANS LE FLUX DE LA PAGE (ZERO CLS)
     ========================================================================== */
  .header-island-spacer {
    height: 84px;
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }

  @media (min-width: 640px) {
    .header-island-spacer {
      height: 94px;
    }
  }

  @media (min-width: 1024px) {
    .header-island-spacer {
      height: 102px;
    }
  }

  /* ==========================================================================
     4. LOGOTYPE WORDMARK
     ========================================================================== */
  .island-wordmark {
    letter-spacing: -0.045em;
    align-items: center;
    gap: 8px;
    font-size: 26px;
    font-weight: 800;
    display: inline-flex;
    color: #0B2A2E;
    text-decoration: none;
    font-family: var(--font-body, 'Manrope', sans-serif);
    line-height: 1;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .island-wordmark:hover {
    opacity: 0.9;
  }

  .island-brand-mark {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .island-logo-sup {
    letter-spacing: 0;
    align-self: flex-start;
    margin-top: 4px;
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    color: #3D5A5E;
  }

  /* ==========================================================================
     5. NAVIGATION CENTRALE BUREAU
     ========================================================================== */
  .island-desktop-nav {
    gap: 18px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    font-family: var(--font-body, 'Manrope', sans-serif);
  }

  @media (min-width: 1024px) {
    .island-desktop-nav {
      gap: 22px;
      font-size: 14.5px;
    }
  }

  @media (min-width: 1200px) {
    .island-desktop-nav {
      gap: 26px;
      font-size: 15px;
    }
  }

  .island-nav-link {
    padding: 6px 2px;
    position: relative;
    color: #0B2A2E;
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .island-nav-link::after {
    content: "";
    transform-origin: center;
    background: #0E7C86;
    width: 100%;
    height: 2px;
    border-radius: 9999px;
    transition: transform 0.25s cubic-bezier(0.2, 0.75, 0.2, 1);
    position: absolute;
    bottom: -1px;
    left: 0;
    transform: scaleX(0);
  }

  .island-nav-link:hover::after,
  .island-nav-link.active-link::after {
    transform: scaleX(1);
  }

  .island-nav-link:hover {
    color: #0E7C86;
  }

  .island-nav-link.active-link {
    color: #0E7C86;
    font-weight: 700;
  }

  /* ==========================================================================
     6. BOUTON CTA PILULE INTÉGRÉ
     ========================================================================== */
  .island-cta-btn {
    background: #0B2A2E;
    color: #FFFFFF;
    border-radius: 9999px;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    transition:
      background-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
    font-family: var(--font-body, 'Manrope', sans-serif);
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(11, 42, 46, 0.12);
  }

  .island-cta-arrow {
    transition: transform 0.25s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .island-cta-btn:hover {
    background: #0E7C86;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(14, 124, 134, 0.28);
  }

  .island-cta-btn:hover .island-cta-arrow {
    transform: translate(2px, -2px);
  }

  .island-cta-btn:active {
    transform: scale(0.97);
  }

  /* ==========================================================================
     7. MENU BURGER MOBILE
     ========================================================================== */
  .island-menu-toggle {
    color: #0B2A2E;
    background: #F5FAFA;
    border: 1px solid rgba(14, 124, 134, 0.18);
    width: 42px;
    height: 42px;
    border-radius: 9999px;
    padding: 0;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.16s ease;
  }

  .island-menu-toggle:hover {
    background: #E3F4F5;
    color: #0E7C86;
    border-color: rgba(14, 124, 134, 0.35);
  }

  .island-menu-toggle:active {
    transform: scale(0.95);
  }

  /* ==========================================================================
     8. MEDIA QUERIES RESPONSIVE
     ========================================================================== */
  @media (max-width: 940px) {
    .island-desktop-nav {
      display: none;
    }
    .island-cta-btn {
      display: none;
    }
    .island-menu-toggle {
      display: flex;
    }
    .island-wordmark {
      font-size: 22px;
    }
    .site-header-island {
      padding: 6px 8px 6px 16px;
      min-height: 54px;
    }
  }

  /* ==========================================================================
     9. TIROIR MOBILE LATÉRAL
     ========================================================================== */
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(11, 42, 46, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 60;
    display: flex;
    justify-content: flex-end;
  }

  .mobile-drawer-overlay.hidden {
    display: none;
  }

  .mobile-drawer-content {
    background: #FFFFFF;
    width: min(88vw, 380px);
    height: 100%;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: -8px 0 32px rgba(11, 42, 46, 0.16);
    border-left: 1px solid rgba(14, 124, 134, 0.12);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(11, 42, 46, 0.12);
    padding-bottom: 18px;
  }

  .drawer-close {
    background: #F5FAFA;
    border: 1px solid rgba(14, 124, 134, 0.15);
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    color: #0B2A2E;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .drawer-close:hover {
    background: #E3F4F5;
    color: #0E7C86;
  }

  .mobile-drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 24px 0;
  }

  .mobile-drawer-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid rgba(11, 42, 46, 0.08);
    font-size: 18px;
    font-weight: 700;
    color: #0B2A2E;
    text-decoration: none;
    font-family: var(--font-body, 'Manrope', sans-serif);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .mobile-drawer-link:hover {
    color: #0E7C86;
    transform: translateX(4px);
  }

  .drawer-arrow {
    font-size: 16px;
    color: #0E7C86;
  }

  .drawer-footer {
    padding-top: 20px;
  }

  .drawer-footer .island-cta-btn {
    display: inline-flex;
    width: 100%;
  }
</style>

<script>
  // 1. Contrôleur de défilement (Scroll State Controller)
  const islandContainer = document.getElementById('header-island-container');
  const siteIsland = document.getElementById('site-header-island');

  if (islandContainer && siteIsland) {
    let isScrolled = false;

    const handleScroll = () => {
      const scrolled = window.scrollY > 20;
      if (scrolled !== isScrolled) {
        isScrolled = scrolled;
        if (isScrolled) {
          islandContainer.classList.add('is-scrolled');
          siteIsland.classList.add('is-scrolled');
        } else {
          islandContainer.classList.remove('is-scrolled');
          siteIsland.classList.remove('is-scrolled');
        }
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // 2. Contrôleur du tiroir mobile accessible
  const openBtn = document.getElementById('mobile-menu-open-btn');
  const closeBtn = document.getElementById('mobile-menu-close-btn');
  const drawer = document.getElementById('mobile-drawer');

  if (openBtn && closeBtn && drawer) {
    const openDrawer = () => {
      drawer.classList.remove('hidden');
      drawer.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const closeDrawer = () => {
      drawer.classList.add('hidden');
      drawer.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) closeDrawer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
        closeDrawer();
        openBtn.focus();
      }
    });
  }
</script>
