---
import Logo from './Logo.astro';
import navData from '../../data/navigation.json';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-sm border-b border-brand-primary-light shadow-sm transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    
    <!-- Logo -->
    <div class="shrink-0">
      <Logo size="md" />
    </div>

    <!-- Navigation Bureau -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Navigation principale">
      {navData.mainNav.map((item) => {
        const isServices = item.children && item.children.length > 0;
        const isActive = currentPath === item.href || (isServices && currentPath.startsWith('/services/'));

        if (isServices) {
          return (
            <div class="relative group">
              <button
                type="button"
                class={`px-3 py-2 text-[15px] font-medium rounded-md transition-colors flex items-center gap-1 focus-visible:outline-2 focus-visible:outline-brand-primary-dark ${
                  isActive ? 'text-brand-primary font-semibold' : 'text-brand-muted hover:text-brand-text'
                }`}
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>{item.label}</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </button>

              <!-- Sous-menu Services -->
              <div class="absolute left-0 top-full pt-1.5 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
                <div class="w-64 bg-white rounded-lg shadow-xl border border-brand-primary-light p-2 flex flex-col gap-1">
                  <a
                    href={item.href}
                    class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-brand-primary hover:bg-brand-primary-light/50 rounded-md transition-colors no-underline block"
                  >
                    Vue d'ensemble des services
                  </a>
                  <div class="h-px bg-brand-primary-light/60 my-1"></div>
                  {item.children.map((subItem) => (
                    <a
                      href={subItem.href}
                      class={`px-3 py-2 text-sm rounded-md transition-colors no-underline block ${
                        currentPath === subItem.href ? 'bg-brand-primary-light text-brand-primary font-semibold' : 'text-brand-muted hover:text-brand-text hover:bg-brand-surface-subtle'
                      }`}
                    >
                      {subItem.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        }

        return (
          <a
            href={item.href}
            class={`px-3 py-2 text-[15px] font-medium rounded-md transition-colors no-underline focus-visible:outline-2 focus-visible:outline-brand-primary-dark ${
              isActive ? 'text-brand-primary font-semibold' : 'text-brand-muted hover:text-brand-text'
            }`}
          >
            {item.label}
          </a>
        );
      })}

      <!-- Lien Emplois secondaire -->
      <a
        href={navData.secondaryNav.href}
        class={`px-3 py-2 text-[15px] font-medium rounded-md transition-colors no-underline focus-visible:outline-2 focus-visible:outline-brand-primary-dark ml-1 ${
          currentPath.startsWith('/carrieres/') ? 'text-brand-primary font-semibold' : 'text-brand-muted hover:text-brand-text'
        }`}
      >
        {navData.secondaryNav.label}
      </a>
    </nav>

    <!-- Bouton CTA principal Bureau + Bouton Hamburger Mobile -->
    <div class="flex items-center gap-3">
      <a
        href={navData.primaryCta.href}
        class="hidden sm:inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-brand-primary hover:bg-brand-primary-dark rounded-md shadow-sm transition-all duration-150 no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary-dark active:scale-[0.98]"
      >
        {navData.primaryCta.label}
      </a>

      <!-- Bouton Menu Mobile (Accessibilité ARIA) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 rounded-md text-brand-text hover:bg-brand-primary-light focus-visible:outline-2 focus-visible:outline-brand-primary-dark"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Ouvrir le menu de navigation"
      >
        <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu Mobile (Déplié) -->
  <div
    id="mobile-nav"
    class="hidden lg:hidden border-t border-brand-primary-light bg-white px-4 pt-3 pb-6 max-h-[85vh] overflow-y-auto"
    aria-label="Navigation mobile"
  >
    <div class="flex flex-col gap-1 pb-4">
      {navData.mainNav.map((item) => {
        if (item.children && item.children.length > 0) {
          return (
            <div class="py-1">
              <span class="block px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-brand-primary">
                {item.label}
              </span>
              <div class="pl-3 flex flex-col gap-0.5 border-l-2 border-brand-primary-light ml-3 my-1">
                <a
                  href={item.href}
                  class={`px-3 py-2 text-sm rounded-md no-underline block ${
                    currentPath === item.href ? 'text-brand-primary font-bold bg-brand-primary-light' : 'text-brand-muted hover:text-brand-text'
                  }`}
                >
                  Vue d'ensemble
                </a>
                {item.children.map((sub) => (
                  <a
                    href={sub.href}
                    class={`px-3 py-2 text-sm rounded-md no-underline block ${
                      currentPath === sub.href ? 'text-brand-primary font-bold bg-brand-primary-light' : 'text-brand-muted hover:text-brand-text'
                    }`}
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        return (
          <a
            href={item.href}
            class={`px-3 py-2.5 text-base font-medium rounded-md no-underline block ${
              currentPath === item.href ? 'text-brand-primary font-bold bg-brand-primary-light' : 'text-brand-text hover:bg-brand-surface-subtle'
            }`}
          >
            {item.label}
          </a>
        );
      })}

      <a
        href={navData.secondaryNav.href}
        class={`px-3 py-2.5 text-base font-medium rounded-md no-underline block ${
          currentPath.startsWith('/carrieres/') ? 'text-brand-primary font-bold bg-brand-primary-light' : 'text-brand-text hover:bg-brand-surface-subtle'
        }`}
      >
        {navData.secondaryNav.label}
      </a>
    </div>

    <!-- CTA Soumission dans le menu mobile (toujours accessible) -->
    <div class="pt-3 border-t border-brand-primary-light/60">
      <a
        href={navData.primaryCta.href}
        class="w-full inline-flex items-center justify-center px-5 py-3 text-base font-semibold text-white bg-brand-primary hover:bg-brand-primary-dark rounded-md shadow-sm transition-all no-underline text-center"
      >
        {navData.primaryCta.label}
      </a>
    </div>
  </div>
</header>

<script>
  // Gestion du menu mobile accessible (clavier, Escape, ARIA)
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    const toggleMenu = (open?: boolean) => {
      const isExpanded = open ?? toggleBtn.getAttribute('aria-expanded') !== 'true';
      toggleBtn.setAttribute('aria-expanded', String(isExpanded));
      toggleBtn.setAttribute('aria-label', isExpanded ? 'Fermer le menu de navigation' : 'Ouvrir le menu de navigation');
      
      if (isExpanded) {
        mobileNav.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        mobileNav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.remove('hidden');
      }
    };

    toggleBtn.addEventListener('click', () => toggleMenu());

    // Fermeture avec la touche Échap
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
        toggleBtn.focus();
      }
    });
  }
</script>
