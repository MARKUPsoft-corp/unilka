---
interface Props {
  stepNumber: number;
  title: string;
  description: string;
}

const { stepNumber, title, description } = Astro.props;
---

<div class="relative flex flex-col bg-white border border-brand-primary-light/80 rounded-xl p-6 shadow-sm hover:border-brand-primary/40 transition-colors">
  <div class="flex items-center justify-between mb-4">
    <span class="w-10 h-10 rounded-full bg-brand-primary-light text-brand-primary font-black text-lg flex items-center justify-center shrink-0" aria-label={`Étape ${stepNumber}`}>
      {stepNumber}
    </span>
    <span class="text-xs uppercase tracking-wider font-semibold text-brand-muted/70">
      Étape {stepNumber}
    </span>
  </div>

  <h3 class="text-base font-bold text-brand-text mb-2">
    {title}
  </h3>
  <p class="text-sm text-brand-muted leading-relaxed">
    {description}
  </p>
</div>
