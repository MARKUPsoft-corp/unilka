---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/site-config.json';

const pageTitle = "Mentions Légales & Conditions — unilka";
const pageDescription = "Mentions légales, informations d'entreprise et conditions d'utilisation du site unilka à Montréal.";

const breadcrumbs = [
  { label: "Mentions légales", href: "/mentions-legales/" }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <section class="py-16 lg:py-24 bg-[#FFFFFF]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="space-y-4 pb-8 border-b border-[#0E7C86]/15">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
          <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#0E7C86]">
            Cadre Réglementaire Québécois
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2A2E] tracking-tight">
          Mentions légales.
        </h1>

        <p class="text-sm sm:text-base text-[#3D5A5E]">
          Conditions d'utilisation et informations relatives à l'exploitation de la marque unilka.
        </p>
      </div>

      <div class="space-y-10 text-[#3D5A5E] leading-relaxed text-sm sm:text-base">
        
        <!-- Éditeur -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">1. Éditeur de la plateforme</h2>
          <p>
            Le présent site web est édité et exploité par l'entreprise <strong>{config.business.legalName || config.business.name}</strong>, exerçant sous le nom commercial <strong>unilka</strong> au Québec, Canada.
          </p>
          {config.business.neq && (
            <p>
              Numéro d'Entreprise du Québec (NEQ) : <strong class="text-[#0B2A2E]">{config.business.neq}</strong>.
            </p>
          )}
          {config.business.email && (
            <p>
              Courriel de contact légal : <a href={`mailto:${config.business.email}`} class="text-[#0E7C86] font-semibold underline">{config.business.email}</a>.
            </p>
          )}
        </section>

        <!-- Hébergement -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">2. Infrastructure & Hébergement</h2>
          <p>
            Le site est hébergé sur le réseau haute disponibilité de <strong>Vercel Inc.</strong>, situé au 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis (<a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="text-[#0E7C86] font-semibold underline">vercel.com</a>).
          </p>
        </section>

        <!-- Propriété intellectuelle -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">3. Propriété intellectuelle</h2>
          <p>
            L'ensemble des éléments constituant le site (arborescence, photographies éditoriales, identité graphique, textes, typographies et logotype unilka®) sont protégés par le droit de la propriété intellectuelle et demeurent la propriété exclusive de unilka inc. Toute reproduction totale ou partielle sans accord préalable écrit est formellement prohibée.
          </p>
        </section>

        <!-- Absence de traceurs publicitaires -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">4. Vie privée & Absence de témoins traceurs</h2>
          <p>
            Ce site est conçu dans le plus strict respect de votre vie privée : aucun témoin (cookie) de pistage publicitaire ou tiers n'est déposé sur votre appareil. Consultez notre <a href="/confidentialite/" class="text-[#0E7C86] font-semibold underline">Politique de confidentialité</a> pour en savoir plus sur l'application de la Loi 25.
          </p>
        </section>

      </div>

    </div>
  </section>

</BaseLayout>
