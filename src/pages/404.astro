---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Page introuvable — unilka";
const pageDescription = "La page demandée est introuvable.";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex={true}>

  <section class="py-20 sm:py-28 bg-brand-surface-subtle min-h-[70vh] flex items-center">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <span class="text-6xl sm:text-7xl font-black text-brand-primary/30 tracking-widest block" aria-hidden="true">
        404
      </span>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-text tracking-tight">
        Page introuvable
      </h1>

      <p class="text-base text-brand-muted leading-relaxed max-w-md mx-auto">
        La page que vous cherchez n'existe pas ou a été déplacée.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-brand-primary hover:bg-brand-primary-dark rounded-md transition-colors no-underline"
        >
          Retour à l'accueil
        </a>
        <a
          href="/soumission/"
          class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-brand-text bg-white hover:bg-brand-primary-light border border-brand-primary-light rounded-md transition-colors no-underline"
        >
          Obtenir une soumission
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
