---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import config from '../data/site-config.json';

const pageTitle = "Zones Desservies : Montréal, Rive-Sud, Lanaudière — unilka";
const pageDescription = "Services d'entretien ménager à Montréal, Longueuil, Rive-Sud et Lanaudière. Vérifiez la disponibilité et demandez votre soumission sous 24h.";

const breadcrumbs = [
  { label: "Zones desservies", href: "/zones-desservies/" }
];

const hasCities = config.zones.cities && config.zones.cities.length > 0;
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <!-- 1. HÉRO ÉDITORIAL ZONES DESSERVIES (STYLE OFFCUT) -->
  <section class="relative bg-white border-b border-[#0E7C86]/12 overflow-hidden pt-10 pb-12 lg:pt-16 lg:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Colonne Gauche : Typographie puissante & Aérée -->
        <div class="lg:col-span-7">
          <p class="flex items-center gap-2.5 text-xs font-black uppercase tracking-[0.14em] text-[#0A5A62] m-0">
            <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
            <span>PÉRIMÈTRE LOGISTIQUE • GRAND MONTRÉAL & ENVIRONS</span>
          </p>

          <h1 class="text-[clamp(42px,11.5vw,56px)] sm:text-6xl lg:text-7xl xl:text-[76px] font-bold text-[#0B2A2E] tracking-[-0.035em] leading-[1.06] mt-7 mb-0">
            <span class="block font-bold text-[#0B2A2E] whitespace-nowrap">Votre quartier.</span>
            <span class="block font-serif italic font-normal text-[#0E7C86] mt-1 whitespace-nowrap">Notre rayon.</span>
          </h1>

          <p class="text-base sm:text-lg text-[#3D5A5E] leading-[1.75] max-w-xl mt-6">
            Nos équipes salariées sillonnent chaque jour la métropole montréalaise, la Rive-Sud et Lanaudière. Ponctualité exemplaire et déplacements sans frais kilométriques dissimulés.
          </p>

          <!-- CTAs épurés -->
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a
              href="/soumission/"
              class="inline-flex items-center justify-center gap-3 px-8 py-4 text-sm font-bold text-white bg-[#0B2A2E] hover:bg-[#0E7C86] rounded-full transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-[0.98] no-underline"
            >
              <span>Obtenir une soumission</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
            </a>
            <a href="#verificateur-postal" class="text-xs font-extrabold uppercase tracking-wider text-[#0A5A62] hover:text-[#0E7C86] underline underline-offset-4 transition-colors">
              Tester mon code postal ↓
            </a>
          </div>
        </div>

        <!-- Colonne Droite : Composition Photo Asymétrique & Badges Offcut -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-[140px_16px_16px_16px] overflow-hidden border border-[#0E7C86]/15 shadow-[0_12px_36px_rgba(11,42,46,0.08)] group bg-[#E8E2D2] h-[460px] sm:h-[520px]">
            <img
              src="/images/hero-unilka.jpg"
              alt="Vue architecturale et intérieur moderne desservi par unilka dans le Grand Montréal"
              width="800"
              height="600"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="eager"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/55 via-transparent to-black/20 pointer-events-none"></div>


            <!-- Légende haut-droite style Offcut -->
            <div class="absolute top-6 right-6 text-right text-white text-[10px] font-bold tracking-[0.1em] uppercase drop-shadow-md">
              <span>DÉPLACEMENT INCLUS<br />MONTRÉAL, RIVE-SUD & NORD</span>
            </div>

            <!-- Badge circulaire rotatif bas-droite -->
            <a class="absolute bottom-6 right-6 w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-white/95 backdrop-blur-md border border-[#0E7C86]/20 shadow-lg flex flex-col items-center justify-center p-3 text-center transition-transform hover:scale-105 hover:rotate-0 no-underline rotate-6" href="#verificateur-postal">
              <span class="text-[10px] font-black uppercase tracking-wider text-[#0B2A2E] leading-tight">3 RÉGIONS.<br />0 FRAIS CACHÉS.</span>
              <svg class="w-4 h-4 text-[#0E7C86] mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14m7-7-7 7-7-7"/></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Hero Foot : 3 micro-lignes Offcut -->
      <div class="mt-12 pt-7 border-t border-[#0E7C86]/12 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[11px] font-bold uppercase tracking-[0.08em] text-[#3D5A5E]">
        <span>MONTRÉAL MÉTROPOLE • TOUS ARRONDISSEMENTS</span>
        <span>RIVE-SUD & COURONNE NORD • TOURNÉES 7J/7</span>
        <a href="#verificateur-postal" class="text-[#0E7C86] hover:text-[#0A5A62] transition-colors">VÉRIFIER MON CODE POSTAL ↓</a>
      </div>
    </div>
  </section>

  <!-- 1.5 MODULE INTERACTIF DE VÉRIFICATION POSTALE -->
  <section id="verificateur-postal" class="py-10 bg-white border-b border-[#0E7C86]/12 scroll-mt-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 sm:p-8 rounded-3xl bg-[#F5FAFA] border border-[#0E7C86]/20 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <label for="postal-check-input" class="text-xs font-black uppercase tracking-wider text-[#0B2A2E] flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#0E7C86]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Vérificateur instantané de disponibilité par code postal
          </label>
          <span class="text-[10px] font-bold text-[#0E7C86] bg-[#E3F4F5] px-2.5 py-0.5 rounded-full">Temps réel</span>
        </div>

        <div class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-1">
            <input
              type="text"
              id="postal-check-input"
              placeholder="Ex: H2V (Outremont), J4B (Boucherville), J6W (Terrebonne)..."
              maxlength="7"
              class="w-full px-4 py-3 rounded-xl border border-[#0E7C86]/25 bg-white text-sm font-semibold text-[#0B2A2E] placeholder:text-[#3D5A5E]/60 focus:outline-none focus:ring-4 focus:ring-[#0E7C86]/12 focus:border-[#0E7C86] transition-all uppercase shadow-2xs"
            />
          </div>
          <button
            type="button"
            id="postal-check-btn"
            class="px-6 py-3 rounded-xl bg-[#0E7C86] hover:bg-[#0A5A62] text-white text-xs font-extrabold uppercase tracking-wider transition-colors shrink-0 shadow-xs cursor-pointer active:scale-[0.98]"
          >
            Vérifier mon code
          </button>
        </div>

        <div id="postal-check-result" class="text-xs font-bold text-[#0A5A62] flex items-center gap-1.5 transition-all">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
          <span>Montréal, Rive-Sud & Lanaudière : déplacements inclus et assurés du lundi au dimanche.</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Vérificateur de code postal interactif et fluide
    const postalInput = document.getElementById('postal-check-input') as HTMLInputElement | null;
    const postalBtn = document.getElementById('postal-check-btn');
    const postalResult = document.getElementById('postal-check-result');

    if (postalInput && postalBtn && postalResult) {
      const checkZone = () => {
        const val = postalInput.value.trim().toUpperCase().replace(/\s/g, '');
        if (!val) {
          postalResult.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span><span>Entrez au moins les 3 premiers caractères (ex: H2V, J4B, J6W).</span>';
          postalResult.className = 'text-xs font-bold text-[#0A5A62] flex items-center gap-1.5 transition-all';
          return;
        }

        const prefix = val.substring(0, 1);
        if (prefix === 'H') {
          postalResult.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="text-emerald-800">Zone 01 confirmée (Montréal) : Équipes disponibles pour interventions régulières et ponctuelles.</span>';
          postalResult.className = 'text-xs font-bold flex items-center gap-1.5 transition-all bg-emerald-50 p-2 rounded-lg border border-emerald-200';
        } else if (prefix === 'J') {
          postalResult.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="text-emerald-800">Zone 02 ou 03 confirmée (Rive-Sud / Lanaudière) : Équipes déployées quotidiennement.</span>';
          postalResult.className = 'text-xs font-bold flex items-center gap-1.5 transition-all bg-emerald-50 p-2 rounded-lg border border-emerald-200';
        } else {
          postalResult.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-500"></span><span class="text-amber-800">Secteur limitrophe : Contactez notre concierge au (514) 800-0000 pour vérifier le créneau.</span>';
          postalResult.className = 'text-xs font-bold flex items-center gap-1.5 transition-all bg-amber-50 p-2 rounded-lg border border-amber-200';
        }
      };

      postalBtn.addEventListener('click', checkZone);
      postalInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkZone();
      });
    }
  </script>

  <!-- 2. LES 3 RÉGIONS MAJEURES -->
  <section class="py-20 lg:py-24 bg-[#F5FAFA] border-b border-[#0E7C86]/12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Montréal -->
        <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-8 shadow-xs flex flex-col justify-between space-y-6 hover:border-[#0E7C86]/30 hover:-translate-y-1 transition-all duration-200">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0E7C86] bg-[#E3F4F5] px-3 py-1 rounded-full">
                Zone 01
              </span>
              <span class="text-xs font-bold text-[#0E7C86]">Interventions quotidiennes</span>
            </div>

            <h2 class="text-2xl font-extrabold text-[#0B2A2E]">
              Montréal & Arrondissements
            </h2>

            <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
              Résidences privées, copropriétés de prestige et locaux d'affaires dans tous les quartiers centraux et périphériques.
            </p>

            <div class="pt-2 flex flex-wrap gap-1.5">
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Ville-Marie</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Outremont</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Westmount</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Plateau</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Griffintown</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Rosemont</span>
            </div>
          </div>

          <div class="pt-4 border-t border-[#0E7C86]/10 text-xs font-bold text-[#0E7C86] flex items-center justify-between">
            <span>Résidentiel & Commercial</span>
            <span>Déplacement direct →</span>
          </div>
        </div>

        <!-- Rive-Sud -->
        <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-8 shadow-xs flex flex-col justify-between space-y-6 hover:border-[#0E7C86]/30 hover:-translate-y-1 transition-all duration-200">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0E7C86] bg-[#E3F4F5] px-3 py-1 rounded-full">
                Zone 02
              </span>
              <span class="text-xs font-bold text-[#0E7C86]">Rive-Sud</span>
            </div>

            <h2 class="text-2xl font-extrabold text-[#0B2A2E]">
              Longueuil & Rive-Sud
            </h2>

            <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
              Maintien régulier de maisons familiales, condos modernes et cabinets professionnels de la couronne sud.
            </p>

            <div class="pt-2 flex flex-wrap gap-1.5">
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Vieux-Longueuil</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Saint-Lambert</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Brossard</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Boucherville</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Saint-Bruno</span>
            </div>
          </div>

          <div class="pt-4 border-t border-[#0E7C86]/10 text-xs font-bold text-[#0E7C86] flex items-center justify-between">
            <span>Formules récurrentes</span>
            <span>Déplacement direct →</span>
          </div>
        </div>

        <!-- Lanaudière -->
        <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-8 shadow-xs flex flex-col justify-between space-y-6 hover:border-[#0E7C86]/30 hover:-translate-y-1 transition-all duration-200">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0E7C86] bg-[#E3F4F5] px-3 py-1 rounded-full">
                Zone 03
              </span>
              <span class="text-xs font-bold text-[#0E7C86]">Couronne Nord</span>
            </div>

            <h2 class="text-2xl font-extrabold text-[#0B2A2E]">
              Lanaudière & Nord
            </h2>

            <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
              Grand ménage approfondi, remise en état et entretien périodique pour propriétés résidentielles et domaines.
            </p>

            <div class="pt-2 flex flex-wrap gap-1.5">
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Repentigny</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Terrebonne</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Mascouche</span>
              <span class="text-[11px] font-semibold text-[#0B2A2E] bg-[#F5FAFA] px-2.5 py-1 rounded-md border border-[#0E7C86]/10">Charlemagne</span>
            </div>
          </div>

          <div class="pt-4 border-t border-[#0E7C86]/10 text-xs font-bold text-[#0E7C86] flex items-center justify-between">
            <span>Selon accès & superficie</span>
            <span>Sur évaluation →</span>
          </div>
        </div>

      </div>

      <!-- Villes desservies complètes si fournies dans la config -->
      {hasCities && (
        <div class="bg-white rounded-2xl border border-[#0E7C86]/15 p-8 space-y-4">
          <h3 class="text-base font-extrabold text-[#0B2A2E]">
            Municipalités et secteurs couverts en continu :
          </h3>
          <div class="flex flex-wrap gap-2">
            {config.zones.cities.map((city: string) => (
              <span class="px-3 py-1.5 rounded-lg bg-[#F5FAFA] border border-[#0E7C86]/12 text-xs font-medium text-[#0B2A2E]">
                {city}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- BANDEAU SOUMISSION SECTORIELLE -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0B2A2E] to-[#0A5A62] p-8 sm:p-10 text-white shadow-xl">
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="space-y-2 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md text-[11px] font-bold text-white uppercase tracking-wider">
              <span>Disponibilité Confirmée sous 24h</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-white">
              Vous souhaitez valider la disponibilité à votre adresse exacte ?
            </h3>
            <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
              Renseignez votre code postal dans le formulaire de soumission. Nos concierges vérifient l'itinéraire de nos équipes et vous confirment un créneau prioritaire sans frais kilométriques cachés.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
            <a
              href="/soumission/"
              class="px-7 py-3.5 text-xs font-bold text-[#0B2A2E] bg-white hover:bg-[#E3F4F5] rounded-full transition-all duration-200 text-center shadow-md hover:scale-[1.02] active:scale-[0.98] no-underline"
            >
              Vérifier mon adresse & obtenir un devis ↗
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. BANDEAU DE CONVERSION -->
  <CtaBanner
    title="Votre secteur est desservi ?"
    description="Quelques minutes suffisent pour nous faire part de vos besoins. Vous recevrez une proposition personnalisée sous 24h."
    ctaText="Demander une soumission"
    ctaLink="/soumission/"
  />

</BaseLayout>
