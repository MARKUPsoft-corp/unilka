---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/site-config.json';

const pageTitle = "Politique de Confidentialité (Loi 25) — unilka";
const pageDescription = "Comment unilka recueille, utilise et protège vos renseignements personnels conformément à la Loi 25 du Québec.";

const breadcrumbs = [
  { label: "Politique de confidentialité", href: "/confidentialite/" }
];

const lastUpdated = "27 octobre 2026";
const dpoContact = config.privacy.dpoName
  ? `${config.privacy.dpoName} (${config.privacy.dpoEmail || 'courriel sur demande'})`
  : "la personne responsable de la protection des renseignements personnels de unilka (joignable via notre page Contact)";
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <section class="py-16 lg:py-24 bg-[#FFFFFF]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="space-y-4 pb-8 border-b border-[#0E7C86]/15">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
          <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#0E7C86]">
            Conformité Loi 25 • Québec
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2A2E] tracking-tight">
          Politique de confidentialité.
        </h1>

        <p class="text-xs font-semibold text-[#0E7C86]">
          Dernière révision : {lastUpdated}
        </p>
      </div>

      <div class="space-y-10 text-[#3D5A5E] leading-relaxed text-sm sm:text-base">
        
        <!-- 1. Responsable -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">1. Responsable de la protection des données</h2>
          <p>
            L'entreprise <strong>unilka</strong> accorde la plus haute importance à la protection et à la confidentialité de vos données personnelles. La personne désignée responsable au sens de la Loi 25 est {dpoContact}.
          </p>
        </section>

        <!-- 2. Données collectées -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">2. Renseignements strictement nécessaires recueillis</h2>
          <ul class="space-y-2 list-disc pl-5" role="list">
            <li><strong>Demande de soumission :</strong> prénom, nom, téléphone, courriel, municipalité, code postal, caractéristiques de l'espace et photos éventuelles des surfaces.</li>
            <li><strong>Dossier de candidature :</strong> prénom, nom, coordonnées, langues parlées, autorisation de travailler au Canada, disponibilités hebdomadaires et expérience professionnelle. Aucun numéro d'assurance sociale (NAS) ni document d'identité n'est exigé via le formulaire public.</li>
            <li><strong>Données de navigation :</strong> aucun témoin tiers ou traceur publicitaire n'est utilisé sur ce site. Seuls les journaux de sécurité réseau techniques minimaux sont traités par notre hébergeur Vercel.</li>
          </ul>
        </section>

        <!-- 3. Finalités -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">3. Finalités du traitement</h2>
          <p>
            Vos renseignements sont exploités exclusivement dans le cadre de l'évaluation de vos soumissions d'entretien, de la planification opérationnelle des missions de nettoyage, ou de la prise de contact pour une opportunité d'emploi. Aucune donnée n'est vendue, cédée ou louée à des tiers.
          </p>
        </section>

        <!-- 4. Vos droits -->
        <section class="space-y-3 p-6 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12">
          <h2 class="text-lg font-extrabold text-[#0B2A2E]">4. Vos droits d'accès et de rectification</h2>
          <p>
            Conformément à la législation québécoise, vous disposez d'un droit d'accès, de mise à jour et de retrait de vos renseignements personnels à tout moment en écrivant à notre équipe à l'adresse officielle de l'entreprise.
          </p>
        </section>

      </div>

    </div>
  </section>

</BaseLayout>
