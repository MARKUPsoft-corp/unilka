---
import BaseLayout from '../layouts/BaseLayout.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import faqData from '../data/faq.json';

const pageTitle = "Foire Aux Questions (FAQ) — unilka";
const pageDescription = "Réponses claires sur nos interventions de nettoyage à Montréal, les tarifs forfaitaires, les produits écologiques et les carrières chez unilka.";

const breadcrumbs = [
  { label: "Questions fréquentes", href: "/faq/" }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <!-- 1. HÉRO ÉDITORIAL FAQ (STYLE OFFCUT) -->
  <section class="relative bg-white border-b border-[#0E7C86]/12 overflow-hidden pt-10 pb-12 lg:pt-16 lg:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Colonne Gauche : Typographie puissante & Aérée -->
        <div class="lg:col-span-7">
          <p class="flex items-center gap-2.5 text-xs font-black uppercase tracking-[0.14em] text-[#0A5A62] m-0">
            <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
            <span>TRANSPARENCE TOTALE • CONCIERGERIE À VOTRE ÉCOUTE</span>
          </p>

          <h1 class="text-[clamp(42px,11.5vw,56px)] sm:text-6xl lg:text-7xl xl:text-[76px] font-bold text-[#0B2A2E] tracking-[-0.035em] leading-[1.06] mt-7 mb-0">
            <span class="block font-bold text-[#0B2A2E] whitespace-nowrap">Vos questions.</span>
            <span class="block font-serif italic font-normal text-[#0E7C86] mt-1 whitespace-nowrap">Réponses nettes.</span>
          </h1>

          <p class="text-base sm:text-lg text-[#3D5A5E] leading-[1.75] max-w-xl mt-6">
            Forfaits sans contrat, assurance responsabilité civile 2M$, sélection du personnel et protection Loi 25. Tout ce que vous devez savoir pour confier votre intérieur en toute sérénité.
          </p>

          <!-- CTAs épurés -->
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a
              href="/contact/"
              class="inline-flex items-center justify-center gap-3 px-8 py-4 text-sm font-bold text-white bg-[#0B2A2E] hover:bg-[#0E7C86] rounded-full transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-[0.98] no-underline"
            >
              <span>Poser une question</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
            </a>
            <a href="#faq-clients" class="text-xs font-extrabold uppercase tracking-wider text-[#0A5A62] hover:text-[#0E7C86] underline underline-offset-4 transition-colors">
              Consulter les réponses ↓
            </a>
          </div>
        </div>

        <!-- Colonne Droite : Composition Photo Asymétrique & Badges Offcut -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-[140px_16px_16px_16px] overflow-hidden border border-[#0E7C86]/15 shadow-[0_12px_36px_rgba(11,42,46,0.08)] group bg-[#E8E2D2] h-[460px] sm:h-[520px]">
            <img
              src="/images/philosophy-unilka.jpg"
              alt="Espace soigné et entretenu dans le calme et la sérénité par unilka"
              width="800"
              height="600"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="eager"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/55 via-transparent to-black/20 pointer-events-none"></div>


            <!-- Légende haut-droite style Offcut -->
            <div class="absolute top-6 right-6 text-right text-white text-[10px] font-bold tracking-[0.1em] uppercase drop-shadow-md">
              <span>RÉPONSES CONCIERGES<br />MONTRÉAL & ENVIRONS</span>
            </div>

            <!-- Badge circulaire rotatif bas-droite -->
            <a class="absolute bottom-6 right-6 w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-white/95 backdrop-blur-md border border-[#0E7C86]/20 shadow-lg flex flex-col items-center justify-center p-3 text-center transition-transform hover:scale-105 hover:rotate-0 no-underline rotate-6" href="#faq-clients">
              <span class="text-[10px] font-black uppercase tracking-wider text-[#0B2A2E] leading-tight">100% CLAIR.<br />0 ZONE D'OMBRE.</span>
              <svg class="w-4 h-4 text-[#0E7C86] mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14m7-7-7 7-7-7"/></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Hero Foot : 3 micro-lignes Offcut -->
      <div class="mt-12 pt-7 border-t border-[#0E7C86]/12 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[11px] font-bold uppercase tracking-[0.08em] text-[#3D5A5E]">
        <span>RESPONSABILITÉ CIVILE 2 000 000 $ • CNESST</span>
        <span>0 CONTRAT D'ENGAGEMENT • PAIEMENT SÉCURISÉ</span>
        <a href="#faq-clients" class="text-[#0E7C86] hover:text-[#0A5A62] transition-colors">PARCOURIR LES QUESTIONS ↓</a>
      </div>
    </div>
  </section>

  <!-- 2. GROUPES D'ACCORDÉONS -->
  <section class="py-20 lg:py-24 bg-[#F5FAFA] border-b border-[#0E7C86]/12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- GROUPE 1 : CLIENTS -->
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-[#0E7C86]/15">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-[#0E7C86] text-white flex items-center justify-center font-bold text-sm shadow-xs">
              01
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-[#0B2A2E]">
              Pour les résidences & entreprises
            </h2>
          </div>
          <span class="text-xs font-bold text-[#0E7C86] uppercase tracking-wider">Clients</span>
        </div>

        <div class="space-y-3">
          {faqData.clients.map((item, index) => (
            <AccordionItem
              question={item.question}
              answer={item.answer}
              open={index === 0}
            />
          ))}
        </div>
      </div>

      <!-- GROUPE 2 : CANDIDATS -->
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-[#0E7C86]/15">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-[#0B2A2E] text-white flex items-center justify-center font-bold text-sm shadow-xs">
              02
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-[#0B2A2E]">
              Pour les candidat(e)s & futur(e)s préposé(e)s
            </h2>
          </div>
          <span class="text-xs font-bold text-[#0B2A2E] uppercase tracking-wider">Carrières</span>
        </div>

        <div class="space-y-3">
          {faqData.candidats.map((item) => (
            <AccordionItem
              question={item.question}
              answer={item.answer}
            />
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- 3. BANDEAU DE CONVERSION -->
  <CtaBanner
    title="Vous avez une demande particulière ?"
    description="Notre équipe concierge répond à toutes vos questions sous 24h ouvrées."
    ctaText="Poser une question via soumission"
    ctaLink="/soumission/"
  />

</BaseLayout>
