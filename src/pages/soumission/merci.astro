---
import BaseLayout from '../../layouts/BaseLayout.astro';
import config from '../../data/site-config.json';

const pageTitle = "Demande envoyée — unilka";
const pageDescription = "Votre demande de soumission a bien été envoyée.";
const delayText = config.business.responseDelay ? ` dans un délai de ${config.business.responseDelay}` : '';
---

<BaseLayout title={pageTitle} description={pageDescription} noindex={true}>

  <section class="py-16 sm:py-24 bg-brand-surface-subtle min-h-[70vh] flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      
      <!-- Icône de succès -->
      <div class="w-16 h-16 rounded-full bg-brand-success text-white mx-auto flex items-center justify-center shadow-md">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <div class="space-y-4">
        <h1 class="text-3xl sm:text-4xl font-black text-brand-text tracking-tight">
          Merci, votre demande a bien été envoyée
        </h1>
        <p class="text-base sm:text-lg text-brand-muted leading-relaxed">
          Notre équipe analysera votre demande et communiquera avec vous{delayText} pour confirmer les détails du service.
        </p>
      </div>

      <!-- Et maintenant ? -->
      <div class="bg-white p-6 sm:p-8 rounded-2xl border border-brand-primary-light/80 text-left space-y-4 shadow-xs">
        <h2 class="text-lg font-bold text-brand-text">
          Et maintenant ?
        </h2>
        <ol class="space-y-3 text-sm text-brand-muted" role="list">
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-brand-primary-light text-brand-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">1</span>
            <span>Nous examinons attentivement vos besoins et les caractéristiques de votre espace.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-brand-primary-light text-brand-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">2</span>
            <span>Nous vous contactons pour clarifier les derniers détails si nécessaire.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-brand-primary-light text-brand-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">3</span>
            <span>Vous recevez votre soumission personnalisée sans engagement.</span>
          </li>
        </ol>
      </div>

      <!-- Boutons retour -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-brand-primary hover:bg-brand-primary-dark rounded-md transition-colors no-underline"
        >
          Retour à l'accueil
        </a>
        <a
          href="/services/"
          class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-brand-text bg-white hover:bg-brand-primary-light border border-brand-primary-light rounded-md transition-colors no-underline"
        >
          Découvrir nos services
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
