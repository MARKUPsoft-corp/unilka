---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

const pageTitle = "Emplois & Carrières en Nettoyage à Montréal — unilka";
const pageDescription = "Rejoignez une entreprise qui respecte et valorise votre métier : missions régulières, flexibilité d'horaires et formation aux standards hôteliers.";

const breadcrumbs = [
  { label: "Carrières & Emplois", href: "/carrieres/" }
];

const benefits = [
  {
    title: "Horaires adaptés à votre quotidien",
    description: "Que vous cherchiez un emploi stable à temps plein ou un complément de revenu à temps partiel, nous bâtissons des plannings respectueux de votre vie personnelle."
  },
  {
    title: "Missions valorisantes & clients de choix",
    description: "Vous intervenez dans des résidences soignées et des locaux professionnels exigeants, où la qualité de votre travail est véritablement reconnue."
  },
  {
    title: "Formation aux protocoles d'excellence",
    description: "Nous vous formons aux techniques hôtelières haut de gamme, à l'utilisation sécuritaire des produits éco-responsables et au soin des matières précieuses."
  },
  {
    title: "Équipements & matériels modernes fournis",
    description: "Nous mettons à votre disposition des outils ergonomiques et des produits écologiques certifiés, sains pour votre santé et efficaces."
  },
  {
    title: "Rémunération juste & ponctuelle",
    description: "Une rétribution équitable versée sans retard, avec des perspectives d'évolution pour les intervenants démontrant rigueur et constance."
  },
  {
    title: "Écoute & respect mutuel au quotidien",
    description: "Chez unilka, vous n'êtes pas un simple numéro : notre équipe de coordination est à votre écoute pour vous accompagner sur chaque mission."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <!-- 1. HÉRO CARRIÈRES ÉDITORIAL -->
  <section class="py-16 lg:py-24 bg-[#FFFFFF] border-b border-[#0E7C86]/12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Texte gauche -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.14em] text-[#0E7C86]">
              Opportunités • Montréal & Rive-Sud
            </span>
          </div>

          <h1 class="text-[clamp(42px,11.5vw,56px)] sm:text-6xl lg:text-7xl font-bold text-[#0B2A2E] tracking-[-0.03em] leading-[1.05]">
            <span class="block font-bold text-[#0B2A2E] whitespace-nowrap">Rejoignez-nous.</span>
            <span class="block font-serif italic font-normal text-[#0E7C86] whitespace-nowrap">Équipe d'élite.</span>
          </h1>

          <p class="text-base sm:text-lg text-[#3D5A5E] leading-[1.75]">
            Vous êtes minutieux(se), sérieux(se) et vous aimez le travail soigné ? Chez unilka, nous offrons un cadre professionnel respectueux, des missions régulières et une vraie reconnaissance de votre métier.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="/carrieres/inscription/"
              class="inline-flex items-center justify-center px-8 py-4 text-sm font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full shadow-sm hover:shadow-md transition-all duration-200 no-underline hover:-translate-y-0.5 active:translate-y-0"
            >
              <span>Déposer ma candidature en ligne</span>
              <span class="ml-2 font-bold" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <!-- Image droite -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-[28px] overflow-hidden border border-[#0E7C86]/15 shadow-sm group">
            <img
              src="/images/careers-unilka.jpg"
              alt="Préposée d'entretien professionnelle et souriante chez unilka"
              width="800"
              height="600"
              class="w-full h-[360px] sm:h-[420px] object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/60 via-transparent to-transparent pointer-events-none"></div>

            <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md rounded-2xl p-4 border border-[#0E7C86]/15 flex items-center justify-between shadow-md">
              <span class="text-xs font-bold text-[#0B2A2E]">Formation & Accompagnement</span>
              <span class="text-xs font-black text-[#0E7C86] bg-[#E3F4F5] px-2.5 py-1 rounded-full">
                Temps plein & partiel
              </span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. AVANTAGES & ENGAGEMENTS DE L'ENTREPRISE -->
  <section class="py-20 lg:py-24 bg-[#F5FAFA] border-b border-[#0E7C86]/12" aria-labelledby="why-work-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs font-bold uppercase tracking-[0.14em] text-[#0E7C86]">
          Nos Engagements Employeur
        </span>
        <h2 id="why-work-title" class="text-3xl sm:text-4xl font-extrabold text-[#0B2A2E] tracking-tight">
          Pourquoi choisir de collaborer avec unilka ?
        </h2>
        <p class="text-sm sm:text-base text-[#3D5A5E]">
          Nous plaçons le respect des personnes et l'esprit d'équipe au cœur de chaque mission.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit, index) => (
          <div class="p-7 rounded-2xl bg-white border border-[#0E7C86]/12 shadow-2xs space-y-3 hover:border-[#0E7C86]/30 transition-all duration-200">
            <div class="w-8 h-8 rounded-xl bg-[#E3F4F5] text-[#0E7C86] font-extrabold text-xs flex items-center justify-center shrink-0">
              0{index + 1}
            </div>
            <h3 class="text-base font-extrabold text-[#0B2A2E]">
              {benefit.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
              {benefit.description}
            </p>
          </div>
        ))}
      </div>

      <!-- Information Réglementaire Importante -->
      <div class="p-6 sm:p-7 rounded-2xl bg-white border border-[#0E7C86]/15 flex items-start gap-4 shadow-[0_4px_20px_rgba(11,42,46,0.04)]">
        <div class="w-8 h-8 rounded-xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center shrink-0 mt-0.5 border border-[#0E7C86]/20">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="text-xs sm:text-sm text-[#3D5A5E] leading-relaxed">
          <strong class="text-[#0B2A2E] font-bold">Information sur le processus :</strong> L'envoi de votre candidature initie une analyse de profil par notre équipe de coordination. Les missions sont attribuées selon les disponibilités et les secteurs géographiques demandés, sous réserve de la vérification préalable des antécédents de sécurité.
        </p>
      </div>

    </div>
  </section>

  <!-- 3. BANDEAU DE CANDIDATURE FINAL -->
  <CtaBanner
    title="Prêt(e) à faire partie de l'équipe unilka ?"
    description="Remplissez votre dossier de candidature en ligne en moins de 5 minutes. Nous vous recontacterons rapidement."
    ctaText="Remplir le formulaire candidat"
    ctaLink="/carrieres/inscription/"
  />

</BaseLayout>
