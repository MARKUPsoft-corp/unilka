---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StepCandidateProfile from '../../components/forms/candidate/StepCandidateProfile.astro';
import StepCandidateCareer from '../../components/forms/candidate/StepCandidateCareer.astro';
import StepCandidateAvailability from '../../components/forms/candidate/StepCandidateAvailability.astro';
import StepCandidateConsent from '../../components/forms/candidate/StepCandidateConsent.astro';

const pageTitle = "Dossier de Candidature en Ligne — unilka Carrières";
const pageDescription = "Postulez en ligne pour rejoindre l'équipe de préposé(e)s à l'entretien ménager unilka à Montréal. Missions régulières, plannings respectés et statut 100% salarié.";

const breadcrumbs = [
  { label: "Carrières", href: "/carrieres/" },
  { label: "Dossier de candidature", href: "/carrieres/inscription/" }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <!-- 1. HÉRO ÉDITORIAL DU DOSSIER DE CANDIDATURE (STYLE OFFCUT) -->
  <section class="relative bg-white border-b border-[#0E7C86]/12 overflow-hidden pt-10 pb-12 lg:pt-16 lg:pb-16">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Colonne Gauche : Typographie & Clarté -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-2.5 text-xs font-black uppercase tracking-[0.14em] text-[#0A5A62]">
            <span class="w-2 h-2 rounded-full bg-[#0E7C86] animate-pulse"></span>
            <span>Talents & Savoir-Faire • Recrutement Continu</span>
          </div>

          <h1 class="text-[clamp(42px,11.5vw,56px)] sm:text-6xl lg:text-7xl xl:text-[76px] font-bold text-[#0B2A2E] tracking-[-0.035em] leading-[1.06] mt-7 mb-0">
            <span class="block font-bold text-[#0B2A2E] whitespace-nowrap">Cadre respectueux.</span>
            <span class="block font-serif italic font-normal text-[#0E7C86] mt-1 whitespace-nowrap">Métier valorisé.</span>
          </h1>

          <p class="text-base sm:text-lg text-[#3D5A5E] leading-[1.75] max-w-xl mt-6">
            Remplissez ce formulaire en 3 minutes pour nous faire part de vos disponibilités, de votre expérience et de vos secteurs de prédilection. Chez unilka, chaque préposé(e) bénéficie d'une vraie considération humaine, de plannings groupés et d'équipements de pointe.
          </p>

          <!-- CTA ancre vers le stepper -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="#candidate-stepper"
              class="inline-flex items-center justify-center px-8 py-4 text-sm font-bold text-white bg-[#0B2A2E] hover:bg-[#0E7C86] rounded-full transition-all duration-200 no-underline shadow-xs hover:-translate-y-0.5"
            >
              <span>Démarrer ma candidature</span>
              <span class="ml-2 font-mono">↓</span>
            </a>
            <span class="text-xs font-semibold text-[#0E7C86] flex items-center gap-1.5 py-3">
              ✓ Démarche en 3 minutes • Réponse garantie sous 48h
            </span>
          </div>
        </div>

        <!-- Colonne Droite : Visuel Arqué Offcut -->
        <div class="lg:col-span-5 relative mt-6 lg:mt-0">
          <div class="relative rounded-[140px_16px_16px_16px] overflow-hidden border border-[#0B2A2E]/10 shadow-[0_20px_50px_rgba(11,42,46,0.12)] bg-[#E8E2D2] aspect-[4/5] sm:aspect-auto sm:h-[500px]">
            <img
              src="/images/careers-unilka.jpg"
              alt="Préposée d'entretien professionnelle et souriante chez unilka"
              width="800"
              height="1000"
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/50 via-transparent to-transparent pointer-events-none"></div>

            <!-- Légende haut-droit -->
            <div class="absolute top-6 right-6 text-right text-white/95 text-[10px] font-bold tracking-[0.14em] uppercase drop-shadow-md">
              <span>ÉQUIPE BIENVEILLANTE<br />MONTRÉAL & ENVIRONS</span>
            </div>

            <!-- Badge circulaire type macaron tournant Offcut -->
            <div class="absolute -bottom-4 -right-4 sm:bottom-6 sm:right-6 w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-white/95 backdrop-blur-md shadow-xl border border-[#0B2A2E]/10 flex flex-col items-center justify-center text-center p-3">
              <span class="text-[9px] font-black uppercase tracking-[0.18em] text-[#0A5A62] leading-tight">
                STATUT<br />SALARIÉ
              </span>
              <span class="text-sm font-bold text-[#0B2A2E] mt-0.5">100%</span>
              <span class="text-[8px] font-bold uppercase tracking-wider text-[#0E7C86] mt-0.5">CNESST ↓</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Hero Foot : 3 engagements pour les préposé(e)s -->
      <div class="mt-14 pt-8 border-t border-[#0E7C86]/12 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-[#3D5A5E]">
        <div class="flex items-start gap-3">
          <span class="font-bold text-[#0E7C86] text-sm">01.</span>
          <div>
            <strong class="text-[#0B2A2E] font-bold block">Plannings Regroupés & Équilibre</strong>
            <span class="leading-relaxed">Missions dans votre secteur géographique pour limiter vos temps de trajet.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="font-bold text-[#0E7C86] text-sm">02.</span>
          <div>
            <strong class="text-[#0B2A2E] font-bold block">Protection CNESST & Rémunération Juste</strong>
            <span class="leading-relaxed">Statut 100% salarié, assurances responsabilité et paie versée avec exactitude.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="font-bold text-[#0E7C86] text-sm">03.</span>
          <div>
            <strong class="text-[#0B2A2E] font-bold block">Matériel & Produits Écologiques Fournis</strong>
            <span class="leading-relaxed">Équipements ergonomiques et produits certifiés sains pour protéger votre santé.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. CONTENEUR DU FORMULAIRE EN STEPPER PROGRESSIF -->
  <section class="py-12 sm:py-16 bg-[#F5FAFA] min-h-[60vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- TIMELINE STEPPER CHECKPOINTS -->
      <div class="mb-8" id="candidate-stepper">
        <div class="bg-white rounded-3xl border border-[#0E7C86]/15 p-4 sm:p-6 shadow-xs">
          
          <!-- Statut mobile de l'étape courante -->
          <div class="sm:hidden flex items-center justify-between pb-3 mb-4 border-b border-[#0E7C86]/10 text-xs">
            <span class="font-extrabold text-[#0E7C86] uppercase tracking-wider" id="cand-mobile-step-indicator">
              Étape 1 sur 4
            </span>
            <span class="font-bold text-[#0B2A2E]" id="cand-mobile-step-name">
              Votre profil
            </span>
          </div>

          <!-- Conteneur de la timeline avec ligne de progression -->
          <div class="relative px-2 sm:px-6">
            <!-- Barre de progression en arrière-plan -->
            <div class="absolute top-5 sm:top-6 left-8 right-8 sm:left-14 sm:right-14 h-1 bg-[#E3F4F5] -translate-y-1/2 z-0 rounded-full">
              <div
                id="cand-timeline-progress-bar"
                class="h-full bg-[#0E7C86] rounded-full transition-all duration-500 ease-out"
                style="width: 0%;"
              ></div>
            </div>

            <!-- Noeuds checkpoints -->
            <div class="relative z-10 grid grid-cols-4 gap-2 sm:gap-4" role="tablist" aria-label="Étapes de la candidature">
              
              <!-- Noeud 1 : Profil -->
              <button
                type="button"
                class="cand-step-checkpoint group flex flex-col items-center focus:outline-none cursor-pointer"
                data-step-target="1"
                id="cand-checkpoint-1"
                aria-selected="true"
                aria-controls="cand-step-panel-1"
              >
                <div class="checkpoint-node w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-extrabold text-sm sm:text-base transition-all duration-300 shadow-xs bg-[#0E7C86] text-white ring-4 ring-[#0E7C86]/20">
                  <span class="checkpoint-number">01</span>
                  <svg class="checkpoint-check hidden w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div class="mt-2.5 text-center">
                  <span class="checkpoint-label text-xs sm:text-sm font-extrabold text-[#0E7C86] block transition-colors">
                    Profil
                  </span>
                  <span class="checkpoint-sub hidden md:block text-[11px] text-[#3D5A5E] mt-0.5">
                    Identité & contact
                  </span>
                </div>
              </button>

              <!-- Noeud 2 : Parcours -->
              <button
                type="button"
                class="cand-step-checkpoint group flex flex-col items-center focus:outline-none cursor-not-allowed opacity-60"
                data-step-target="2"
                id="cand-checkpoint-2"
                aria-selected="false"
                aria-controls="cand-step-panel-2"
              >
                <div class="checkpoint-node w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-extrabold text-sm sm:text-base transition-all duration-300 shadow-xs bg-white text-[#3D5A5E] border-2 border-[#0E7C86]/25">
                  <span class="checkpoint-number">02</span>
                  <svg class="checkpoint-check hidden w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div class="mt-2.5 text-center">
                  <span class="checkpoint-label text-xs sm:text-sm font-semibold text-[#3D5A5E] block transition-colors">
                    Parcours
                  </span>
                  <span class="checkpoint-sub hidden md:block text-[11px] text-[#3D5A5E]/70 mt-0.5">
                    Statut & expérience
                  </span>
                </div>
              </button>

              <!-- Noeud 3 : Disponibilités -->
              <button
                type="button"
                class="cand-step-checkpoint group flex flex-col items-center focus:outline-none cursor-not-allowed opacity-60"
                data-step-target="3"
                id="cand-checkpoint-3"
                aria-selected="false"
                aria-controls="cand-step-panel-3"
              >
                <div class="checkpoint-node w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-extrabold text-sm sm:text-base transition-all duration-300 shadow-xs bg-white text-[#3D5A5E] border-2 border-[#0E7C86]/25">
                  <span class="checkpoint-number">03</span>
                  <svg class="checkpoint-check hidden w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div class="mt-2.5 text-center">
                  <span class="checkpoint-label text-xs sm:text-sm font-semibold text-[#3D5A5E] block transition-colors">
                    Disponibilités
                  </span>
                  <span class="checkpoint-sub hidden md:block text-[11px] text-[#3D5A5E]/70 mt-0.5">
                    Horaires & mobilité
                  </span>
                </div>
              </button>

              <!-- Noeud 4 : Validation -->
              <button
                type="button"
                class="cand-step-checkpoint group flex flex-col items-center focus:outline-none cursor-not-allowed opacity-60"
                data-step-target="4"
                id="cand-checkpoint-4"
                aria-selected="false"
                aria-controls="cand-step-panel-4"
              >
                <div class="checkpoint-node w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-extrabold text-sm sm:text-base transition-all duration-300 shadow-xs bg-white text-[#3D5A5E] border-2 border-[#0E7C86]/25">
                  <span class="checkpoint-number">04</span>
                  <svg class="checkpoint-check hidden w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div class="mt-2.5 text-center">
                  <span class="checkpoint-label text-xs sm:text-sm font-semibold text-[#3D5A5E] block transition-colors">
                    Validation
                  </span>
                  <span class="checkpoint-sub hidden md:block text-[11px] text-[#3D5A5E]/70 mt-0.5">
                    Consentement & envoi
                  </span>
                </div>
              </button>

            </div>
          </div>
        </div>
      </div>

      <!-- RÉSUMÉ D'ERREURS ACCESSIBLE -->
      <div
        id="cand-error-summary"
        tabindex="-1"
        class="hidden mb-8 p-6 rounded-2xl bg-red-50 border-2 border-red-500 text-red-800 shadow-sm focus:outline-none focus:ring-4 focus:ring-red-200"
        role="alert"
        aria-labelledby="cand-error-summary-heading"
      >
        <h2 id="cand-error-summary-heading" class="text-lg font-bold text-red-800 mb-2 flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span>Veuillez corriger les éléments suivants :</span>
        </h2>
        <ul id="cand-error-summary-list" class="list-disc pl-6 space-y-1 text-sm font-medium"></ul>
      </div>

      <!-- FORMULAIRE CANDIDAT EN STEPPER PROGRESSIF -->
      <form id="candidate-form" novalidate class="space-y-8">
        
        <!-- ÉTAPE 1 : PROFIL & COORDONNÉES -->
        <div id="cand-step-panel-1" class="cand-step-panel space-y-6" role="tabpanel" aria-labelledby="cand-checkpoint-1">
          <StepCandidateProfile />
          <div class="flex justify-end pt-2">
            <button
              type="button"
              class="btn-step-next inline-flex items-center justify-center px-8 py-4 text-sm font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full shadow-[0_4px_18px_rgba(14,124,134,0.25)] hover:shadow-[0_8px_24px_rgba(14,124,134,0.35)] transition-all duration-200 hover:-translate-y-0.5 cursor-pointer"
              data-target="2"
            >
              <span>Continuer vers votre parcours</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
          </div>
        </div>

        <!-- ÉTAPE 2 : PARCOURS & EXPÉRIENCE -->
        <div id="cand-step-panel-2" class="cand-step-panel hidden space-y-6" role="tabpanel" aria-labelledby="cand-checkpoint-2">
          <StepCandidateCareer />
          <div class="flex items-center justify-between pt-2">
            <button
              type="button"
              class="btn-step-prev inline-flex items-center justify-center px-6 py-3.5 text-xs font-bold text-[#0B2A2E] hover:text-[#0E7C86] bg-white border border-[#0E7C86]/20 hover:bg-[#E3F4F5] rounded-full transition-colors shadow-2xs cursor-pointer"
              data-target="1"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
              <span>Étape précédente</span>
            </button>
            <button
              type="button"
              class="btn-step-next inline-flex items-center justify-center px-8 py-4 text-sm font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full shadow-[0_4px_18px_rgba(14,124,134,0.25)] hover:shadow-[0_8px_24px_rgba(14,124,134,0.35)] transition-all duration-200 hover:-translate-y-0.5 cursor-pointer"
              data-target="3"
            >
              <span>Continuer vers vos disponibilités</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
          </div>
        </div>

        <!-- ÉTAPE 3 : DISPONIBILITÉS & MOBILITÉ -->
        <div id="cand-step-panel-3" class="cand-step-panel hidden space-y-6" role="tabpanel" aria-labelledby="cand-checkpoint-3">
          <StepCandidateAvailability />
          <div class="flex items-center justify-between pt-2">
            <button
              type="button"
              class="btn-step-prev inline-flex items-center justify-center px-6 py-3.5 text-xs font-bold text-[#0B2A2E] hover:text-[#0E7C86] bg-white border border-[#0E7C86]/20 hover:bg-[#E3F4F5] rounded-full transition-colors shadow-2xs cursor-pointer"
              data-target="2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
              <span>Étape précédente</span>
            </button>
            <button
              type="button"
              class="btn-step-next inline-flex items-center justify-center px-8 py-4 text-sm font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full shadow-[0_4px_18px_rgba(14,124,134,0.25)] hover:shadow-[0_8px_24px_rgba(14,124,134,0.35)] transition-all duration-200 hover:-translate-y-0.5 cursor-pointer"
              data-target="4"
            >
              <span>Continuer vers la validation</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
          </div>
        </div>

        <!-- ÉTAPE 4 : FORMATION, CONSENTEMENTS & ENVOI -->
        <div id="cand-step-panel-4" class="cand-step-panel hidden space-y-6" role="tabpanel" aria-labelledby="cand-checkpoint-4">
          <StepCandidateConsent />
        </div>

      </form>

    </div>
  </section>

</BaseLayout>

<style>
  .cand-step-panel:not(.hidden) {
    animation: stepEnter 260ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @keyframes stepEnter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cand-step-panel:not(.hidden) {
      animation: none;
    }
  }
</style>

<script>
  import { initCandidateForm } from '../../scripts/candidate-form.js';
  initCandidateForm();
</script>
