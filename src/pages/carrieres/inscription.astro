---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIdentity from '../../components/forms/candidate/SectionIdentity.astro';
import SectionWorkAuth from '../../components/forms/candidate/SectionWorkAuth.astro';
import SectionExperience from '../../components/forms/candidate/SectionExperience.astro';
import SectionAvailability from '../../components/forms/candidate/SectionAvailability.astro';
import SectionMobility from '../../components/forms/candidate/SectionMobility.astro';
import SectionConsent from '../../components/forms/candidate/SectionConsent.astro';

const pageTitle = "Dossier de Candidature en Ligne — unilka Carrières";
const pageDescription = "Postulez en ligne pour rejoindre l'équipe de préposé(e)s à l'entretien ménager unilka à Montréal. Missions régulières et respect de votre travail.";

const breadcrumbs = [
  { label: "Carrières", href: "/carrieres/" },
  { label: "Formulaire d'inscription", href: "/carrieres/inscription/" }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <!-- 1. HÉRO ÉDITORIAL DU DOSSIER DE CANDIDATURE (STYLE OFFCUT) -->
  <section class="relative bg-white border-b border-[#0E7C86]/12 overflow-hidden pt-8 pb-12 lg:pt-14 lg:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-[#F5FAFA]/60 via-white to-white pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Colonne Gauche : Typographie & Étapes de recrutement -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-[#0E7C86] animate-pulse"></span>
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.14em] text-[#0A5A62]">
              Talents & Savoir-Faire • Candidature en ligne
            </span>
          </div>

          <h1 class="text-[clamp(40px,11vw,56px)] sm:text-6xl lg:text-7xl font-bold text-[#0B2A2E] tracking-[-0.03em] leading-[1.05]">
            <span class="block font-bold text-[#0B2A2E]">Cadre respectueux.</span>
            <span class="block font-serif italic font-normal text-[#0E7C86]">Métier valorisé.</span>
          </h1>

          <p class="text-base sm:text-lg text-[#3D5A5E] leading-[1.75] max-w-2xl">
            Remplissez ce formulaire pour nous faire part de vos disponibilités, de votre expérience et de votre secteur de prédilection. Chez unilka, chaque préposé(e) bénéficie d'une vraie considération humaine, de missions régulières et de matériel haut de gamme.
          </p>

          <!-- Timeline recrutement en 3 étapes -->
          <div class="pt-1">
            <p class="text-xs font-extrabold uppercase tracking-wider text-[#0A5A62] mb-3">
              Processus d'embauche clair & rapide :
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div class="p-3 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/20 shadow-2xs">
                <span class="text-[10px] font-black tracking-wider text-[#0E7C86] block">01. EN LIGNE</span>
                <span class="text-xs font-extrabold text-[#0B2A2E] block">Formulaire</span>
                <span class="text-[11px] text-[#3D5A5E]">3 minutes</span>
              </div>
              <div class="p-3 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/20 shadow-2xs">
                <span class="text-[10px] font-black tracking-wider text-[#0E7C86] block">02. RENCONTRE</span>
                <span class="text-xs font-extrabold text-[#0B2A2E] block">Échange</span>
                <span class="text-[11px] text-[#3D5A5E]">Entretien bienveillant</span>
              </div>
              <div class="p-3 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/20 shadow-2xs">
                <span class="text-[10px] font-black tracking-wider text-[#0E7C86] block">03. DÉMARRAGE</span>
                <span class="text-xs font-extrabold text-[#0B2A2E] block">Formation</span>
                <span class="text-[11px] text-[#3D5A5E]">Intégration rémunérée</span>
              </div>
            </div>
          </div>

          <!-- Puces de réassurance -->
          <div class="pt-2 flex flex-wrap items-center gap-3 text-xs font-semibold text-[#0A5A62]">
            <span class="inline-flex items-center gap-1.5 bg-[#E3F4F5] px-3 py-1.5 rounded-full">
              <span class="text-[#0E7C86] font-bold">✓</span> Statut 100% salarié (CNESST)
            </span>
            <span class="inline-flex items-center gap-1.5 bg-[#E3F4F5] px-3 py-1.5 rounded-full">
              <span class="text-[#0E7C86] font-bold">✓</span> Matériel de pointe fourni
            </span>
            <span class="inline-flex items-center gap-1.5 bg-[#E3F4F5] px-3 py-1.5 rounded-full">
              <span class="text-[#0E7C86] font-bold">✓</span> Confidentialité Loi 25
            </span>
          </div>
        </div>

        <!-- Colonne Droite : Visuel Équipe & Badges Carrières -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-[16px_120px_16px_16px] overflow-hidden border border-[#0E7C86]/15 shadow-[0_12px_36px_rgba(11,42,46,0.09)] group bg-[#E8E2D2]">
            <img
              src="/images/careers-unilka.jpg"
              alt="Préposée d'entretien professionnelle et souriante chez unilka"
              width="800"
              height="600"
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-700 group-hover:scale-105"
              loading="eager"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/70 via-transparent to-black/20 pointer-events-none"></div>

            <!-- Légende haut-gauche -->
            <div class="absolute top-5 left-5 text-left text-white text-[10px] font-bold tracking-[0.1em] uppercase drop-shadow-md">
              <span>ÉQUIPE CHALEUREUSE & SOUDÉE<br />MONTRÉAL & ENVIRONS</span>
            </div>

            <!-- Badge statut bas-droite -->
            <div class="absolute bottom-5 right-5 left-5 sm:left-auto bg-white/95 backdrop-blur-md rounded-2xl p-4 border border-[#0E7C86]/15 shadow-lg sm:max-w-[270px]">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-800">
                  Postes Disponibles
                </span>
              </div>
              <p class="text-xs font-bold text-[#0B2A2E] leading-snug">
                Temps plein ou partiel : nous adaptons vos missions selon vos créneaux.
              </p>
              <div class="mt-2 pt-2 border-t border-[#0E7C86]/10 flex items-center justify-between text-[11px] font-black text-[#0A5A62]">
                <span>Prise de contact</span>
                <span class="text-[#0E7C86]">Sous 48h ouvrées</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Hero Foot : 3 engagements pour les candidats -->
      <div class="mt-12 pt-8 border-t border-[#0E7C86]/12 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-[#3D5A5E]">
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-lg bg-[#E3F4F5] text-[#0E7C86] font-bold flex items-center justify-center shrink-0">✓</span>
          <div>
            <strong class="text-[#0B2A2E] font-bold block">Plannings Regroupés</strong>
            <span>Missions dans un même secteur pour limiter vos temps de transport.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-lg bg-[#E3F4F5] text-[#0E7C86] font-bold flex items-center justify-center shrink-0">✓</span>
          <div>
            <strong class="text-[#0B2A2E] font-bold block">Produits Sains & Sécuritaires</strong>
            <span>Zéro acide violent ou émanations toxiques : nous protégeons votre santé au quotidien.</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-lg bg-[#E3F4F5] text-[#0E7C86] font-bold flex items-center justify-center shrink-0">✓</span>
          <div>
            <strong class="text-[#0B2A2E] font-bold block">Accompagnement Bienveillant</strong>
            <span>Une coordinatrice toujours joignable en cas d'imprévu sur le terrain.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. CONTENEUR DU FORMULAIRE CANDIDAT -->
  <section class="py-12 sm:py-16 bg-[#F5FAFA] min-h-[60vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- RÉSUMÉ D'ERREURS ACCESSIBLE -->
      <div
        id="cand-error-summary"
        tabindex="-1"
        class="hidden mb-8 p-6 rounded-2xl bg-red-50 border-2 border-red-500 text-red-800 shadow-sm focus:outline-none focus:ring-4 focus:ring-red-200"
        role="alert"
        aria-labelledby="cand-error-summary-heading"
      >
        <h2 id="cand-error-summary-heading" class="text-lg font-bold text-red-800 mb-2 flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span>Veuillez corriger les éléments suivants :</span>
        </h2>
        <ul id="cand-error-summary-list" class="list-disc pl-6 space-y-1 text-sm font-medium"></ul>
      </div>

      <!-- FORMULAIRE MODULAIRE CANDIDAT -->
      <form id="candidate-form" novalidate class="space-y-8">
        <SectionIdentity />
        <SectionWorkAuth />
        <SectionExperience />
        <SectionAvailability />
        <SectionMobility />
        <SectionConsent />
      </form>

    </div>
  </section>

</BaseLayout>

<script>
  import { initCandidateForm } from '../../scripts/candidate-form.js';
  initCandidateForm();
</script>
