---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Inscription envoyée — unilka";
const pageDescription = "Votre inscription a bien été envoyée.";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex={true}>

  <section class="py-16 sm:py-24 bg-brand-surface-subtle min-h-[70vh] flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      
      <!-- Icône de succès -->
      <div class="w-16 h-16 rounded-full bg-brand-success text-white mx-auto flex items-center justify-center shadow-md">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <div class="space-y-4">
        <h1 class="text-3xl sm:text-4xl font-black text-brand-text tracking-tight">
          Merci, votre inscription a bien été envoyée
        </h1>
        <p class="text-base sm:text-lg text-brand-muted leading-relaxed">
          Votre candidature sera évaluée en fonction de nos besoins et des opportunités disponibles. Si votre profil correspond, nous communiquerons avec vous pour planifier un entretien.
        </p>
      </div>

      <!-- Rappel -->
      <div class="p-5 rounded-xl bg-amber-50 border border-amber-200 text-xs sm:text-sm text-brand-text text-left max-w-lg mx-auto">
        <p class="leading-relaxed">
          <span class="font-bold">Rappel :</span> L'inscription ne garantit pas automatiquement l'obtention d'un emploi ou d'une mission.
        </p>
      </div>

      <!-- Bouton retour -->
      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-brand-primary hover:bg-brand-primary-dark rounded-md transition-colors no-underline"
        >
          Retour à l'accueil
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
