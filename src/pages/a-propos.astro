---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/cards/FeatureCard.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';

const pageTitle = "À propos de unilka — Nettoyage professionnel";
const pageDescription = "Découvrez notre approche : un service professionnel, prompt et personnalisé pour des espaces propres, sains et agréables.";

const breadcrumbs = [
  { label: "À propos", href: "/a-propos/" }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>

  <!-- EN-TÊTE -->
  <section class="bg-brand-surface-subtle py-12 lg:py-16 border-b border-brand-primary-light/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-text tracking-tight">
        À propos de unilka
      </h1>
      <p class="text-base sm:text-lg text-brand-muted leading-relaxed max-w-2xl mx-auto">
        Chez unilka, nous croyons qu'un espace propre et bien entretenu contribue directement au confort, au bien-être et à la qualité de vie. Nous offrons des services de nettoyage professionnels adaptés aux besoins des particuliers, des entreprises et des propriétaires.
      </p>
    </div>
  </section>

  <!-- CONTENU -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Notre objectif -->
      <div class="p-8 sm:p-10 rounded-2xl bg-brand-primary-light/50 border border-brand-primary/20 text-center space-y-3">
        <h2 class="text-2xl font-bold text-brand-primary">
          Notre objectif
        </h2>
        <p class="text-xl sm:text-2xl font-extrabold text-brand-text tracking-tight max-w-2xl mx-auto">
          Vous faire gagner du temps et vous offrir un environnement propre, sain et agréable.
        </p>
      </div>

      <!-- Nos engagements -->
      <div class="space-y-8">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-text tracking-tight">
            Nos engagements
          </h2>
          <p class="text-sm text-brand-muted">
            Les quatre piliers de la qualité unilka.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <FeatureCard
            title="Un service professionnel"
            description="Nous accordons une grande importance à la qualité de chaque intervention. Notre objectif est de vous offrir un service professionnel, organisé et adapté à vos attentes."
            icon="check-shield"
          />
          <FeatureCard
            title="Des personnes sérieuses et compétentes"
            description="Nous travaillons avec des personnes sérieuses et compétentes afin de vous offrir une expérience de nettoyage sécuritaire et satisfaisante."
            icon="users"
          />
          <FeatureCard
            title="Promptitude et efficacité"
            description="Nous respectons les horaires convenus et nous nous efforçons d'effectuer chaque intervention avec efficacité, sans compromettre la qualité du travail."
            icon="clock"
          />
          <FeatureCard
            title="Un service personnalisé"
            description="Chaque client et chaque espace sont différents. C'est pourquoi nous prenons le temps de comprendre vos besoins afin de vous proposer une solution adaptée."
            icon="sparkles"
          />
        </div>
      </div>

      <!-- Notre équipe -->
      <div class="p-8 rounded-xl bg-brand-surface-subtle border border-brand-primary-light/80 text-center space-y-4">
        <h2 class="text-2xl font-bold text-brand-text">
          Notre équipe
        </h2>
        <p class="text-base text-brand-muted max-w-xl mx-auto">
          Nous travaillons avec des personnes sérieuses et compétentes. Vous souhaitez en faire partie ?
        </p>
        <div>
          <a
            href="/carrieres/"
            class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-brand-primary bg-white hover:bg-brand-primary-light border border-brand-primary-light rounded-md transition-colors no-underline"
          >
            Découvrir nos opportunités d'emploi &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- BANDE FINALE -->
  <CtaBanner
    title="Besoin d'un nettoyage ?"
    description="Obtenez une évaluation de vos besoins en quelques étapes."
    ctaText="Obtenir une soumission"
    ctaLink="/soumission/"
  />

</BaseLayout>
