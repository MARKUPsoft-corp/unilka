---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';

const defaultActiveStaff = [
  {
    id: "STF-01",
    name: "Fatou Diop",
    role: "Préposée senior d'hôtellerie",
    photo: "/images/admin/staff-fatou.jpg",
    initials: "FD",
    phone: "(514) 712-4401",
    email: "fatou.d@unilka.ca",
    sector: "Westmount, Outremont, Ville-Marie",
    missionsPerWeek: 8,
    backgroundCheck: "Validé (Mars 2026)",
    trainedDate: "Avril 2026",
    status: "Actif",
    statusColor: "bg-emerald-100 text-emerald-800"
  },
  {
    id: "STF-02",
    name: "Khadija Benmoussa",
    role: "Préposée certifiée résidentiel",
    photo: "",
    initials: "KB",
    phone: "(514) 609-1288",
    email: "khadija.b@unilka.ca",
    sector: "Plateau-Mont-Royal, Rosemont, Brossard",
    missionsPerWeek: 7,
    backgroundCheck: "Validé (Février 2026)",
    trainedDate: "Février 2026",
    status: "Actif",
    statusColor: "bg-emerald-100 text-emerald-800"
  },
  {
    id: "STF-03",
    name: "Jean-Marc Tremblay",
    role: "Technicien surfaces & textiles",
    photo: "/images/admin/staff-jeanmarc.jpg",
    initials: "JT",
    phone: "(514) 998-3120",
    email: "jm.tremblay@unilka.ca",
    sector: "Montréal, Rive-Sud, Lanaudière",
    missionsPerWeek: 6,
    backgroundCheck: "Validé (Janvier 2026)",
    trainedDate: "Janvier 2026",
    status: "Actif",
    statusColor: "bg-emerald-100 text-emerald-800"
  },
  {
    id: "STF-04",
    name: "Assane Ndiaye",
    role: "Responsable entretien commercial",
    photo: "",
    initials: "AN",
    phone: "(514) 554-7719",
    email: "assane.n@unilka.ca",
    sector: "Vieux-Montréal, Ville-Marie, Griffintown",
    missionsPerWeek: 5,
    backgroundCheck: "Validé (Mai 2026)",
    trainedDate: "Juin 2026",
    status: "Actif",
    statusColor: "bg-emerald-100 text-emerald-800"
  }
];

const defaultCandidates = [
  {
    id: "CAN-108",
    name: "Marie-Claire Kabore",
    date: "27 oct. 2026, 15:10",
    phone: "(514) 431-8902",
    email: "mc.kabore@email.ca",
    city: "Terrebonne, Lanaudière",
    workAuth: "Citoyenne canadienne / Résidente permanente",
    availability: "Temps plein (semaine & samedi)",
    experience: "3 ans en hôtellerie (Hôtel Omni Mont-Royal)",
    transport: "Voiture personnelle",
    trainingWish: "Protocoles sanitaires & relation client",
    loi25Consent: true,
    status: "Nouveau profil",
    statusColor: "bg-amber-100 text-amber-900 border-amber-200"
  },
  {
    id: "CAN-107",
    name: "Youssef Amrani",
    date: "26 oct. 2026, 11:25",
    phone: "(450) 819-3301",
    email: "y.amrani@domain.qc.ca",
    city: "Longueuil, Rive-Sud",
    workAuth: "Permis de travail ouvert valide",
    availability: "Temps partiel (matinées 8h-14h)",
    experience: "2 ans en entretien de bureaux d'affaires",
    transport: "Transport en commun",
    trainingWish: "Techniques d'entretien commercial",
    loi25Consent: true,
    status: "Entrevue planifiée",
    statusColor: "bg-blue-100 text-blue-800 border-blue-200"
  },
  {
    id: "CAN-106",
    name: "Geneviève Beaulieu",
    date: "24 oct. 2026, 16:40",
    phone: "(514) 320-7788",
    email: "g.beaulieu@service.ca",
    city: "Rosemont, Montréal",
    workAuth: "Citoyenne canadienne",
    availability: "Temps plein",
    experience: "5 ans chez des particuliers de prestige",
    transport: "Voiture personnelle",
    trainingWish: "Produits éco-certifiés Unilka",
    loi25Consent: true,
    status: "Enquête antécédents",
    statusColor: "bg-purple-100 text-purple-800 border-purple-200"
  }
];

let liveCandidates: any[] = [];
let liveStaff: any[] = [];
try {
  const { db } = await import('../../lib/firebase');
  const { collection, getDocs, query, orderBy, limit } = await import('firebase/firestore');

  // Candidats récents
  const qCand = query(collection(db, 'candidates'), orderBy('createdAt', 'desc'), limit(50));
  const snapCand = await getDocs(qCand);
  liveCandidates = snapCand.docs.map(doc => {
    const data = doc.data();
    const d = data.createdAt ? new Date(data.createdAt) : new Date();
    const formattedDate = d.toLocaleDateString('fr-CA', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });

    return {
      id: `CAN-${doc.id.substring(0, 5).toUpperCase()}`,
      rawId: doc.id,
      name: data.candidateName || data.name || `${data.firstName || ''} ${data.lastName || ''}`.trim() || 'Candidat Unilka',
      date: formattedDate,
      phone: data.phone || '',
      email: data.email || '',
      city: data.city || 'Grand Montréal',
      workAuth: data.workAuth || 'Citoyenne canadienne / Résidente',
      availability: data.availability || 'Temps plein',
      experience: data.experience || 'Entretien',
      transport: data.transport || 'Voiture personnelle',
      trainingWish: data.trainingWish || 'Protocoles sanitaires Unilka',
      loi25Consent: true,
      status: data.status || 'Nouveau profil',
      statusColor: data.statusColor || 'bg-amber-100 text-amber-900 border-amber-200'
    };
  });

  // Collaborateurs actifs
  const qStaff = query(collection(db, 'staff'), orderBy('createdAt', 'desc'), limit(50));
  const snapStaff = await getDocs(qStaff);
  liveStaff = snapStaff.docs.map(doc => {
    const data = doc.data();
    const parts = (data.name || 'Collaborateur').split(' ').filter(Boolean);
    const initials = (parts[0]?.[0] || 'U') + (parts[1]?.[0] || 'N');
    return {
      id: doc.id.startsWith('STF-') ? doc.id : `STF-${doc.id.substring(0, 4).toUpperCase()}`,
      rawId: doc.id,
      name: data.name || 'Collaborateur',
      role: data.role || 'Préposé(e) certifié(e)',
      photo: data.photo || '',
      initials: (data.initials || initials).toUpperCase(),
      phone: data.phone || '(514) 000-0000',
      email: data.email || 'equipe@unilka.ca',
      sector: data.sector || 'Grand Montréal',
      missionsPerWeek: data.missionsPerWeek || 7,
      backgroundCheck: data.backgroundCheck || 'Validé (Novembre 2026)',
      trainedDate: data.trainedDate || 'Novembre 2026',
      status: data.status || 'Actif',
      statusColor: 'bg-emerald-100 text-emerald-800'
    };
  });
} catch (err: any) {
  console.warn('[Admin Equipe] Chargement Firestore échoué (mode démo actif) :', err?.message);
}

const pendingCandidates = liveCandidates.length > 0 ? liveCandidates : defaultCandidates;
const activeStaff = [...liveStaff, ...defaultActiveStaff];
---

<AdminLayout title="Équipe & Candidats" activeNav="equipe">

  <!-- 1. EN-TÊTE -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
        <span>Ressources Humaines & Recrutement</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight">
        Équipe active & Candidatures
      </h1>
      <p class="text-xs sm:text-sm text-[#3D5A5E]">
        <span id="active-staff-count-badge">{activeStaff.length}</span> collaborateurs actifs • <span id="candidates-count-badge">{pendingCandidates.length}</span> candidatures reçues via le formulaire carrières.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button
        type="button"
        id="btn-open-add-staff"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-colors cursor-pointer"
      >
        <span>+ Ajouter un préposé</span>
      </button>
    </div>
  </div>

  <!-- 2. SECTION CANDIDATURES EN ATTENTE (PRIORITÉ RH) -->
  <div class="bg-white rounded-2xl border border-[#0E7C86]/12 overflow-hidden shadow-2xs space-y-4 p-6">
    <div class="flex items-center justify-between pb-3 border-b border-[#0E7C86]/10">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
        <h2 class="text-base font-extrabold text-[#0B2A2E]">
          Candidatures récentes reçues en ligne
        </h2>
      </div>
      <span class="text-xs font-bold text-[#0E7C86] bg-[#E3F4F5] px-2.5 py-1 rounded-full">
        {pendingCandidates.length} profils
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pendingCandidates.map((can) => (
        <div class="p-5 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12 space-y-3.5 flex flex-col justify-between shadow-2xs hover:border-[#0E7C86]/30 transition-all candidate-card" data-id={can.id} data-rawid={can.rawId || ''} data-name={can.name} data-phone={can.phone} data-email={can.email} data-city={can.city} data-availability={can.availability} data-experience={can.experience} data-training={can.trainingWish} data-status={can.status}>
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <span class={`status-badge text-[10px] font-extrabold px-2.5 py-0.5 rounded-full border ${can.statusColor}`}>
                {can.status}
              </span>
              <span class="text-[10px] text-[#3D5A5E]/70 font-mono">{can.date.split(',')[0]}</span>
            </div>

            <div>
              <h3 class="text-sm font-extrabold text-[#0B2A2E]">{can.name}</h3>
              <p class="text-xs text-[#3D5A5E] flex items-center gap-1.5 mt-0.5">
                <AdminIcon name="location" class="w-3.5 h-3.5 text-[#0E7C86] shrink-0" />
                <span>{can.city}</span>
              </p>
              <p class="text-xs text-[#3D5A5E] flex items-center gap-1.5 mt-0.5">
                <AdminIcon name="phone" class="w-3.5 h-3.5 text-[#0E7C86] shrink-0" />
                <span>{can.phone || 'Non renseigné'}</span>
              </p>
            </div>
            
            <div class="pt-2 border-t border-[#0E7C86]/10 text-[11px] text-[#3D5A5E] space-y-1.5">
              <p><strong class="text-[#0B2A2E]">Disponibilité :</strong> {can.availability}</p>
              <p><strong class="text-[#0B2A2E]">Expérience :</strong> {can.experience}</p>
              <p><strong class="text-[#0B2A2E]">Mobilité / Transport :</strong> {can.transport}</p>
              <p><strong class="text-[#0B2A2E]">Formation souhaitée :</strong> {can.trainingWish}</p>
              <p class="pt-1 flex items-center gap-1 text-[10px] text-emerald-700 font-bold">
                <AdminIcon name="shield-check" class="w-3 h-3 text-emerald-700 shrink-0" />
                <span>Consentement Loi 25 confirmé</span>
              </p>
            </div>
          </div>

          <div class="pt-3 border-t border-[#0E7C86]/10 space-y-2">
            <div class="flex items-center justify-between gap-2">
              <button
                type="button"
                class="btn-call-candidate flex-1 px-3 py-1.5 text-xs font-bold text-[#0E7C86] bg-white hover:bg-[#E3F4F5] border border-[#0E7C86]/20 rounded-full transition-colors cursor-pointer text-center"
                data-name={can.name}
                data-phone={can.phone}
              >
                Appeler
              </button>
              <button
                type="button"
                class="btn-schedule-interview flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 text-xs font-bold text-[#0B2A2E] bg-white hover:bg-[#F5FAFA] border border-[#0E7C86]/20 rounded-full shadow-2xs transition-colors cursor-pointer text-center"
                data-id={can.id}
                data-rawid={can.rawId || ''}
                data-name={can.name}
                data-phone={can.phone}
                data-email={can.email}
                data-city={can.city}
                data-role={can.trainingWish}
                data-availability={can.availability}
                data-experience={can.experience}
              >
                <span>Entretien</span>
                <AdminIcon name="arrow-right" class="w-3 h-3" />
              </button>
            </div>

            <!-- BOUTON DE CONFIRMATION AUTOMATIQUE EN COLLABORATEUR ACTIF -->
            {can.status === 'Collaborateur actif' ? (
              <div class="w-full py-2 px-3 rounded-full bg-emerald-50 border border-emerald-300 text-emerald-800 font-extrabold text-xs text-center flex items-center justify-center gap-1.5 shadow-2xs">
                <AdminIcon name="check" class="w-3.5 h-3.5 text-emerald-600" />
                <span>Collaborateur actif</span>
              </div>
            ) : (
              <button
                type="button"
                class="btn-confirm-collaborator w-full py-2 px-3 rounded-full bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-xs text-center flex items-center justify-center gap-1.5 shadow-sm hover:shadow transition-all cursor-pointer"
                data-id={can.id}
                data-rawid={can.rawId || ''}
                data-name={can.name}
                data-phone={can.phone}
                data-email={can.email}
                data-city={can.city}
                data-availability={can.availability}
                data-experience={can.experience}
                data-training={can.trainingWish}
              >
                <AdminIcon name="shield-check" class="w-3.5 h-3.5 text-white" />
                <span>Confirmer en collaborateur actif</span>
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 3. PERSONNEL ACTIF & STATUTS DE SÉCURITÉ -->
  <div class="bg-white rounded-2xl border border-[#0E7C86]/12 overflow-hidden shadow-2xs">
    <div class="p-5 sm:p-6 border-b border-[#0E7C86]/10 flex items-center justify-between">
      <h2 class="text-base font-extrabold text-[#0B2A2E]">
        Équipe active sur le terrain
      </h2>
      <span class="text-xs text-[#3D5A5E]">
        Contrôle d'antécédents systématique
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-[#F5FAFA] border-b border-[#0E7C86]/12 text-[#3D5A5E] font-extrabold uppercase tracking-wider text-[10px]">
            <th class="py-3.5 px-4">Collaborateur</th>
            <th class="py-3.5 px-4">Rôle & Spécialité</th>
            <th class="py-3.5 px-4">Secteurs réguliers</th>
            <th class="py-3.5 px-4">Missions / sem.</th>
            <th class="py-3.5 px-4">Enquête antécédents</th>
            <th class="py-3.5 px-4">Formation palace</th>
            <th class="py-3.5 px-4">Statut</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#0E7C86]/08" id="staff-table-body">
          {activeStaff.map((stf) => (
            <tr class="hover:bg-[#F5FAFA]/60 transition-colors staff-row">
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  {stf.photo ? (
                    <img src={stf.photo} alt={stf.name} class="w-10 h-10 rounded-full object-cover border border-[#0E7C86]/20 shrink-0 shadow-2xs" />
                  ) : (
                    <span class="w-10 h-10 rounded-full bg-[#E3F4F5] text-[#0E7C86] font-bold text-xs flex items-center justify-center shrink-0">
                      {stf.initials}
                    </span>
                  )}
                  <div>
                    <span class="font-extrabold text-[#0B2A2E] block text-[13px]">{stf.name}</span>
                    <span class="text-[#3D5A5E] block">{stf.phone}</span>
                  </div>
                </div>
              </td>
              <td class="py-4 px-4 font-semibold text-[#0B2A2E]">
                {stf.role}
              </td>
              <td class="py-4 px-4 text-[#3D5A5E]">
                {stf.sector}
              </td>
              <td class="py-4 px-4 font-bold text-[#0B2A2E]">
                {stf.missionsPerWeek} missions
              </td>
              <td class="py-4 px-4">
                <span class="inline-flex items-center gap-1.5 text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                  <AdminIcon name="shield-check" class="w-3.5 h-3.5 text-emerald-700 shrink-0" />
                  <span>{stf.backgroundCheck}</span>
                </span>
              </td>
              <td class="py-4 px-4 text-[#3D5A5E]">
                {stf.trainedDate}
              </td>
              <td class="py-4 px-4">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${stf.statusColor}`}>
                  {stf.status}
                </span>
              </td>
              <td class="py-4 px-4 text-right">
                <a
                  href="/admin/planning/"
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold text-[#0E7C86] hover:bg-[#E3F4F5] transition-colors no-underline cursor-pointer"
                >
                  <span>Planning préposé</span>
                  <AdminIcon name="arrow-right" class="w-3 h-3" />
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4. MODALE PLANIFIER UN ENTRETIEN -->
  <div
    id="modal-schedule-interview"
    class="fixed inset-0 z-[80] hidden items-center justify-center p-3 sm:p-5"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-interview-title"
  >
    <div class="fixed inset-0 bg-[#0B2A2E]/60 backdrop-blur-sm -z-10 modal-backdrop-click"></div>
    <div class="bg-white rounded-3xl border border-[#0E7C86]/20 shadow-2xl max-w-lg w-full max-h-[92vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-200 modal-card">
      
      <div class="p-6 border-b border-[#0E7C86]/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center">
            <AdminIcon name="calendar" class="w-4 h-4 text-[#0E7C86]" />
          </span>
          <div>
            <h2 id="modal-interview-title" class="text-base font-extrabold text-[#0B2A2E]">
              Planifier un entretien d'embauche
            </h2>
            <p class="text-xs text-[#3D5A5E]" id="interview-candidate-sub">Candidat : —</p>
          </div>
        </div>
        <button
          type="button"
          id="close-interview-modal-btn"
          class="p-1.5 rounded-lg text-[#3D5A5E] hover:text-[#0B2A2E] hover:bg-[#F5FAFA] cursor-pointer"
          aria-label="Fermer la boîte de dialogue"
        >
          <AdminIcon name="close" class="w-4 h-4" />
        </button>
      </div>

      <div class="p-6 space-y-4 text-xs overflow-y-auto">
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Date de l'entrevue</label>
            <input
              type="date"
              id="interview-date"
              class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            />
          </div>
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Heure de rendez-vous</label>
            <input
              type="time"
              id="interview-time"
              value="10:00"
              class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            />
          </div>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-[#0B2A2E]">Format de la rencontre</label>
          <select
            id="interview-format"
            class="w-full px-3 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
          >
            <option value="visio">Visioconférence Google Meet (Lien généré)</option>
            <option value="phone">Entretien téléphonique direct</option>
            <option value="in_person">Bureaux Unilka Montréal (1040 Av. Laurier Ouest)</option>
          </select>
        </div>

        <!-- Modèle de message invitation -->
        <div class="p-4 rounded-xl bg-[#E3F4F5]/60 border border-[#0E7C86]/15 space-y-2 text-[11px]">
          <span class="font-bold text-[#0B2A2E] block">Aperçu de la convocation transmise au candidat :</span>
          <p id="interview-preview-text" class="text-[#3D5A5E] leading-relaxed italic bg-white p-3 rounded-lg border border-[#0E7C86]/10">
            « Bonjour, suite à votre candidature chez Unilka, nous souhaitons vous convier à un entretien officiel. »
          </p>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row gap-2">
          <button
            type="button"
            id="btn-copy-interview-sms"
            class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full border border-[#0E7C86]/20 bg-white hover:bg-[#F5FAFA] text-xs font-bold text-[#0B2A2E] transition-colors cursor-pointer"
          >
            <AdminIcon name="document" class="w-3.5 h-3.5 text-[#0E7C86]" />
            <span>Copier le SMS d'invitation</span>
          </button>
          <a
            id="btn-email-interview"
            href="#"
            class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full bg-[#0E7C86] hover:bg-[#0A5A62] text-xs font-bold text-white transition-colors no-underline cursor-pointer shadow-2xs"
          >
            <AdminIcon name="envelope" class="w-3.5 h-3.5 text-white" />
            <span>Envoyer par courriel</span>
          </a>
        </div>
      </div>

      <div class="p-5 bg-[#F5FAFA] border-t border-[#0E7C86]/10 flex items-center justify-between">
        <button
          type="button"
          id="btn-cancel-interview"
          class="text-xs font-bold text-[#3D5A5E] hover:text-[#0B2A2E] cursor-pointer"
        >
          Annuler
        </button>
        <button
          type="button"
          id="btn-confirm-interview-status"
