  <script>
    import { db } from '../../lib/firebase';
    import { collection, addDoc, updateDoc, doc } from 'firebase/firestore';

    // 1. Téléportation des modales vers document.body
    const modalInterview = document.getElementById('modal-schedule-interview');
    const modalAddStaff = document.getElementById('modal-add-staff');
    const modalConfirm = document.getElementById('modal-confirm-collaborator');

    function teleportModal(m: HTMLElement | null) {
      if (m && m.parentElement !== document.body) {
        document.body.appendChild(m);
      }
    }
    teleportModal(modalInterview);
    teleportModal(modalAddStaff);
    teleportModal(modalConfirm);

    function showModal(modalEl: HTMLElement | null) {
      if (!modalEl) return;
      teleportModal(modalEl);
      modalEl.classList.remove('hidden');
      modalEl.classList.add('flex');
      document.body.style.overflow = 'hidden';
      const card = modalEl.querySelector('.modal-card');
      setTimeout(() => {
        card?.classList.remove('scale-95', 'opacity-0');
        card?.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function hideModal(modalEl: HTMLElement | null) {
      if (!modalEl) return;
      const card = modalEl.querySelector('.modal-card');
      card?.classList.remove('scale-100', 'opacity-100');
      card?.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modalEl.classList.remove('flex');
        modalEl.classList.add('hidden');
        document.body.style.overflow = '';
      }, 180);
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideModal(modalInterview);
        hideModal(modalAddStaff);
        hideModal(modalConfirm);
      }
    });

    document.querySelectorAll('.modal-backdrop-click').forEach((bd) => {
      bd.addEventListener('click', () => {
        hideModal(modalInterview);
        hideModal(modalAddStaff);
        hideModal(modalConfirm);
      });
    });

    // 2. Boutons Appeler Candidat (ouvre tel: et affiche toast)
    document.querySelectorAll('.btn-call-candidate').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetBtn = btn as HTMLElement;
        const name = targetBtn.dataset.name || 'Candidat';
        const phone = targetBtn.dataset.phone || '';
        if (phone) {
          window.location.href = `tel:${phone.replace(/[^0-9+]/g, '')}`;
        }
        (window as any).showAdminToast?.(`Appel vers ${name} (${phone}) initié…`);
      });
    });

    // 3. Planifier entretien
    let currentInterviewCandidate: any = null;

    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const yyyy = tomorrow.getFullYear();
    const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
    const dd = String(tomorrow.getDate()).padStart(2, '0');
    const interviewDateInput = document.getElementById('interview-date') as HTMLInputElement | null;
    if (interviewDateInput) {
      interviewDateInput.value = `${yyyy}-${mm}-${dd}`;
    }

    function updateInterviewPreview() {
      if (!currentInterviewCandidate) return;
      const name = currentInterviewCandidate.name;
      const date = interviewDateInput?.value || `${yyyy}-${mm}-${dd}`;
      const time = (document.getElementById('interview-time') as HTMLInputElement)?.value || '10:00';
      const format = (document.getElementById('interview-format') as HTMLSelectElement)?.value || 'visio';
      const formatLabel = format === 'visio' ? 'en visioconférence Google Meet' : (format === 'phone' ? 'par téléphone' : 'dans nos locaux à Montréal');

      const text = `Bonjour ${name}, suite à l'analyse de votre candidature chez Unilka, nous avons le plaisir de vous inviter à un entretien officiel le ${date} à ${time} (${formatLabel}). Merci de nous confirmer votre disponibilité. L'équipe RH Unilka.`;

      const previewEl = document.getElementById('interview-preview-text');
      if (previewEl) previewEl.textContent = text;

      const emailLink = document.getElementById('btn-email-interview') as HTMLAnchorElement | null;
      if (emailLink && currentInterviewCandidate.email) {
        const subject = encodeURIComponent("Invitation à un entretien d'embauche — Unilka");
        const body = encodeURIComponent(text);
        emailLink.href = `mailto:${currentInterviewCandidate.email}?subject=${subject}&body=${body}`;
      }
    }

    interviewDateInput?.addEventListener('input', updateInterviewPreview);
    document.getElementById('interview-time')?.addEventListener('input', updateInterviewPreview);
    document.getElementById('interview-format')?.addEventListener('change', updateInterviewPreview);

    document.querySelectorAll('.btn-schedule-interview').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetBtn = btn as HTMLElement;
        currentInterviewCandidate = {
          id: targetBtn.dataset.id,
          rawId: targetBtn.dataset.rawid,
          name: targetBtn.dataset.name,
          phone: targetBtn.dataset.phone,
          email: targetBtn.dataset.email,
          card: targetBtn.closest('.candidate-card')
        };

        const subEl = document.getElementById('interview-candidate-sub');
        if (subEl) subEl.textContent = `Candidat : ${currentInterviewCandidate.name} • ${currentInterviewCandidate.phone || currentInterviewCandidate.email}`;

        updateInterviewPreview();
        showModal(modalInterview);
      });
    });

    document.getElementById('close-interview-modal-btn')?.addEventListener('click', () => hideModal(modalInterview));
    document.getElementById('btn-cancel-interview')?.addEventListener('click', () => hideModal(modalInterview));

    document.getElementById('btn-copy-interview-sms')?.addEventListener('click', () => {
      const text = document.getElementById('interview-preview-text')?.textContent || '';
      navigator.clipboard?.writeText(text).then(() => {
        (window as any).showAdminToast?.("Modèle SMS copié dans le presse-papier !");
      });
    });

    document.getElementById('btn-confirm-interview-status')?.addEventListener('click', async () => {
      if (currentInterviewCandidate?.card) {
        const badge = currentInterviewCandidate.card.querySelector('.status-badge');
        if (badge) {
          badge.className = 'status-badge text-[10px] font-extrabold px-2.5 py-0.5 rounded-full border bg-blue-100 text-blue-800 border-blue-200';
          badge.textContent = 'Entrevue planifiée';
        }
      }

      if (currentInterviewCandidate?.rawId) {
        try {
          await updateDoc(doc(db, 'candidates', currentInterviewCandidate.rawId), {
            status: 'Entrevue planifiée',
            statusColor: 'bg-blue-100 text-blue-800 border-blue-200'
          });
        } catch (err) {
          console.warn('Erreur update statut Firestore :', err);
        }
      }

      hideModal(modalInterview);
      (window as any).showAdminToast?.(`Entrevue planifiée avec succès pour ${currentInterviewCandidate?.name} !`);
    });

    // 4. CONFIRMATION AUTOMATIQUE DU PRÉPOSÉ EN COLLABORATEUR ACTIF
    let activeCandidateToConfirm: any = null;

    document.querySelectorAll('.btn-confirm-collaborator').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetBtn = btn as HTMLElement;
        const card = targetBtn.closest('.candidate-card') as HTMLElement;
        
        const candidateId = targetBtn.dataset.id || '';
        const rawId = targetBtn.dataset.rawid || '';
        const name = targetBtn.dataset.name || '';
        const phone = targetBtn.dataset.phone || '';
        const email = targetBtn.dataset.email || '';
        const city = targetBtn.dataset.city || 'Montréal';
        const availability = targetBtn.dataset.availability || '';
        const experience = targetBtn.dataset.experience || '';
        const training = targetBtn.dataset.training || '';

        activeCandidateToConfirm = {
          candidateId,
          rawId,
          name,
          phone,
          email,
          city,
          availability,
          experience,
          training,
          card
        };

        // Déduction intelligente du rôle selon profil
        let role = "Préposé(e) certifié(e) résidentiel";
        const combined = `${experience} ${training}`.toLowerCase();
        if (combined.includes('commercial') || combined.includes('bureau')) {
          role = "Responsable entretien commercial";
        } else if (combined.includes('hôtel') || combined.includes('hôtellerie') || combined.includes('prestige') || combined.includes('omni')) {
          role = "Préposée senior d'hôtellerie";
        } else if (combined.includes('textile') || combined.includes('tapis') || combined.includes('spécialisé')) {
          role = "Technicien surfaces & textiles";
        }

        // Déduction du volume de missions hebdomadaires
        let missions = 8;
        if (availability.toLowerCase().includes('partiel')) {
          missions = 4;
        }

        // Génération du courriel d'équipe Unilka
        const nameParts = name.trim().split(' ').filter(Boolean);
        const firstName = nameParts[0] || 'collaborateur';
        const lastInitial = nameParts[1]?.[0] || 'u';
        const cleanFirst = firstName.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        const staffEmail = `${cleanFirst}.${lastInitial.toLowerCase()}@unilka.ca`;

        const nameInput = document.getElementById('confirm-staff-name') as HTMLInputElement | null;
        const roleSelect = document.getElementById('confirm-staff-role') as HTMLSelectElement | null;
        const phoneInput = document.getElementById('confirm-staff-phone') as HTMLInputElement | null;
        const emailInput = document.getElementById('confirm-staff-email') as HTMLInputElement | null;
        const sectorInput = document.getElementById('confirm-staff-sector') as HTMLInputElement | null;
        const missionsInput = document.getElementById('confirm-staff-missions') as HTMLInputElement | null;
        const displayName = document.getElementById('confirm-display-name');
        const displayCity = document.getElementById('confirm-display-city');

        if (nameInput) nameInput.value = name;
        if (roleSelect) roleSelect.value = role;
        if (phoneInput) phoneInput.value = phone || '(514) 555-0199';
        if (emailInput) emailInput.value = staffEmail;
        if (sectorInput) sectorInput.value = city;
        if (missionsInput) missionsInput.value = String(missions);
        if (displayName) displayName.textContent = name;
        if (displayCity) displayCity.textContent = city;

        showModal(modalConfirm);
      });
    });

    document.getElementById('close-confirm-modal-btn')?.addEventListener('click', () => hideModal(modalConfirm));
    document.getElementById('cancel-confirm-modal-btn')?.addEventListener('click', () => hideModal(modalConfirm));

    const formConfirm = document.getElementById('form-confirm-collaborator');
    formConfirm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('btn-submit-confirm-collaborator');
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Activation en cours…';
      }

      const name = (document.getElementById('confirm-staff-name') as HTMLInputElement)?.value.trim() || 'Collaborateur';
      const role = (document.getElementById('confirm-staff-role') as HTMLSelectElement)?.value || "Préposé(e) certifié(e)";
      const phone = (document.getElementById('confirm-staff-phone') as HTMLInputElement)?.value.trim() || '(514) 000-0000';
      const email = (document.getElementById('confirm-staff-email') as HTMLInputElement)?.value.trim() || 'equipe@unilka.ca';
      const sector = (document.getElementById('confirm-staff-sector') as HTMLInputElement)?.value.trim() || 'Montréal';
      const missions = parseInt((document.getElementById('confirm-staff-missions') as HTMLInputElement)?.value || '8');
      const check = (document.getElementById('confirm-staff-check') as HTMLSelectElement)?.value || 'Validé (Novembre 2026)';

      const parts = name.split(' ').filter(Boolean);
      const initials = (parts[0]?.[0] || 'U') + (parts[1]?.[0] || 'N');

      try {
        // 1. Ajouter dans la collection 'staff' de Firestore
        await addDoc(collection(db, 'staff'), {
          name,
          role,
          phone,
          email,
          sector,
          missionsPerWeek: missions,
          backgroundCheck: check,
          trainedDate: 'Novembre 2026',
          status: 'Actif',
          statusColor: 'bg-emerald-100 text-emerald-800',
          initials: initials.toUpperCase(),
          sourceCandidateId: activeCandidateToConfirm?.rawId || activeCandidateToConfirm?.candidateId || '',
          createdAt: new Date().toISOString()
        });

        // 2. Mettre à jour la candidature dans 'candidates' de Firestore
        if (activeCandidateToConfirm?.rawId) {
          try {
            await updateDoc(doc(db, 'candidates', activeCandidateToConfirm.rawId), {
              status: 'Collaborateur actif',
              statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-200',
              confirmedAt: new Date().toISOString()
            });
          } catch (updateErr) {
            console.warn('Erreur mise à jour statut candidat Firestore :', updateErr);
          }
        }

        // 3. Mettre à jour l'affichage de la carte candidat
        if (activeCandidateToConfirm?.card) {
          const badge = activeCandidateToConfirm.card.querySelector('.status-badge');
          if (badge) {
            badge.className = 'status-badge text-[10px] font-extrabold px-2.5 py-0.5 rounded-full border bg-emerald-100 text-emerald-800 border-emerald-200';
            badge.textContent = 'Collaborateur actif';
          }
          const confirmBtn = activeCandidateToConfirm.card.querySelector('.btn-confirm-collaborator');
          if (confirmBtn) {
            confirmBtn.outerHTML = `
              <div class="w-full py-2 px-3 rounded-full bg-emerald-50 border border-emerald-300 text-emerald-800 font-extrabold text-xs text-center flex items-center justify-center gap-1.5 shadow-2xs">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Collaborateur actif</span>
              </div>
            `;
          }
        }

        // 4. Insérer visuellement dans la table d'équipe active
        const tbody = document.getElementById('staff-table-body');
        if (tbody) {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[#F5FAFA]/60 transition-colors staff-row bg-emerald-50/40 ring-1 ring-emerald-300';
          tr.innerHTML = `
            <td class="py-4 px-4">
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-full bg-[#E3F4F5] text-[#0E7C86] font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs">
                  ${initials.toUpperCase()}
                </span>
                <div>
                  <span class="font-extrabold text-[#0B2A2E] block text-[13px]">${name}</span>
                  <span class="text-[#3D5A5E] block">${phone}</span>
                </div>
              </div>
            </td>
            <td class="py-4 px-4 font-semibold text-[#0B2A2E]">
              ${role}
            </td>
            <td class="py-4 px-4 text-[#3D5A5E]">
              ${sector}
            </td>
            <td class="py-4 px-4 font-bold text-[#0B2A2E]">
              ${missions} missions
            </td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <span>${check}</span>
              </span>
            </td>
            <td class="py-4 px-4 text-[#3D5A5E]">
              Novembre 2026
            </td>
            <td class="py-4 px-4">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                Actif
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a
                href="/admin/planning/"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold text-[#0E7C86] hover:bg-[#E3F4F5] transition-colors no-underline cursor-pointer"
              >
                <span>Planning préposé</span>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </td>
          `;
          tbody.insertBefore(tr, tbody.firstChild);
        }

        // Mettre à jour le badge de compteur
        const staffCountBadge = document.getElementById('active-staff-count-badge');
        if (staffCountBadge) {
          const currentCount = parseInt(staffCountBadge.textContent || '0');
          staffCountBadge.textContent = String(currentCount + 1);
        }

        hideModal(modalConfirm);

        if ((window as any).showAdminToast) {
          (window as any).showAdminToast(`Félicitations ! ${name} est désormais collaborateur actif de l'équipe Unilka.`);
        }
      } catch (err) {
        console.error('Erreur confirmation collaborateur :', err);
        alert("Erreur lors de l'activation du collaborateur. Veuillez réessayer.");
      } finally {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = 'Valider et activer le collaborateur en 1 clic';
        }
      }
    });

    // 5. AJOUT MANUEL D'UN PRÉPOSÉ VIA BOUTON EN-TÊTE
    const btnOpenAddStaff = document.getElementById('btn-open-add-staff');
    const closeStaffModalBtn = document.getElementById('close-staff-modal-btn');
    const cancelStaffBtn = document.getElementById('cancel-staff-btn');
    const formAddStaff = document.getElementById('form-add-staff');

    btnOpenAddStaff?.addEventListener('click', () => {
      (formAddStaff as HTMLFormElement)?.reset();
      showModal(modalAddStaff);
    });

    closeStaffModalBtn?.addEventListener('click', () => hideModal(modalAddStaff));
    cancelStaffBtn?.addEventListener('click', () => hideModal(modalAddStaff));

    formAddStaff?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = formAddStaff.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Enregistrement…';
      }

      const name = (document.getElementById('new-staff-name') as HTMLInputElement)?.value.trim() || 'Collaborateur';
      const role = (document.getElementById('new-staff-role') as HTMLSelectElement)?.value || 'Préposée certifiée';
      const phone = (document.getElementById('new-staff-phone') as HTMLInputElement)?.value.trim() || '(514) 000-0000';
      const email = (document.getElementById('new-staff-email') as HTMLInputElement)?.value.trim() || 'equipe@unilka.ca';
      const sector = (document.getElementById('new-staff-sector') as HTMLInputElement)?.value.trim() || 'Montréal';
      const missions = parseInt((document.getElementById('new-staff-missions') as HTMLInputElement)?.value || '7');
      const check = (document.getElementById('new-staff-check') as HTMLSelectElement)?.value || 'Validé';

      const parts = name.split(' ').filter(Boolean);
      const initials = (parts[0]?.[0] || 'U') + (parts[1]?.[0] || 'N');

      try {
        await addDoc(collection(db, 'staff'), {
          name,
          role,
          phone,
          email,
          sector,
          missionsPerWeek: missions,
          backgroundCheck: check,
          trainedDate: 'Novembre 2026',
          status: 'Actif',
          statusColor: 'bg-emerald-100 text-emerald-800',
          initials: initials.toUpperCase(),
          createdAt: new Date().toISOString()
        });

        const tbody = document.getElementById('staff-table-body');
        if (tbody) {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[#F5FAFA]/60 transition-colors staff-row bg-emerald-50/20';
          tr.innerHTML = `
            <td class="py-4 px-4">
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-full bg-[#E3F4F5] text-[#0E7C86] font-bold text-xs flex items-center justify-center shrink-0">
                  ${initials.toUpperCase()}
                </span>
                <div>
                  <span class="font-extrabold text-[#0B2A2E] block text-[13px]">${name}</span>
                  <span class="text-[#3D5A5E] block">${phone}</span>
                </div>
              </div>
            </td>
            <td class="py-4 px-4 font-semibold text-[#0B2A2E]">
              ${role}
            </td>
            <td class="py-4 px-4 text-[#3D5A5E]">
              ${sector}
            </td>
            <td class="py-4 px-4 font-bold text-[#0B2A2E]">
              ${missions} missions
            </td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                <svg class="w-3.5 h-3.5 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <span>${check}</span>
              </span>
            </td>
            <td class="py-4 px-4 text-[#3D5A5E]">
              Novembre 2026
            </td>
            <td class="py-4 px-4">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                Actif
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a
                href="/admin/planning/"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold text-[#0E7C86] hover:bg-[#E3F4F5] transition-colors no-underline cursor-pointer"
              >
                <span>Planning préposé</span>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </td>
          `;
          tbody.insertBefore(tr, tbody.firstChild);
        }

        const staffCountBadge = document.getElementById('active-staff-count-badge');
        if (staffCountBadge) {
          const currentCount = parseInt(staffCountBadge.textContent || '0');
          staffCountBadge.textContent = String(currentCount + 1);
        }

        hideModal(modalAddStaff);
        (window as any).showAdminToast?.(`Collaborateur ${name} ajouté avec succès !`);
      } catch (err) {
        console.error('Erreur ajout collaborateur :', err);
        alert("Erreur lors de l'enregistrement. Veuillez réessayer.");
      } finally {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = 'Enregistrer le préposé';
        }
      }
    });
  </script>

</AdminLayout>
