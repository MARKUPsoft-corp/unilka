---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import AdminCharts from '../../components/admin/AdminCharts.astro';

const invoices = [
  {
    id: "FAC-2026-118",
    quoteId: "SOU-1035",
    client: "Alexandre Tremblay",
    service: "Grand ménage résidentiel",
    date: "27 oct. 2026",
    grossAmount: "345,00 $",
    stripeFee: "10,31 $",
    netAmount: "334,69 $",
    method: "Stripe (Visa •••• 4242)",
    status: "Payé",
    statusColor: "bg-emerald-100 text-emerald-800 border-emerald-200"
  },
  {
    id: "FAC-2026-117",
    quoteId: "SOU-1034",
    client: "Cabinet Dentaire Saint-Laurent",
    service: "Entretien commercial bimensuel",
    date: "25 oct. 2026",
    grossAmount: "480,00 $",
    stripeFee: "14,22 $",
    netAmount: "465,78 $",
    method: "Stripe (Mastercard •••• 8812)",
    status: "Payé",
    statusColor: "bg-emerald-100 text-emerald-800 border-emerald-200"
  },
  {
    id: "FAC-2026-116",
    quoteId: "SOU-1032",
    client: "Mme Claire Vachon",
    service: "Forfait résidentiel hebdomadaire",
    date: "24 oct. 2026",
    grossAmount: "220,00 $",
    stripeFee: "0,00 $",
    netAmount: "220,00 $",
    method: "Virement Interac",
    status: "Payé",
    statusColor: "bg-emerald-100 text-emerald-800 border-emerald-200"
  },
  {
    id: "FAC-2026-115",
    quoteId: "SOU-1031",
    client: "Marc-Antoine Roy",
    service: "Nettoyage spécialisé (Canapé & tapis)",
    date: "24 oct. 2026",
    grossAmount: "280,00 $",
    stripeFee: "8,42 $",
    netAmount: "271,58 $",
    method: "Lien de paiement Stripe",
    status: "En attente",
    statusColor: "bg-amber-100 text-amber-900 border-amber-200"
  },
  {
    id: "FAC-2026-114",
    quoteId: "SOU-1029",
    client: "Agence Numérique Pixel Inc.",
    service: "Entretien mensuel bureaux",
    date: "20 oct. 2026",
    grossAmount: "440,00 $",
    stripeFee: "13,06 $",
    netAmount: "426,94 $",
    method: "Stripe (Amex •••• 1009)",
    status: "Payé",
    statusColor: "bg-emerald-100 text-emerald-800 border-emerald-200"
  }
];
---

<AdminLayout title="Facturation & Stripe" activeNav="facturation">

  <!-- 1. EN-TÊTE -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
        <span>Paiements & Encaissements</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight">
        Facturation, Devis & Stripe
      </h1>
      <p class="text-xs sm:text-sm text-[#3D5A5E]">
        Suivi des règlements par carte de crédit, virements bancaires et commissions de traitement Stripe.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://dashboard.stripe.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-bold text-[#0B2A2E] bg-white hover:bg-[#F5FAFA] border border-[#0E7C86]/20 shadow-2xs transition-colors no-underline"
      >
        <span>Tableau de bord Stripe</span>
        <AdminIcon name="external" class="w-3.5 h-3.5 text-[#0E7C86]" />
      </a>
      <button
        type="button"
        id="btn-open-payment-modal"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-colors"
      >
        <span>+ Créer un lien de paiement</span>
      </button>
    </div>
  </div>

  <!-- 2. CARTES FINANCIÈRES (4 KPIs) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <div class="p-6 rounded-2xl bg-white border border-[#0E7C86]/12 shadow-2xs space-y-2">
      <span class="text-xs font-extrabold uppercase tracking-wider text-[#0E7C86]">Encaissé ce mois</span>
      <span class="text-3xl font-black text-[#0B2A2E] tracking-tight block">16 420,00 $</span>
      <p class="text-[11px] text-[#3D5A5E]">+18% par rapport au mois précédent</p>
    </div>

    <div class="p-6 rounded-2xl bg-white border border-[#0E7C86]/12 shadow-2xs space-y-2">
      <span class="text-xs font-extrabold uppercase tracking-wider text-amber-600">En attente</span>
      <span class="text-3xl font-black text-[#0B2A2E] tracking-tight block">1 280,00 $</span>
      <p class="text-[11px] text-[#3D5A5E]">3 devis transmis à relancer</p>
    </div>

    <div class="p-6 rounded-2xl bg-white border border-[#0E7C86]/12 shadow-2xs space-y-2">
      <span class="text-xs font-extrabold uppercase tracking-wider text-[#0E7C86]">Commissions Stripe</span>
      <span class="text-3xl font-black text-[#0B2A2E] tracking-tight block">432,60 $</span>
      <p class="text-[11px] text-[#3D5A5E]">Tarif standard Stripe Canada (2,9% + 0,30$)</p>
    </div>

    <div class="p-6 rounded-2xl bg-white border border-[#0E7C86]/12 shadow-2xs space-y-2">
      <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-600">Net Encaissé</span>
      <span class="text-3xl font-black text-emerald-700 tracking-tight block">15 987,40 $</span>
      <p class="text-[11px] text-[#3D5A5E]">Versements directs sur compte bancaire</p>
    </div>

  </div>

  <!-- 3. VISUALISATION FINANCIÈRE STRIPE CANADA -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    <!-- Graphique Décomposition Frais Stripe vs Net (8 cols) -->
    <div class="lg:col-span-8 bg-white rounded-2xl border border-[#0E7C86]/12 p-6 shadow-2xs">
      <AdminCharts type="stripe-breakdown" />
    </div>

    <!-- Passerelle Stripe Canada (4 cols) -->
    <div class="lg:col-span-4 p-6 rounded-2xl bg-[#E3F4F5]/60 border border-[#0E7C86]/20 flex flex-col justify-between space-y-4 shadow-2xs">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <h3 class="text-sm font-extrabold text-[#0B2A2E]">
            Passerelle Stripe Connectée
          </h3>
        </div>
        <p class="text-xs text-[#3D5A5E] leading-relaxed">
          Prélèvements automatisés pour forfaits réguliers et liens de paiement instantanés (Apple Pay, Visa, Mastercard, Interac).
        </p>
      </div>

      <div class="space-y-3 pt-2 border-t border-[#0E7C86]/15">
        <div class="flex items-center justify-between text-xs">
          <span class="text-[#3D5A5E]">Identifiant marchand :</span>
          <span class="font-mono bg-white px-2.5 py-1 rounded-lg border border-[#0E7C86]/20 text-[#0E7C86] font-bold">
            acct_1QunilkaCA
          </span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-[#3D5A5E]">Délai virement :</span>
          <span class="font-bold text-[#0B2A2E]">2 jours ouvrables</span>
        </div>
        <a
          href="https://dashboard.stripe.com/settings"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full transition-colors no-underline"
        >
          <span>Paramètres Stripe Canada</span>
          <AdminIcon name="external" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </div>

  <!-- 4. TABLEAU DES TRANSACTIONS & FACTURES -->
  <div class="bg-white rounded-2xl border border-[#0E7C86]/12 overflow-hidden shadow-2xs">
    <div class="p-5 sm:p-6 border-b border-[#0E7C86]/10 flex items-center justify-between">
      <h2 class="text-base font-extrabold text-[#0B2A2E]">
        Historique des factures et encaissements récents
      </h2>
      <span class="text-xs text-[#3D5A5E]">
        Devises : Dollar Canadien ($ CAD)
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-[#F5FAFA] border-b border-[#0E7C86]/12 text-[#3D5A5E] font-extrabold uppercase tracking-wider text-[10px]">
            <th class="py-3.5 px-4">N° Facture</th>
            <th class="py-3.5 px-4">Client</th>
            <th class="py-3.5 px-4">Prestation</th>
            <th class="py-3.5 px-4">Date</th>
            <th class="py-3.5 px-4">Montant Brut</th>
            <th class="py-3.5 px-4">Frais Stripe</th>
            <th class="py-3.5 px-4">Net Unilka</th>
            <th class="py-3.5 px-4">Méthode</th>
            <th class="py-3.5 px-4">Statut</th>
            <th class="py-3.5 px-4 text-right">Reçu</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#0E7C86]/08">
          {invoices.map((inv) => (
            <tr class="hover:bg-[#F5FAFA]/60 transition-colors">
              <td class="py-4 px-4 font-mono font-bold text-[#0E7C86]">
                {inv.id}
              </td>
              <td class="py-4 px-4 font-extrabold text-[#0B2A2E]">
                {inv.client}
              </td>
              <td class="py-4 px-4 text-[#3D5A5E]">
                {inv.service}
              </td>
              <td class="py-4 px-4 text-[#3D5A5E]">
                {inv.date}
              </td>
              <td class="py-4 px-4 font-black text-[#0B2A2E]">
                {inv.grossAmount}
              </td>
              <td class="py-4 px-4 text-[#3D5A5E]">
                {inv.stripeFee}
              </td>
              <td class="py-4 px-4 font-bold text-emerald-700">
                {inv.netAmount}
              </td>
              <td class="py-4 px-4 text-[#3D5A5E]">
                {inv.method}
              </td>
              <td class="py-4 px-4">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${inv.statusColor}`}>
                  {inv.status}
                </span>
              </td>
              <td class="py-4 px-4 text-right">
                <button
                  type="button"
                  class="btn-pdf-receipt inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[#0E7C86] hover:bg-[#E3F4F5] font-bold transition-colors cursor-pointer"
                  data-id={inv.id}
                  data-quote={inv.quoteId}
                  data-client={inv.client}
                  data-service={inv.service}
                  data-date={inv.date}
                  data-gross={inv.grossAmount}
                  data-fee={inv.stripeFee}
                  data-net={inv.netAmount}
                  data-method={inv.method}
                  data-status={inv.status}
                >
                  <span>PDF</span>
                  <AdminIcon name="download" class="w-3.5 h-3.5" />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5. MODAL DE CRÉATION DE LIEN DE PAIEMENT STRIPE -->
  <div
    id="payment-modal-backdrop"
    class="fixed inset-0 bg-[#0B2A2E]/60 backdrop-blur-sm z-[80] hidden transition-opacity duration-200"
  ></div>

  <div
    id="payment-modal"
    class="fixed inset-0 z-[80] flex items-center justify-center p-4 hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-payment-title"
  >
    <div class="bg-white rounded-3xl border border-[#0E7C86]/20 shadow-2xl max-w-lg w-full overflow-hidden transform transition-all duration-200 scale-95 opacity-0 modal-card">
      <div class="p-6 border-b border-[#0E7C86]/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center">
            <AdminIcon name="credit-card" class="w-4 h-4 text-[#0E7C86]" />
          </span>
          <h2 id="modal-payment-title" class="text-base font-extrabold text-[#0B2A2E]">
            Générer un lien de paiement Stripe
          </h2>
        </div>
        <button
          type="button"
          id="close-payment-modal-btn"
          class="p-1.5 rounded-lg text-[#3D5A5E] hover:text-[#0E7C86] hover:bg-[#F5FAFA]"
          aria-label="Fermer la boîte de dialogue"
        >
          <AdminIcon name="close" class="w-4 h-4" />
        </button>
      </div>

      <div class="p-6 space-y-4 text-xs">
        <div class="space-y-1">
          <label class="font-bold text-[#0B2A2E]">Nom du client</label>
          <input
            type="text"
            id="modal-client-name"
            placeholder="ex: Alexandre Tremblay"
            value="Alexandre Tremblay"
            class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium"
          />
        </div>

        <div class="space-y-1">
          <label class="font-bold text-[#0B2A2E]">Courriel pour l'envoi du reçu</label>
          <input
            type="email"
            id="modal-client-email"
            placeholder="client@domaine.ca"
            value="a.tremblay@email.ca"
            class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium"
          />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Montant brut ($ CAD)</label>
            <input
              type="number"
              id="modal-amount"
              value="345.00"
              step="5"
              min="10"
              class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-extrabold text-sm"
            />
          </div>
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Type de facture</label>
            <select class="w-full px-3 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium">
              <option>Paiement unique</option>
              <option>Abonnement récurrent mensuel</option>
              <option>Acompte de confirmation (50%)</option>
            </select>
          </div>
        </div>

        <!-- Simulation Frais Stripe Canada -->
        <div class="p-4 rounded-2xl bg-[#E3F4F5]/60 border border-[#0E7C86]/15 space-y-2 text-[11px]">
          <div class="flex justify-between text-[#3D5A5E]">
            <span>Frais Stripe Canada (2.9% + 0.30 $ CAD) :</span>
            <span id="modal-stripe-fee" class="font-bold text-[#0B2A2E]">10,31 $ CAD</span>
          </div>
          <div class="pt-1 border-t border-[#0E7C86]/15 flex justify-between font-bold text-xs text-emerald-800">
            <span>Versement net sur compte Unilka :</span>
            <span id="modal-net-amount" class="text-sm font-black">334,69 $ CAD</span>
          </div>
        </div>
      </div>

      <div class="p-6 bg-[#F5FAFA] border-t border-[#0E7C86]/10 flex items-center justify-between">
        <button
          type="button"
          id="btn-cancel-modal"
          class="text-xs font-bold text-[#3D5A5E] hover:text-[#0B2A2E]"
        >
          Annuler
        </button>
        <button
          type="button"
          id="btn-confirm-stripe-link"
          class="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-all"
        >
          Copier le lien & Activer
        </button>
      </div>
    </div>
  </div>

  <!-- 6. MODAL REÇU OFFICIEL PDF & FACTURE IMPRIMABLE -->
  <div
    id="modal-invoice-receipt"
    class="fixed inset-0 z-[80] hidden items-center justify-center p-3 sm:p-5"
    role="dialog"
    aria-modal="true"
    aria-labelledby="receipt-title"
  >
    <div class="fixed inset-0 bg-[#0B2A2E]/60 backdrop-blur-sm -z-10 modal-receipt-backdrop"></div>
    <div class="bg-white rounded-3xl border border-[#0E7C86]/20 shadow-2xl max-w-2xl w-full max-h-[92vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-200 modal-card printable-receipt">
      
      <!-- En-tête Facture / Reçu -->
      <div class="p-6 border-b border-[#0E7C86]/10 flex items-start justify-between bg-gradient-to-r from-[#E3F4F5]/60 to-white">
        <div class="flex items-center gap-3">
          <img
            src="/images/logo-unilka-transparent.png"
            alt="Unilka Logo"
            class="h-10 w-auto object-contain"
          />
          <div>
            <h2 id="receipt-title" class="text-base font-extrabold text-[#0B2A2E]">
              Reçu Officiel & Facture de Paiement
            </h2>
            <p class="text-[11px] text-[#3D5A5E]">
              Unilka Inc. • NEQ : 1178942301 • Grand Montréal, QC
            </p>
          </div>
        </div>
        <button
          type="button"
          id="close-receipt-modal-btn"
          class="p-2 rounded-xl text-[#3D5A5E] hover:text-[#0B2A2E] hover:bg-white/80 transition-colors cursor-pointer"
          aria-label="Fermer"
        >
          <AdminIcon name="close" class="w-4 h-4" />
        </button>
      </div>

      <!-- Corps du reçu -->
      <div class="p-6 overflow-y-auto space-y-6 text-xs text-[#0B2A2E]">
        
        <!-- Métadonnées transaction -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/10 text-xs">
          <div>
            <span class="text-[10px] font-bold text-[#3D5A5E] uppercase block">N° Facture</span>
            <span id="receipt-inv-id" class="font-mono font-extrabold text-[#0E7C86]">FAC-2026-118</span>
          </div>
          <div>
            <span class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Devis Source</span>
            <span id="receipt-quote-id" class="font-mono font-bold text-[#0B2A2E]">SOU-1035</span>
          </div>
          <div>
            <span class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Date règlement</span>
            <span id="receipt-date" class="font-medium">27 oct. 2026</span>
          </div>
          <div>
            <span class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Statut</span>
            <span class="inline-flex items-center gap-1 font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-[10px]">
              <AdminIcon name="shield-check" class="w-3 h-3 text-emerald-700" />
              <span id="receipt-status">Payé</span>
            </span>
          </div>
        </div>

        <!-- Informations Client & Entreprise -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs">
          <div class="p-4 rounded-xl border border-[#0E7C86]/12 space-y-1">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#0E7C86] block">Émetteur du service</span>
            <strong class="block text-[#0B2A2E]">UNILKA INC.</strong>
            <p class="text-[#3D5A5E]">Services d'entretien hôtelier & commercial</p>
            <p class="text-[#3D5A5E]">Montréal (Québec), Canada</p>
            <p class="text-[#3D5A5E] font-mono text-[11px]">TPS : 789456123 RT0001 • TVQ : 1234567890 TQ0001</p>
          </div>

          <div class="p-4 rounded-xl border border-[#0E7C86]/12 space-y-1">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#0E7C86] block">Facturé à</span>
            <strong id="receipt-client-name" class="block text-[#0B2A2E] text-sm">Alexandre Tremblay</strong>
            <p class="text-[#3D5A5E]">Client résidentiel régulier</p>
            <p class="text-[#3D5A5E]" id="receipt-payment-method">Stripe (Visa •••• 4242)</p>
            <p class="text-emerald-700 font-semibold text-[11px]">Transaction sécurisée certifiée PCI-DSS</p>
          </div>
        </div>

        <!-- Tableau des lignes de facturation -->
        <div class="rounded-xl border border-[#0E7C86]/12 overflow-hidden">
          <table class="w-full text-left text-xs">
            <thead class="bg-[#F5FAFA] border-b border-[#0E7C86]/10 text-[10px] font-bold text-[#3D5A5E] uppercase">
              <tr>
                <th class="p-3">Désignation de la prestation</th>
                <th class="p-3 text-right">Qté</th>
                <th class="p-3 text-right">Montant Hors Taxes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#0E7C86]/08">
              <tr>
                <td class="p-3 font-semibold" id="receipt-service-name">Grand ménage résidentiel approfondi</td>
                <td class="p-3 text-right font-mono">1</td>
                <td class="p-3 text-right font-bold" id="receipt-subtotal">300,00 $ CAD</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Décomposition Fiscale & Totaux (Loi fiscale Québec) -->
        <div class="flex justify-end">
          <div class="w-full sm:w-72 space-y-2 text-xs">
            <div class="flex justify-between text-[#3D5A5E]">
              <span>Sous-total HT :</span>
              <span id="receipt-subtotal-val" class="font-bold">300,00 $</span>
            </div>
            <div class="flex justify-between text-[#3D5A5E]">
              <span>TPS (5.000%) :</span>
              <span id="receipt-tps-val">15,00 $</span>
            </div>
            <div class="flex justify-between text-[#3D5A5E]">
              <span>TVQ (9.975%) :</span>
              <span id="receipt-tvq-val">29,93 $</span>
            </div>
            <div class="pt-2 border-t border-[#0E7C86]/20 flex justify-between font-black text-sm text-[#0B2A2E]">
              <span>Total payé ($ CAD) :</span>
              <span id="receipt-total-val" class="text-base text-[#0E7C86]">345,00 $</span>
            </div>
            <div class="pt-1 text-[10px] text-[#3D5A5E] text-right italic">
              Dont commissions Stripe : <span id="receipt-fee-val">10,31 $</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Actions impression & partage -->
      <div id="receipt-actions-bar" class="p-5 bg-[#F5FAFA] border-t border-[#0E7C86]/10 flex items-center justify-between">
        <button
          type="button"
          id="btn-close-receipt"
          class="text-xs font-bold text-[#3D5A5E] hover:text-[#0B2A2E] cursor-pointer"
        >
          Fermer
        </button>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-print-receipt"
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-all cursor-pointer"
          >
            <AdminIcon name="download" class="w-3.5 h-3.5" />
            <span>Imprimer / Télécharger en PDF</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <style>
    @media print {
      body * {
        visibility: hidden !important;
      }
      #modal-invoice-receipt, #modal-invoice-receipt * {
        visibility: visible !important;
      }
      #modal-invoice-receipt {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: white !important;
        padding: 0 !important;
        margin: 0 !important;
        z-index: 99999 !important;
        display: block !important;
      }
      .modal-receipt-backdrop, #receipt-actions-bar, #close-receipt-modal-btn {
        display: none !important;
      }
      .modal-card {
        box-shadow: none !important;
        border: none !important;
        max-width: 100% !important;
        width: 100% !important;
        transform: none !important;
      }
    }
  </style>

  <script is:inline>
    // 1. Modal Stripe Link
    const modalBackdrop = document.getElementById('payment-modal-backdrop');
    const modal = document.getElementById('payment-modal');
    const modalCard = modal?.querySelector('.modal-card');
    const openBtn = document.getElementById('btn-open-payment-modal');
    const closeBtn = document.getElementById('close-payment-modal-btn');
    const cancelBtn = document.getElementById('btn-cancel-modal');
    const confirmBtn = document.getElementById('btn-confirm-stripe-link');
    const amountInput = document.getElementById('modal-amount');
    const feeEl = document.getElementById('modal-stripe-fee');
    const netEl = document.getElementById('modal-net-amount');

    // 2. Modal Reçu PDF
    const modalReceipt = document.getElementById('modal-invoice-receipt');
    const closeReceiptBtn = document.getElementById('close-receipt-modal-btn');
    const btnCloseReceipt = document.getElementById('btn-close-receipt');
    const btnPrintReceipt = document.getElementById('btn-print-receipt');
    const receiptBackdrop = document.querySelector('.modal-receipt-backdrop');

    // Téléportation vers document.body
    function teleport(el) {
      if (el && el.parentElement !== document.body) {
        document.body.appendChild(el);
      }
    }
    teleport(modalBackdrop);
    teleport(modal);
    teleport(modalReceipt);

    function calculateStripeFee() {
      const gross = parseFloat(amountInput?.value || 0);
      const fee = (gross * 0.029) + 0.30;
      const net = Math.max(0, gross - fee);

      if (feeEl) feeEl.textContent = `${fee.toFixed(2).replace('.', ',')} $ CAD`;
      if (netEl) netEl.textContent = `${net.toFixed(2).replace('.', ',')} $ CAD`;
    }

    amountInput?.addEventListener('input', calculateStripeFee);

    function openModal() {
      if (!modal || !modalBackdrop || !modalCard) return;
      teleport(modalBackdrop);
      teleport(modal);
      calculateStripeFee();
      modal.classList.remove('hidden');
      modalBackdrop.classList.remove('hidden');
      setTimeout(() => {
        modalCard.classList.remove('scale-95', 'opacity-0');
        modalCard.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function closeModal() {
      if (!modal || !modalBackdrop || !modalCard) return;
      modalCard.classList.remove('scale-100', 'opacity-100');
      modalCard.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        modalBackdrop.classList.add('hidden');
      }, 200);
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    modalBackdrop?.addEventListener('click', closeModal);

    confirmBtn?.addEventListener('click', () => {
      const client = document.getElementById('modal-client-name')?.value || 'Client';
      const gross = document.getElementById('modal-amount')?.value || '345.00';
      const link = `https://buy.stripe.com/live_unilka_${Date.now()}`;

      navigator.clipboard?.writeText(link).then(() => {
        if (window.showAdminToast) {
          window.showAdminToast(`Lien Stripe de ${gross} $ CAD copié pour ${client} !`);
        }
      }).catch(() => {
        if (window.showAdminToast) {
          window.showAdminToast(`Lien Stripe généré : ${link}`);
        }
      });

      closeModal();
    });

    // 3. Gestionnaire Reçu Officiel PDF
    function openReceiptModal(data) {
      if (!modalReceipt) return;
      teleport(modalReceipt);

      // Remplissage des champs
      const invIdEl = document.getElementById('receipt-inv-id');
      const quoteIdEl = document.getElementById('receipt-quote-id');
      const dateEl = document.getElementById('receipt-date');
      const statusEl = document.getElementById('receipt-status');
      const clientNameEl = document.getElementById('receipt-client-name');
      const methodEl = document.getElementById('receipt-payment-method');
      const serviceEl = document.getElementById('receipt-service-name');
      const subtotalEl = document.getElementById('receipt-subtotal');
      const subtotalValEl = document.getElementById('receipt-subtotal-val');
      const tpsValEl = document.getElementById('receipt-tps-val');
      const tvqValEl = document.getElementById('receipt-tvq-val');
      const totalValEl = document.getElementById('receipt-total-val');
      const feeValEl = document.getElementById('receipt-fee-val');

      if (invIdEl) invIdEl.textContent = data.id || 'FAC-2026';
      if (quoteIdEl) quoteIdEl.textContent = data.quote || 'SOU-1035';
      if (dateEl) dateEl.textContent = data.date || '27 oct. 2026';
      if (statusEl) statusEl.textContent = data.status || 'Payé';
      if (clientNameEl) clientNameEl.textContent = data.client || 'Client Unilka';
      if (methodEl) methodEl.textContent = data.method || 'Carte de crédit';
      if (serviceEl) serviceEl.textContent = data.service || 'Service de nettoyage';

      // Calcul des montants avec taxes QC
      const grossNum = parseFloat((data.gross || '345,00').replace(/[^0-9.,]/g, '').replace(',', '.')) || 345.00;
      // Total = HT * (1 + 0.05 + 0.09975) = HT * 1.14975
      const htNum = grossNum / 1.14975;
      const tpsNum = htNum * 0.05;
      const tvqNum = htNum * 0.09975;

      const fmt = (n) => `${n.toFixed(2).replace('.', ',')} $ CAD`;
      if (subtotalEl) subtotalEl.textContent = fmt(htNum);
      if (subtotalValEl) subtotalValEl.textContent = fmt(htNum);
      if (tpsValEl) tpsValEl.textContent = fmt(tpsNum);
      if (tvqValEl) tvqValEl.textContent = fmt(tvqNum);
      if (totalValEl) totalValEl.textContent = fmt(grossNum);
      if (feeValEl) feeValEl.textContent = data.fee || '10,31 $ CAD';

      modalReceipt.classList.remove('hidden');
      modalReceipt.classList.add('flex');
      document.body.style.overflow = 'hidden';
      const card = modalReceipt.querySelector('.modal-card');
      setTimeout(() => {
        card?.classList.remove('scale-95', 'opacity-0');
        card?.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function closeReceiptModal() {
      if (!modalReceipt) return;
      const card = modalReceipt.querySelector('.modal-card');
      card?.classList.remove('scale-100', 'opacity-100');
      card?.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modalReceipt.classList.remove('flex');
        modalReceipt.classList.add('hidden');
        document.body.style.overflow = '';
      }, 180);
    }

    document.querySelectorAll('.btn-pdf-receipt').forEach((btn) => {
      btn.addEventListener('click', () => {
        const data = {
          id: btn.dataset.id,
          quote: btn.dataset.quote,
          client: btn.dataset.client,
          service: btn.dataset.service,
          date: btn.dataset.date,
          gross: btn.dataset.gross,
          fee: btn.dataset.fee,
          net: btn.dataset.net,
          method: btn.dataset.method,
          status: btn.dataset.status
        };
        openReceiptModal(data);
      });
    });

    closeReceiptBtn?.addEventListener('click', closeReceiptModal);
    btnCloseReceipt?.addEventListener('click', closeReceiptModal);
    receiptBackdrop?.addEventListener('click', closeReceiptModal);

    btnPrintReceipt?.addEventListener('click', () => {
      window.print();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal();
        closeReceiptModal();
      }
    });
  </script>

</AdminLayout>
