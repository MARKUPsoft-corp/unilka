            <button
              type="button"
              class="btn-plan-for-day px-4 py-2 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62]"
            >
              + Planifier une intervention
            </button>
          </div>
        `;
        weekMissionsContainer.querySelector('.btn-plan-for-day')?.addEventListener('click', () => {
          openNewMissionModal(targetFullDate);
        });
        return;
      }

      dayMissions.forEach((mis, index) => {
        const card = document.createElement('div');
        card.className = "bg-white rounded-2xl border border-[#0E7C86]/12 p-6 shadow-2xs hover:border-[#0E7C86]/30 transition-all space-y-4";
        card.style.animation = `fadeIn 250ms ease-out ${index * 60}ms forwards`;

        card.innerHTML = `
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#0E7C86]/10">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md bg-[#E3F4F5] text-[#0E7C86] text-xs font-black">
                ${mis.time || '09:00 — 12:00'}
              </span>
              <span class="text-xs font-bold text-[#3D5A5E]">${mis.day || formatFrenchDate(mis.date)}</span>
              <span class="text-xs font-mono text-[#3D5A5E]/60">#${mis.code || mis.id}</span>
            </div>

            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold border ${mis.statusColor || getStatusColor(mis.status)}">
                ${mis.status}
              </span>
              <span class="text-[11px] font-semibold text-[#0E7C86] bg-[#F5FAFA] px-2 py-0.5 rounded">
                ${mis.checklist || '42 points'}
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="space-y-1">
              <h3 class="text-sm font-extrabold text-[#0B2A2E]">${mis.client}</h3>
              <p class="text-[#3D5A5E] flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#0E7C86] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>${mis.address}</span>
              </p>
              <p class="text-[#0E7C86] font-semibold">Prestation : ${mis.service}</p>
            </div>

            <div class="space-y-1 sm:border-l sm:border-[#0E7C86]/10 sm:pl-4">
              <div class="flex items-center gap-2.5">
                ${mis.staffPhoto ? `
                  <img src="${mis.staffPhoto}" alt="${mis.staff}" class="w-8 h-8 rounded-full object-cover border border-[#0E7C86]/20 shrink-0" />
                ` : `
                  <span class="w-8 h-8 rounded-full bg-[#E3F4F5] text-[#0E7C86] font-bold text-[10px] flex items-center justify-center shrink-0">
                    ${(mis.staff || 'Staff').split(' ').map((n: string)=>n[0]).join('')}
                  </span>
                `}
                <div>
                  <p class="text-[#3D5A5E]">
                    Préposé(e) : <strong class="text-[#0B2A2E]">${mis.staff}</strong>
                  </p>
                  <p class="text-[#3D5A5E] text-[11px]">${mis.staffRole || 'Préposé(e) dédié(e)'}</p>
                </div>
              </div>

              <div class="pt-1">
                <span class="inline-flex items-center gap-1.5 text-amber-800 bg-amber-50 px-2 py-1 rounded text-[11px] font-medium border border-amber-200/50">
                  <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-1.5 1.5L16 7l-2-2-1.5 1.5 2 2L13 10l-2-2-1.5 1.5 2 2L10 13l-1.5-1.5L7 13l-1-1L2 16v6h6l4-4-1-1 1.5-1.5L14 16l1.5-1.5-2-2 1.5-1.5 2 2 1.5-1.5-2-2 2-2 1.5 1.5z"></path><circle cx="18" cy="6" r="3"></circle></svg>
                  <span>${mis.accessKey || 'Consignes à confirmer'}</span>
                </span>
              </div>
            </div>
          </div>

          <div class="pt-2 flex items-center justify-end gap-2 border-t border-[#0E7C86]/08">
            <button
              type="button"
              class="btn-open-detail px-4 py-1.5 text-xs font-bold text-[#0E7C86] bg-[#E3F4F5] hover:bg-[#0E7C86] hover:text-white rounded-full transition-colors"
            >
              Inspecter la fiche
            </button>
          </div>
        `;

        card.querySelector('.btn-open-detail')?.addEventListener('click', () => {
          openMissionModal(mis);
        });

        weekMissionsContainer.appendChild(card);
      });
    }

    // 7. Modale Détail de la Mission (Protégée et Sécurisée)
    const detailModal = document.getElementById('mission-detail-modal');
    const detailCard = document.getElementById('mission-detail-card');
    const btnCloseDetail = document.getElementById('btn-close-mission-modal');
    const btnCloseDetailFooter = document.getElementById('btn-close-mission-modal-footer');
    const staffSelect = document.getElementById('modal-mission-staff-select') as HTMLSelectElement | null;
    const btnToggleStatus = document.getElementById('btn-toggle-mission-status');
    const btnSaveMission = document.getElementById('btn-save-mission-changes');
    const btnCopyAccessKey = document.getElementById('btn-copy-access-key');
    let currentSelectedMission: any = null;

    // Téléportation vers document.body pour que le flou couvre 100% de la fenêtre (y compris le header supérieur)
    if (detailModal && detailModal.parentElement !== document.body) {
      document.body.appendChild(detailModal);
    }

    function openMissionModal(mis: any) {
      if (!detailModal || !detailCard || !mis) return;
      currentSelectedMission = mis;

      // Assignation ultra-sécurisée avec vérification d'existence
      const idEl = document.getElementById('modal-mission-id');
      if (idEl) idEl.textContent = mis.code || mis.id || '';

      const clientEl = document.getElementById('modal-mission-client');
      if (clientEl) clientEl.textContent = mis.client || '';

      const clientDetailEl = document.getElementById('modal-mission-client-detail');
      if (clientDetailEl) clientDetailEl.textContent = mis.client || '';

      const timeEl = document.getElementById('modal-mission-time');
      if (timeEl) timeEl.textContent = mis.time || '09:00 — 12:00';

      const dayEl = document.getElementById('modal-mission-day');
      if (dayEl) dayEl.textContent = mis.day || formatFrenchDate(mis.date);

      const addressEl = document.getElementById('modal-mission-address');
      if (addressEl) addressEl.textContent = mis.address || '';

      const serviceEl = document.getElementById('modal-mission-service');
      if (serviceEl) serviceEl.textContent = mis.service || '';

      const accessEl = document.getElementById('modal-mission-access-notes');
      if (accessEl) accessEl.textContent = mis.accessKey || 'Consignes à confirmer avec le client';

      // Statut
      const statusEl = document.getElementById('modal-mission-status');
      if (statusEl) {
        statusEl.textContent = mis.status || 'Planifié';
        statusEl.className = `px-2.5 py-0.5 rounded-full text-[10px] font-extrabold border ${mis.statusColor || getStatusColor(mis.status)}`;
      }

      // Téléphone & Courriel
      const phoneLink = document.getElementById('modal-mission-phone') as HTMLAnchorElement | null;
      const phoneLabel = document.getElementById('modal-mission-phone-label');
      if (phoneLink && phoneLabel) {
        phoneLink.href = `tel:${mis.phone || '+15148924182'}`;
        phoneLabel.textContent = mis.phone || '+1 (514) 892-4182';
      }

      const emailLink = document.getElementById('modal-mission-email') as HTMLAnchorElement | null;
      if (emailLink) {
        emailLink.href = `mailto:${mis.email || 'client@unilka.ca'}`;
      }

      // Google Maps
      const mapsLink = document.getElementById('modal-mission-maps-link') as HTMLAnchorElement | null;
      if (mapsLink) {
        mapsLink.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mis.address || 'Montréal')}`;
      }

      // Staff Select
      if (staffSelect) {
        staffSelect.value = mis.staff || 'Fatou D.';
      }

      // Staff Avatar
      const avatarImg = document.getElementById('modal-mission-staff-img') as HTMLImageElement | null;
      const avatarInitials = document.getElementById('modal-mission-staff-initials');
      if (mis.staffPhoto && avatarImg) {
        avatarImg.src = mis.staffPhoto;
        avatarImg.classList.remove('hidden');
        if (avatarInitials) avatarInitials.classList.add('hidden');
      } else {
        if (avatarImg) avatarImg.classList.add('hidden');
        if (avatarInitials) {
          avatarInitials.textContent = (mis.staff || 'UN').split(' ').map((n: string) => n[0]).join('');
          avatarInitials.classList.remove('hidden');
        }
      }

      // Afficher modale avec animation fluide
      detailModal.classList.remove('hidden');
      detailModal.classList.add('flex');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        detailCard.classList.remove('scale-95', 'opacity-0');
        detailCard.classList.add('scale-100', 'opacity-100');
      });
    }

    function closeMissionModal() {
      if (!detailModal || !detailCard) return;
      detailCard.classList.remove('scale-100', 'opacity-100');
      detailCard.classList.add('scale-95', 'opacity-0');
      document.body.style.overflow = '';
      setTimeout(() => {
        detailModal.classList.add('hidden');
        detailModal.classList.remove('flex');
      }, 200);
    }

    btnCloseDetail?.addEventListener('click', closeMissionModal);
    btnCloseDetailFooter?.addEventListener('click', closeMissionModal);
    detailModal?.addEventListener('click', (e) => {
      if (e.target === detailModal) closeMissionModal();
    });

    // Copier consignes d'accès
    btnCopyAccessKey?.addEventListener('click', () => {
      const text = document.getElementById('modal-mission-access-notes')?.textContent || '';
      navigator.clipboard?.writeText(text).then(() => {
        if ((window as any).showAdminToast) {
          (window as any).showAdminToast("Consignes d'accès copiées dans le presse-papier !");
        }
      });
    });

    // Basculer statut dans Firebase
    btnToggleStatus?.addEventListener('click', async () => {
      if (!currentSelectedMission) return;
      let newStatus = 'En cours';
      let newColor = 'bg-sky-100 text-sky-800 border-sky-200';

      if (currentSelectedMission.status === 'Terminé') {
        newStatus = 'En cours';
        newColor = 'bg-sky-100 text-sky-800 border-sky-200';
      } else if (currentSelectedMission.status === 'En cours') {
        newStatus = 'Planifié';
        newColor = 'bg-gray-100 text-gray-800 border-gray-200';
      } else {
        newStatus = 'Terminé';
        newColor = 'bg-emerald-100 text-emerald-800 border-emerald-200';
      }

      currentSelectedMission.status = newStatus;
      currentSelectedMission.statusColor = newColor;

      const statusEl = document.getElementById('modal-mission-status');
      if (statusEl) {
        statusEl.textContent = newStatus;
        statusEl.className = `px-2.5 py-0.5 rounded-full text-[10px] font-extrabold border ${newColor}`;
      }

      try {
        if (currentSelectedMission.id) {
          await updateDoc(doc(db, 'interventions', currentSelectedMission.id), {
            status: newStatus,
            statusColor: newColor,
            updatedAt: serverTimestamp()
          });
        }
      } catch (err) {
        console.warn('Erreur mise à jour Firebase :', err);
      }

      renderMonthlyCalendar();
      renderWeekMissions(activeDayFullDate);
      if ((window as any).showAdminToast) {
        (window as any).showAdminToast(`Statut mis à jour : ${newStatus}`);
      }
    });

    // Enregistrer modifications préposé dans Firebase
    btnSaveMission?.addEventListener('click', async () => {
      if (!currentSelectedMission || !staffSelect) return;
      const newStaff = staffSelect.value;
      const newPhoto = newStaff === 'Fatou D.' ? '/images/admin/staff-fatou.jpg' : (newStaff === 'Jean-Marc T.' ? '/images/admin/staff-jeanmarc.jpg' : '');

      currentSelectedMission.staff = newStaff;
      currentSelectedMission.staffPhoto = newPhoto;

      try {
        if (currentSelectedMission.id) {
          await updateDoc(doc(db, 'interventions', currentSelectedMission.id), {
            staff: newStaff,
            staffPhoto: newPhoto,
            updatedAt: serverTimestamp()
          });
        }
      } catch (err) {
        console.warn('Erreur réassignation Firebase :', err);
      }

      renderMonthlyCalendar();
      renderWeekMissions(activeDayFullDate);
      closeMissionModal();
      if ((window as any).showAdminToast) {
        (window as any).showAdminToast(`Mission réassignée à ${newStaff} !`);
