    // Téléportation vers document.body pour que le flou couvre 100% de la fenêtre (y compris le header supérieur)
    if (newMissionModal && newMissionModal.parentElement !== document.body) {
      document.body.appendChild(newMissionModal);
    }

    function openNewMissionModal(prefillDate?: string) {
      if (!newMissionModal || !newMissionCard) return;
      const dateInput = document.getElementById('new-date') as HTMLInputElement | null;
      if (dateInput) {
        dateInput.value = prefillDate || todayDateStr;
      }

      newMissionModal.classList.remove('hidden');
      newMissionModal.classList.add('flex');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        newMissionCard.classList.remove('scale-95', 'opacity-0');
        newMissionCard.classList.add('scale-100', 'opacity-100');
      });
    }

    function closeNewMissionModal() {
      if (!newMissionModal || !newMissionCard) return;
      newMissionCard.classList.remove('scale-100', 'opacity-100');
      newMissionCard.classList.add('scale-95', 'opacity-0');
      document.body.style.overflow = '';
      setTimeout(() => {
        newMissionModal.classList.add('hidden');
        newMissionModal.classList.remove('flex');
      }, 200);
    }

    btnOpenNew?.addEventListener('click', () => openNewMissionModal(activeDayFullDate));
    btnCloseNew?.addEventListener('click', closeNewMissionModal);
    btnCancelNew?.addEventListener('click', closeNewMissionModal);
    newMissionModal?.addEventListener('click', (e) => {
      if (e.target === newMissionModal) closeNewMissionModal();
    });

    // Création dans Firestore
    newMissionForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const dateInput = document.getElementById('new-date') as HTMLInputElement | null;
      const timeSelect = document.getElementById('new-time') as HTMLSelectElement | null;
      const clientInput = document.getElementById('new-client') as HTMLInputElement | null;
      const addressInput = document.getElementById('new-address') as HTMLInputElement | null;
      const serviceSelect = document.getElementById('new-service') as HTMLSelectElement | null;
      const staffSelectEl = document.getElementById('new-staff') as HTMLSelectElement | null;
      const accessInput = document.getElementById('new-access') as HTMLInputElement | null;

