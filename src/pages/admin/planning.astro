        isSeeding = true;
        await seedInitialInterventions();
        return;
      }

      const list: any[] = [];
      snapshot.forEach((docSnap) => {
        const data = docSnap.data();
        list.push({
          id: docSnap.id,
          code: data.code || `MIS-${docSnap.id.slice(0, 5)}`,
          date: data.date,
          day: data.day || formatFrenchDate(data.date),
