          >
            Annuler
          </button>
          <button
            type="submit"
            id="btn-submit-new-mission"
            class="px-5 py-2.5 rounded-full font-extrabold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-all"
