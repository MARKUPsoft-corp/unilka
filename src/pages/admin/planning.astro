      const missionData = {
        code: newCode,
        date: date,
        day: dayFormatted,
        time: time,
        client: client,
        phone: "+1 514 555-0199",
        email: "client@unilka.ca",
        address: address,
        service: service,
        category: (service.toLowerCase().includes('bureau') || service.toLowerCase().includes('commercial')) ? 'commercial' : 'residentiel',
        staff: staff,
        staffRole: "Préposé(e) dédié(e)",
        staffPhoto: staffPhoto,
        status: "Planifié",
        statusColor: "bg-gray-100 text-gray-800 border-gray-200",
        checklist: "Grille hôtelière 42 pts",
        checklistProgress: 0,
        accessKey: access,
        createdAt: serverTimestamp()
      };

      try {
        const docRef = await addDoc(collection(db, 'interventions'), missionData);
        closeNewMissionModal();
        (newMissionForm as HTMLFormElement).reset();

        activeDayFullDate = date;
        if ((window as any).showAdminToast) {
          (window as any).showAdminToast(`Intervention #${newCode} enregistrée !`);
        }
      } catch (err) {
        console.error('Erreur ajout Firestore :', err);
        if ((window as any).showAdminToast) {
          (window as any).showAdminToast("Erreur lors de l'enregistrement de l'intervention");
        }
      }
    });

    // Touche Échap
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMissionModal();
        closeNewMissionModal();
      }
    });

