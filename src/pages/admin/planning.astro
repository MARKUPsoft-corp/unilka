  <!-- ======================================================== -->
  <!-- 6. LOGIQUE CLIENT CALENDRIER & SYNCHRONISATION FIREBASE -->
  <!-- ======================================================== -->
  <script>
    import { db } from '../../lib/firebase';
    import {
      collection,
      onSnapshot,
      addDoc,
      doc,
      updateDoc,
      setDoc,
      serverTimestamp
    } from 'firebase/firestore';

    // 1. Initialisation de la date d'aujourd'hui en temps réel
    const now = new Date();
    const todayYear = now.getFullYear();
    const todayMonth = now.getMonth();
    const todayDay = now.getDate();
    const todayDateStr = `${todayYear}-${String(todayMonth + 1).padStart(2, '0')}-${String(todayDay).padStart(2, '0')}`;

    let currentYear = todayYear;
    let currentMonth = todayMonth;
    let activeFilter = 'all';
    let activeDayFullDate = todayDateStr;
    let missions: any[] = [];
    let isSeeding = false;

    const MONTH_NAMES = [
      "Janvier", "Février", "Mars", "Avril", "Mai", "Juin",
      "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"
    ];

    const MONTH_NAMES_SHORT = [
      "janv.", "févr.", "mars", "avr.", "mai", "juin",
      "juil.", "août", "sept.", "oct.", "nov.", "déc."
    ];

    const DAY_NAMES = [
      "Dimanche", "Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi"
    ];

    // Helper couleur de statut
    function getStatusColor(status: string): string {
      if (status === 'Terminé') return 'bg-emerald-100 text-emerald-800 border-emerald-200';
      if (status === 'En cours') return 'bg-sky-100 text-sky-800 border-sky-200';
      return 'bg-gray-100 text-gray-800 border-gray-200';
    }

    // Helper formatage date française
    function formatFrenchDate(dateStr: string): string {
      const d = new Date(dateStr + 'T12:00:00');
      return `${DAY_NAMES[d.getDay()]} ${d.getDate()} ${MONTH_NAMES_SHORT[d.getMonth()]}`;
    }

    // Helper pour générer une date relative (en jours par rapport à aujourd'hui)
    function getRelativeDateStr(offsetDays: number): string {
      const d = new Date(now);
      d.setDate(now.getDate() + offsetDays);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    // Helper pour générer un jour spécifique du mois en cours
    function getMonthDayStr(year: number, monthIndex: number, dayNum: number): string {
      return `${year}-${String(monthIndex + 1).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
    }

    // Éléments DOM
    const viewWeekBtn = document.getElementById('btn-view-week');
    const viewMonthBtn = document.getElementById('btn-view-month');
    const viewWeekContainer = document.getElementById('view-week-container');
    const viewMonthContainer = document.getElementById('view-month-container');
    const calendarCellsGrid = document.getElementById('calendar-cells-grid');
    const currentMonthHeading = document.getElementById('calendar-current-label');
    const currentMonthCountLabel = document.getElementById('calendar-month-count-label');
    const subtitleCounter = document.getElementById('planning-subtitle-counter');
    const statusFilters = document.querySelectorAll('.cal-status-filter');

    // 2. Bascule Vue Semaine / Vue Mois
    function setView(view: 'week' | 'month') {
      if (view === 'week') {
        viewWeekBtn?.classList.add('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
        viewWeekBtn?.classList.remove('text-[#3D5A5E]', 'font-bold');

        viewMonthBtn?.classList.remove('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
        viewMonthBtn?.classList.add('text-[#3D5A5E]', 'font-bold');

        viewWeekContainer?.classList.remove('hidden');
        viewMonthContainer?.classList.add('hidden');
        renderWeekBar();
        renderWeekMissions(activeDayFullDate);
      } else {
        viewMonthBtn?.classList.add('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
        viewMonthBtn?.classList.remove('text-[#3D5A5E]', 'font-bold');

        viewWeekBtn?.classList.remove('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
        viewWeekBtn?.classList.add('text-[#3D5A5E]', 'font-bold');

        viewMonthContainer?.classList.remove('hidden');
        viewWeekContainer?.classList.add('hidden');
        renderMonthlyCalendar();
      }
    }

    viewWeekBtn?.addEventListener('click', () => setView('week'));
    viewMonthBtn?.addEventListener('click', () => setView('month'));

    // 3. Rendu du Calendrier Mensuel avec missions dans chaque case
    function renderMonthlyCalendar() {
      if (!calendarCellsGrid) return;
      calendarCellsGrid.innerHTML = '';

      if (currentMonthHeading) {
        currentMonthHeading.textContent = `${MONTH_NAMES[currentMonth]} ${currentYear}`;
      }

      const firstDay = new Date(currentYear, currentMonth, 1);
      let startingDayIndex = firstDay.getDay() - 1;
      if (startingDayIndex === -1) startingDayIndex = 6;

      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const daysInPrevMonth = new Date(currentYear, currentMonth, 0).getDate();

      const monthPrefix = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`;
      const currentMonthMissions = missions.filter(m => m.date && m.date.startsWith(monthPrefix));
      
      if (currentMonthCountLabel) {
        currentMonthCountLabel.textContent = `${currentMonthMissions.length} intervention(s) planifiée(s)`;
      }
      if (subtitleCounter) {
        subtitleCounter.textContent = `${currentMonthMissions.length} interventions planifiées en ${MONTH_NAMES[currentMonth]} ${currentYear} dans le Grand Montréal.`;
      }

      // Cases du mois précédent
      for (let i = startingDayIndex - 1; i >= 0; i--) {
        const dayNum = daysInPrevMonth - i;
        const cell = document.createElement('div');
        cell.className = 'min-h-[120px] sm:min-h-[135px] p-2 bg-[#F5FAFA]/40 text-[#3D5A5E]/40 flex flex-col justify-between';
        cell.innerHTML = `
          <div class="flex items-center justify-between text-xs font-bold opacity-40">
            <span>${dayNum}</span>
          </div>
          <div class="flex-1 mt-1"></div>
        `;
        calendarCellsGrid.appendChild(cell);
      }

      // Cases du mois en cours
      for (let day = 1; day <= daysInMonth; day++) {
        const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const isToday = (dateStr === todayDateStr);

        let dayMissions = missions.filter(m => m.date === dateStr);
        if (activeFilter !== 'all') {
          dayMissions = dayMissions.filter(m => m.status === activeFilter);
        }

        const cell = document.createElement('div');
        cell.className = `min-h-[120px] sm:min-h-[135px] p-2 bg-white flex flex-col justify-between transition-all duration-150 relative group cursor-pointer hover:bg-[#F5FAFA]/80 ${
          isToday ? 'bg-[#E3F4F5]/30 ring-2 ring-inset ring-[#0E7C86]' : ''
        }`;
        cell.dataset.date = dateStr;

        // En-tête de la case
        const header = document.createElement('div');
        header.className = 'flex items-center justify-between text-xs font-extrabold pb-1';

        const leftBox = document.createElement('div');
        leftBox.className = 'flex items-center gap-1.5';
        if (isToday) {
          leftBox.innerHTML = `
            <span class="w-6 h-6 rounded-full bg-[#0E7C86] text-white flex items-center justify-center font-black text-xs shadow-xs">
              ${day}
            </span>
            <span class="text-[9px] font-extrabold uppercase text-[#0E7C86] hidden sm:inline">Auj.</span>
          `;
        } else {
          leftBox.innerHTML = `<span class="text-[#0B2A2E] text-xs font-bold pl-1">${day}</span>`;
        }

        const rightBox = document.createElement('div');
        rightBox.className = 'flex items-center gap-1';
        if (dayMissions.length > 0) {
          rightBox.innerHTML += `
            <span class="text-[10px] px-1.5 py-0.5 rounded-full font-extrabold ${
              isToday ? 'bg-[#0E7C86] text-white' : 'bg-[#E3F4F5] text-[#0E7C86]'
            }">
              ${dayMissions.length}
            </span>
          `;
        }
        rightBox.innerHTML += `
          <button
            type="button"
            class="btn-add-day-mission opacity-0 group-hover:opacity-100 transition-opacity w-5 h-5 rounded-full bg-[#E3F4F5] hover:bg-[#0E7C86] text-[#0E7C86] hover:text-white flex items-center justify-center text-xs font-bold"
            data-date="${dateStr}"
            title="Ajouter une intervention ce jour"
          >+</button>
        `;

        header.appendChild(leftBox);
        header.appendChild(rightBox);
        cell.appendChild(header);

        // Conteneur des missions dans la case du jour
        const missionsContainer = document.createElement('div');
        missionsContainer.className = 'space-y-1.5 overflow-hidden flex-1 mt-1';

        const visibleMissions = dayMissions.slice(0, 3);
        visibleMissions.forEach((mis, idx) => {
          const chip = document.createElement('div');
          
          let statusClasses = 'bg-[#F5FAFA] text-[#0B2A2E] border-[#0E7C86]/15 hover:border-[#0E7C86]/40';
          let dotColor = 'bg-amber-500';
          if (mis.status === 'Terminé') {
            statusClasses = 'bg-emerald-50 text-emerald-900 border-emerald-200/80 hover:bg-emerald-100/70';
            dotColor = 'bg-emerald-500';
          } else if (mis.status === 'En cours') {
            statusClasses = 'bg-sky-50 text-sky-900 border-sky-200/80 hover:bg-sky-100/70';
            dotColor = 'bg-sky-500';
          }

          chip.className = `mission-chip p-1.5 rounded-xl border text-[11px] font-semibold leading-tight flex items-center justify-between gap-1 shadow-2xs hover:shadow-xs transform hover:-translate-y-0.5 transition-all duration-150 cursor-pointer ${statusClasses}`;
          chip.dataset.id = mis.id;
          chip.style.animation = `fadeIn 200ms ease-out ${idx * 40}ms forwards`;

          const clientName = mis.client || 'Client';
          const startTime = (mis.time || '09:00').split(' ')[0];
          const staffInitial = (mis.staff || 'Staff').split(' ')[0];

          chip.innerHTML = `
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-1.5 h-1.5 rounded-full ${dotColor} shrink-0"></span>
              <span class="font-extrabold text-[10px] shrink-0 text-[#0E7C86]">${startTime}</span>
              <span class="truncate font-bold text-[#0B2A2E]">${clientName}</span>
            </div>
            <span class="text-[9px] font-bold text-[#3D5A5E] shrink-0 px-1 rounded bg-white/70">${staffInitial}</span>
          `;

          // Clic direct sur la pastille -> Ouvre la modale des détails
          chip.addEventListener('click', (e) => {
            e.stopPropagation();
            openMissionModal(mis);
          });

          missionsContainer.appendChild(chip);
        });

        if (dayMissions.length > 3) {
          const moreBadge = document.createElement('div');
          moreBadge.className = 'text-[10px] font-extrabold text-[#0E7C86] hover:underline text-center pt-0.5 cursor-pointer';
          moreBadge.textContent = `+ ${dayMissions.length - 3} autre(s)...`;
          moreBadge.addEventListener('click', (e) => {
            e.stopPropagation();
            activeDayFullDate = dateStr;
            setView('week');
          });
          missionsContainer.appendChild(moreBadge);
        }

        cell.appendChild(missionsContainer);

        // Clic sur la case elle-même
        cell.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.btn-add-day-mission') || (e.target as HTMLElement).closest('.mission-chip')) return;
          activeDayFullDate = dateStr;
          if (dayMissions.length > 0) {
            openMissionModal(dayMissions[0]);
          } else {
            openNewMissionModal(dateStr);
          }
        });

        calendarCellsGrid.appendChild(cell);
      }

      // Cases de fin de grille
      const totalRendered = startingDayIndex + daysInMonth;
      const remainingCells = (Math.ceil(totalRendered / 7) * 7) - totalRendered;
      for (let j = 1; j <= remainingCells; j++) {
        const cell = document.createElement('div');
        cell.className = 'min-h-[120px] sm:min-h-[135px] p-2 bg-[#F5FAFA]/40 text-[#3D5A5E]/40 flex flex-col justify-between';
        cell.innerHTML = `
          <div class="flex items-center justify-between text-xs font-bold opacity-40">
            <span>${j}</span>
          </div>
          <div class="flex-1 mt-1"></div>
        `;
        calendarCellsGrid.appendChild(cell);
      }

      // Attacher listener aux boutons + des cases
      document.querySelectorAll('.btn-add-day-mission').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetDate = (btn as HTMLElement).dataset.date;
          openNewMissionModal(targetDate);
        });
      });
    }

    // 4. Navigation Mois Précédent / Mois Suivant / Aujourd'hui
    document.getElementById('cal-prev-month')?.addEventListener('click', () => {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderMonthlyCalendar();
    });

    document.getElementById('cal-next-month')?.addEventListener('click', () => {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderMonthlyCalendar();
    });

    document.getElementById('cal-today-btn')?.addEventListener('click', () => {
      currentYear = todayYear;
      currentMonth = todayMonth;
      activeDayFullDate = todayDateStr;
      renderMonthlyCalendar();
      if ((window as any).showAdminToast) {
        (window as any).showAdminToast(`Retour à aujourd'hui (${formatFrenchDate(todayDateStr)})`);
      }
    });

    // 5. Filtres par Statut
    statusFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        statusFilters.forEach(b => {
          b.classList.remove('active', 'bg-[#0E7C86]', 'text-white');
          b.classList.add('bg-[#F5FAFA]', 'text-[#3D5A5E]');
        });
        btn.classList.add('active', 'bg-[#0E7C86]', 'text-white');
        btn.classList.remove('bg-[#F5FAFA]', 'text-[#3D5A5E]');

        activeFilter = (btn as HTMLElement).dataset.filter || 'all';
        renderMonthlyCalendar();
      });
    });

    // 6. Rendu dynamique de la barre de la semaine
    const planningDaysBar = document.getElementById('planning-days-bar');
    const weekMissionsContainer = document.getElementById('week-missions-container');
    const weekSelectedTitle = document.getElementById('week-selected-title');

    function renderWeekBar() {
      if (!planningDaysBar) return;
      planningDaysBar.innerHTML = '';

      // Calculer le lundi de la semaine active
      const ref = new Date(activeDayFullDate + 'T12:00:00');
      let dayOfWeek = ref.getDay();
      let mondayDiff = dayOfWeek === 0 ? -6 : 1 - dayOfWeek;
      const monday = new Date(ref);
      monday.setDate(ref.getDate() + mondayDiff);

      for (let i = 0; i < 7; i++) {
        const d = new Date(monday);
        d.setDate(monday.getDate() + i);
        const dStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const dayCount = missions.filter(m => m.date === dStr).length;
        const isToday = (dStr === todayDateStr);
        const isSelected = (dStr === activeDayFullDate);

        const card = document.createElement('div');
        card.className = `day-card p-3.5 rounded-2xl border transition-all cursor-pointer ${
          isSelected
            ? 'active-day bg-[#E3F4F5] border-[#0E7C86] text-[#0E7C86] shadow-2xs font-extrabold'
            : 'bg-white border-[#0E7C86]/12 text-[#0B2A2E] hover:border-[#0E7C86]/30'
        }`;
        card.dataset.fulldate = dStr;
        card.dataset.day = `${DAY_NAMES[d.getDay()]} ${d.getDate()} ${MONTH_NAMES_SHORT[d.getMonth()]}`;

        card.innerHTML = `
          <div class="flex items-center justify-between text-xs">
            <span>${DAY_NAMES[d.getDay()]}</span>
            <span class="day-count text-[10px] px-2 py-0.5 rounded-full font-bold ${
              isSelected ? 'bg-[#0E7C86] text-white' : 'bg-[#F5FAFA] text-[#3D5A5E]'
            }">
              ${dayCount}
            </span>
          </div>
          <div class="flex items-center gap-1.5 mt-1">
            <span class="text-lg font-black block">${d.getDate()} ${MONTH_NAMES_SHORT[d.getMonth()]}</span>
            ${isToday ? '<span class="text-[9px] font-black uppercase text-[#0E7C86] bg-[#E3F4F5] px-1.5 py-0.5 rounded">Auj.</span>' : ''}
          </div>
        `;

        card.addEventListener('click', () => {
          activeDayFullDate = dStr;
          renderWeekBar();
          renderWeekMissions(activeDayFullDate);
        });

        planningDaysBar.appendChild(card);
      }
    }

    function renderWeekMissions(targetFullDate: string) {
      if (!weekMissionsContainer) return;
      weekMissionsContainer.innerHTML = '';

      const dayMissions = missions.filter(m => m.date === targetFullDate);
      
      if (weekSelectedTitle) {
        weekSelectedTitle.textContent = `Missions du ${formatFrenchDate(targetFullDate)} (${dayMissions.length} intervention(s))`;
      }

      if (dayMissions.length === 0) {
        weekMissionsContainer.innerHTML = `
          <div class="p-8 text-center bg-white rounded-2xl border border-[#0E7C86]/12 space-y-3">
