---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';

// Disponibilité des équipes de référence
const staffAvailabilities = [
  { name: "Fatou D.", photo: "/images/admin/staff-fatou.jpg", initials: "FD", status: "En mission", todayMissions: 2, sector: "Montréal Centre / Ouest" },
  { name: "Khadija B.", photo: "", initials: "KB", status: "En mission", todayMissions: 1, sector: "Plateau & Rosemont" },
  { name: "Jean-Marc T.", photo: "/images/admin/staff-jeanmarc.jpg", initials: "JT", status: "En mission", todayMissions: 1, sector: "Montréal & Rive-Sud" },
  { name: "Assane N.", photo: "", initials: "AN", status: "Disponible (Soir)", todayMissions: 1, sector: "Commercial & Bureaux" },
  { name: "Marie-Louise P.", photo: "", initials: "ML", status: "Disponible", todayMissions: 0, sector: "Lanaudière & Nord" }
];
---

<AdminLayout title="Planning & Missions" activeNav="planning">

  <!-- 1. EN-TÊTE PRINCIPAL : TITRE, STATS & SÉLECTEUR DE VUE -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
        <span>Organisation des Tournées & Missions</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight">
        Planning des interventions
      </h1>
      <p class="text-xs sm:text-sm text-[#3D5A5E]" id="planning-subtitle-counter">
        Synchronisation avec Firebase Firestore en cours…
      </p>
    </div>

    <!-- Contrôles de Vue & Nouvelle intervention -->
    <div class="flex items-center gap-3">
      <!-- Toggle Semaine / Mois -->
      <div class="flex items-center rounded-full border border-[#0E7C86]/15 bg-white p-1 shadow-2xs">
        <button
          type="button"
          id="btn-view-week"
          class="px-3.5 py-1.5 rounded-full text-xs font-bold text-[#3D5A5E] hover:text-[#0B2A2E] transition-all"
        >
          Semaine
        </button>
        <button
          type="button"
          id="btn-view-month"
          class="px-3.5 py-1.5 rounded-full text-xs font-extrabold bg-[#0E7C86] text-white shadow-2xs transition-all"
        >
          Mois
        </button>
      </div>

      <!-- Bouton d'ajout d'intervention -->
      <button
        type="button"
        id="btn-open-new-mission"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-extrabold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-all transform active:scale-95"
      >
        <AdminIcon name="plus" class="w-4 h-4 text-white" />
        <span>Nouvelle intervention</span>
      </button>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- 2. VUE CALENDRIER MENSUEL INTERACTIF (PLEINE LARGEUR) -->
  <!-- ======================================================== -->
  <div id="view-month-container" class="space-y-4 transition-all duration-200">
    
    <!-- Barre de contrôle du mois & filtres de statut -->
    <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-4 sm:p-5 shadow-2xs flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      
      <!-- Navigation du Mois (Précédent, Aujourd'hui, Suivant) -->
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1 bg-[#F5FAFA] rounded-full p-1 border border-[#0E7C86]/10">
          <button
            type="button"
            id="cal-prev-month"
            class="w-8 h-8 rounded-full flex items-center justify-center text-[#3D5A5E] hover:text-[#0B2A2E] hover:bg-white transition-colors"
            title="Mois précédent"
            aria-label="Mois précédent"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            id="cal-today-btn"
            class="px-3 py-1 text-xs font-bold text-[#0E7C86] hover:bg-white rounded-full transition-colors"
          >
            Aujourd'hui
          </button>
          <button
            type="button"
            id="cal-next-month"
            class="w-8 h-8 rounded-full flex items-center justify-center text-[#3D5A5E] hover:text-[#0B2A2E] hover:bg-white transition-colors"
            title="Mois suivant"
            aria-label="Mois suivant"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>

        <div>
          <h2 id="calendar-current-label" class="text-lg sm:text-xl font-extrabold text-[#0B2A2E]">
            Mois en cours
          </h2>
          <span id="calendar-month-count-label" class="text-xs text-[#3D5A5E] font-medium block">
            Chargement des missions…
          </span>
        </div>
      </div>

      <!-- Filtres par statut et catégories -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="text-[11px] font-bold uppercase tracking-wider text-[#3D5A5E] mr-1 hidden sm:inline">Statut :</span>
        
        <button
          type="button"
          class="cal-status-filter active px-3 py-1.5 rounded-full font-bold bg-[#0E7C86] text-white shadow-2xs transition-all"
          data-filter="all"
        >
          Toutes
        </button>

        <button
          type="button"
          class="cal-status-filter px-3 py-1.5 rounded-full font-bold bg-[#F5FAFA] text-[#3D5A5E] hover:bg-[#E3F4F5] hover:text-[#0B2A2E] border border-[#0E7C86]/10 transition-all inline-flex items-center gap-1.5"
          data-filter="En cours"
        >
          <span class="w-2 h-2 rounded-full bg-sky-500"></span>
          <span>En cours</span>
        </button>

        <button
          type="button"
          class="cal-status-filter px-3 py-1.5 rounded-full font-bold bg-[#F5FAFA] text-[#3D5A5E] hover:bg-[#E3F4F5] hover:text-[#0B2A2E] border border-[#0E7C86]/10 transition-all inline-flex items-center gap-1.5"
          data-filter="Planifié"
        >
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span>Planifiées</span>
        </button>

        <button
          type="button"
          class="cal-status-filter px-3 py-1.5 rounded-full font-bold bg-[#F5FAFA] text-[#3D5A5E] hover:bg-[#E3F4F5] hover:text-[#0B2A2E] border border-[#0E7C86]/10 transition-all inline-flex items-center gap-1.5"
          data-filter="Terminé"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Terminées</span>
        </button>
      </div>

    </div>

    <!-- GRILLE DU CALENDRIER (7 COLONNES : LUN AU DIM) -->
    <div class="bg-white rounded-3xl border border-[#0E7C86]/15 shadow-sm overflow-hidden">
      
      <!-- En-tête des 7 jours -->
      <div class="grid grid-cols-7 border-b border-[#0E7C86]/12 bg-[#F5FAFA] text-center text-xs font-extrabold text-[#3D5A5E] divide-x divide-[#0E7C86]/10">
        <div class="py-3 px-1"><span class="hidden sm:inline">Lundi</span><span class="sm:hidden">Lun</span></div>
        <div class="py-3 px-1"><span class="hidden sm:inline">Mardi</span><span class="sm:hidden">Mar</span></div>
        <div class="py-3 px-1"><span class="hidden sm:inline">Mercredi</span><span class="sm:hidden">Mer</span></div>
        <div class="py-3 px-1"><span class="hidden sm:inline">Jeudi</span><span class="sm:hidden">Jeu</span></div>
        <div class="py-3 px-1"><span class="hidden sm:inline">Vendredi</span><span class="sm:hidden">Ven</span></div>
        <div class="py-3 px-1 text-[#0E7C86]"><span class="hidden sm:inline">Samedi</span><span class="sm:hidden">Sam</span></div>
        <div class="py-3 px-1 text-[#0E7C86]"><span class="hidden sm:inline">Dimanche</span><span class="sm:hidden">Dim</span></div>
      </div>

      <!-- Cellules du Mois (Générées interactivement en JS synchronisé avec Firestore) -->
      <div
        id="calendar-cells-grid"
        class="grid grid-cols-7 divide-x divide-y divide-[#0E7C86]/10 bg-gray-50/50"
      >
        <div class="col-span-7 p-12 text-center text-xs text-[#3D5A5E]">
          Chargement du calendrier en direct…
        </div>
      </div>

    </div>

  </div>

  <!-- ======================================================== -->
  <!-- 3. VUE SEMAINE DÉTAILLÉE (AVEC DISPONIBILITÉS ÉQUIPES) -->
  <!-- ======================================================== -->
  <div id="view-week-container" class="space-y-6 hidden transition-all duration-200">
    
    <!-- Sélecteur dynamique des jours de la semaine active -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3" id="planning-days-bar">
      <!-- Rendu dynamique JS -->
    </div>

    <!-- Contenu de la semaine : Cartes de missions à gauche (8 cols), Disponibilités à droite (4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Liste des interventions planifiées pour le jour sélectionné -->
      <div class="lg:col-span-8 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-extrabold text-[#0B2A2E]" id="week-selected-title">
            Missions de la journée
          </h2>
          <span class="text-xs text-[#3D5A5E]">Trié par chronologie</span>
        </div>

        <div class="space-y-4" id="week-missions-container">
          <!-- Injecté dynamiquement par JS -->
        </div>
      </div>

      <!-- Colonne Latérale : Disponibilités des équipes -->
      <div class="lg:col-span-4 space-y-6">
        
        <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-6 shadow-2xs space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#0E7C86]">
              Disponibilité des Équipes
            </h3>
            <span class="text-[10px] text-[#3D5A5E]">Aujourd'hui</span>
          </div>

          <div class="space-y-3">
            {staffAvailabilities.map((st) => (
              <div class="p-3 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/10 flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                  {st.photo ? (
                    <img src={st.photo} alt={st.name} class="w-8 h-8 rounded-full object-cover border border-[#0E7C86]/20 shrink-0" />
                  ) : (
                    <span class="w-8 h-8 rounded-full bg-[#E3F4F5] text-[#0E7C86] font-bold text-[10px] flex items-center justify-center shrink-0">
                      {st.initials}
                    </span>
                  )}
                  <div class="space-y-0.5">
                    <span class="font-bold text-[#0B2A2E] block">{st.name}</span>
                    <span class="text-[10px] text-[#3D5A5E]">{st.sector}</span>
                  </div>
                </div>
                <div class="text-right">
                  <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                    st.status === 'En mission' ? 'bg-sky-100 text-sky-800' : 'bg-emerald-100 text-emerald-800'
                  }`}>
                    {st.status}
                  </span>
                  <span class="block text-[10px] text-[#3D5A5E] mt-0.5">{st.todayMissions} mission(s)</span>
                </div>
              </div>
            ))}
          </div>

          <div class="pt-2">
            <a
              href="/admin/equipe/"
              class="w-full inline-flex items-center justify-center gap-1.5 p-2.5 rounded-full bg-[#E3F4F5] text-xs font-bold text-[#0E7C86] hover:bg-[#0E7C86] hover:text-white transition-colors no-underline"
            >
              <span>Gérer toute l'équipe (12 collaborateurs)</span>
              <AdminIcon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Norme Hôtelière Palace -->
        <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-6 shadow-2xs space-y-3 text-xs">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
            Rappel de Procédure
          </span>
          <h4 class="font-bold text-[#0B2A2E]">
            Remplacement garanti sous 24h
          </h4>
          <p class="text-[#3D5A5E] leading-relaxed">
            En cas d'imprévu ou d'indisponibilité d'un collaborateur régulier, une préposée de réserve formée aux mêmes standards prend immédiatement le relais.
          </p>
        </div>

      </div>

    </div>

  </div>

  <!-- ======================================================== -->
  <!-- 4. MODALE CENTRÉE DE DÉTAIL ET PILOTAGE D'INTERVENTION -->
  <!-- ======================================================== -->
  <div
    id="mission-detail-modal"
    class="fixed inset-0 bg-[#0B2A2E]/60 backdrop-blur-sm z-[80] hidden items-center justify-center p-3 sm:p-5 md:p-8 transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
  >
    <div
      id="mission-detail-card"
      class="bg-white rounded-3xl shadow-2xl border border-[#0E7C86]/20 w-full max-w-3xl max-h-[92vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-200 ease-out"
    >
      <!-- En-tête Modale -->
      <div class="p-5 sm:p-6 border-b border-[#0E7C86]/12 flex items-center justify-between bg-white shrink-0">
        <div class="flex items-center gap-3.5">
          <span class="w-10 h-10 rounded-2xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center shadow-2xs">
            <AdminIcon name="calendar" class="w-5 h-5 text-[#0E7C86]" />
          </span>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86] block">
                Fiche d'Intervention
              </span>
              <span id="modal-mission-status" class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-200">
                Terminé
              </span>
            </div>
            <h2 class="text-lg sm:text-xl font-extrabold text-[#0B2A2E] leading-tight mt-0.5">
              Mission #<span id="modal-mission-id">MIS-841</span> — <span id="modal-mission-client">Résidence Mme Vachon</span>
            </h2>
          </div>
        </div>

        <button
          type="button"
          id="btn-close-mission-modal"
          class="p-2 text-[#3D5A5E] hover:text-[#0B2A2E] rounded-xl hover:bg-[#F5FAFA] transition-colors"
          aria-label="Fermer la modale"
        >
          <AdminIcon name="close" class="w-5 h-5" />
        </button>
      </div>

      <!-- Corps Déroulant -->
      <div class="flex-1 overflow-y-auto p-5 sm:p-6 lg:p-8 space-y-6 text-xs text-[#0B2A2E]">
        
        <!-- Bloc Date, Heure & Localisation -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/10 space-y-2">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#3D5A5E] block">
              Horaire & Date
            </span>
            <div class="flex items-center gap-2 text-sm font-bold text-[#0B2A2E]">
              <AdminIcon name="clock" class="w-4 h-4 text-[#0E7C86]" />
              <span id="modal-mission-time">08:30 — 11:30</span>
            </div>
            <p id="modal-mission-day" class="text-xs text-[#3D5A5E] font-medium">Aujourd'hui</p>
          </div>

          <div class="p-4 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/10 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#3D5A5E]">
                Lieu de l'intervention
              </span>
              <a
                id="modal-mission-maps-link"
                href="#"
                target="_blank"
                rel="noopener"
                class="text-[11px] font-bold text-[#0E7C86] hover:underline inline-flex items-center gap-1"
              >
                <span>Google Maps</span>
                <AdminIcon name="external" class="w-3 h-3" />
              </a>
            </div>
            <p id="modal-mission-address" class="text-xs font-bold text-[#0B2A2E]">
              Westmount, Av. Clarke (H3Y 3C7)
            </p>
            <p id="modal-mission-service" class="text-[11px] text-[#0E7C86] font-semibold">
              Entretien résidentiel régulier (Hebdo)
            </p>
          </div>
        </div>

        <!-- Bloc Client & Préposé(e) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <!-- Contact Client -->
          <div class="p-4 rounded-2xl bg-white border border-[#0E7C86]/15 space-y-2.5">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#3D5A5E] block">
              Coordonnées Client
            </span>
            <p id="modal-mission-client-detail" class="text-sm font-black text-[#0B2A2E]">Résidence Mme Vachon</p>
            <div class="flex flex-wrap items-center gap-2 pt-1">
              <a
                id="modal-mission-phone"
                href="tel:+15148924182"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#E3F4F5] text-[#0E7C86] font-bold text-xs hover:bg-[#0E7C86] hover:text-white transition-colors"
              >
                <AdminIcon name="phone" class="w-3.5 h-3.5" />
                <span id="modal-mission-phone-label">+1 (514) 892-4182</span>
              </a>
              <a
                id="modal-mission-email"
                href="mailto:vachon@gmail.com"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#F5FAFA] text-[#3D5A5E] font-medium text-xs hover:bg-[#E3F4F5] hover:text-[#0B2A2E] border border-[#0E7C86]/10 transition-colors"
              >
                <AdminIcon name="mail" class="w-3.5 h-3.5 text-[#0E7C86]" />
                <span id="modal-mission-email-label">Envoyer courriel</span>
              </a>
            </div>
          </div>

          <!-- Préposé Assigné & Réassignation -->
          <div class="p-4 rounded-2xl bg-white border border-[#0E7C86]/15 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#3D5A5E]">
                Personnel Assigné
              </span>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                Certifié(e)
              </span>
            </div>
            
            <div class="flex items-center gap-3">
              <div id="modal-mission-staff-avatar-box" class="w-10 h-10 rounded-full overflow-hidden border border-[#0E7C86]/20 bg-[#E3F4F5] flex items-center justify-center font-bold text-[#0E7C86] shrink-0">
                <img id="modal-mission-staff-img" src="/images/admin/staff-fatou.jpg" alt="" class="w-full h-full object-cover hidden" />
                <span id="modal-mission-staff-initials">FD</span>
              </div>
              <div class="flex-1">
                <select
                  id="modal-mission-staff-select"
                  class="w-full text-xs font-bold text-[#0B2A2E] bg-[#F5FAFA] border border-[#0E7C86]/20 rounded-xl px-2.5 py-1.5 focus:border-[#0E7C86] focus:ring-1 focus:ring-[#0E7C86] outline-hidden cursor-pointer"
                >
                  <option value="Fatou D.">Fatou D. (Préposée senior)</option>
                  <option value="Khadija B.">Khadija B. (Préposée certifiée)</option>
                  <option value="Jean-Marc T.">Jean-Marc T. (Technicien injection)</option>
                  <option value="Assane N.">Assane N. (Spécialiste commercial)</option>
                  <option value="Marie-Louise P.">Marie-Louise P. (Préposée polyvalente)</option>
                </select>
                <span class="text-[10px] text-[#3D5A5E] block mt-0.5">Réassignable instantanément</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Consignes d'Accès & Sécurité Clé -->
        <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200/60 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-900 inline-flex items-center gap-1.5">
              <AdminIcon name="key" class="w-3.5 h-3.5 text-amber-700" />
              <span>Consignes d'Accès & Coffre à clés</span>
            </span>
            <button
              type="button"
              id="btn-copy-access-key"
              class="text-[11px] font-bold text-amber-900 bg-amber-100 hover:bg-amber-200 px-2.5 py-1 rounded-md transition-colors"
            >
              Copier les consignes
            </button>
          </div>
          <p id="modal-mission-access-notes" class="text-xs font-mono font-bold text-amber-950 bg-white/80 p-2.5 rounded-xl border border-amber-200/50">
            Boîte à clés code #4182
          </p>
        </div>

        <!-- Checklist Hôtelière 42 Points (Interactive) -->
        <div class="p-5 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/12 space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <h4 class="text-xs font-extrabold text-[#0B2A2E] uppercase tracking-wider inline-flex items-center gap-1.5">
                <AdminIcon name="shield-check" class="w-4 h-4 text-[#0E7C86]" />
                <span>Protocole de Conformité Hôtelière</span>
              </h4>
              <p class="text-[11px] text-[#3D5A5E]">Contrôle qualité en 42 points obligatoires avant départ</p>
            </div>
            <span id="modal-checklist-percentage" class="px-2.5 py-1 rounded-full text-xs font-black bg-[#0E7C86] text-white">
              100% validé
            </span>
          </div>

          <!-- Barre de progression -->
          <div class="w-full bg-[#E3F4F5] h-2 rounded-full overflow-hidden">
            <div id="modal-checklist-bar" class="bg-[#0E7C86] h-full rounded-full transition-all duration-300" style="width: 100%;"></div>
          </div>

          <!-- Éléments de checklist interactifs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] pt-1" id="modal-checklist-items">
            <label class="flex items-center gap-2 p-2 bg-white rounded-xl border border-[#0E7C86]/10 cursor-pointer">
              <input type="checkbox" checked class="chk-step rounded text-[#0E7C86] focus:ring-0" />
              <span>Dépoussiérage plinthes & moulures</span>
            </label>
