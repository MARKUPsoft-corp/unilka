      const time = timeSelect?.value || '09:00 — 12:00';
      const client = (clientInput?.value || '').trim();
      const address = (addressInput?.value || '').trim();
      const service = serviceSelect?.value || 'Entretien résidentiel régulier';
      const staff = staffSelectEl?.value || 'Fatou D.';
      const access = (accessInput?.value || '').trim() || 'À confirmer avec le client';

      const newCode = `MIS-${Math.floor(860 + Math.random() * 90)}`;
      const dayFormatted = formatFrenchDate(date);
