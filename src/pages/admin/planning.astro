  <!-- 6. LOGIQUE CLIENT CALENDRIER & INTERACTIVITÉ -->
  <!-- ======================================================== -->
  <script is:inline define:vars={{ initialMissions }}>
    (function() {
      // 1. Stockage réactif des missions
      let missions = [];
      try {
        const stored = localStorage.getItem('unilka_calendar_missions');
        if (stored) {
          missions = JSON.parse(stored);
        } else {
          missions = [...initialMissions];
          localStorage.setItem('unilka_calendar_missions', JSON.stringify(missions));
        }
      } catch (e) {
        missions = [...initialMissions];
      }

      function saveMissions() {
        try {
          localStorage.setItem('unilka_calendar_missions', JSON.stringify(missions));
        } catch (e) {}
      }

      // Date active du calendrier (Année et Mois)
      let currentYear = 2026;
      let currentMonth = 9; // Octobre = index 9 (0-11)
      let activeFilter = 'all';
      let activeDayFullDate = '2026-10-27'; // Mardi 27 oct. par défaut

      const MONTH_NAMES = [
        "Janvier", "Février", "Mars", "Avril", "Mai", "Juin",
        "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"
      ];

      // Éléments DOM
      const viewWeekBtn = document.getElementById('btn-view-week');
      const viewMonthBtn = document.getElementById('btn-view-month');
      const viewWeekContainer = document.getElementById('view-week-container');
      const viewMonthContainer = document.getElementById('view-month-container');
      const calendarCellsGrid = document.getElementById('calendar-cells-grid');
      const currentMonthHeading = document.getElementById('calendar-current-label');
      const currentMonthCountLabel = document.getElementById('calendar-month-count-label');
      const subtitleCounter = document.getElementById('planning-subtitle-counter');
      const statusFilters = document.querySelectorAll('.cal-status-filter');

      // 2. Gestion de la Bascule de Vue (Semaine / Mois)
      function setView(view) {
        if (view === 'week') {
          viewWeekBtn.classList.add('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
          viewWeekBtn.classList.remove('text-[#3D5A5E]', 'font-bold');

          viewMonthBtn.classList.remove('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
          viewMonthBtn.classList.add('text-[#3D5A5E]', 'font-bold');

          viewWeekContainer.classList.remove('hidden');
          viewMonthContainer.classList.add('hidden');
          renderWeekMissions(activeDayFullDate);
        } else {
          viewMonthBtn.classList.add('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
          viewMonthBtn.classList.remove('text-[#3D5A5E]', 'font-bold');

          viewWeekBtn.classList.remove('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
          viewWeekBtn.classList.add('text-[#3D5A5E]', 'font-bold');

          viewMonthContainer.classList.remove('hidden');
          viewWeekContainer.classList.add('hidden');
          renderMonthlyCalendar();
        }
      }

      viewWeekBtn?.addEventListener('click', () => setView('week'));
      viewMonthBtn?.addEventListener('click', () => setView('month'));

      // 3. Rendu du Calendrier Mensuel avec les Missions dans les cases
      function renderMonthlyCalendar() {
        if (!calendarCellsGrid) return;
        calendarCellsGrid.innerHTML = '';

        if (currentMonthHeading) {
          currentMonthHeading.textContent = `${MONTH_NAMES[currentMonth]} ${currentYear}`;
        }

        // Premier jour du mois
        const firstDay = new Date(currentYear, currentMonth, 1);
        // Dimanche = 0 -> adapter pour Lundi = 0
        let startingDayIndex = firstDay.getDay() - 1;
        if (startingDayIndex === -1) startingDayIndex = 6;

        // Nombre de jours dans le mois
        const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
        // Nombre de jours dans le mois précédent
        const daysInPrevMonth = new Date(currentYear, currentMonth, 0).getDate();

        // Calculer missions du mois
        const monthPrefix = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`;
        const currentMonthMissions = missions.filter(m => m.date.startsWith(monthPrefix));
        
        if (currentMonthCountLabel) {
          currentMonthCountLabel.textContent = `${currentMonthMissions.length} interventions planifiées`;
        }
        if (subtitleCounter) {
          subtitleCounter.textContent = `${currentMonthMissions.length} interventions planifiées en ${MONTH_NAMES[currentMonth]} ${currentYear} dans le Grand Montréal.`;
        }

        // Cases du mois précédent (inactives)
        for (let i = startingDayIndex - 1; i >= 0; i--) {
          const dayNum = daysInPrevMonth - i;
          const cell = document.createElement('div');
          cell.className = 'min-h-[120px] sm:min-h-[135px] p-2 bg-[#F5FAFA]/40 text-[#3D5A5E]/40 flex flex-col justify-between';
          cell.innerHTML = `
            <div class="flex items-center justify-between text-xs font-bold opacity-50">
              <span>${dayNum}</span>
            </div>
            <div class="flex-1 mt-1"></div>
          `;
          calendarCellsGrid.appendChild(cell);
        }

        // Cases du mois en cours
        for (let day = 1; day <= daysInMonth; day++) {
          const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          const isToday = (dateStr === '2026-10-27'); // Démo calée sur le 27 oct 2026

          // Filtrer les missions de ce jour
          let dayMissions = missions.filter(m => m.date === dateStr);
          if (activeFilter !== 'all') {
            dayMissions = dayMissions.filter(m => m.status === activeFilter);
          }

          const cell = document.createElement('div');
          cell.className = `min-h-[120px] sm:min-h-[135px] p-2 bg-white flex flex-col justify-between transition-all duration-150 relative group cursor-pointer hover:bg-[#F5FAFA]/80 ${
            isToday ? 'bg-[#E3F4F5]/30 ring-2 ring-inset ring-[#0E7C86]' : ''
          }`;
          cell.dataset.date = dateStr;

          // En-tête de la case du jour
          const header = document.createElement('div');
          header.className = 'flex items-center justify-between text-xs font-extrabold pb-1';

          const leftBox = document.createElement('div');
          leftBox.className = 'flex items-center gap-1.5';
          if (isToday) {
            leftBox.innerHTML = `
              <span class="w-6 h-6 rounded-full bg-[#0E7C86] text-white flex items-center justify-center font-black text-xs shadow-xs">
                ${day}
              </span>
              <span class="text-[9px] font-extrabold uppercase text-[#0E7C86] hidden sm:inline">Auj.</span>
            `;
          } else {
            leftBox.innerHTML = `<span class="text-[#0B2A2E] text-xs font-bold pl-1">${day}</span>`;
          }

          const rightBox = document.createElement('div');
          rightBox.className = 'flex items-center gap-1';
          if (dayMissions.length > 0) {
            rightBox.innerHTML += `
              <span class="text-[10px] px-1.5 py-0.5 rounded-full font-extrabold ${
                isToday ? 'bg-[#0E7C86] text-white' : 'bg-[#E3F4F5] text-[#0E7C86]'
              }">
                ${dayMissions.length}
              </span>
            `;
          }
          rightBox.innerHTML += `
            <button
              type="button"
              class="btn-add-day-mission opacity-0 group-hover:opacity-100 transition-opacity w-5 h-5 rounded-full bg-[#E3F4F5] hover:bg-[#0E7C86] text-[#0E7C86] hover:text-white flex items-center justify-center text-xs font-bold"
              data-date="${dateStr}"
              title="Ajouter une intervention ce jour"
            >+</button>
          `;

          header.appendChild(leftBox);
          header.appendChild(rightBox);
          cell.appendChild(header);

          // Conteneur des missions dans la case du jour
          const missionsContainer = document.createElement('div');
          missionsContainer.className = 'space-y-1.5 overflow-hidden flex-1 mt-1';

          const visibleMissions = dayMissions.slice(0, 3);
          visibleMissions.forEach((mis, idx) => {
            const chip = document.createElement('div');
            
            // Couleurs selon statut
            let statusClasses = 'bg-[#F5FAFA] text-[#0B2A2E] border-[#0E7C86]/15 hover:border-[#0E7C86]/40';
            let dotColor = 'bg-amber-500';
            if (mis.status === 'Terminé') {
              statusClasses = 'bg-emerald-50 text-emerald-900 border-emerald-200/80 hover:bg-emerald-100/70';
              dotColor = 'bg-emerald-500';
            } else if (mis.status === 'En cours') {
              statusClasses = 'bg-sky-50 text-sky-900 border-sky-200/80 hover:bg-sky-100/70';
              dotColor = 'bg-sky-500';
            }

            chip.className = `mission-chip p-1.5 rounded-xl border text-[11px] font-semibold leading-tight flex items-center justify-between gap-1 shadow-2xs hover:shadow-xs transform hover:-translate-y-0.5 transition-all duration-150 cursor-pointer ${statusClasses}`;
            chip.dataset.id = mis.id;
            chip.style.animation = `fadeIn 200ms ease-out ${idx * 40}ms forwards`;

            chip.innerHTML = `
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="w-1.5 h-1.5 rounded-full ${dotColor} shrink-0"></span>
                <span class="font-extrabold text-[10px] shrink-0 text-[#0E7C86]">${mis.time.split(' ')[0]}</span>
                <span class="truncate font-bold text-[#0B2A2E]">${mis.client}</span>
              </div>
              <span class="text-[9px] font-bold text-[#3D5A5E] shrink-0 px-1 rounded bg-white/70">${mis.staff.split(' ')[0]}</span>
            `;

            chip.addEventListener('click', (e) => {
              e.stopPropagation();
              openMissionModal(mis);
            });

            missionsContainer.appendChild(chip);
          });

          if (dayMissions.length > 3) {
            const moreBadge = document.createElement('div');
            moreBadge.className = 'text-[10px] font-extrabold text-[#0E7C86] hover:underline text-center pt-0.5';
            moreBadge.textContent = `+ ${dayMissions.length - 3} autre(s)...`;
            moreBadge.addEventListener('click', (e) => {
              e.stopPropagation();
              activeDayFullDate = dateStr;
              setView('week');
            });
            missionsContainer.appendChild(moreBadge);
          }

          cell.appendChild(missionsContainer);

          // Clic sur la case elle-même pour ouvrir le jour
          cell.addEventListener('click', (e) => {
            if (e.target.closest('.btn-add-day-mission')) return;
            activeDayFullDate = dateStr;
            // Si le jour a des missions, on peut naviguer ou ouvrir la première
            if (dayMissions.length > 0) {
              openMissionModal(dayMissions[0]);
            } else {
              openNewMissionModal(dateStr);
            }
          });

          calendarCellsGrid.appendChild(cell);
        }

        // Cases de fin de grille pour compléter le 7x5 ou 7x6
        const totalRendered = startingDayIndex + daysInMonth;
        const remainingCells = (Math.ceil(totalRendered / 7) * 7) - totalRendered;
        for (let j = 1; j <= remainingCells; j++) {
          const cell = document.createElement('div');
          cell.className = 'min-h-[120px] sm:min-h-[135px] p-2 bg-[#F5FAFA]/40 text-[#3D5A5E]/40 flex flex-col justify-between';
          cell.innerHTML = `
            <div class="flex items-center justify-between text-xs font-bold opacity-50">
              <span>${j}</span>
            </div>
            <div class="flex-1 mt-1"></div>
          `;
          calendarCellsGrid.appendChild(cell);
        }

        // Attacher listener aux boutons + des cases
        document.querySelectorAll('.btn-add-day-mission').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const targetDate = btn.dataset.date;
            openNewMissionModal(targetDate);
          });
        });
      }

      // 4. Navigation Mois Précédent / Mois Suivant
      document.getElementById('cal-prev-month')?.addEventListener('click', () => {
        currentMonth--;
        if (currentMonth < 0) {
          currentMonth = 11;
          currentYear--;
        }
        renderMonthlyCalendar();
      });

      document.getElementById('cal-next-month')?.addEventListener('click', () => {
        currentMonth++;
        if (currentMonth > 11) {
          currentMonth = 0;
          currentYear++;
        }
        renderMonthlyCalendar();
      });

      document.getElementById('cal-today-btn')?.addEventListener('click', () => {
        currentYear = 2026;
        currentMonth = 9; // Octobre 2026
        renderMonthlyCalendar();
        if (window.showAdminToast) {
          window.showAdminToast("Retour à la date d'aujourd'hui (27 oct. 2026)");
        }
      });

      // 5. Filtres par Statut dans la vue Mois
      statusFilters.forEach(btn => {
        btn.addEventListener('click', () => {
          statusFilters.forEach(b => {
            b.classList.remove('active', 'bg-[#0E7C86]', 'text-white');
            b.classList.add('bg-[#F5FAFA]', 'text-[#3D5A5E]');
          });
          btn.classList.add('active', 'bg-[#0E7C86]', 'text-white');
          btn.classList.remove('bg-[#F5FAFA]', 'text-[#3D5A5E]');

          activeFilter = btn.dataset.filter || 'all';
          renderMonthlyCalendar();
        });
      });

      // 6. Rendu de la Vue Semaine
      const weekMissionsContainer = document.getElementById('week-missions-container');
      const weekSelectedTitle = document.getElementById('week-selected-title');
      const weekDayCards = document.querySelectorAll('.day-card');

      function renderWeekMissions(targetFullDate) {
        if (!weekMissionsContainer) return;
        weekMissionsContainer.innerHTML = '';

        const dayMissions = missions.filter(m => m.date === targetFullDate);
        
        // Mettre à jour titre
        const matchedDay = Array.from(weekDayCards).find(c => c.dataset.fulldate === targetFullDate);
        const dayName = matchedDay ? matchedDay.dataset.day : targetFullDate;
        if (weekSelectedTitle) {
          weekSelectedTitle.textContent = `Missions du ${dayName} (${dayMissions.length} intervention(s))`;
        }

        // Mettre à jour l'apparence des onglets jours
        weekDayCards.forEach(c => {
          const isSelected = (c.dataset.fulldate === targetFullDate);
          if (isSelected) {
            c.classList.add('active-day', 'bg-[#E3F4F5]', 'border-[#0E7C86]', 'text-[#0E7C86]', 'font-extrabold', 'shadow-2xs');
            c.classList.remove('bg-white', 'border-[#0E7C86]/12', 'text-[#0B2A2E]');
            const badge = c.querySelector('.day-count');
            if (badge) {
              badge.classList.add('bg-[#0E7C86]', 'text-white');
              badge.classList.remove('bg-[#F5FAFA]', 'text-[#3D5A5E]');
            }
          } else {
            c.classList.remove('active-day', 'bg-[#E3F4F5]', 'border-[#0E7C86]', 'text-[#0E7C86]', 'font-extrabold', 'shadow-2xs');
            c.classList.add('bg-white', 'border-[#0E7C86]/12', 'text-[#0B2A2E]');
            const badge = c.querySelector('.day-count');
            if (badge) {
              badge.classList.remove('bg-[#0E7C86]', 'text-white');
              badge.classList.add('bg-[#F5FAFA]', 'text-[#3D5A5E]');
            }
          }
        });

        if (dayMissions.length === 0) {
          weekMissionsContainer.innerHTML = `
            <div class="p-8 text-center bg-white rounded-2xl border border-[#0E7C86]/12 space-y-3">
              <span class="w-12 h-12 rounded-full bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center mx-auto text-lg font-black">
                !
              </span>
              <h3 class="text-sm font-bold text-[#0B2A2E]">Aucune mission programmée pour cette journée</h3>
              <p class="text-xs text-[#3D5A5E]">Vous pouvez planifier une intervention dès maintenant.</p>
              <button
                type="button"
                class="btn-plan-for-day px-4 py-2 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62]"
                data-date="${targetFullDate}"
              >
                + Planifier une intervention
              </button>
            </div>
          `;
          weekMissionsContainer.querySelector('.btn-plan-for-day')?.addEventListener('click', () => {
            openNewMissionModal(targetFullDate);
          });
          return;
        }

        dayMissions.forEach((mis, index) => {
          const card = document.createElement('div');
          card.className = "bg-white rounded-2xl border border-[#0E7C86]/12 p-6 shadow-2xs hover:border-[#0E7C86]/30 transition-all space-y-4";
          card.style.animation = `fadeIn 250ms ease-out ${index * 60}ms forwards`;

          card.innerHTML = `
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#0E7C86]/10">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-md bg-[#E3F4F5] text-[#0E7C86] text-xs font-black">
                  ${mis.time}
                </span>
                <span class="text-xs font-bold text-[#3D5A5E]">${mis.day}</span>
                <span class="text-xs font-mono text-[#3D5A5E]/60">#${mis.id}</span>
              </div>

              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold border ${mis.statusColor}">
                  ${mis.status}
                </span>
                <span class="text-[11px] font-semibold text-[#0E7C86] bg-[#F5FAFA] px-2 py-0.5 rounded">
                  ${mis.checklist}
                </span>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div class="space-y-1">
                <h3 class="text-sm font-extrabold text-[#0B2A2E]">${mis.client}</h3>
                <p class="text-[#3D5A5E] flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#0E7C86] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  <span>${mis.address}</span>
                </p>
                <p class="text-[#0E7C86] font-semibold">Prestation : ${mis.service}</p>
              </div>

              <div class="space-y-1 sm:border-l sm:border-[#0E7C86]/10 sm:pl-4">
                <div class="flex items-center gap-2.5">
                  ${mis.staffPhoto ? `
                    <img src="${mis.staffPhoto}" alt="${mis.staff}" class="w-8 h-8 rounded-full object-cover border border-[#0E7C86]/20 shrink-0" />
                  ` : `
                    <span class="w-8 h-8 rounded-full bg-[#E3F4F5] text-[#0E7C86] font-bold text-[10px] flex items-center justify-center shrink-0">
                      ${mis.staff.split(' ').map(n=>n[0]).join('')}
                    </span>
                  `}
                  <div>
                    <p class="text-[#3D5A5E]">
                      Préposé(e) : <strong class="text-[#0B2A2E]">${mis.staff}</strong>
                    </p>
                    <p class="text-[#3D5A5E] text-[11px]">${mis.staffRole}</p>
                  </div>
                </div>

                <div class="pt-1">
                  <span class="inline-flex items-center gap-1.5 text-amber-800 bg-amber-50 px-2 py-1 rounded text-[11px] font-medium border border-amber-200/50">
                    <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-1.5 1.5L16 7l-2-2-1.5 1.5 2 2L13 10l-2-2-1.5 1.5 2 2L10 13l-1.5-1.5L7 13l-1-1L2 16v6h6l4-4-1-1 1.5-1.5L14 16l1.5-1.5-2-2 1.5-1.5 2 2 1.5-1.5-2-2 2-2 1.5 1.5z"></path><circle cx="18" cy="6" r="3"></circle></svg>
                    <span>${mis.accessKey}</span>
                  </span>
                </div>
              </div>
            </div>

            <div class="pt-2 flex items-center justify-end gap-2 border-t border-[#0E7C86]/08">
              <button
                type="button"
                class="btn-open-detail px-4 py-1.5 text-xs font-bold text-[#0E7C86] bg-[#E3F4F5] hover:bg-[#0E7C86] hover:text-white rounded-full transition-colors"
                data-id="${mis.id}"
              >
                Inspecter la fiche
              </button>
            </div>
          `;

          card.querySelector('.btn-open-detail')?.addEventListener('click', () => {
            openMissionModal(mis);
          });

          weekMissionsContainer.appendChild(card);
        });
      }

      weekDayCards.forEach(c => {
        c.addEventListener('click', () => {
          activeDayFullDate = c.dataset.fulldate || '2026-10-27';
          renderWeekMissions(activeDayFullDate);
        });
      });

      // 7. Modale Détail de la Mission
      const detailModal = document.getElementById('mission-detail-modal');
      const detailCard = document.getElementById('mission-detail-card');
      const btnCloseDetail = document.getElementById('btn-close-mission-modal');
      const btnCloseDetailFooter = document.getElementById('btn-close-mission-modal-footer');
      const staffSelect = document.getElementById('modal-mission-staff-select');
      const btnToggleStatus = document.getElementById('btn-toggle-mission-status');
      const btnSaveMission = document.getElementById('btn-save-mission-changes');
      const btnCopyAccessKey = document.getElementById('btn-copy-access-key');

      let currentSelectedMission = null;

      function openMissionModal(mis) {
        if (!detailModal || !detailCard) return;
        currentSelectedMission = mis;

        document.getElementById('modal-mission-id').textContent = mis.id;
        document.getElementById('modal-mission-title').textContent = `${mis.client} (#${mis.id})`;
        document.getElementById('modal-mission-client').textContent = mis.client;
        document.getElementById('modal-mission-client-detail').textContent = mis.client;
        document.getElementById('modal-mission-time').textContent = mis.time;
        document.getElementById('modal-mission-day').textContent = mis.day || mis.date;
        document.getElementById('modal-mission-address').textContent = mis.address;
        document.getElementById('modal-mission-service').textContent = mis.service;
        document.getElementById('modal-mission-access-notes').textContent = mis.accessKey;

        // Statut
        const statusEl = document.getElementById('modal-mission-status');
        if (statusEl) {
          statusEl.textContent = mis.status;
          statusEl.className = `px-2.5 py-0.5 rounded-full text-[10px] font-extrabold border ${mis.statusColor}`;
        }

        // Téléphone & Courriel
        const phoneLink = document.getElementById('modal-mission-phone');
        const phoneLabel = document.getElementById('modal-mission-phone-label');
        if (phoneLink && phoneLabel) {
          phoneLink.href = `tel:${mis.phone || '+15148924182'}`;
          phoneLabel.textContent = mis.phone || '+1 (514) 892-4182';
        }

        const emailLink = document.getElementById('modal-mission-email');
        if (emailLink) {
          emailLink.href = `mailto:${mis.email || 'client@unilka.ca'}`;
        }

        // Google Maps
        const mapsLink = document.getElementById('modal-mission-maps-link');
        if (mapsLink) {
          mapsLink.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mis.address)}`;
        }

        // Staff Select
        if (staffSelect) {
          staffSelect.value = mis.staff;
        }

        // Staff Avatar
        const avatarImg = document.getElementById('modal-mission-staff-img');
        const avatarInitials = document.getElementById('modal-mission-staff-initials');
        if (mis.staffPhoto && avatarImg) {
          avatarImg.src = mis.staffPhoto;
          avatarImg.classList.remove('hidden');
          if (avatarInitials) avatarInitials.classList.add('hidden');
        } else {
          if (avatarImg) avatarImg.classList.add('hidden');
          if (avatarInitials) {
            avatarInitials.textContent = mis.staff.split(' ').map(n=>n[0]).join('');
            avatarInitials.classList.remove('hidden');
          }
        }

        // Afficher modale avec animation
        detailModal.classList.remove('hidden');
        detailModal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        requestAnimationFrame(() => {
          detailCard.classList.remove('scale-95', 'opacity-0');
          detailCard.classList.add('scale-100', 'opacity-100');
        });
      }

      function closeMissionModal() {
        if (!detailModal || !detailCard) return;
        detailCard.classList.remove('scale-100', 'opacity-100');
        detailCard.classList.add('scale-95', 'opacity-0');
        document.body.style.overflow = '';
        setTimeout(() => {
          detailModal.classList.add('hidden');
          detailModal.classList.remove('flex');
        }, 200);
      }

      btnCloseDetail?.addEventListener('click', closeMissionModal);
      btnCloseDetailFooter?.addEventListener('click', closeMissionModal);
      detailModal?.addEventListener('click', (e) => {
        if (e.target === detailModal) closeMissionModal();
      });

      // Copier les consignes d'accès
      btnCopyAccessKey?.addEventListener('click', () => {
        const text = document.getElementById('modal-mission-access-notes')?.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          if (window.showAdminToast) {
            window.showAdminToast("Consignes d'accès copiées dans le presse-papier !");
          }
        });
      });

      // Basculer statut
      btnToggleStatus?.addEventListener('click', () => {
        if (!currentSelectedMission) return;
        if (currentSelectedMission.status === 'Terminé') {
          currentSelectedMission.status = 'En cours';
          currentSelectedMission.statusColor = 'bg-sky-100 text-sky-800 border-sky-200';
        } else if (currentSelectedMission.status === 'En cours') {
          currentSelectedMission.status = 'Planifié';
          currentSelectedMission.statusColor = 'bg-gray-100 text-gray-800 border-gray-200';
        } else {
          currentSelectedMission.status = 'Terminé';
          currentSelectedMission.statusColor = 'bg-emerald-100 text-emerald-800 border-emerald-200';
        }

        const statusEl = document.getElementById('modal-mission-status');
        if (statusEl) {
          statusEl.textContent = currentSelectedMission.status;
          statusEl.className = `px-2.5 py-0.5 rounded-full text-[10px] font-extrabold border ${currentSelectedMission.statusColor}`;
        }

        saveMissions();
        renderMonthlyCalendar();
        renderWeekMissions(activeDayFullDate);
        if (window.showAdminToast) {
          window.showAdminToast(`Statut mis à jour : ${currentSelectedMission.status}`);
        }
      });

      // Enregistrer changements de préposé
      btnSaveMission?.addEventListener('click', () => {
        if (!currentSelectedMission || !staffSelect) return;
        const newStaff = staffSelect.value;
        currentSelectedMission.staff = newStaff;
        saveMissions();
        renderMonthlyCalendar();
        renderWeekMissions(activeDayFullDate);
        closeMissionModal();
        if (window.showAdminToast) {
          window.showAdminToast(`Mission #${currentSelectedMission.id} assignée à ${newStaff} !`);
        }
      });

      // 8. Modale Nouvelle Intervention
      const newMissionModal = document.getElementById('new-mission-modal');
      const newMissionCard = document.getElementById('new-mission-card');
      const btnOpenNew = document.getElementById('btn-open-new-mission');
      const btnCloseNew = document.getElementById('btn-close-new-mission');
      const btnCancelNew = document.getElementById('btn-cancel-new-mission');
      const newMissionForm = document.getElementById('new-mission-form');

      function openNewMissionModal(prefillDate) {
        if (!newMissionModal || !newMissionCard) return;
        const dateInput = document.getElementById('new-date');
        if (dateInput && prefillDate) {
          dateInput.value = prefillDate;
        }

        newMissionModal.classList.remove('hidden');
        newMissionModal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        requestAnimationFrame(() => {
          newMissionCard.classList.remove('scale-95', 'opacity-0');
          newMissionCard.classList.add('scale-100', 'opacity-100');
        });
      }

      function closeNewMissionModal() {
        if (!newMissionModal || !newMissionCard) return;
        newMissionCard.classList.remove('scale-100', 'opacity-100');
        newMissionCard.classList.add('scale-95', 'opacity-0');
        document.body.style.overflow = '';
        setTimeout(() => {
          newMissionModal.classList.add('hidden');
          newMissionModal.classList.remove('flex');
        }, 200);
      }

      btnOpenNew?.addEventListener('click', () => openNewMissionModal(activeDayFullDate));
      btnCloseNew?.addEventListener('click', closeNewMissionModal);
      btnCancelNew?.addEventListener('click', closeNewMissionModal);
      newMissionModal?.addEventListener('click', (e) => {
        if (e.target === newMissionModal) closeNewMissionModal();
      });

      // Soumission formulaire nouvelle intervention
      newMissionForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const date = document.getElementById('new-date').value;
        const time = document.getElementById('new-time').value;
        const client = document.getElementById('new-client').value.trim();
        const address = document.getElementById('new-address').value.trim();
        const service = document.getElementById('new-service').value;
        const staff = document.getElementById('new-staff').value;
        const access = document.getElementById('new-access').value.trim() || 'À confirmer avec le client';

        const newId = `MIS-${Math.floor(860 + Math.random() * 90)}`;
        const dateObj = new Date(date + 'T12:00:00');
        const dayFormatted = `${['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'][dateObj.getDay()]} ${dateObj.getDate()} ${MONTH_NAMES[dateObj.getMonth()].slice(0,3)}.`;

        const newMission = {
          id: newId,
          date: date,
          day: dayFormatted,
          time: time,
          client: client,
          phone: "+1 514 555-0199",
          email: "client@unilka.ca",
          address: address,
          service: service,
          category: service.toLowerCase().includes('bureau') ? 'commercial' : 'residentiel',
          staff: staff,
          staffRole: "Préposé(e) dédié(e)",
          staffPhoto: staff === 'Fatou D.' ? '/images/admin/staff-fatou.jpg' : (staff === 'Jean-Marc T.' ? '/images/admin/staff-jeanmarc.jpg' : ''),
          status: "Planifié",
          statusColor: "bg-gray-100 text-gray-800 border-gray-200",
          checklist: "Grille hôtelière 42 pts",
          checklistProgress: 0,
          accessKey: access
        };

        missions.unshift(newMission);
        saveMissions();

        // Réinitialiser formulaire
        newMissionForm.reset();
        closeNewMissionModal();

        // Mettre à jour calendriers
        activeDayFullDate = date;
        renderMonthlyCalendar();
        renderWeekMissions(date);

        if (window.showAdminToast) {
          window.showAdminToast(`Intervention #${newId} pour ${client} planifiée avec succès !`);
        }
      });

      // Fermeture des modales avec la touche Échap
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeMissionModal();
          closeNewMissionModal();
        }
      });

      // 9. Initialisation par défaut : vue Mois
      setView('month');
      renderMonthlyCalendar();

    })();
  </script>

  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

</AdminLayout>
