      try {
        await navigator.clipboard.writeText(msg);
        if (copyBtnText) copyBtnText.textContent = "✓ Message copié !";
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = "Copier le message d'invitation";
        }, 3000);
