      <!-- Bloc 2 : Planning des interventions d'aujourd'hui avec photos préposés -->
      <div class="bg-white rounded-2xl border border-[#0E7C86]/12 overflow-hidden shadow-2xs">
        <div class="p-5 sm:p-6 border-b border-[#0E7C86]/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <h2 class="text-base font-extrabold text-[#0B2A2E]">
              Interventions d'aujourd'hui (Montréal & Rive-Sud)
            </h2>
          </div>
          <span class="text-xs font-semibold text-[#3D5A5E] inline-flex items-center gap-1.5">
            <AdminIcon name="calendar" class="w-3.5 h-3.5 text-[#0E7C86]" />
            Mardi 27 octobre 2026
