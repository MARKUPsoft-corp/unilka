            <div class="p-5 sm:p-6 hover:bg-[#F5FAFA] transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4 submission-item" data-id={sub.rawId || sub.id}>
              
              <div class="flex items-start gap-4 flex-1">
                <!-- Miniature photo réelle de l'espace ou de la demande -->
                <div class="relative w-20 h-20 rounded-xl overflow-hidden shrink-0 border border-[#0E7C86]/15 bg-gray-100 flex items-center justify-center">
                  {sub.image ? (
                    <img
                      src={sub.image}
                      alt={sub.service}
                      class="w-full h-full object-cover"
