        <div class="p-4 bg-[#F5FAFA] border-t border-[#0E7C86]/10 text-center">
          <a id="total-submissions-link" href="/admin/soumissions/" class="text-xs font-bold text-[#0E7C86] hover:underline inline-flex items-center gap-1">
            <span>Consulter l'historique complet de toutes les soumissions ({totalCount})</span>
            <AdminIcon name="arrow-right" class="w-3 h-3" />
