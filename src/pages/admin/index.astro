        <span class="w-7 h-7 rounded-lg bg-[#FFB703]/20 text-[#0B2A2E] flex items-center justify-center text-xs font-black">
          $
        </span>
      </div>
      <div>
        <span class="text-3xl font-black text-[#0B2A2E] tracking-tight">16 420 $</span>
        <p class="text-xs text-[#3D5A5E] mt-1">+22% vs mois dernier (Stripe & Interac)</p>
      </div>
      <div class="pt-2 border-t border-[#0E7C86]/10 flex items-center justify-between text-[11px] text-[#0E7C86] font-bold">
        <span>Commissions Stripe : 432,60 $</span>
        <a href="/admin/facturation/" class="hover:underline inline-flex items-center gap-1">
          <span>Finances</span>
          <AdminIcon name="arrow-right" class="w-3 h-3" />
        </a>
      </div>
    </div>

  </div>

  <!-- 3. SECTION GRAPHIQUES DE VISUALISATION DE DONNÉES -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-7">
      <AdminCharts type="revenue-area" />
    </div>
    <div class="lg:col-span-5">
      <AdminCharts type="services-donut" />
    </div>
  </div>

  <!-- 4. GRILLE CENTRALE DE GESTION AVEC PHOTOS RÉELLES -->
