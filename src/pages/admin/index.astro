    statusColor: "bg-amber-100 text-amber-900 border-amber-200",
    image: "/images/service-specialized.jpg",
    hasPhotos: true
  }
];

function formatRelativeTime(dateStr: string | undefined): string {
  if (!dateStr) return 'Récemment';
  const diffMs = Date.now() - new Date(dateStr).getTime();
  const diffMins = Math.floor(diffMs / (1000 * 60));
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffMins < 1) return "À l'instant";
  if (diffMins < 60) return `Il y a ${diffMins} min`;
  if (diffHours < 24) return `Il y a ${diffHours}h`;
  if (diffDays === 1) return `Hier`;
  return `Il y a ${diffDays} jours`;
}

let livePendingSubmissions: any[] = [];
let totalSubmissionsCount = 0;
let pendingSubmissionsCount = 0;
let candidatesCount = 0;
let liveActivities: any[] = [];

try {
  const { db } = await import('../../lib/firebase');
  const { collection, getDocs, query, orderBy, limit } = await import('firebase/firestore');

  // 1. Récupération des soumissions Firestore
  const qSub = query(collection(db, 'submissions'), orderBy('createdAt', 'desc'), limit(50));
  const snap = await getDocs(qSub);
  totalSubmissionsCount = snap.size;

  const rawSubmissions = snap.docs.map(doc => {
    const data = doc.data();
    const d = data.createdAt ? new Date(data.createdAt) : new Date();
    const formattedDate = d.toLocaleDateString('fr-CA', {
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit'
    });

    const hasPhotos = Boolean(data.hasPhotos || (Array.isArray(data.photos) && data.photos.length > 0));
    const image = data.photoUrl || (Array.isArray(data.photos) && data.photos[0]?.url) || '';

    const isPending = !data.status || data.status === 'À traiter' || data.status === 'Nouveau' || data.status === 'nouveau';
    if (isPending) pendingSubmissionsCount++;

    return {
      rawId: doc.id,
      id: `SOU-${doc.id.substring(0, 5).toUpperCase()}`,
      client: data.client || `${data.firstName || ''} ${data.lastName || ''}`.trim() || 'Client',
      email: data.email || '',
      phone: data.phone || '',
      service: `${data.service || 'Nettoyage résidentiel'} (${data.frequency || 'Ponctuel'})`,
      location: data.location || (data.city ? `${data.city}, QC` : 'Montréal'),
      dateDesired: formattedDate,
      surface: data.surface || 'Non spécifiée',
      status: data.status === 'À traiter' ? 'Nouveau' : (data.status || 'Nouveau'),
      statusColor: data.statusColor || 'bg-amber-100 text-amber-900 border-amber-200',
      image,
      hasPhotos,
      createdAt: data.createdAt,
      isPending
    };
  });

  livePendingSubmissions = rawSubmissions.filter(s => s.isPending);
  if (livePendingSubmissions.length === 0 && rawSubmissions.length > 0) {
    livePendingSubmissions = rawSubmissions.slice(0, 10);
  }

  // 2. Récupération des candidatures Firestore
  const qCand = query(collection(db, 'candidates'), orderBy('createdAt', 'desc'), limit(20));
  const candSnap = await getDocs(qCand);
  candidatesCount = candSnap.size;

  // 3. Activités récentes dynamiques
  const subActs = rawSubmissions.slice(0, 3).map(s => ({
    type: "soumission",
    title: "Nouvelle soumission reçue",
    desc: `${s.client} a demandé un devis (${s.service}, ${s.location}).`,
    time: formatRelativeTime(s.createdAt),
    timestamp: s.createdAt ? new Date(s.createdAt).getTime() : 0,
    badge: "Soumission"
  }));

  const candActs = candSnap.docs.slice(0, 3).map(doc => {
    const data = doc.data();
    const name = data.candidateName || data.name || `${data.firstName || ''} ${data.lastName || ''}`.trim() || 'Candidat';
    return {
      type: "candidature",
      title: "Nouvelle candidature reçue",
      desc: `${name} a postulé (${data.availability || 'Dispo'}, ${data.city || 'Montréal'}).`,
      time: formatRelativeTime(data.createdAt),
      timestamp: data.createdAt ? new Date(data.createdAt).getTime() : 0,
      badge: "Recrutement"
    };
  });

  liveActivities = [...subActs, ...candActs].sort((a, b) => b.timestamp - a.timestamp).slice(0, 4);

} catch (err: any) {
  console.warn('[Admin Dashboard] Chargement Firestore échoué (mode démo actif) :', err?.message);
}

const pendingSubmissions = livePendingSubmissions.length > 0 ? livePendingSubmissions : defaultPendingSubmissions;
const pendingCount = pendingSubmissionsCount || (livePendingSubmissions.length > 0 ? livePendingSubmissions.length : defaultPendingSubmissions.length);
const totalCount = totalSubmissionsCount || pendingCount;
const candCount = candidatesCount || 11;
const recentActivities = liveActivities.length > 0 ? liveActivities : [
  {
    type: "candidature",
    title: "Nouvelle candidature reçue",
    desc: "Marie-Claire K. a postulé comme préposée (Dispo temps plein, Lanaudière).",
    time: "Il y a 28 min",
    badge: "Recrutement"
  },
  {
    type: "paiement",
    title: "Paiement Stripe confirmé",
    desc: "Facture #FAC-2026-118 réglée par carte de crédit (345,00 $ CAD).",
    time: "Il y a 1h 40m",
    badge: "Stripe"
  },
  {
    type: "soumission",
