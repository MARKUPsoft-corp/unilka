                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0 sm:self-center">
                <a
                  href={`/admin/soumissions/?id=${sub.rawId || sub.id}`}
                  class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full transition-colors no-underline shadow-2xs"
