                    <span class="text-xs font-bold text-[#0B2A2E]">{m.client}</span>
                  </div>
                  <p class="text-xs text-[#3D5A5E] inline-flex items-center gap-1">
                    <AdminIcon name="location" class="w-3 h-3 text-[#3D5A5E]" />
                    {m.address} • {m.service}
                  </p>
                  <p class="text-xs text-[#0B2A2E] font-medium">
                    Préposé(e) : <strong class="text-[#0E7C86]">{m.staff}</strong> <span class="text-[11px] text-[#3D5A5E]">({m.staffRole})</span>
                  </p>
                </div>
              </div>

              <div class="shrink-0 flex items-center gap-3">
                <span class={`text-[11px] font-bold px-3 py-1 rounded-full border ${m.checklistColor} inline-flex items-center gap-1.5`}>
                  <AdminIcon name="check" class="w-3 h-3" />
                  {m.checklist}
                </span>
                <a
                  href="/admin/planning/"
                  class="p-2 text-[#3D5A5E] hover:text-[#0E7C86] rounded-lg hover:bg-[#F5FAFA] transition-colors"
                  title="Modifier l'assignation"
                  aria-label="Modifier"
                >
                  <AdminIcon name="arrow-right" class="w-4 h-4" />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Colonne Latérale : Alertes récentes & Actions rapides (4 cols) -->
    <div class="lg:col-span-4 space-y-6">
      
      <!-- Actions Rapides Direction -->
      <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-6 shadow-2xs space-y-4">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#0E7C86]">
          Actions Rapides
        </h3>

        <div class="space-y-2">
          <a
            href="/admin/soumissions/"
            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F5FAFA] hover:bg-[#E3F4F5] border border-[#0E7C86]/10 text-xs font-bold text-[#0B2A2E] transition-colors no-underline group"
          >
            <div class="flex items-center gap-2.5">
              <AdminIcon name="plus" class="w-4 h-4 text-[#0E7C86]" />
              <span>Créer un devis manuel</span>
            </div>
            <AdminIcon name="arrow-right" class="w-3.5 h-3.5 text-[#0E7C86] group-hover:translate-x-0.5 transition-transform" />
          </a>

          <a
            href="/admin/planning/"
            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F5FAFA] hover:bg-[#E3F4F5] border border-[#0E7C86]/10 text-xs font-bold text-[#0B2A2E] transition-colors no-underline group"
          >
            <div class="flex items-center gap-2.5">
              <AdminIcon name="calendar" class="w-4 h-4 text-[#0E7C86]" />
              <span>Planifier une intervention</span>
            </div>
            <AdminIcon name="arrow-right" class="w-3.5 h-3.5 text-[#0E7C86] group-hover:translate-x-0.5 transition-transform" />
          </a>

          <a
            href="/admin/facturation/"
            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F5FAFA] hover:bg-[#E3F4F5] border border-[#0E7C86]/10 text-xs font-bold text-[#0B2A2E] transition-colors no-underline group"
          >
            <div class="flex items-center gap-2.5">
              <AdminIcon name="credit-card" class="w-4 h-4 text-[#0E7C86]" />
              <span>Générer un lien Stripe</span>
            </div>
            <AdminIcon name="arrow-right" class="w-3.5 h-3.5 text-[#0E7C86] group-hover:translate-x-0.5 transition-transform" />
          </a>

          <a
            href="/admin/equipe/"
            class="w-full flex items-center justify-between p-3 rounded-xl bg-[#F5FAFA] hover:bg-[#E3F4F5] border border-[#0E7C86]/10 text-xs font-bold text-[#0B2A2E] transition-colors no-underline group"
          >
            <div class="flex items-center gap-2.5">
              <AdminIcon name="users" class="w-4 h-4 text-[#0E7C86]" />
              <span id="quick-action-candidates-count">Voir les candidatures reçues ({candCount})</span>
            </div>
            <span class="w-2 h-2 rounded-full bg-[#FFB703]"></span>
          </a>
        </div>
      </div>

      <!-- Vitrine d'inspection hôtelière avec photo réelle -->
      <div class="bg-white rounded-2xl border border-[#0E7C86]/12 overflow-hidden shadow-2xs">
        <div class="relative h-40 w-full overflow-hidden">
          <img
            src="/images/philosophy-unilka.jpg"
            alt="Inspection 42 points"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B2A2E]/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-4 right-4 text-white">
            <span class="text-[9px] font-extrabold uppercase tracking-widest text-[#FFB703] block">
              Contrôle Qualité Palace
            </span>
            <span class="text-xs font-extrabold block">
              100% des préposés cautionnés & certifiés
            </span>
          </div>
        </div>
        <div class="p-4 space-y-2 text-xs">
          <p class="text-[#3D5A5E] leading-relaxed text-[11px]">
            Toutes les interventions de la semaine à Westmount et Outremont ont validé les 42 points de conformité sans réserve.
          </p>
          <div class="flex items-center justify-between text-[11px] font-bold text-[#0E7C86] pt-1 border-t border-[#0E7C86]/10">
            <span>Grille de contrôle hôtelière</span>
            <span class="inline-flex items-center gap-1">
              <AdminIcon name="shield-check" class="w-3.5 h-3.5 text-emerald-600" />
              Conforme
            </span>
          </div>
        </div>
      </div>

      <!-- Journal d'activité récente -->
      <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-6 shadow-2xs space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#0E7C86]">
            Activités Récentes
          </h3>
          <span class="text-[10px] text-[#3D5A5E] flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86] animate-pulse"></span>
            <span>Temps réel</span>
          </span>
        </div>

        <div class="space-y-4" id="recent-activities-container">
          {recentActivities.map((act) => (
            <div class="flex items-start gap-3 text-xs pb-3 border-b border-[#0E7C86]/08 last:border-0 last:pb-0">
              <span class={`w-2 h-2 rounded-full ${act.type === 'soumission' ? 'bg-[#0E7C86]' : 'bg-[#FFB703]'} shrink-0 mt-1.5`}></span>
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-[#0B2A2E]">{act.title}</span>
                  <span class={`text-[9px] font-extrabold ${act.type === 'soumission' ? 'bg-[#E3F4F5] text-[#0E7C86]' : 'bg-[#FFB703]/20 text-[#0B2A2E]'} px-1.5 py-0.2 rounded`}>
                    {act.badge}
                  </span>
                </div>
                <p class="text-[#3D5A5E] leading-relaxed text-[11px]">{act.desc}</p>
                <span class="text-[10px] text-[#3D5A5E]/60">{act.time}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>

  <!-- Synchronisation temps réel Firestore du Dashboard -->
  <script>
    import { db } from '../../lib/firebase';
    import { collection, onSnapshot, query, orderBy, limit } from 'firebase/firestore';

    let isInitialSubLoad = true;
    let latestSubmissions: any[] = [];
    let latestCandidates: any[] = [];

    function getRelativeTime(timestamp: number): string {
      const diffMs = Date.now() - timestamp;
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);
      if (diffMins < 1) return "À l'instant";
      if (diffMins < 60) return `Il y a ${diffMins} min`;
      if (diffHours < 24) return `Il y a ${diffHours}h`;
      if (diffDays === 1) return `Hier`;
      return `Il y a ${diffDays} jours`;
    }

    function updateActivitiesFeed() {
      const actContainer = document.getElementById('recent-activities-container');
      if (!actContainer) return;

      const subActs = latestSubmissions.slice(0, 3).map(s => ({
        type: "soumission",
        title: "Nouvelle soumission reçue",
        desc: `${s.client} a demandé un devis (${s.service}, ${s.location}).`,
        time: getRelativeTime(s.timestamp),
        timestamp: s.timestamp,
        badge: "Soumission"
      }));

      const candActs = latestCandidates.slice(0, 3).map(c => ({
        type: "candidature",
        title: "Nouvelle candidature reçue",
        desc: `${c.name} a postulé (${c.availability || 'Dispo'}, ${c.city || 'Montréal'}).`,
        time: getRelativeTime(c.timestamp),
        timestamp: c.timestamp,
        badge: "Recrutement"
      }));

      const merged = [...subActs, ...candActs].sort((a, b) => b.timestamp - a.timestamp).slice(0, 4);
      if (merged.length > 0) {
        actContainer.innerHTML = merged.map(act => `
          <div class="flex items-start gap-3 text-xs pb-3 border-b border-[#0E7C86]/08 last:border-0 last:pb-0">
            <span class="w-2 h-2 rounded-full ${act.type === 'soumission' ? 'bg-[#0E7C86]' : 'bg-[#FFB703]'} shrink-0 mt-1.5"></span>
            <div class="space-y-0.5">
              <div class="flex items-center gap-2">
                <span class="font-bold text-[#0B2A2E]">${act.title}</span>
                <span class="text-[9px] font-extrabold ${act.type === 'soumission' ? 'bg-[#E3F4F5] text-[#0E7C86]' : 'bg-[#FFB703]/20 text-[#0B2A2E]'} px-1.5 py-0.2 rounded">
                  ${act.badge}
                </span>
              </div>
              <p class="text-[#3D5A5E] leading-relaxed text-[11px]">${act.desc}</p>
              <span class="text-[10px] text-[#3D5A5E]/60">${act.time}</span>
            </div>
          </div>
        `).join('');
      }
    }

    try {
      // 1. Écouteur en direct sur les soumissions
      const subQ = query(collection(db, 'submissions'), orderBy('createdAt', 'desc'), limit(50));
      onSnapshot(subQ, (snapshot) => {
        const totalCount = snapshot.size;
        let pendingCount = 0;
        const items: any[] = [];

        snapshot.docs.forEach(doc => {
          const data = doc.data();
          const isPending = !data.status || data.status === 'À traiter' || data.status === 'Nouveau' || data.status === 'nouveau';
          if (isPending) pendingCount++;

          const ts = data.createdAt ? new Date(data.createdAt).getTime() : Date.now();
          const d = new Date(ts);
          const formattedDate = d.toLocaleDateString('fr-CA', {
            day: 'numeric',
            month: 'short',
            hour: '2-digit',
            minute: '2-digit'
          });

          const hasPhotos = Boolean(data.hasPhotos || (Array.isArray(data.photos) && data.photos.length > 0));
          const image = data.photoUrl || (Array.isArray(data.photos) && data.photos[0]?.url) || '';

          items.push({
            rawId: doc.id,
            id: `SOU-${doc.id.substring(0, 5).toUpperCase()}`,
            client: data.client || `${data.firstName || ''} ${data.lastName || ''}`.trim() || 'Client',
            service: `${data.service || 'Nettoyage résidentiel'} (${data.frequency || 'Ponctuel'})`,
            location: data.location || (data.city ? `${data.city}, QC` : 'Montréal'),
            dateDesired: formattedDate,
            surface: data.surface || 'Non spécifiée',
            status: data.status === 'À traiter' ? 'Nouveau' : (data.status || 'Nouveau'),
            statusColor: data.statusColor || 'bg-amber-100 text-amber-900 border-amber-200',
            image,
            hasPhotos,
            timestamp: ts,
            isPending
          });
        });

        latestSubmissions = items;

        // Mise à jour des compteurs et KPI
        const btnCount = document.getElementById('btn-pending-count');
        if (btnCount) btnCount.textContent = `Traiter les ${pendingCount || totalCount} soumissions`;

        const kpiBadge = document.getElementById('kpi-submissions-badge');
        if (kpiBadge) kpiBadge.textContent = String(pendingCount || totalCount);

        const kpiVal = document.getElementById('kpi-submissions-val');
        if (kpiVal) kpiVal.textContent = `${pendingCount || totalCount} en attente`;

        const kpiSub = document.getElementById('kpi-submissions-sub');
        if (kpiSub) {
          kpiSub.innerHTML = pendingCount > 0 
            ? 'Délai moyen de réponse : <strong>2h 15m</strong>' 
            : 'Toutes les demandes sont traitées';
        }

        const tableBadge = document.getElementById('table-pending-count');
        if (tableBadge) tableBadge.textContent = `${pendingCount || totalCount} demandes en attente`;

        const totalLink = document.getElementById('total-submissions-link');
        if (totalLink) {
          totalLink.innerHTML = `<span>Consulter l'historique complet de toutes les soumissions (${totalCount})</span><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>`;
        }

        // Mise à jour du tableau des soumissions entrantes
        const container = document.getElementById('submissions-list-container');
        const pendingItems = items.filter(i => i.isPending);
        const displayItems = pendingItems.length > 0 ? pendingItems.slice(0, 10) : items.slice(0, 10);

        if (container && displayItems.length > 0) {
          container.innerHTML = displayItems.map(sub => `
            <div class="p-5 sm:p-6 hover:bg-[#F5FAFA] transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4 submission-item" data-id="${sub.rawId}">
              <div class="flex items-start gap-4 flex-1">
                <div class="relative w-20 h-20 rounded-xl overflow-hidden shrink-0 border border-[#0E7C86]/15 bg-gray-100 flex items-center justify-center">
                  ${sub.image 
                    ? `<img src="${sub.image}" alt="${sub.service}" class="w-full h-full object-cover" loading="lazy" />`
                    : `<div class="w-full h-full bg-[#E3F4F5] flex flex-col items-center justify-center text-[#0E7C86]">
                         <svg class="w-6 h-6 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                         <span class="text-[9px] font-bold mt-1">Devis</span>
                       </div>`
                  }
                  ${sub.hasPhotos ? `
                    <span class="absolute bottom-1 right-1 bg-[#0B2A2E]/80 text-white p-1 rounded-md" title="Photos jointes par le client">
                      <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </span>
                  ` : ''}
                </div>

                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-black text-[#0B2A2E]">${sub.client}</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border ${sub.statusColor}">
                      ${sub.status}
                    </span>
                    <span class="text-[11px] text-[#3D5A5E]/70 font-mono">#${sub.id}</span>
                  </div>
                  <p class="text-xs font-bold text-[#0E7C86] truncate">${sub.service}</p>
                  
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-[#3D5A5E]">
                    <span class="inline-flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-[#0E7C86]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      ${sub.location}
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-[#0E7C86]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                      ${sub.surface}
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-[#0E7C86]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      ${sub.dateDesired}
                    </span>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0 sm:self-center">
                <a
                  href="/admin/soumissions/?id=${sub.rawId}"
                  class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] rounded-full transition-colors no-underline shadow-2xs"
                >
                  <span>Chiffrer</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          `).join('');
        }

        updateActivitiesFeed();

        // Notification toast en direct si une soumission est ajoutée pendant la session
        if (!isInitialSubLoad) {
          snapshot.docChanges().forEach(change => {
            if (change.type === 'added') {
              const d = change.doc.data();
              const clientName = d.client || `${d.firstName || ''} ${d.lastName || ''}`.trim() || 'Un client';
              if ((window as any).showAdminToast) {
                (window as any).showAdminToast(`Nouvelle soumission en direct : ${clientName} (${d.service || 'Ménage'})`);
              }
            }
          });
        }
        isInitialSubLoad = false;
      });

      // 2. Écouteur en direct sur les candidats
      const candQ = query(collection(db, 'candidates'), orderBy('createdAt', 'desc'), limit(20));
      onSnapshot(candQ, (snapshot) => {
        const count = snapshot.size;
        const quickBtn = document.getElementById('quick-action-candidates-count');
        if (quickBtn) quickBtn.textContent = `Voir les candidatures reçues (${count})`;

        latestCandidates = snapshot.docs.map(doc => {
          const data = doc.data();
          const name = data.candidateName || data.name || `${data.firstName || ''} ${data.lastName || ''}`.trim() || 'Candidat';
          const ts = data.createdAt ? new Date(data.createdAt).getTime() : Date.now();
          return {
            name,
            city: data.city || 'Montréal',
            availability: data.availability || 'Dispo',
            timestamp: ts
          };
        });

        updateActivitiesFeed();
      });
    } catch (err) {
      console.warn('[Admin Dashboard] Erreur synchronisation temps réel :', err);
    }
  </script>

</AdminLayout>
