                    <div class="w-full h-full bg-[#E3F4F5] flex flex-col items-center justify-center text-[#0E7C86]">
                      <AdminIcon name="document" class="w-6 h-6 opacity-60" />
                      <span class="text-[9px] font-bold mt-1">Devis</span>
                    </div>
                  )}
                  {sub.hasPhotos && (
                    <span class="absolute bottom-1 right-1 bg-[#0B2A2E]/80 text-white p-1 rounded-md" title="Photos jointes par le client">
                      <AdminIcon name="camera" class="w-3 h-3 text-white" />
                    </span>
                  )}
                </div>

                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-black text-[#0B2A2E]">{sub.client}</span>
                    <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full border ${sub.statusColor}`}>
                      {sub.status}
                    </span>
                    <span class="text-[11px] text-[#3D5A5E]/70 font-mono">#{sub.id}</span>
                  </div>
                  <p class="text-xs font-bold text-[#0E7C86] truncate">{sub.service}</p>
                  
