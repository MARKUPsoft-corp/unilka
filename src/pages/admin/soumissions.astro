    notes: "Sol en parquet franc de chêne massif, produits non abrasifs requis.",
    hasPhotos: false,
    photoUrl: "",
    photoLabel: ""
  },
  {
    id: "SOU-1039",
    date: "26 oct. 2026, 18:20",
    client: "Marc-Antoine Roy",
    email: "ma.roy@invest.ca",
    phone: "(514) 710-3329",
    service: "Nettoyage spécialisé",
    serviceType: "Canapés & Tapis",
    location: "Griffintown, Montréal",
    postalCode: "H3C 0K7",
    surface: "Canapé 5 places + 2 tapis laine",
    frequency: "Ponctuel",
    estimatedPrice: "280,00 $",
    status: "Devis envoyé",
    statusColor: "bg-blue-100 text-blue-800 border-blue-200",
    notes: "Détachage café sur tissu beige.",
    hasPhotos: true,
    photoUrl: "/images/admin/submission-condo.jpg",
    photoLabel: "Mobilier salon, Griffintown"
  },
  {
    id: "SOU-1038",
    date: "26 oct. 2026, 14:05",
    client: "Sophie Marchand",
    email: "s.marchand@videotron.ca",
    phone: "(450) 581-2244",
    service: "Nettoyage résidentiel",
    serviceType: "Avant emménagement",
    location: "Repentigny, Lanaudière",
    postalCode: "J6A 2P4",
    surface: "2 200 pi² (Maison unifamiliale)",
    frequency: "Ponctuel",
    estimatedPrice: "420,00 $",
    status: "Confirmé & Payé",
    statusColor: "bg-emerald-100 text-emerald-800 border-emerald-200",
    notes: "Maison vide, remise des clés prévue vendredi matin à 9h00.",
    hasPhotos: true,
    photoUrl: "/images/admin/submission-condo.jpg",
    photoLabel: "Maison unifamiliale, Repentigny"
  },
  {
    id: "SOU-1037",
    date: "25 oct. 2026, 16:40",
    client: "Boutique Mode Laurier",
    email: "contact@boutiquemode.ca",
    phone: "(514) 279-5500",
    service: "Nettoyage commercial",
    serviceType: "Boutique & Showroom",
    location: "Plateau-Mont-Royal, Montréal",
    postalCode: "H2T 1E4",
    surface: "1 200 pi² (Espace vente + réserve)",
    frequency: "Hebdomadaire",
    estimatedPrice: "360,00 $/mois",
    status: "Confirmé & Payé",
    statusColor: "bg-emerald-100 text-emerald-800 border-emerald-200",
    notes: "Lavage des deux vitrines principales inclus.",
    hasPhotos: false,
    photoUrl: "",
    photoLabel: ""
  }
];

let liveSubmissions: any[] = [];
try {
  const { db } = await import('../../lib/firebase');
  const { collection, getDocs, query, orderBy, limit } = await import('firebase/firestore');

  const q = query(collection(db, 'submissions'), orderBy('createdAt', 'desc'), limit(50));
  const snap = await getDocs(q);
  liveSubmissions = snap.docs.map(doc => {
    const data = doc.data();
    const d = data.createdAt ? new Date(data.createdAt) : new Date();
    const formattedDate = d.toLocaleDateString('fr-CA', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });

    const hasPhotos = Boolean(data.hasPhotos || (Array.isArray(data.photos) && data.photos.length > 0));
    const photoUrl = data.photoUrl || (Array.isArray(data.photos) && data.photos[0]?.url) || '';

    return {
      rawId: doc.id,
      id: `SOU-${doc.id.substring(0, 5).toUpperCase()}`,
      date: formattedDate,
      client: data.client || `${data.firstName || ''} ${data.lastName || ''}`.trim() || 'Client',
      email: data.email || '',
      phone: data.phone || '',
      service: data.service || 'Nettoyage résidentiel',
      serviceType: data.serviceType || 'Grand ménage',
      location: data.location || (data.city ? `${data.city}, QC` : 'Montréal'),
      postalCode: data.postalCode || '',
      surface: data.surface || 'Non spécifiée',
      frequency: data.frequency || 'Ponctuel',
      estimatedPrice: data.estimatedPrice || 'Sur devis',
      status: data.status || 'À traiter',
      statusColor: data.statusColor || 'bg-amber-100 text-amber-900 border-amber-200',
      notes: data.notes || '',
      hasPhotos,
      photoUrl,
      photoLabel: data.photoLabel || (hasPhotos ? 'Photo(s) téléversée(s)' : '')
    };
  });
} catch (err: any) {
  console.warn('[Admin Soumissions] Chargement Firestore en direct échoué (mode démo actif) :', err?.message);
}

const submissions = liveSubmissions.length > 0 ? liveSubmissions : defaultSubmissions;

const countAll = submissions.length;
const countPending = submissions.filter(s => s.status === 'À traiter' || s.status === 'Nouveau' || s.status === 'nouveau').length;
const countSent = submissions.filter(s => s.status === 'Devis envoyé').length;
const countConfirmed = submissions.filter(s => s.status === 'Confirmé & Payé' || s.status === 'Confirmé').length;
---

<AdminLayout title="Soumissions & Devis" activeNav="soumissions">

  <!-- 1. EN-TÊTE PAGE -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
        <span>Gestion des Demandes Clients</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight">
        Demandes de soumission & Devis
      </h1>
      <p class="text-xs sm:text-sm text-[#3D5A5E]">
        Analysez les besoins des prospects, générez vos estimations et suivez les confirmations de réservation.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button
        type="button"
        id="btn-export-csv"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-bold text-[#0B2A2E] bg-white hover:bg-[#F5FAFA] border border-[#0E7C86]/20 shadow-2xs transition-colors"
      >
        <AdminIcon name="download" class="w-3.5 h-3.5 text-[#0E7C86]" />
        <span>Exporter en CSV</span>
      </button>
      <button
        type="button"
        id="btn-create-soumission"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-colors"
      >
        <span>+ Nouvelle soumission manuelle</span>
      </button>
    </div>
  </div>

  <!-- 2. ONGLETS DE STATUT & FILTRES -->
  <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-4 shadow-2xs space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      
      <!-- Onglets Pilules Interactifs -->
      <div class="flex flex-wrap items-center gap-2" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="filter-tab px-4 py-2 rounded-full text-xs font-extrabold bg-[#0E7C86] text-white transition-all shadow-xs"
        >
          Toutes ({countAll})
        </button>
        <button
          type="button"
          data-filter="À traiter"
          class="filter-tab px-4 py-2 rounded-full text-xs font-bold bg-[#F5FAFA] text-[#0B2A2E] hover:bg-[#E3F4F5] border border-[#0E7C86]/15 transition-all"
        >
          À traiter ({countPending})
        </button>
        <button
          type="button"
          data-filter="Devis envoyé"
          class="filter-tab px-4 py-2 rounded-full text-xs font-bold bg-[#F5FAFA] text-[#0B2A2E] hover:bg-[#E3F4F5] border border-[#0E7C86]/15 transition-all"
        >
          Devis envoyé ({countSent})
        </button>
        <button
          type="button"
          data-filter="Confirmé & Payé"
          class="filter-tab px-4 py-2 rounded-full text-xs font-bold bg-[#F5FAFA] text-[#0B2A2E] hover:bg-[#E3F4F5] border border-[#0E7C86]/15 transition-all"
        >
          Confirmées & Payées ({countConfirmed})
        </button>
      </div>

      <!-- Filtre Catégorie de service & Zone -->
      <div class="flex items-center gap-2">
        <select
          id="service-select"
          class="px-3 py-2 text-xs rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:outline-none focus:border-[#0E7C86]"
        >
          <option value="all">Tous les services</option>
          <option value="résidentiel">Résidentiel</option>
          <option value="commercial">Commercial</option>
          <option value="régulier">Entretien régulier</option>
          <option value="spécialisé">Spécialisé</option>
        </select>

        <select
          id="zone-select"
          class="px-3 py-2 text-xs rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:outline-none focus:border-[#0E7C86]"
        >
          <option value="all">Toutes les zones</option>
          <option value="montréal">Montréal</option>
          <option value="rive-sud">Rive-Sud</option>
          <option value="lanaudière">Lanaudière</option>
        </select>
      </div>

    </div>
  </div>

  <!-- 3. TABLEAU DES SOUMISSIONS -->
  <div class="bg-white rounded-2xl border border-[#0E7C86]/12 overflow-hidden shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs" id="submissions-table">
        <thead>
          <tr class="bg-[#F5FAFA] border-b border-[#0E7C86]/12 text-[#3D5A5E] font-extrabold uppercase tracking-wider text-[10px]">
            <th class="py-3.5 px-4">Réf.</th>
            <th class="py-3.5 px-4">Client & Contact</th>
            <th class="py-3.5 px-4">Prestation demandée</th>
            <th class="py-3.5 px-4">Localisation</th>
            <th class="py-3.5 px-4">Détails surface</th>
            <th class="py-3.5 px-4">Tarif estimé</th>
            <th class="py-3.5 px-4">Statut</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#0E7C86]/08" id="submissions-tbody">
          {submissions.map((sub) => (
            <tr
              class="submission-row hover:bg-[#F5FAFA] transition-colors group cursor-pointer"
              data-id={sub.id}
              data-rawid={sub.rawId || sub.id}
              data-client={sub.client}
              data-email={sub.email}
              data-phone={sub.phone}
              data-service={sub.service}
              data-servicetype={sub.serviceType}
              data-frequency={sub.frequency}
              data-location={sub.location}
              data-postalcode={sub.postalCode}
              data-surface={sub.surface}
              data-price={sub.estimatedPrice}
              data-status={sub.status}
              data-notes={sub.notes}
              data-hasphotos={sub.hasPhotos ? "true" : "false"}
              data-photourl={sub.photoUrl || ""}
              data-photolabel={sub.photoLabel || ""}
            >
              <td class="py-4 px-4 font-mono font-bold text-[#0E7C86]">
                {sub.id}
                <span class="block text-[10px] text-[#3D5A5E]/60 font-sans">{sub.date.split(',')[0]}</span>
              </td>
              <td class="py-4 px-4">
                <span class="font-extrabold text-[#0B2A2E] block text-[13px]">{sub.client}</span>
                <span class="text-[#3D5A5E] block">{sub.phone}</span>
                <span class="text-[#3D5A5E]/70 block">{sub.email}</span>
              </td>
              <td class="py-4 px-4">
                <span class="font-bold text-[#0B2A2E] block">{sub.service}</span>
                <span class="text-[11px] text-[#0E7C86] font-semibold">{sub.serviceType} • {sub.frequency}</span>
              </td>
              <td class="py-4 px-4">
                <span class="font-medium text-[#0B2A2E] block">{sub.location}</span>
                <span class="text-[10px] font-mono text-[#3D5A5E]">{sub.postalCode}</span>
              </td>
              <td class="py-4 px-4">
                <span class="text-[#3D5A5E] block font-medium">{sub.surface}</span>
                {sub.hasPhotos && (
                  <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-[#0E7C86] bg-[#E3F4F5] px-2 py-0.5 rounded mt-0.5">
                    <AdminIcon name="camera" class="w-3 h-3 text-[#0E7C86]" />
                    <span>Photos jointes</span>
                  </span>
                )}
              </td>
              <td class="py-4 px-4">
                <span class="font-black text-[#0B2A2E] text-sm block">{sub.estimatedPrice}</span>
              </td>
              <td class="py-4 px-4">
                <span class={`inline-block px-2.5 py-1 rounded-full text-[10px] font-extrabold border ${sub.statusColor}`}>
                  {sub.status}
                </span>
              </td>
              <td class="py-4 px-4 text-right">
                <div class="inline-flex items-center gap-1.5" onclick="event.stopPropagation()">
                  <button
                    type="button"
                    class="btn-send-email p-2 rounded-lg text-[#3D5A5E] hover:text-[#0E7C86] hover:bg-[#E3F4F5] transition-colors"
                    title="Envoyer le devis par courriel"
                    data-id={sub.id}
                  >
                    <AdminIcon name="mail" class="w-3.5 h-3.5" />
                  </button>
                  <button
                    type="button"
                    class="btn-open-row inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-2xs transition-colors"
                    data-id={sub.id}
                  >
                    <span>Ouvrir fiche</span>
                    <AdminIcon name="arrow-right" class="w-3 h-3" />
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="p-4 bg-[#F5FAFA] border-t border-[#0E7C86]/10 flex items-center justify-between text-xs text-[#3D5A5E]">
      <span id="rows-count-label">Affichage de {submissions.length} soumissions</span>
      <div class="flex items-center gap-1">
        <button type="button" id="btn-pagination-prev" class="px-2.5 py-1 rounded border border-[#0E7C86]/20 bg-white hover:bg-[#E3F4F5] transition-colors cursor-pointer" title="Page précédente">Précédent</button>
        <button type="button" class="px-2.5 py-1 rounded bg-[#0E7C86] text-white font-bold cursor-default">1</button>
        <button type="button" id="btn-pagination-next" class="px-2.5 py-1 rounded border border-[#0E7C86]/20 bg-white hover:bg-[#E3F4F5] transition-colors cursor-pointer" title="Page suivante">Suivant</button>
      </div>
    </div>
  </div>

  <!-- 4. MODALE CENTRÉE D'ANALYSE ET CHIFFRAGE DE SOUMISSION -->
  <div
    id="drawer-backdrop"
    class="fixed inset-0 bg-[#0B2A2E]/60 backdrop-blur-sm z-[80] hidden items-center justify-center p-3 sm:p-5 md:p-8 transition-opacity duration-200"
  >
    <div
      id="submission-drawer"
      class="bg-white rounded-3xl shadow-2xl border border-[#0E7C86]/20 w-full max-w-4xl max-h-[92vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-200 ease-out"
      role="dialog"
      aria-modal="true"
      aria-labelledby="drawer-title"
    >
      <!-- En-tête Modale -->
      <div class="p-5 sm:p-6 border-b border-[#0E7C86]/12 flex items-center justify-between bg-white shrink-0">
        <div class="flex items-center gap-3.5">
          <span class="w-10 h-10 rounded-2xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center shadow-2xs">
            <AdminIcon name="document" class="w-5 h-5 text-[#0E7C86]" />
          </span>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86] block">
                Fiche d'Analyse Soumission
              </span>
              <span id="drawer-status-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-900 border border-amber-200">
                Nouveau
              </span>
            </div>
            <h2 id="drawer-title" class="text-lg sm:text-xl font-extrabold text-[#0B2A2E] leading-tight mt-0.5">
              Soumission #<span id="drawer-id">SOU-1042</span>
            </h2>
          </div>
        </div>

        <button
          type="button"
          id="close-drawer-btn"
          class="p-2 text-[#3D5A5E] hover:text-[#0B2A2E] rounded-xl hover:bg-[#F5FAFA] transition-colors"
          aria-label="Fermer la modale"
        >
          <AdminIcon name="close" class="w-5 h-5" />
        </button>
      </div>

      <!-- Corps Déroulant de la Modale -->
      <div class="flex-1 overflow-y-auto p-5 sm:p-6 lg:p-8 space-y-6 text-xs text-[#0B2A2E]">
        
        <!-- Grille 2 Colonnes : Coordonnées & Prestation à gauche, Chiffrage à droite -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          
          <!-- Colonne Gauche (7 cols) : Détails Client, Besoins et Photo -->
          <div class="lg:col-span-7 space-y-5">
            
            <!-- Bloc Coordonnées Client -->
            <div class="p-4 sm:p-5 rounded-2xl bg-[#F5FAFA] border border-[#0E7C86]/10 space-y-3">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#0E7C86] block">
                Client & Coordonnées
              </span>
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                <div class="space-y-1">
                  <h3 id="drawer-client" class="text-base font-extrabold text-[#0B2A2E]">Alexandre Tremblay</h3>
                  <p id="drawer-location" class="text-xs text-[#3D5A5E] flex items-center gap-1.5">
                    <AdminIcon name="location" class="w-3.5 h-3.5 text-[#0E7C86]" />
                    <span>Outremont, Montréal (H2V 2Z4)</span>
                  </p>
                </div>
                <div class="flex sm:flex-col items-center sm:items-end gap-3 sm:gap-1 text-xs">
                  <a id="drawer-phone" href="tel:" class="font-extrabold text-[#0E7C86] hover:underline inline-flex items-center gap-1">
                    <AdminIcon name="phone" class="w-3.5 h-3.5" />
                    <span>(514) 892-4110</span>
                  </a>
                  <a id="drawer-email" href="mailto:" class="text-[#3D5A5E] hover:underline inline-flex items-center gap-1">
                    <AdminIcon name="mail" class="w-3.5 h-3.5" />
                    <span>a.tremblay@email.ca</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Prestation & Spécificités -->
            <div class="space-y-3">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#0E7C86] block">
                Prestation & Spécificités
              </span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="p-3.5 rounded-xl bg-white border border-[#0E7C86]/15 space-y-1 shadow-2xs">
                  <span class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Formule demandée</span>
                  <span id="drawer-service" class="font-black text-[#0B2A2E] text-sm block">Nettoyage résidentiel</span>
                  <span id="drawer-servicetype" class="text-xs text-[#0E7C86] font-semibold block">Grand ménage • Ponctuel</span>
                </div>
                <div class="p-3.5 rounded-xl bg-white border border-[#0E7C86]/15 space-y-1 shadow-2xs">
                  <span class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Superficie déclarée</span>
                  <span id="drawer-surface" class="font-black text-[#0B2A2E] text-sm block">1 850 pi² (3 ch, 2 sdb)</span>
                  <span id="drawer-photos" class="inline-flex items-center gap-1 text-[11px] text-emerald-700 font-bold">
                    <AdminIcon name="camera" class="w-3.5 h-3.5 text-emerald-700" />
                    <span>Photos jointes (vérifiées)</span>
                  </span>
                </div>
              </div>

              <!-- Consignes client -->
              <div class="p-3.5 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/10 space-y-1">
                <span class="text-[10px] font-extrabold text-[#3D5A5E] uppercase block">Consignes & Notes spéciales du client :</span>
                <p id="drawer-notes" class="text-[#3D5A5E] italic leading-relaxed text-xs">
                  Présence d'un chat. Souhaite une attention particulière sur la cuisine et le détartrage des parois de douche en verre.
                </p>
              </div>

              <!-- Aperçu Photo du Chantier Client (si fournie) -->
              <div id="drawer-photo-preview-box" class="p-4 rounded-2xl bg-white border border-[#0E7C86]/15 space-y-2.5 shadow-2xs">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-wider text-[#0E7C86]">
                    <AdminIcon name="camera" class="w-3.5 h-3.5 text-[#0E7C86]" />
                    <span>Évaluation visuelle du lieu</span>
                  </span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#E3F4F5] text-[#0E7C86] border border-[#0E7C86]/20">
                    Photo client
                  </span>
                </div>
                <div class="relative rounded-xl overflow-hidden max-h-56 bg-[#0B2A2E]/5 border border-[#0E7C86]/10 flex items-center justify-center">
                  <img
                    id="drawer-photo-img"
                    src="/images/admin/submission-condo.jpg"
                    alt="Photo des lieux soumise par le client"
                    class="w-full h-full max-h-56 object-cover transition-transform duration-300 hover:scale-105"
                  />
                </div>
                <p id="drawer-photo-caption" class="text-[11px] text-[#3D5A5E] font-medium text-center">
                  Condo 1 850 pi², Outremont
                </p>
              </div>

            </div>

          </div>

          <!-- Colonne Droite (5 cols) : Calculateur de devis interactif -->
          <div class="lg:col-span-5 space-y-4">
            <div class="p-5 rounded-2xl bg-[#E3F4F5]/60 border border-[#0E7C86]/25 space-y-4 shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-[#0E7C86]"></span>
                  <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
                    Chiffrage & Devis Officiel
                  </span>
                </div>
                <span class="text-[10px] font-bold text-[#0E7C86] bg-white px-2 py-0.5 rounded-full border border-[#0E7C86]/20">
                  Protocole 42 pts
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                  <label class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Heures estimées</label>
                  <div class="flex items-center gap-1.5">
                    <input
                      type="number"
                      id="calc-hours"
                      value="5.5"
                      step="0.5"
                      min="1"
                      max="20"
                      class="w-full px-3 py-2 rounded-xl bg-white border border-[#0E7C86]/25 text-[#0B2A2E] font-extrabold text-center focus:outline-none focus:border-[#0E7C86]"
                    />
                    <span class="text-xs text-[#3D5A5E] font-bold">h</span>
                  </div>
                </div>

                <div class="space-y-1">
                  <label class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Taux horaire</label>
                  <div class="flex items-center gap-1.5">
                    <input
                      type="number"
                      id="calc-rate"
                      value="55"
                      step="5"
                      min="40"
                      max="100"
                      class="w-full px-3 py-2 rounded-xl bg-white border border-[#0E7C86]/25 text-[#0B2A2E] font-extrabold text-center focus:outline-none focus:border-[#0E7C86]"
                    />
                    <span class="text-xs text-[#3D5A5E] font-bold">$/h</span>
                  </div>
                </div>
              </div>

              <!-- Extras Optionnels -->
              <div class="space-y-2 pt-2 border-t border-[#0E7C86]/15">
                <span class="text-[10px] font-bold text-[#3D5A5E] uppercase block">Options supplémentaires :</span>
                <div class="space-y-1.5 text-xs">
                  <label class="flex items-center justify-between p-2.5 rounded-xl bg-white/80 border border-[#0E7C86]/12 cursor-pointer hover:bg-white transition-colors">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" id="extra-oven" class="calc-extra rounded text-[#0E7C86] focus:ring-0" data-price="45" />
                      <span class="font-medium text-[#0B2A2E]">Four / Électroménagers</span>
                    </div>
                    <span class="font-extrabold text-[#0E7C86]">+45 $</span>
                  </label>
                  <label class="flex items-center justify-between p-2.5 rounded-xl bg-white/80 border border-[#0E7C86]/12 cursor-pointer hover:bg-white transition-colors">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" id="extra-windows" class="calc-extra rounded text-[#0E7C86] focus:ring-0" data-price="65" />
                      <span class="font-medium text-[#0B2A2E]">Intérieur des vitres</span>
                    </div>
                    <span class="font-extrabold text-[#0E7C86]">+65 $</span>
                  </label>
                </div>
              </div>

              <!-- Décomposition Totaux -->
              <div class="pt-3 border-t border-[#0E7C86]/20 space-y-1.5 text-xs">
                <div class="flex justify-between items-center text-[#3D5A5E]">
                  <span>Sous-total HT :</span>
                  <span id="calc-subtotal" class="font-bold text-[#0B2A2E]">302,50 $ CAD</span>
                </div>
                <div class="flex justify-between items-center text-[#3D5A5E]/80 text-[11px]">
                  <span>TPS (5%) :</span>
                  <span id="calc-tps" class="font-semibold">15,13 $ CAD</span>
                </div>
                <div class="flex justify-between items-center text-[#3D5A5E]/80 text-[11px]">
                  <span>TVQ (9.975%) :</span>
                  <span id="calc-tvq" class="font-semibold">30,17 $ CAD</span>
                </div>
                <div class="pt-2 border-t border-[#0E7C86]/20 flex justify-between items-center text-sm font-black text-[#0E7C86]">
                  <span>Total estimé TTC :</span>
                  <span id="calc-total" class="text-lg font-black text-[#0B2A2E]">347,80 $ CAD</span>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- Actions de la Modale (Pied-de-page) -->
      <div class="p-5 sm:p-6 border-t border-[#0E7C86]/12 bg-[#F5FAFA] flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0">
        <div class="flex items-center gap-2 text-xs">
          <a href="/admin/planning/" class="inline-flex items-center gap-1.5 font-bold text-[#0E7C86] hover:underline">
            <AdminIcon name="calendar" class="w-3.5 h-3.5 text-[#0E7C86]" />
            <span>Planifier au calendrier</span>
          </a>
        </div>

        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="btn-cancel-drawer"
            class="px-4 py-2.5 rounded-full text-xs font-bold text-[#3D5A5E] hover:text-[#0B2A2E] hover:bg-[#E3F4F5]/60 transition-colors"
          >
            Fermer
          </button>

          <button
            type="button"
            id="btn-send-quote-email"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs font-bold text-[#0B2A2E] bg-white border border-[#0E7C86]/20 hover:bg-[#E3F4F5] transition-colors shadow-2xs"
          >
            <AdminIcon name="mail" class="w-4 h-4 text-[#0B2A2E]" />
            <span>Envoyer devis</span>
          </button>

          <button
            type="button"
            id="btn-copy-stripe"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-xs font-extrabold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-all"
          >
            <AdminIcon name="credit-card" class="w-4 h-4 text-white" />
            <span>Copier le lien Stripe Canada</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- 5. MODALE DE CRÉATION DE SOUMISSION MANUELLE -->
  <div
    id="modal-create-soumission"
    class="fixed inset-0 z-[80] items-center justify-center p-4 bg-[#0B2A2E]/60 backdrop-blur-sm hidden"
    role="dialog"
    aria-modal="true"
  >
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-[#0E7C86]/20 space-y-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-4 border-b border-[#0E7C86]/10">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center">
            <AdminIcon name="plus" class="w-5 h-5 text-[#0E7C86]" />
          </span>
          <div>
            <h3 class="text-base font-extrabold text-[#0B2A2E]">Nouvelle soumission manuelle</h3>
            <p class="text-xs text-[#3D5A5E]">Enregistrement direct dans Firestore</p>
          </div>
        </div>
        <button type="button" id="close-create-modal" class="p-2 text-[#3D5A5E] hover:text-[#0B2A2E] rounded-xl hover:bg-[#F5FAFA] cursor-pointer" aria-label="Fermer">
          <AdminIcon name="close" class="w-4 h-4" />
        </button>
      </div>

      <form id="form-create-soumission" class="space-y-4 text-xs">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Prénom</label>
            <input type="text" name="firstName" required class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86]" placeholder="Ex: Jean" />
          </div>
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Nom</label>
            <input type="text" name="lastName" required class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86]" placeholder="Ex: Tremblay" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Courriel</label>
            <input type="email" name="email" required class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86]" placeholder="client@exemple.ca" />
          </div>
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Téléphone</label>
            <input type="tel" name="phone" required class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86]" placeholder="(514) 000-0000" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Service</label>
            <select name="service" class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86] bg-white">
              <option value="Nettoyage résidentiel">Nettoyage résidentiel</option>
              <option value="Nettoyage commercial">Nettoyage commercial</option>
              <option value="Grand ménage">Grand ménage d'automne/printemps</option>
              <option value="Nettoyage spécialisé">Nettoyage spécialisé (tapis/canapés)</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Fréquence</label>
            <select name="frequency" class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86] bg-white">
              <option value="Ponctuel">Ponctuel</option>
              <option value="Hebdomadaire">Hebdomadaire</option>
              <option value="Aux 2 semaines">Aux 2 semaines</option>
              <option value="Mensuel">Mensuel</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Ville</label>
            <input type="text" name="city" required class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86]" placeholder="Ex: Montréal" />
          </div>
          <div>
            <label class="block font-bold text-[#0B2A2E] mb-1">Surface approximative</label>
            <input type="text" name="surface" class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86]" placeholder="Ex: 1 200 pi²" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-[#0B2A2E] mb-1">Notes / Instructions particulières</label>
          <textarea name="notes" rows="2" class="w-full px-3 py-2 rounded-xl border border-[#0E7C86]/20 focus:outline-none focus:border-[#0E7C86]" placeholder="Besoins spécifiques du client..."></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#0E7C86]/10">
          <button type="button" id="cancel-create-modal" class="px-4 py-2 rounded-full border border-[#0E7C86]/20 text-[#3D5A5E] hover:bg-[#F5FAFA] cursor-pointer">
            Annuler
          </button>
          <button type="submit" id="submit-create-btn" class="px-5 py-2 rounded-full bg-[#0E7C86] hover:bg-[#0A5A62] text-white font-bold shadow-sm transition-all cursor-pointer">
            Créer la soumission
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- SCRIPT CLIENT INTERACTIF SOUMISSIONS -->
  <script>
    import { db } from '../../lib/firebase';
    import { collection, addDoc, doc, updateDoc } from 'firebase/firestore';

    // 1. Filtrage dynamique par statut
    const filterTabs = document.querySelectorAll('.filter-tab');
    const rows = document.querySelectorAll<HTMLElement>('.submission-row');
    const serviceSelect = document.getElementById('service-select') as HTMLSelectElement | null;
    const zoneSelect = document.getElementById('zone-select') as HTMLSelectElement | null;
    const countLabel = document.getElementById('rows-count-label');

    let currentStatus = 'all';

    function applyFilters() {
      let visibleCount = 0;
      const selectedService = serviceSelect ? serviceSelect.value.toLowerCase() : 'all';
      const selectedZone = zoneSelect ? zoneSelect.value.toLowerCase() : 'all';

      rows.forEach((row) => {
        const rowStatus = row.dataset.status || '';
        const rowService = (row.dataset.service || '').toLowerCase();
        const rowLocation = (row.dataset.location || '').toLowerCase();

        const matchStatus = currentStatus === 'all' || rowStatus.toLowerCase().includes(currentStatus.toLowerCase());
        const matchService = selectedService === 'all' || rowService.includes(selectedService);
        const matchZone = selectedZone === 'all' || rowLocation.includes(selectedZone);

        if (matchStatus && matchService && matchZone) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (countLabel) {
        countLabel.textContent = `Affichage de ${visibleCount} sur ${rows.length} soumissions`;
      }
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => {
          t.classList.remove('bg-[#0E7C86]', 'text-white', 'shadow-xs');
          t.classList.add('bg-[#F5FAFA]', 'text-[#0B2A2E]');
        });
        tab.classList.add('bg-[#0E7C86]', 'text-white', 'shadow-xs');
        tab.classList.remove('bg-[#F5FAFA]', 'text-[#0B2A2E]');

        currentStatus = tab.dataset.filter || 'all';
        applyFilters();
      });
    });

    serviceSelect?.addEventListener('change', applyFilters);
    zoneSelect?.addEventListener('change', applyFilters);

    // 2. Tiroir Coulissant (Slide-Over Drawer)
    const drawer = document.getElementById('submission-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const closeDrawerBtn = document.getElementById('close-drawer-btn');
    const cancelDrawerBtn = document.getElementById('btn-cancel-drawer');

    // Téléportation vers document.body pour que le flou couvre 100% de la fenêtre (y compris le header supérieur)
    if (backdrop && backdrop.parentElement !== document.body) {
      document.body.appendChild(backdrop);
    }

    let currentOpenRow = null;

    function openDrawer(row) {
      if (!drawer || !backdrop) return;
      if (backdrop.parentElement !== document.body) {
        document.body.appendChild(backdrop);
      }
      currentOpenRow = row;

      const id = row.dataset.id;
      const client = row.dataset.client;
      const email = row.dataset.email;
      const phone = row.dataset.phone;
      const service = row.dataset.service;
      const serviceType = row.dataset.servicetype;
      const frequency = row.dataset.frequency;
      const location = row.dataset.location;
      const postalCode = row.dataset.postalcode;
      const surface = row.dataset.surface;
      const status = row.dataset.status;
      const notes = row.dataset.notes;
      const hasPhotos = row.dataset.hasphotos === 'true';

      document.getElementById('drawer-id').textContent = id;
      document.getElementById('drawer-client').textContent = client;
      document.getElementById('drawer-location').textContent = `${location} (${postalCode})`;
      
      const phoneEl = document.getElementById('drawer-phone');
      phoneEl.textContent = phone;
      phoneEl.href = `tel:${phone}`;

      const emailEl = document.getElementById('drawer-email');
      emailEl.textContent = email;
      emailEl.href = `mailto:${email}`;

      document.getElementById('drawer-service').textContent = service;
      document.getElementById('drawer-servicetype').textContent = `${serviceType} • ${frequency}`;
      document.getElementById('drawer-surface').textContent = surface;
      document.getElementById('drawer-notes').textContent = notes;
      
      const photoEl = document.getElementById('drawer-photos');
      if (photoEl) photoEl.style.display = hasPhotos ? 'inline-flex' : 'none';

      const photoBox = document.getElementById('drawer-photo-preview-box');
      const photoImg = document.getElementById('drawer-photo-img');
      const photoCaption = document.getElementById('drawer-photo-caption');
      const photoUrl = row.dataset.photourl;
      const photoLabel = row.dataset.photolabel;

      if (photoBox && photoImg && photoCaption) {
        if (hasPhotos && photoUrl) {
          photoBox.style.display = 'block';
          photoImg.src = photoUrl;
          photoCaption.textContent = photoLabel || 'Photo soumise par le client';
        } else {
          photoBox.style.display = 'none';
        }
      }

      const statusBadge = document.getElementById('drawer-status-badge');
      if (statusBadge) statusBadge.textContent = status;

      recalculateQuote();

      backdrop.classList.remove('hidden');
      backdrop.classList.add('flex');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        drawer.classList.remove('scale-95', 'opacity-0');
        drawer.classList.add('scale-100', 'opacity-100');
      });
    }

    function closeDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('scale-100', 'opacity-100');
      drawer.classList.add('scale-95', 'opacity-0');
      document.body.style.overflow = '';
      setTimeout(() => {
        backdrop.classList.add('hidden');
        backdrop.classList.remove('flex');
      }, 200);
    }

    rows.forEach((row) => {
      row.addEventListener('click', () => openDrawer(row));
    });

    document.querySelectorAll('.btn-open-row').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const row = btn.closest('.submission-row');
        if (row) openDrawer(row);
      });
    });

    closeDrawerBtn?.addEventListener('click', closeDrawer);
    cancelDrawerBtn?.addEventListener('click', closeDrawer);
    
    // Fermeture en cliquant sur l'arrière-plan flouté
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeDrawer();
      }
    });

    // Fermeture avec la touche Échap
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDrawer();
        closeCreateModal();
      }
    });

    // Auto-ouverture si paramètre ?id= dans l'URL
    const urlParams = new URLSearchParams(window.location.search);
    const targetParamId = urlParams.get('id');
    if (targetParamId) {
      const match = Array.from(rows).find(r => 
        r.dataset.id === targetParamId ||
        r.dataset.rawid === targetParamId ||
        (r.dataset.id && r.dataset.id.toLowerCase().includes(targetParamId.toLowerCase())) ||
        (r.dataset.rawid && r.dataset.rawid.toLowerCase().includes(targetParamId.toLowerCase()))
      );
      if (match) {
        setTimeout(() => {
          openDrawer(match);
          match.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 150);
      }
    }

    // 3. Calculateur de devis
    const hoursInput = document.getElementById('calc-hours');
    const rateInput = document.getElementById('calc-rate');
    const extras = document.querySelectorAll('.calc-extra');

    function recalculateQuote() {
      const hours = parseFloat(hoursInput?.value || 0);
      const rate = parseFloat(rateInput?.value || 0);
      let base = hours * rate;

      extras.forEach((cb) => {
        if (cb.checked) {
          base += parseFloat(cb.dataset.price || 0);
        }
      });

      const tps = base * 0.05;
      const tvq = base * 0.09975;
      const total = base + tps + tvq;

      const subtotalEl = document.getElementById('calc-subtotal');
      const tpsEl = document.getElementById('calc-tps');
      const tvqEl = document.getElementById('calc-tvq');
      const totalEl = document.getElementById('calc-total');

      if (subtotalEl) subtotalEl.textContent = `${base.toFixed(2).replace('.', ',')} $ CAD`;
      if (tpsEl) tpsEl.textContent = `${tps.toFixed(2).replace('.', ',')} $ CAD`;
      if (tvqEl) tvqEl.textContent = `${tvq.toFixed(2).replace('.', ',')} $ CAD`;
      if (totalEl) totalEl.textContent = `${total.toFixed(2).replace('.', ',')} $ CAD`;
    }

    hoursInput?.addEventListener('input', recalculateQuote);
    rateInput?.addEventListener('input', recalculateQuote);
    extras.forEach((cb) => cb.addEventListener('change', recalculateQuote));

    // 4. Copie du lien Stripe & Action toasts
    const copyStripeBtn = document.getElementById('btn-copy-stripe');
    copyStripeBtn?.addEventListener('click', () => {
      const id = document.getElementById('drawer-id')?.textContent || 'SOU-1042';
      const fakeUrl = `https://buy.stripe.com/live_unilka_${id.toLowerCase()}_checkout`;
      
      navigator.clipboard?.writeText(fakeUrl).then(() => {
        if (window.showAdminToast) {
          window.showAdminToast(`Lien Stripe ${id} copié dans le presse-papiers !`);
        }
      }).catch(() => {
        if (window.showAdminToast) {
          window.showAdminToast(`Lien Stripe généré : ${fakeUrl}`);
        }
      });
    });

    const sendQuoteBtn = document.getElementById('btn-send-quote-email');
    sendQuoteBtn?.addEventListener('click', async () => {
      const id = document.getElementById('drawer-id')?.textContent || 'SOU-1042';
      const client = document.getElementById('drawer-client')?.textContent || 'Client';

      try {
        const rawId = currentOpenRow?.dataset.rawid;
        if (rawId) {
          await updateDoc(doc(db, 'submissions', rawId), {
            status: 'Devis envoyé',
            statusColor: 'bg-blue-100 text-blue-800 border-blue-200'
          });
          const badge = document.getElementById('drawer-status-badge');
          if (badge) {
            badge.textContent = 'Devis envoyé';
            badge.className = 'px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-blue-100 text-blue-800 border border-blue-200';
          }
          if (currentOpenRow) {
            currentOpenRow.dataset.status = 'Devis envoyé';
          }
        }
      } catch (e) {
        console.warn('Mise à jour statut Firestore :', e);
      }

      if ((window as any).showAdminToast) {
        (window as any).showAdminToast(`Devis ${id} officiellement transmis à ${client} !`);
      }
    });

    document.querySelectorAll('.btn-send-email').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.dataset.id;
        if (window.showAdminToast) {
          window.showAdminToast(`Devis ${id} transmis par courriel !`);
        }
      });
    });

    // 5. Exportation CSV des soumissions
    const exportBtn = document.getElementById('btn-export-csv');
    exportBtn?.addEventListener('click', () => {
      const rowsList = document.querySelectorAll('.submission-row');
      if (rowsList.length === 0) {
        if (window.showAdminToast) window.showAdminToast('Aucune soumission à exporter.');
        return;
      }

      const csvRows = [
        ['Référence', 'Date', 'Client', 'Courriel', 'Téléphone', 'Service', 'Fréquence', 'Localisation', 'Code Postal', 'Surface', 'Statut', 'Prix Estimé', 'Notes'].join(';')
      ];

      rowsList.forEach((r) => {
        const d = r.dataset;
        csvRows.push([
          `"${d.id || ''}"`,
          `"${r.querySelector('td')?.textContent?.trim().replace(/\s+/g, ' ') || ''}"`,
          `"${d.client || ''}"`,
          `"${d.email || ''}"`,
          `"${d.phone || ''}"`,
          `"${d.service || ''}"`,
          `"${d.frequency || ''}"`,
          `"${d.location || ''}"`,
          `"${d.postalcode || ''}"`,
          `"${d.surface || ''}"`,
          `"${d.status || ''}"`,
          `"${d.price || ''}"`,
          `"${(d.notes || '').replace(/"/g, '""')}"`
        ].join(';'));
      });

      const blob = new Blob(['\uFEFF' + csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `soumissions-unilka-${new Date().toISOString().split('T')[0]}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      if (window.showAdminToast) {
        window.showAdminToast(`Exportation CSV de ${rowsList.length} soumissions réussie !`);
      }
    });

    // 6. Modal de création manuelle de soumission
    const createModal = document.getElementById('modal-create-soumission');
    const openCreateBtn = document.getElementById('btn-create-soumission');
    const closeCreateBtn = document.getElementById('close-create-modal');
    const cancelCreateBtn = document.getElementById('cancel-create-modal');
    const formCreate = document.getElementById('form-create-soumission');

    // Téléportation vers document.body
    if (createModal && createModal.parentElement !== document.body) {
      document.body.appendChild(createModal);
    }

    function openCreateModal() {
      const modal = document.getElementById('modal-create-soumission');
      if (!modal) return;
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeCreateModal() {
      const modal = document.getElementById('modal-create-soumission');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    openCreateBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      openCreateModal();
    });

    closeCreateBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      closeCreateModal();
    });

    cancelCreateBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      closeCreateModal();
    });

    // Fermeture si clic à l'extérieur de la modale
    createModal?.addEventListener('click', (e) => {
      if (e.target === createModal) {
        closeCreateModal();
      }
    });

    // Auto-ouverture du formulaire de création si ?create=true
    if (urlParams.get('create') === 'true') {
      setTimeout(openCreateModal, 200);
    }

    // Support des clics sur les liens "+ Devis" dans la page
    document.querySelectorAll('a[href*="create=true"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (window.location.pathname.includes('/admin/soumissions')) {
          e.preventDefault();
          openCreateModal();
        }
      });
    });

    // Auto-recherche si ?q=... dans l'URL
    const qParam = urlParams.get('q');
    if (qParam) {
      const searchBox = document.getElementById('admin-search-input');
      if (searchBox) {
        searchBox.value = qParam;
        searchBox.dispatchEvent(new Event('input'));
      }
    }

    formCreate?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-create-btn');
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Enregistrement…';
      }

      const formData = new FormData(formCreate as HTMLFormElement);
      const firstName = formData.get('firstName')?.toString().trim() || '';
      const lastName = formData.get('lastName')?.toString().trim() || '';
      const email = formData.get('email')?.toString().trim() || '';
      const phone = formData.get('phone')?.toString().trim() || '';
      const service = formData.get('service')?.toString() || 'Nettoyage résidentiel';
      const frequency = formData.get('frequency')?.toString() || 'Ponctuel';
      const city = formData.get('city')?.toString().trim() || 'Montréal';
      const surface = formData.get('surface')?.toString().trim() || 'Non spécifiée';
      const notes = formData.get('notes')?.toString().trim() || '';

      try {
        await addDoc(collection(db, 'submissions'), {
          firstName,
          lastName,
          client: `${firstName} ${lastName}`.trim(),
          email,
          phone,
          service,
          serviceType: service,
          frequency,
          frequencyCode: frequency.toLowerCase(),
          city,
          location: `${city}, QC`,
          surface: surface || 'Non spécifiée',
          notes,
          status: 'À traiter',
          statusColor: 'bg-amber-100 text-amber-900 border-amber-200',
          estimatedPrice: 'Sur devis',
          createdAt: new Date().toISOString(),
          hasPhotos: false,
          photos: []
        });

        closeCreateModal();
        (formCreate as HTMLFormElement).reset();

        if ((window as any).showAdminToast) {
          (window as any).showAdminToast(`Soumission créée pour ${firstName} ${lastName} !`);
        }

        setTimeout(() => {
          window.location.reload();
        }, 800);
      } catch (err) {
        console.error('Erreur création soumission Firestore :', err);
        alert('Erreur lors de la création de la soumission. Veuillez réessayer.');
      } finally {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = 'Créer la soumission';
        }
      }
    });

    // Pagination
    document.getElementById('btn-pagination-prev')?.addEventListener('click', () => {
      if ((window as any).showAdminToast) {
        (window as any).showAdminToast("Page 1 sur 1 — Toutes les soumissions sont déjà affichées.");
      }
    });
    document.getElementById('btn-pagination-next')?.addEventListener('click', () => {
      if ((window as any).showAdminToast) {
        (window as any).showAdminToast("Page 1 sur 1 — Toutes les soumissions sont déjà affichées.");
      }
    });
  </script>

</AdminLayout>
