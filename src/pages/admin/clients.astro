                </div>
              </td>
              <td class="py-4 px-4">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${cli.typeBadge}`}>
                  {cli.type}
                </span>
              </td>
              <td class="py-4 px-4 font-medium text-[#0B2A2E]">
                <span class="inline-flex items-center gap-1.5">
                  <AdminIcon name="location" class="w-3.5 h-3.5 text-[#0E7C86] shrink-0" />
                  <span>{cli.sector}</span>
                </span>
              </td>
              <td class="py-4 px-4">
                <span class="font-bold text-[#0E7C86]">{cli.frequency}</span>
              </td>
              <td class="py-4 px-4">
                <span class="font-semibold text-[#0B2A2E] block">{cli.regularStaff}</span>
                <span class="inline-flex items-center gap-1 text-[10px] text-emerald-600 font-bold">
                  <AdminIcon name="shield-check" class="w-3 h-3 text-emerald-600" />
                  <span>Cautionné(e)</span>
                </span>
              </td>
              <td class="py-4 px-4">
                <span class="font-black text-[#0B2A2E] text-sm">{cli.monthlyRevenue}</span>
              </td>
              <td class="py-4 px-4 max-w-xs">
