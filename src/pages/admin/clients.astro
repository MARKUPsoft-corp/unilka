              data-phone={cli.phone}
              data-email={cli.email}
              data-address={cli.address}
              data-frequency={cli.frequency}
              data-staff={cli.regularStaff}
              data-revenue={cli.monthlyRevenue}
              data-notes={cli.accessNotes}
              data-type={cli.type}
              data-since={cli.since}
            >
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  {cli.photo ? (
                    <img src={cli.photo} alt={cli.name} class="w-10 h-10 rounded-xl object-cover border border-[#0E7C86]/20 shrink-0 shadow-2xs" />
