---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';

const clients = [
  {
    id: "CLI-01",
    name: "Alexandre & Sophie Tremblay",
    type: "Résidence privée",
    typeBadge: "bg-emerald-100 text-emerald-800",
    sector: "Outremont, Montréal",
    photo: "/images/admin/submission-condo.jpg",
    frequency: "Bimensuel (jeudi)",
    regularStaff: "Fatou D.",
    monthlyRevenue: "390,00 $ CAD",
    since: "Avril 2026",
    accessNotes: "Boîte à clés sécurisée #4182. Chien très calme.",
    status: "Actif"
  },
  {
    id: "CLI-02",
    name: "Cabinet Dentaire Saint-Laurent",
    type: "Clinique & Bureaux",
    typeBadge: "bg-blue-100 text-blue-800",
    sector: "Ville-Marie, Montréal",
    photo: "/images/admin/submission-clinic.jpg",
    frequency: "Hebdomadaire (mardi & ven. soir)",
    regularStaff: "Assane N.",
    monthlyRevenue: "960,00 $ CAD",
    since: "Janvier 2026",
    accessNotes: "Alarme code #9021. Badge remis.",
    status: "Actif"
  },
  {
    id: "CLI-03",
    name: "Mme Claire Vachon",
    type: "Résidence privée",
    typeBadge: "bg-emerald-100 text-emerald-800",
    sector: "Westmount, Montréal",
    photo: "",
    frequency: "Hebdomadaire (mardi matin)",
    regularStaff: "Fatou D.",
    monthlyRevenue: "880,00 $ CAD",
    since: "Février 2026",
    accessNotes: "Parquet ancien huilé. Produits doux bio Unilka.",
    status: "Actif"
  },
  {
    id: "CLI-04",
    name: "Agence Numérique Pixel Inc.",
    type: "Espace bureaux",
    typeBadge: "bg-blue-100 text-blue-800",
    sector: "Vieux-Montréal",
    frequency: "Hebdomadaire (lundi soir)",
    regularStaff: "Assane N.",
    monthlyRevenue: "440,00 $ CAD",
    since: "Juin 2026",
    accessNotes: "Entrée principale, code ascenseur #304.",
    status: "Actif"
  },
  {
    id: "CLI-05",
    name: "Famille Bédard",
    type: "Maison unifamiliale",
    typeBadge: "bg-emerald-100 text-emerald-800",
    sector: "Brossard, Rive-Sud",
    frequency: "Bimensuel (mercredi matin)",
    regularStaff: "Khadija B.",
    monthlyRevenue: "420,00 $ CAD",
    since: "Août 2026",
    accessNotes: "Code garage envoyé par SMS la veille.",
    status: "Actif"
  },
  {
    id: "CLI-06",
    name: "Boutique Mode Laurier",
    type: "Commerce & Showroom",
    typeBadge: "bg-purple-100 text-purple-800",
    sector: "Plateau-Mont-Royal",
    frequency: "Hebdomadaire (lundi matin avant ouverture)",
    regularStaff: "Jean-Marc T.",
    monthlyRevenue: "360,00 $ CAD",
    since: "Mars 2026",
    accessNotes: "Clé remise à la gérante le matin.",
    status: "Actif"
  }
];
---

<AdminLayout title="Clients & Forfaits" activeNav="clients">

  <!-- 1. EN-TÊTE -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#E3F4F5] border border-[#0E7C86]/20 text-[10px] font-extrabold uppercase tracking-widest text-[#0E7C86]">
        <span>Gestion de la Clientèle</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight">
        Clients & Forfaits réguliers
      </h1>
      <p class="text-xs sm:text-sm text-[#3D5A5E]">
        42 clients enregistrés • 28 contrats récurrents actifs dans le Grand Montréal.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button
        type="button"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-colors"
      >
        <span>+ Ajouter un nouveau client</span>
      </button>
    </div>
  </div>

  <!-- 2. RECHERCHE & FILTRES -->
  <div class="bg-white rounded-2xl border border-[#0E7C86]/12 p-4 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
      <button type="button" class="px-4 py-2 rounded-full text-xs font-extrabold bg-[#0E7C86] text-white">
        Tous (42)
      </button>
      <button type="button" class="px-4 py-2 rounded-full text-xs font-bold bg-[#F5FAFA] text-[#0B2A2E] hover:bg-[#E3F4F5] border border-[#0E7C86]/15 transition-colors">
        Résidentiel régulier (19)
      </button>
      <button type="button" class="px-4 py-2 rounded-full text-xs font-bold bg-[#F5FAFA] text-[#0B2A2E] hover:bg-[#E3F4F5] border border-[#0E7C86]/15 transition-colors">
        Commercial & Bureaux (9)
      </button>
      <button type="button" class="px-4 py-2 rounded-full text-xs font-bold bg-[#F5FAFA] text-[#0B2A2E] hover:bg-[#E3F4F5] border border-[#0E7C86]/15 transition-colors">
        Missions ponctuelles (14)
      </button>
    </div>

    <div class="w-full sm:w-64">
      <input
        type="search"
        placeholder="Filtrer par nom ou secteur..."
        class="w-full px-3.5 py-2 text-xs rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] placeholder-[#3D5A5E]/60 focus:outline-none focus:border-[#0E7C86]"
      />
    </div>
  </div>

  <!-- 3. TABLEAU DES CLIENTS -->
  <div class="bg-white rounded-2xl border border-[#0E7C86]/12 overflow-hidden shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-[#F5FAFA] border-b border-[#0E7C86]/12 text-[#3D5A5E] font-extrabold uppercase tracking-wider text-[10px]">
            <th class="py-3.5 px-4">Client</th>
            <th class="py-3.5 px-4">Typologie</th>
            <th class="py-3.5 px-4">Secteur</th>
            <th class="py-3.5 px-4">Fréquence de passage</th>
            <th class="py-3.5 px-4">Préposé(e) dédié(e)</th>
            <th class="py-3.5 px-4">Volume mensuel</th>
            <th class="py-3.5 px-4">Consignes & Clés</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#0E7C86]/08">
          {clients.map((cli) => (
            <tr class="hover:bg-[#F5FAFA]/60 transition-colors client-row" data-name={cli.name.toLowerCase()} data-sector={cli.sector.toLowerCase()}>
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  {cli.photo ? (
                    <img src={cli.photo} alt={cli.name} class="w-10 h-10 rounded-xl object-cover border border-[#0E7C86]/20 shrink-0 shadow-2xs" />
                  ) : (
                    <span class="w-10 h-10 rounded-xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center shrink-0">
                      <AdminIcon name="home" class="w-5 h-5" />
                    </span>
                  )}
                  <div>
                    <span class="font-extrabold text-[#0B2A2E] block text-[13px]">{cli.name}</span>
                    <span class="text-[10px] text-[#3D5A5E]/60 font-mono">Client depuis {cli.since}</span>
                  </div>
                </div>
              </td>
              <td class="py-4 px-4">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${cli.typeBadge}`}>
                  {cli.type}
                </span>
              </td>
              <td class="py-4 px-4 font-medium text-[#0B2A2E]">
                <span class="inline-flex items-center gap-1.5">
                  <AdminIcon name="location" class="w-3.5 h-3.5 text-[#0E7C86] shrink-0" />
                  <span>{cli.sector}</span>
                </span>
              </td>
              <td class="py-4 px-4">
                <span class="font-bold text-[#0E7C86]">{cli.frequency}</span>
              </td>
              <td class="py-4 px-4">
                <span class="font-semibold text-[#0B2A2E] block">{cli.regularStaff}</span>
                <span class="inline-flex items-center gap-1 text-[10px] text-emerald-600 font-bold">
                  <AdminIcon name="shield-check" class="w-3 h-3 text-emerald-600" />
                  <span>Cautionné(e)</span>
                </span>
              </td>
              <td class="py-4 px-4">
                <span class="font-black text-[#0B2A2E] text-sm">{cli.monthlyRevenue}</span>
              </td>
              <td class="py-4 px-4 max-w-xs">
                <span class="inline-flex items-center gap-1.5 text-[#3D5A5E] text-[11px] truncate block" title={cli.accessNotes}>
                  <AdminIcon name="key" class="w-3.5 h-3.5 text-amber-700 shrink-0" />
                  <span class="truncate">{cli.accessNotes}</span>
                </span>
              </td>
              <td class="py-4 px-4 text-right">
                <div class="inline-flex items-center gap-1.5">
                  <button
                    type="button"
                    class="btn-client-history p-2 rounded-lg text-[#3D5A5E] hover:text-[#0E7C86] hover:bg-[#E3F4F5] transition-colors"
                    title="Voir historique des interventions"
                    data-client={cli.name}
                  >
                    <AdminIcon name="document" class="w-3.5 h-3.5" />
                  </button>
                  <button
                    type="button"
                    class="btn-open-client-card inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-2xs transition-colors"
                    data-client={cli.name}
                  >
                    <span>Fiche client</span>
                    <AdminIcon name="arrow-right" class="w-3 h-3" />
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    // Recherche et filtrage en temps réel
    const searchInput = document.querySelector('input[type="search"]');
    const clientRows = document.querySelectorAll('.client-row');

    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      clientRows.forEach((row) => {
        const name = row.dataset.name || '';
        const sector = row.dataset.sector || '';
        if (!q || name.includes(q) || sector.includes(q)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });

    document.querySelectorAll('.btn-client-history').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.client;
        if (window.showAdminToast) {
          window.showAdminToast(`Historique complet de ${name} chargé`);
        }
      });
    });

    document.querySelectorAll('.btn-open-client-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.client;
        if (window.showAdminToast) {
          window.showAdminToast(`Ouverture du dossier client : ${name}`);
        }
      });
    });
  </script>

</AdminLayout>
