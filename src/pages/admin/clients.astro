                <span class="font-bold text-[#0B2A2E] block">Jeudi 8 octobre 2026 — 09:00</span>
                <span class="text-[10px] text-[#3D5A5E]">Intervention régulière par Fatou D.</span>
              </div>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                42/42 points validés
              </span>
            </div>
          </div>
        </div>

      </div>

      <!-- Bas modal -->
      <div class="p-5 bg-[#F5FAFA] border-t border-[#0E7C86]/10 flex items-center justify-between">
        <button
          type="button"
          id="btn-close-card"
          class="text-xs font-bold text-[#3D5A5E] hover:text-[#0B2A2E] cursor-pointer"
        >
          Fermer le dossier
        </button>
        <div class="flex items-center gap-2">
          <a
            href="/admin/planning/"
            class="px-4 py-2 rounded-full text-xs font-bold text-[#0E7C86] bg-white hover:bg-[#E3F4F5] border border-[#0E7C86]/20 transition-colors no-underline cursor-pointer"
          >
            Planifier dans le planning
          </a>
          <a
            href="/admin/soumissions/?create=true"
            class="px-4 py-2 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] transition-colors no-underline shadow-2xs cursor-pointer"
          >
            + Devis additionnel
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- 5. MODALE AJOUTER UN NOUVEAU CLIENT -->
  <div
    id="modal-create-client"
    class="fixed inset-0 z-[80] hidden items-center justify-center p-3 sm:p-5"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-create-client-title"
  >
    <div class="fixed inset-0 bg-[#0B2A2E]/60 backdrop-blur-sm -z-10 modal-backdrop-click"></div>
    <div class="bg-white rounded-3xl border border-[#0E7C86]/20 shadow-2xl max-w-lg w-full max-h-[92vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-200 modal-card">
      
      <div class="p-6 border-b border-[#0E7C86]/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-[#E3F4F5] text-[#0E7C86] flex items-center justify-center">
            <AdminIcon name="users" class="w-4 h-4 text-[#0E7C86]" />
          </span>
          <h2 id="modal-create-client-title" class="text-base font-extrabold text-[#0B2A2E]">
            Ajouter un nouveau client au portefeuille
          </h2>
        </div>
        <button
          type="button"
          id="close-create-client-btn"
          class="p-1.5 rounded-lg text-[#3D5A5E] hover:text-[#0B2A2E] hover:bg-[#F5FAFA] cursor-pointer"
          aria-label="Fermer la boîte de dialogue"
        >
          <AdminIcon name="close" class="w-4 h-4" />
        </button>
      </div>

      <form id="form-create-client" class="p-6 space-y-4 text-xs overflow-y-auto">
        <div class="space-y-1">
          <label class="font-bold text-[#0B2A2E]">Nom du client ou Société *</label>
          <input
            type="text"
            id="new-client-name"
            required
            placeholder="ex: Dr. Martin Leblanc ou Résidence Gagnon"
            class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Courriel *</label>
            <input
              type="email"
              id="new-client-email"
              required
              placeholder="client@domaine.ca"
              class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            />
          </div>
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Téléphone direct *</label>
            <input
              type="tel"
              id="new-client-phone"
              required
              placeholder="(514) 000-0000"
              class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Typologie *</label>
            <select
              id="new-client-category"
              class="w-full px-3 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            >
              <option value="residentiel">Résidentiel régulier</option>
              <option value="commercial">Commercial & Bureaux</option>
              <option value="ponctuel">Mission ponctuelle</option>
            </select>
          </div>
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Secteur *</label>
            <input
              type="text"
              id="new-client-sector"
              required
              placeholder="ex: Outremont, Montréal"
              class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            />
          </div>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-[#0B2A2E]">Adresse complète d'intervention</label>
          <input
            type="text"
            id="new-client-address"
            placeholder="Numéro, rue, appartement, code postal"
            class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Fréquence de passage</label>
            <select
              id="new-client-frequency"
              class="w-full px-3 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            >
              <option>Hebdomadaire (1x / semaine)</option>
              <option>Bimensuel (aux 2 semaines)</option>
              <option>Bihebdomadaire (2x / semaine)</option>
              <option>Mensuel</option>
              <option>Mission ponctuelle</option>
            </select>
          </div>
          <div class="space-y-1">
            <label class="font-bold text-[#0B2A2E]">Préposé(e) dédié(e)</label>
            <select
              id="new-client-staff"
              class="w-full px-3 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
            >
              <option>Fatou D.</option>
              <option>Khadija B.</option>
              <option>Jean-Marc T.</option>
              <option>Assane N.</option>
              <option>À assigner</option>
            </select>
          </div>
        </div>

        <div class="space-y-1">
          <label class="font-bold text-[#0B2A2E]">Volume mensuel récurrent ($ CAD)</label>
          <input
            type="text"
            id="new-client-revenue"
            placeholder="ex: 390,00 $ CAD"
            value="390,00 $ CAD"
            class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-extrabold focus:border-[#0E7C86] focus:outline-none"
          />
        </div>

        <div class="space-y-1">
          <label class="font-bold text-[#0B2A2E]">Consignes d'accès & Sécurité</label>
          <textarea
            id="new-client-notes"
            rows="2"
            placeholder="Code boîte à clés, alarme, animaux, instructions de stationnement..."
            class="w-full px-3.5 py-2 rounded-xl bg-[#F5FAFA] border border-[#0E7C86]/15 text-[#0B2A2E] font-medium focus:border-[#0E7C86] focus:outline-none"
          ></textarea>
        </div>

        <div class="p-6 -mx-6 -mb-6 bg-[#F5FAFA] border-t border-[#0E7C86]/10 flex items-center justify-between">
          <button
            type="button"
            id="cancel-create-client-btn"
            class="text-xs font-bold text-[#3D5A5E] hover:text-[#0B2A2E] cursor-pointer"
          >
            Annuler
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-sm transition-all cursor-pointer"
          >
            Enregistrer le client
          </button>
        </div>
      </form>

    </div>
  </div>

  <script is:inline>
    // 1. Recherche et filtrage combiné
    const searchInput = document.getElementById('client-search-input');
    const filterTabs = document.querySelectorAll('.client-filter-tab');
    let currentFilter = 'all';

    function applyClientFilters() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.client-row');

      rows.forEach((row) => {
        const name = row.dataset.name || '';
        const sector = row.dataset.sector || '';
        const staff = (row.dataset.staff || '').toLowerCase();
        const type = (row.dataset.type || '').toLowerCase();
        const category = row.dataset.category || '';

        const matchesQuery = !q || name.includes(q) || sector.includes(q) || staff.includes(q) || type.includes(q);
        const matchesCategory = currentFilter === 'all' || category === currentFilter;

        if (matchesQuery && matchesCategory) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    searchInput?.addEventListener('input', applyClientFilters);

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => {
          t.classList.remove('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');
          t.classList.add('bg-[#F5FAFA]', 'text-[#0B2A2E]', 'font-bold', 'border', 'border-[#0E7C86]/15');
        });
        tab.classList.remove('bg-[#F5FAFA]', 'text-[#0B2A2E]', 'font-bold', 'border', 'border-[#0E7C86]/15');
        tab.classList.add('bg-[#0E7C86]', 'text-white', 'font-extrabold', 'shadow-2xs');

        currentFilter = tab.dataset.filter || 'all';
        applyClientFilters();
      });
    });

    // 2. Gestion des modales avec téléportation vers document.body
    const modalClientCard = document.getElementById('modal-client-card');
    const modalCreateClient = document.getElementById('modal-create-client');

    function teleportModal(m) {
      if (m && m.parentElement !== document.body) {
        document.body.appendChild(m);
      }
    }
    teleportModal(modalClientCard);
    teleportModal(modalCreateClient);

    function showModal(modalEl) {
      if (!modalEl) return;
      teleportModal(modalEl);
      modalEl.classList.remove('hidden');
      modalEl.classList.add('flex');
      document.body.style.overflow = 'hidden';
      const card = modalEl.querySelector('.modal-card');
      setTimeout(() => {
        card?.classList.remove('scale-95', 'opacity-0');
        card?.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function hideModal(modalEl) {
      if (!modalEl) return;
      const card = modalEl.querySelector('.modal-card');
      card?.classList.remove('scale-100', 'opacity-100');
      card?.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modalEl.classList.remove('flex');
        modalEl.classList.add('hidden');
        document.body.style.overflow = '';
      }, 180);
    }

    // Fermeture avec touche Échap ou clic extérieur
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideModal(modalClientCard);
        hideModal(modalCreateClient);
      }
    });

    document.querySelectorAll('.modal-backdrop-click').forEach((bd) => {
      bd.addEventListener('click', () => {
        hideModal(modalClientCard);
        hideModal(modalCreateClient);
      });
    });

    // 3. Fiche client : Remplissage dynamique et ouverture
    function openClientCard(row) {
      if (!row || !modalClientCard) return;

      const rawName = row.dataset.rawName || 'Client Unilka';
      const id = row.dataset.id || 'CLI-01';
      const since = row.dataset.since || '2026';
      const phone = row.dataset.phone || '(514) 000-0000';
      const email = row.dataset.email || 'contact@client.ca';
      const address = row.dataset.address || 'Grand Montréal, QC';
      const sector = row.dataset.sector || 'Montréal';
      const frequency = row.dataset.frequency || 'Régulier';
      const staff = row.dataset.staff || 'Équipe Unilka';
      const revenue = row.dataset.revenue || '390,00 $ CAD';
      const notes = row.dataset.notes || 'Aucune consigne spécifique.';

      // Initiales pour l'avatar
      const parts = rawName.split(' ').filter(Boolean);
      const initials = (parts[0]?.[0] || 'U') + (parts[1]?.[0] || 'N');

      const avatarEl = document.getElementById('card-avatar');
      const titleEl = document.getElementById('card-client-title');
      const idEl = document.getElementById('card-id');
      const sinceEl = document.getElementById('card-since');
      const phoneTextEl = document.getElementById('card-phone-text');
      const emailTextEl = document.getElementById('card-email-text');
      const callLink = document.getElementById('card-call-link');
      const emailLink = document.getElementById('card-email-link');
      const addressEl = document.getElementById('card-address');
      const sectorEl = document.getElementById('card-sector');
      const freqEl = document.getElementById('card-frequency');
      const staffEl = document.getElementById('card-staff');
      const revEl = document.getElementById('card-revenue');
      const notesEl = document.getElementById('card-notes');

      if (avatarEl) avatarEl.textContent = initials.toUpperCase();
      if (titleEl) titleEl.textContent = rawName;
      if (idEl) idEl.textContent = id;
      if (sinceEl) sinceEl.textContent = `Client régulier depuis ${since}`;
      if (phoneTextEl) phoneTextEl.textContent = phone;
      if (emailTextEl) emailTextEl.textContent = email;
      if (callLink) callLink.href = `tel:${phone.replace(/[^0-9+]/g, '')}`;
      if (emailLink) emailLink.href = `mailto:${email}?subject=unilka%20%E2%80%94%20Votre%20service%20d%27entretien`;
      if (addressEl) addressEl.textContent = address;
      if (sectorEl) sectorEl.textContent = sector;
      if (freqEl) freqEl.textContent = frequency;
      if (staffEl) staffEl.textContent = staff;
      if (revEl) revEl.textContent = revenue;
      if (notesEl) notesEl.textContent = notes;

      showModal(modalClientCard);
    }

    // Attach row clicks
    function bindRowEvents() {
      document.querySelectorAll('.client-row').forEach((row) => {
        row.onclick = (e) => {
          if (e.target.closest('.btn-client-history')) return;
          openClientCard(row);
        };
      });

      document.querySelectorAll('.btn-open-client-card').forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const row = btn.closest('.client-row');
          openClientCard(row);
        };
      });

      document.querySelectorAll('.btn-client-history').forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          const row = btn.closest('.client-row');
          const name = btn.dataset.client;
          if (window.showAdminToast) {
            window.showAdminToast(`Historique complet des interventions pour ${name}`);
          }
          openClientCard(row);
        };
      });
    }
    bindRowEvents();

    document.getElementById('close-card-modal-btn')?.addEventListener('click', () => hideModal(modalClientCard));
    document.getElementById('btn-close-card')?.addEventListener('click', () => hideModal(modalClientCard));

    document.getElementById('btn-copy-card-info')?.addEventListener('click', () => {
      const name = document.getElementById('card-client-title')?.textContent || '';
      const phone = document.getElementById('card-phone-text')?.textContent || '';
      const email = document.getElementById('card-email-text')?.textContent || '';
      const address = document.getElementById('card-address')?.textContent || '';
      const text = `${name}\nTel : ${phone}\nEmail : ${email}\nAdresse : ${address}`;
      navigator.clipboard?.writeText(text).then(() => {
        window.showAdminToast?.("Coordonnées du client copiées dans le presse-papier !");
      });
    });

    // 4. Ajouter un nouveau client
    const openCreateBtn = document.getElementById('btn-open-create-client');
    const closeCreateBtn = document.getElementById('close-create-client-btn');
    const cancelCreateBtn = document.getElementById('cancel-create-client-btn');
    const formCreateClient = document.getElementById('form-create-client');

    openCreateBtn?.addEventListener('click', () => {
      formCreateClient?.reset();
      showModal(modalCreateClient);
    });

    closeCreateBtn?.addEventListener('click', () => hideModal(modalCreateClient));
    cancelCreateBtn?.addEventListener('click', () => hideModal(modalCreateClient));

    formCreateClient?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('new-client-name')?.value.trim() || 'Nouveau Client';
      const email = document.getElementById('new-client-email')?.value.trim() || '';
      const phone = document.getElementById('new-client-phone')?.value.trim() || '';
      const category = document.getElementById('new-client-category')?.value || 'residentiel';
      const sector = document.getElementById('new-client-sector')?.value.trim() || 'Montréal';
      const address = document.getElementById('new-client-address')?.value.trim() || `${sector}, QC`;
      const frequency = document.getElementById('new-client-frequency')?.value || 'Hebdomadaire';
      const staff = document.getElementById('new-client-staff')?.value || 'Fatou D.';
      const revenue = document.getElementById('new-client-revenue')?.value.trim() || '390,00 $ CAD';
      const notes = document.getElementById('new-client-notes')?.value.trim() || 'Accès standard.';

      const newId = `CLI-${String(Math.floor(Math.random() * 900) + 100)}`;
      const typeLabel = category === 'commercial' ? 'Commercial & Bureaux' : (category === 'ponctuel' ? 'Mission ponctuelle' : 'Résidence privée');
      const badgeClass = category === 'commercial' ? 'bg-blue-100 text-blue-800' : (category === 'ponctuel' ? 'bg-amber-100 text-amber-900' : 'bg-emerald-100 text-emerald-800');

      const tbody = document.getElementById('clients-table-body');
      if (tbody) {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-[#F5FAFA]/60 transition-colors client-row cursor-pointer bg-emerald-50/30';
        tr.dataset.id = newId;
        tr.dataset.name = name.toLowerCase();
        tr.dataset.sector = sector.toLowerCase();
        tr.dataset.category = category;
        tr.dataset.rawName = name;
        tr.dataset.phone = phone;
        tr.dataset.email = email;
        tr.dataset.address = address;
        tr.dataset.frequency = frequency;
        tr.dataset.staff = staff;
        tr.dataset.revenue = revenue;
        tr.dataset.notes = notes;
        tr.dataset.type = typeLabel;
        tr.dataset.since = "Novembre 2026";

        tr.innerHTML = `
          <td class="py-4 px-4">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-[#E3F4F5] text-[#0E7C86] font-black flex items-center justify-center shrink-0">
                ${name.substring(0, 2).toUpperCase()}
              </span>
              <div>
                <span class="font-extrabold text-[#0B2A2E] block text-[13px]">${name}</span>
                <span class="text-[10px] text-[#3D5A5E]/60 font-mono">${newId} • Client récent</span>
              </div>
            </div>
          </td>
          <td class="py-4 px-4">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${badgeClass}">
              ${typeLabel}
            </span>
          </td>
          <td class="py-4 px-4 font-medium text-[#0B2A2E]">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#0E7C86] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>${sector}</span>
            </span>
          </td>
          <td class="py-4 px-4">
            <span class="font-bold text-[#0E7C86]">${frequency}</span>
          </td>
          <td class="py-4 px-4">
            <span class="font-semibold text-[#0B2A2E] block">${staff}</span>
            <span class="inline-flex items-center gap-1 text-[10px] text-emerald-600 font-bold">
              <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span>Cautionné(e)</span>
            </span>
          </td>
          <td class="py-4 px-4">
            <span class="font-black text-[#0B2A2E] text-sm">${revenue}</span>
          </td>
          <td class="py-4 px-4 max-w-xs">
            <span class="inline-flex items-center gap-1.5 text-[#3D5A5E] text-[11px] truncate block" title="${notes}">
              <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
              <span class="truncate">${notes}</span>
            </span>
          </td>
          <td class="py-4 px-4 text-right">
            <div class="inline-flex items-center gap-1.5">
              <button
                type="button"
                class="btn-client-history p-2 rounded-lg text-[#3D5A5E] hover:text-[#0E7C86] hover:bg-[#E3F4F5] transition-colors cursor-pointer"
                title="Voir historique des interventions"
                data-client="${name}"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </button>
              <button
                type="button"
                class="btn-open-client-card inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold text-white bg-[#0E7C86] hover:bg-[#0A5A62] shadow-2xs transition-colors cursor-pointer"
                data-client="${name}"
              >
                <span>Fiche client</span>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </button>
            </div>
          </td>
        `;

        tbody.insertBefore(tr, tbody.firstChild);
        bindRowEvents();
      }

      hideModal(modalCreateClient);
      window.showAdminToast?.(`Client « ${name} » enregistré avec succès !`);
    });
  </script>

</AdminLayout>
