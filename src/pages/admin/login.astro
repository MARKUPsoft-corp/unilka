---
import '../../styles/global.css';

export const prerender = true;
---

<!DOCTYPE html>
<html lang="fr-CA" class="h-full bg-[#0B2A2E]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion Administration — unilka</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-full font-['Manrope',sans-serif] text-[#0B2A2E] antialiased bg-[#0B2A2E] flex items-center justify-center p-4 relative overflow-hidden">
    
    <!-- Halos lumineux d'ambiance de luxe -->
    <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-[#0E7C86]/25 blur-[120px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full bg-[#C5A880]/15 blur-[140px] pointer-events-none"></div>

    <main class="w-full max-w-md relative z-10">
      
      <!-- Carte de Connexion Frosted Glass -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-2xl border border-white/20 relative overflow-hidden">
        
        <!-- En-tête Marque Unilka -->
        <div class="text-center space-y-3 mb-8">
          <div class="inline-flex items-center justify-center mb-1">
            <img
              src="/images/logo-unilka-transparent.png"
              alt="UNILKA Nettoyage - entretien"
              class="h-12 w-auto object-contain mx-auto"
            />
          </div>
          <div>
            <p class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-[#0E7C86] mt-0.5">
              Console de Gestion
            </p>
          </div>
          <p class="text-xs text-[#3D5A5E] leading-relaxed max-w-xs mx-auto pt-1">
            Espace réservé à la direction, aux superviseurs et à l'administration des opérations.
          </p>
        </div>

        <!-- Message d'erreur dynamique -->
        <div id="login-error-box" class="hidden mb-6 p-3.5 rounded-xl bg-red-50 border border-red-200 text-xs text-red-800 flex items-start gap-2.5">
          <svg class="w-4 h-4 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span id="login-error-text">Une erreur est survenue lors de la connexion.</span>
        </div>

        <!-- Bouton Google Sign-In Principal -->
        <div class="space-y-4">
          <button
            type="button"
            id="google-signin-btn"
            class="w-full flex items-center justify-center gap-3.5 px-5 py-3.5 rounded-2xl bg-white hover:bg-[#F5FAFA] active:bg-[#E3F4F5] border-2 border-[#0B2A2E]/10 hover:border-[#0E7C86]/40 text-[#0B2A2E] font-bold text-sm shadow-sm hover:shadow transition-all duration-200 cursor-pointer group disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <!-- Logo Officiel Google SVG -->
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
            <span id="google-btn-text">Se connecter avec Google</span>
            <svg id="google-btn-spinner" class="w-4 h-4 animate-spin text-[#0E7C86] hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>

          <div class="pt-2 text-center">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#3D5A5E] hover:text-[#0E7C86] transition-colors"
            >
              <span>← Retourner sur le site public</span>
            </a>
          </div>
        </div>

        <!-- Pied de carte Sécurité -->
        <div class="mt-8 pt-6 border-t border-[#0E7C86]/10 text-center">
          <p class="text-[10px] text-[#3D5A5E]/70 flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Authentification chiffrée SSL • Google Identity & Firebase</span>
          </p>
        </div>

      </div>

    </main>

    <script>
      import { auth, googleProvider } from '../../lib/firebase';
      import { signInWithPopup, onAuthStateChanged } from 'firebase/auth';

      const btn = document.getElementById('google-signin-btn');
      const btnText = document.getElementById('google-btn-text');
      const btnSpinner = document.getElementById('google-btn-spinner');
      const errorBox = document.getElementById('login-error-box');
      const errorText = document.getElementById('login-error-text');

      // Récupérer l'URL de redirection souhaitée (?redirect=/admin/...)
      const urlParams = new URLSearchParams(window.location.search);
      const redirectTarget = urlParams.get('redirect') || '/admin/';

      // Si l'utilisateur est déjà connecté, on redirige automatiquement
      onAuthStateChanged(auth, (user) => {
        if (user) {
          try { localStorage.setItem('unilka_admin_logged_in', 'true'); } catch (e) {}
          window.location.replace(redirectTarget);
        }
      });

      btn?.addEventListener('click', async () => {
        if (errorBox) errorBox.classList.add('hidden');
        if (btn) (btn as HTMLButtonElement).disabled = true;
        if (btnText) btnText.textContent = "Authentification en cours…";
        if (btnSpinner) btnSpinner.classList.remove('hidden');

        try {
          const result = await signInWithPopup(auth, googleProvider);
          const user = result.user;
          console.log("[unilka Auth] Connexion réussie pour :", user.email);

          try { localStorage.setItem('unilka_admin_logged_in', 'true'); } catch (e) {}

          // Redirection instantanée vers le tableau de bord
          window.location.replace(redirectTarget);
        } catch (err: any) {
          console.error("[unilka Auth Error] Échec connexion Google :", err);
          
          let friendlyMsg = "Échec de la connexion. Veuillez réessayer.";
          if (err.code === 'auth/popup-closed-by-user') {
            friendlyMsg = "La fenêtre de connexion Google a été fermée.";
          } else if (err.code === 'auth/unauthorized-domain') {
            friendlyMsg = "Ce domaine n'est pas encore autorisé dans Firebase Console (Authentification > Settings > Domaines autorisés).";
          } else if (err.code === 'auth/network-request-failed') {
            friendlyMsg = "Erreur réseau. Vérifiez votre connexion internet.";
          } else if (err.message) {
            friendlyMsg = err.message;
          }

          if (errorText) errorText.textContent = friendlyMsg;
          if (errorBox) errorBox.classList.remove('hidden');

          if (btn) (btn as HTMLButtonElement).disabled = false;
          if (btnText) btnText.textContent = "Se connecter avec Google";
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    </script>

  </body>
</html>
