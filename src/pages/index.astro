---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOffcut from '../components/home/HeroOffcut.astro';
import MarqueeTicker from '../components/home/MarqueeTicker.astro';
import ServicesCollection from '../components/home/ServicesCollection.astro';
import PillarsOfExcellence from '../components/home/PillarsOfExcellence.astro';
import CardJourneySection from '../components/sections/card-journey/CardJourneySection.astro';
import ProcessConcierge from '../components/home/ProcessConcierge.astro';
import GoogleReviewsSection from '../components/home/GoogleReviewsSection.astro';
import TerritoriesSection from '../components/home/TerritoriesSection.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';

const pageTitle = "unilka — Entretien ménager & Nettoyage haut de gamme à Montréal";
const pageDescription = "Service d'entretien ménager haut de gamme à Montréal, Longueuil et Lanaudière. Résidences privées, bureaux et formules régulières. Devis personnalisé sous 24h.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- 1. HERO ARCHITECTURALE & ÉDITORIALE -->
  <HeroOffcut />

  <!-- 2. RUBAN DÉFILANT CONTINU -->
  <MarqueeTicker />

  <!-- 3. COLLECTION DES SERVICES (AVEC FILTRES PILLS) -->
  <ServicesCollection />

  <!-- 4. CARD JOURNEY SECTION (OPTION 2 SHARINGAN / RASENGAN) -->
  <CardJourneySection />

  <!-- 5. PARCOURS CONCIERGE SANS ENGAGEMENT -->
  <ProcessConcierge />

  <!-- 6. AVIS GOOGLE CERTIFIÉS & SOCIAL PROOF -->
  <GoogleReviewsSection />

  <!-- 7. TERRITOIRES DESSERVIS (MONTRÉAL, RIVE-SUD, LANAUDIÈRE) -->
  <TerritoriesSection />

  <!-- 7. SECTION CARRIÈRES / RECRUTEMENT VALORISANT -->
  <section class="py-14 lg:py-16 bg-[#F5FAFA] border-b border-[#0E7C86]/12" aria-labelledby="careers-banner-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-white border border-[#0E7C86]/15 p-8 sm:p-12 shadow-sm flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-3 text-center md:text-left max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E3F4F5] text-[#0E7C86] text-[11px] font-bold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0E7C86]"></span>
            <span>Carrières & Opportunités</span>
          </div>
          <h2 id="careers-banner-title" class="text-2xl sm:text-3xl font-extrabold text-[#0B2A2E] tracking-tight">
            Vous partagez notre goût du travail soigné ?
          </h2>
          <p class="text-sm sm:text-base text-[#3D5A5E] leading-relaxed">
            Nous recrutons des préposé(e)s sérieux et attentionnés : missions régulières, planning respectueux de votre équilibre, équipement fourni et reconnaissance de votre savoir-faire.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href="/carrieres/"
            class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-bold text-white bg-[#0B2A2E] hover:bg-[#0E7C86] rounded-full shadow-sm hover:shadow-md transition-all duration-200 no-underline hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>Postuler chez unilka</span>
            <span class="ml-2 font-bold" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. BANDEAU DE CONVERSION FINAL -->
  <CtaBanner
    title="Prêt(e) à retrouver la sérénité d'un intérieur irréprochable ?"
    description="Quelques minutes suffisent pour nous faire part de vos besoins. Vous recevrez une proposition personnalisée, claire et sans engagement sous 24h."
    ctaText="Demander une soumission"
    ctaLink="/soumission/"
  />

</BaseLayout>
